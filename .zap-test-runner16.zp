import "bootstrap/b1/lexer.zp"
import "bootstrap/b1/parser.zp"

export fn test():
    let src = read_text("bootstrap/fixtures/parser/invalid_indentation_jump.zp")
    let lines = split(trim(src), "\n")
    let header = trim(lines[0])
    let open_index = 0
    while open_index < len(header):
        if char_at(header, open_index) == "(":
            break
        open_index = open_index + 1
    let close_index = len(header) - 1
    while close_index >= 0:
        if char_at(header, close_index) == ")":
            break
        close_index = close_index - 1
    let raw_name = trim(substring(header, 3, open_index))
    let type_params = generic_parameters_from_name(raw_name)
    let name_text = raw_name
    if contains(raw_name, "<"):
        let name_parts = split(raw_name, "<")
        name_text = trim(name_parts[0])
    let parameter_text = substring(header, open_index + 1, close_index)
    let nested = parse_block_from(lines, 1, 4)
    say "nested next: " + str(nested["next"])
    let function = {"body": {"statements": nested["statements"]}, "constraints": [], "exported": false, "is_async": false, "kind": "function", "name": name_text, "params": parse_parameter_list(parameter_text), "return_type": none, "span": span(1, 1, len(header)), "type_params": type_params, "visibility": "public"}
    say "function created"
    let statements = []
    statements = append(statements, rebase_statement_spans(function, 0))
    say "rebase done"
    let cursor = nested["next"]
    while cursor < len(lines):
        let line = lines[cursor]
        let value = trim(line)
        if value != "":
            if indentation_width(line) == 0 and (starts_with(value, "fn ") or starts_with(value, "async fn ") or starts_with(value, "class ") or starts_with(value, "trait ") or starts_with(value, "interface ") or starts_with(value, "module ")):
                return statements
            let stmt = parse_statement(line, cursor + 1, 1)
            statements = append(statements, rebase_statement_spans(stmt, cursor))
        cursor = cursor + 1
    say "loop done"
    return statements

test()
