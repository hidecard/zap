let parsed = url_parse("https://example.com:8443/api?q=zap")
assert(parsed["scheme"] == "https", "URL scheme mismatch")
assert(parsed["host"] == "example.com", "URL host mismatch")
let setting = env_get("ZAP_CI_MISSING_SETTING", "fallback")
assert(setting == "fallback", "environment default mismatch")
let root = config_dir()
let safe = config_path("zap-ci-smoke.conf")
assert(type(root) == "text", "configuration directory must be text")
assert(type(safe) == "text", "configuration path must be text")
let result = process_run("printf", ["zap"])
assert(result["success"] == true, "process smoke failed")
assert(result["stdout"] == "zap", "process output mismatch")
assert(type(parsed) == "map", "URL parse result must be a map")
say "P3.3 smoke OK"
