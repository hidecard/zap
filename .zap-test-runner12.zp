import "bootstrap/b1/lexer.zp"
import "bootstrap/b1/parser.zp"

export fn test():
    let src = read_text("bootstrap/fixtures/parser/invalid_indentation_jump.zp")
    let lines = split(trim(src), "\n")
    let nested = parse_block_from(lines, 1, 4)
    let statements = []
    let cursor = nested["next"]
    while cursor < len(lines):
        let line = lines[cursor]
        let value = trim(line)
        if value != "":
            if indentation_width(line) == 0 and (starts_with(value, "fn ") or starts_with(value, "async fn ") or starts_with(value, "class ") or starts_with(value, "trait ") or starts_with(value, "interface ") or starts_with(value, "module ")):
                return statements
            let stmt = parse_statement(line, cursor + 1, 1)
            say "before append"
            statements = append(statements, stmt)
            say "after append"
        cursor = cursor + 1
    say "done"
    return statements

test()
