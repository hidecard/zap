let COMMAND_CHECK = "check"
let COMMAND_BUILD = "build"
let SUPPORTED = [COMMAND_CHECK, COMMAND_BUILD]

fn command_supported(command):
    return contains(SUPPORTED, command)

fn usage():
    return "usage: " + str(len(SUPPORTED))

fn dispatch(command):
    if command_supported(command):
        return "command: " + command
    return "ZAP-DRIVER-001 unsupported driver command: " + command

let args = argv()
let count = argc()
say "argc: " + str(count)
if count == 0:
    say usage()
else:
    let command = args[0]
    say dispatch(command)
    say "supported: " + str(command_supported(command))