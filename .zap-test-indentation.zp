import "bootstrap/b1/lexer.zp"
import "bootstrap/b1/parser.zp"

export fn test_indentation():
    let src = read_text("bootstrap/fixtures/parser/arbitrary_deep_indentation.zp")
    let toks = from_json(lex(src, "test.zp"))
    let table = token_indentation_table(toks["tokens"], 0, [])
    say "Table length: " + str(len(table))
    for entry in table:
        say "Line " + str(entry["line"]) + " column " + str(entry["column"])
    let lines = split(trim(src), "\n")
    say "Lines count: " + str(len(lines))
    let i = 0
    while i < len(lines):
        let indent = token_indentation_for(table, i + 1, 0)
        say "Line " + str(i + 1) + " indent: " + str(indent)
        i = i + 1
    return none

test_indentation()