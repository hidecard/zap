import "bootstrap/b1/lexer.zp"
import "bootstrap/b1/parser.zp"

export fn test():
    let lines = ["a", "b", "c"]
    let statements = []
    for cursor in range(0, len(lines)):
        let line = lines[cursor]
        let value = trim(line)
        if value != "":
            let stmt = parse_statement(line, cursor + 1, 1)
            statements = append(statements, stmt)
    say "statements count: " + str(len(statements))
    return statements

test()
