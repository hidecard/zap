# B2 candidate type checker written in Zap.
# This is a provisional corpus-limited implementation. Native Rust remains the
# reference type checker and owns the complete language semantics.

import "bootstrap/b1/parser.zp"

export fn ast_lookup_type(environment, name):
    let result = "any"
    for binding in environment:
        if binding["name"] == name:
            result = binding["type"]
    return result

export fn symbol_environment_bind(environment, name, type):
    return append(environment, {"name": name, "type": type})

export fn symbol_environment_has(environment, name):
    for binding in environment:
        if binding["name"] == name:
            return true
    return false

export fn branch_local_declaration_merge(base, then_environment, else_environment, names):
    let merged = base
    for name in names:
        if symbol_environment_has(then_environment, name) and symbol_environment_has(else_environment, name):
            let then_type = ast_lookup_type(then_environment, name)
            let else_type = ast_lookup_type(else_environment, name)
            if then_type == else_type:
                merged = symbol_environment_bind(merged, name, then_type)
            else:
                merged = symbol_environment_bind(merged, name, "any")
    return merged

export fn symbol_environment_from_parameters(parameters):
    let environment = []
    for parameter in parameters:
        environment = symbol_environment_bind(environment, parameter["name"], parameter["type"])
    return environment

export fn symbol_environment_extend(environment, locals):
    let result = environment
    for binding in locals:
        result = symbol_environment_bind(result, binding["name"], binding["type"])
    return result

export fn branch_environment_merge(base, then_environment, else_environment):
    let merged = []
    for binding in base:
        let then_type = ast_lookup_type(then_environment, binding["name"])
        let else_type = ast_lookup_type(else_environment, binding["name"])
        if then_type == else_type:
            merged = symbol_environment_bind(merged, binding["name"], then_type)
        else:
            merged = symbol_environment_bind(merged, binding["name"], "any")
    return merged

export fn symbol_environment_snapshot(environment):
    return environment

export fn symbol_environment_restore(snapshot):
    return snapshot

export fn scope_enter(parent, bindings):
    return symbol_environment_extend(parent, bindings)

export fn scope_exit(parent, child):
    return symbol_environment_restore(parent)

export fn branch_environment_merge_paths(base, then_environment, else_environment, then_returns, else_returns):
    if then_returns and not else_returns:
        return else_environment
    if else_returns and not then_returns:
        return then_environment
    if then_returns and else_returns:
        return base
    return branch_environment_merge(base, then_environment, else_environment)

export fn function_body_environment(parameters, locals):
    return symbol_environment_extend(symbol_environment_from_parameters(parameters), locals)

export fn flow_guard_type(type_name, positive):
    let parts = type_wrapper_parts(type_name)
    if positive and parts["wrapper"] == "option":
        return parts["inner"]
    if positive and parts["wrapper"] == "result":
        return parts["inner"]
    if not positive and parts["wrapper"] == "option":
        return "none"
    if not positive and parts["wrapper"] == "result":
        return "error"
    return type_name

export fn condition_derived_environment(environment, name, guard, positive):
    let current = ast_lookup_type(environment, name)
    if guard == "is_some" or guard == "is_option_none" or guard == "is_ok" or guard == "is_err":
        return symbol_environment_bind(environment, name, flow_guard_type(current, positive))
    return environment

export fn condition_path_states(environment, name, guard):
    let positive = condition_derived_environment(environment, name, guard, true)
    let negative = condition_derived_environment(environment, name, guard, false)
    return {"then": positive, "else": negative}

export fn condition_expression_paths(environment, condition):
    if condition["kind"] == "guard":
        return condition_path_states(environment, condition["name"], condition["guard"])
    if condition["kind"] == "logical":
        let left_paths = condition_expression_paths(environment, condition["left"])
        if condition["operator"] == "and":
            let right_paths = condition_expression_paths(left_paths["then"], condition["right"])
            return {"then": right_paths["then"], "else": branch_environment_merge_many(environment, [left_paths["else"], right_paths["else"]])}
        if condition["operator"] == "or":
            let right_paths = condition_expression_paths(left_paths["else"], condition["right"])
            return {"then": branch_environment_merge_many(environment, [left_paths["then"], right_paths["then"]]), "else": right_paths["else"]}
    return {"then": environment, "else": environment}

export fn compound_condition_paths(environment, conditions):
    let then_environment = environment
    let else_environment = environment
    for condition in conditions:
        let paths = condition_path_states(then_environment, condition["name"], condition["guard"])
        then_environment = paths["then"]
        else_environment = paths["else"]
    return {"then": then_environment, "else": else_environment}

export fn short_circuit_condition_paths(environment, left, right, operator):
    let left_paths = condition_path_states(environment, left["name"], left["guard"])
    if operator == "and":
        let right_paths = condition_path_states(left_paths["then"], right["name"], right["guard"])
        return {"then": right_paths["then"], "else": branch_environment_merge_many(environment, [left_paths["else"], right_paths["else"]])}
    if operator == "or":
        let right_paths = condition_path_states(left_paths["else"], right["name"], right["guard"])
        return {"then": branch_environment_merge_many(environment, [left_paths["then"], right_paths["then"]]), "else": right_paths["else"]}
    return {"then": environment, "else": environment}

export fn nested_branch_flow(base, branches):
    let live_paths = []
    for branch in branches:
        if not branch["returns"]:
            live_paths = append(live_paths, branch["environment"])
    if len(live_paths) == 0:
        return base
    return branch_environment_merge_many(base, live_paths)

export fn branch_environment_merge_many(base, environments):
    let merged = base
    for binding in base:
        let candidate = ""
        let consistent = true
        for environment in environments:
            let current = ast_lookup_type(environment, binding["name"])
            if candidate == "":
                candidate = current
            if current != candidate:
                consistent = false
        if consistent:
            merged = symbol_environment_bind(merged, binding["name"], candidate)
        else:
            merged = symbol_environment_bind(merged, binding["name"], "any")
    return merged

export fn branch_path_declaration_merge(base, environments, names):
    let merged = base
    for name in names:
        let present = true
        let candidate = ""
        let consistent = true
        for environment in environments:
            if not symbol_environment_has(environment, name):
                present = false
            else:
                let current = ast_lookup_type(environment, name)
                if candidate == "":
                    candidate = current
                if current != candidate:
                    consistent = false
        if present:
            if consistent:
                merged = symbol_environment_bind(merged, name, candidate)
            else:
                merged = symbol_environment_bind(merged, name, "any")
    return merged

export fn flow_reassignment_invalidate(environment, name, assigned_type, narrowed_names):
    let result = environment
    if list_contains(narrowed_names, name):
        result = symbol_environment_bind(result, name, assigned_type)
        return result
    return symbol_environment_bind(result, name, assigned_type)

export fn cfg_node(identifier, kind, successors, environment):
    return {"environment": environment, "id": identifier, "kind": kind, "successors": successors}

export fn cfg_condition_node(identifier, condition, then_id, else_id, environment):
    return {"condition": condition, "environment": environment, "id": identifier, "kind": "condition", "successors": [then_id, else_id]}

export fn cfg_exception_node(identifier, body_id, catch_id, continuation, environment):
    return {"environment": environment, "id": identifier, "kind": "try_catch", "successors": [body_id, catch_id, continuation]}

