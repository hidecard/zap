{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zap",
  "scopeName": "source.zap",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.zap", "match": "#.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zap",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.zap", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.zap",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.zap", "match": "\\\\." }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.zap", "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|\\d+(?:\\.\\d+)?)\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        { "name": "keyword.declaration.function.zap", "match": "\\b(fn|function)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.declaration.function.zap" }, "2": { "name": "entity.name.function.zap" } } },
        { "name": "keyword.declaration.class.zap", "match": "\\b(class|struct|enum|module)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.declaration.zap" }, "2": { "name": "entity.name.type.zap" } } },
        { "name": "keyword.control.import.zap", "match": "\\b(import)\\s+([^\\s]+)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?", "captures": { "1": { "name": "keyword.control.import.zap" }, "3": { "name": "keyword.control.import.zap" }, "4": { "name": "variable.other.constant.zap" } } }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.zap", "match": "\\b(if|elif|else|for|while|in|break|continue|return|raise|try|catch|match|case|pass|async|await|defer)\\b" },
        { "name": "keyword.operator.logical.zap", "match": "\\b(and|or|not)\\b" },
        { "name": "storage.type.function.zap", "match": "\\b(let|const|var|mut|pub|private|protected|static|self|super)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.zap", "match": "\\b(number|text|bool|none|list|map|set|option|result|future|unknown|any)\\b" }
      ]
    },
    "builtins": {
      "patterns": [
        { "name": "support.function.zap", "match": "\\b(say|print|len|type|range|enumerate|zip|map|filter|reduce|now|sleep|url_parse|url_encode|url_decode|http_get|http_request|process_run|has_env|env|path_join|basename|dirname|json_parse|json_stringify|spawn|task_join|task_is_ready)\\b(?=\\s*\\()" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.zap", "match": "\\b(true|false|none|null)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.zap", "match": "(?:==|!=|<=|>=|=>|\\+|-|\\*|/|%|<|>|=|\\||&)" }
      ]
    }
  }
}
