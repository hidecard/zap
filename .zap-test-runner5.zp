import "bootstrap/b1/lexer.zp"
import "bootstrap/b1/parser.zp"

export fn test():
    let src = read_text("bootstrap/fixtures/parser/invalid_indentation_jump.zp")
    let toks = from_json(lex(src, "invalid_indentation_jump.zp"))
    let table = token_indentation_table(toks["tokens"], 0, [])
    let lines = split(trim(src), "\n")
    say "line 0: " + lines[0]
    say "line 1: " + lines[1]
    say "line 2: " + lines[2]
    let chunked = top_level_slice_walk(lines, 1, [lines[0]])
    say "chunked next: " + str(chunked["next"])
    say "chunked lines count: " + str(len(chunked["lines"]))
    return none

test()
