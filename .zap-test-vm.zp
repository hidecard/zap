import "bootstrap/b3/vm.zp"

export fn test():
    let handlers = []
    let remaining = []
    let index = 0
    while index < len(handlers):
        if index < len(handlers) - 1:
            remaining = append(remaining, handlers[index])
        index = index + 1
    say "done: " + str(len(remaining))
    return none

test()
