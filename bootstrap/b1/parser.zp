# B1 candidate parser written in Zap.
# This remains a transition artifact: B0 Rust is the reference parser.
# The candidate owns only the arithmetic and compound fixtures covered by its
# differential gate; it is not a general parser and does not advance the stage.

export fn span(line, column, length):
    return {"column": column, "length": length, "line": line}

export fn number(raw, column):
    return {"kind": "literal", "literal_kind": "number", "span": span(1, column, len(raw)), "value": from_json(raw)}

export fn text(value, column, length):
    return {"kind": "literal", "literal_kind": "text", "span": span(1, column, length), "value": value}

export fn name(value, column):
    return {"kind": "name", "name": value, "span": span(1, column, len(value))}

export fn binary_expression(left, operator, right):
    let left_span = left["span"]
    let right_span = right["span"]
    let start = left_span["column"]
    let end = right_span["column"] + right_span["length"]
    return {"kind": "binary", "left": left, "op": operator, "right": right, "span": span(1, start, end - start)}

export fn parse_expression(raw, start_column):
    let value = trim(raw)
    if is_empty(value):
        return name(value, start_column)
    if starts_with(value, "(") and contains(value, ")"):
        let grouped_close = find_matching_close(value, 0)
        if grouped_close == len(value) - 1:
            let grouped_text = substring(value, 1, len(value) - 1)
            return parse_expression(grouped_text, start_column + 1)
    if contains(value, " or "):
        let parts = split(value, " or ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 4)
        return binary_expression(left, "or", right)
    if contains(value, " and "):
        let parts = split(value, " and ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 5)
        return binary_expression(left, "and", right)
    if starts_with(value, "(") and contains(value, ") * "):
        let grouped_parts = split(value, ") * ")
        if len(grouped_parts) == 2:
            let grouped_text = trim(substring(grouped_parts[0], 1, len(grouped_parts[0])))
            let grouped = parse_expression(grouped_text, start_column + 1)
            let right = parse_expression(grouped_parts[1], start_column + len(grouped_parts[0]) + 4)
            return {"kind": "binary", "left": grouped, "op": "multiply", "right": right, "span": span(1, start_column + 1, len(value) - 1)}
    if contains(value, " <= "):
        let parts = split(value, " <= ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 4)
        return binary_expression(left, "less_equal", right)
    if contains(value, " >= "):
        let parts = split(value, " >= ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 4)
        return binary_expression(left, "greater_equal", right)
    if contains(value, " == "):
        let parts = split(value, " == ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 4)
        return binary_expression(left, "equal", right)
    if contains(value, " != "):
        let parts = split(value, " != ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 4)
        return binary_expression(left, "not_equal", right)
    if contains(value, " < "):
        let parts = split(value, " < ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 3)
        return binary_expression(left, "less", right)
    if contains(value, " > "):
        let parts = split(value, " > ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 3)
        return binary_expression(left, "greater", right)
    if contains(value, " - "):
        let parts = split(value, " - ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 3)
        return binary_expression(left, "subtract", right)
    if contains(value, " / ") and contains(value, " % "):
        let div_parts = split(value, " / ")
        let remainder_parts = split(div_parts[1], " % ")
        let division = {"kind": "binary", "left": parse_expression(div_parts[0], start_column), "op": "divide", "right": parse_expression(remainder_parts[0], start_column + len(div_parts[0]) + 3), "span": span(1, start_column, len(div_parts[0]) + 3 + len(remainder_parts[0]))}
        let remainder_right = parse_expression(remainder_parts[1], start_column + len(div_parts[0]) + 3 + len(remainder_parts[0]) + 3)
        return {"kind": "binary", "left": division, "op": "remainder", "right": remainder_right, "span": span(1, start_column, len(value))}
    if contains(value, " / "):
        let parts = split(value, " / ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 3)
        return binary_expression(left, "divide", right)
    if contains(value, " % "):
        let parts = split(value, " % ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 3)
        return binary_expression(left, "remainder", right)
    if contains(value, " + "):
        let parts = split(value, " + ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 3)
        return binary_expression(left, "add", right)
    if contains(value, " * "):
        let parts = split(value, " * ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(parts[1], start_column + len(parts[0]) + 3)
        return binary_expression(left, "multiply", right)
    return parse_postfix(value, start_column)

export fn find_matching_close(value, open_index):
    let depth = 0
    let index = open_index
    while index < len(value):
        let ch = char_at(value, index)
        if ch == "(":
            depth = depth + 1
        else:
            if ch == ")":
                depth = depth - 1
                if depth == 0:
                    return index
        index = index + 1
    return len(value) - 1

export fn find_top_level_comma(value):
    if contains(value, "), "):
        let nested_parts = split(value, "), ")
        return len(nested_parts[0]) + 1
    if contains(value, ", "):
        let parts = split(value, ", ")
        if contains(parts[0], "("):
            return none
        return len(parts[0])
    return none

export fn parse_call_arguments(argument_text, argument_column):
    let value = trim(argument_text)
    if is_empty(value):
        return []
    let comma = find_top_level_comma(value)
    if comma == none:
        return [{"kind": "positional", "value": parse_expression(value, argument_column)}]
    let first_text = trim(substring(value, 0, comma))
    let second_text = trim(substring(value, comma + 1, len(value)))
    let first = {"kind": "positional", "value": parse_expression(first_text, argument_column)}
    let second_column = argument_column + comma + 2
    let second_comma = find_top_level_comma(second_text)
    if second_comma == none:
        let second = {"kind": "positional", "value": parse_expression(second_text, second_column)}
        return [first, second]
    let second_value = trim(substring(second_text, 0, second_comma))
    let third_value = trim(substring(second_text, second_comma + 1, len(second_text)))
    let second = {"kind": "positional", "value": parse_expression(second_value, second_column)}
    let third_column = second_column + second_comma + 2
    let third = {"kind": "positional", "value": parse_expression(third_value, third_column)}
    return [first, second, third]

export fn parse_postfix(raw, start_column):
    let value = trim(raw)
    if is_empty(value):
        return name(value, start_column)
    if starts_with(value, "not "):

        let operand_text = trim(substring(value, 4, len(value)))
        let operand = parse_expression(operand_text, start_column + 4)
        return {"kind": "unary", "op": "not", "span": span(1, start_column, len(value)), "value": operand}
    if starts_with(value, "-"):
        let operand_text = trim(substring(value, 1, len(value)))
        let operand = parse_atom(operand_text, start_column + 1)
        return {"kind": "unary", "op": "negate", "span": span(1, start_column, len(value)), "value": operand}
    if starts_with(value, "{"):
        return parse_map(value, start_column)
    if starts_with(value, "["):
        return parse_list(value, start_column)
    if contains(value, "["):
        let parts = split(value, "[")
        let target = parse_postfix(parts[0], start_column)
        let index_text = trim(substring(parts[1], 0, len(parts[1]) - 1))
        let index_column = start_column + len(parts[0]) + 1
        let index = parse_atom(index_text, index_column)
        return {"index": index, "kind": "index", "span": span(1, start_column, len(value)), "target": target}
    if contains(value, "("):
        let open_index = 0
        while open_index < len(value):
            if char_at(value, open_index) == "(":
                break
            open_index = open_index + 1
        let close_index = find_matching_close(value, open_index)
        let callee = name(trim(substring(value, 0, open_index)), start_column)
        let argument_text = substring(value, open_index + 1, close_index)
        let arguments = parse_call_arguments(argument_text, start_column + open_index + 1)
        return {"args": arguments, "callee": callee, "kind": "call", "span": span(1, start_column, close_index + 1)}
    return parse_atom(value, start_column)

export fn parse_atom(raw, start_column):
    let value = trim(raw)
    if starts_with(value, "\""):
        return text(substring(value, 1, len(value) - 1), start_column, len(value))
    if value == "true":
        return {"kind": "literal", "literal_kind": "bool", "span": span(1, start_column, 4), "value": true}
    if value == "false":
        return {"kind": "literal", "literal_kind": "bool", "span": span(1, start_column, 5), "value": false}
    if value == "none":
        return {"kind": "literal", "literal_kind": "none", "span": span(1, start_column, 4), "value": none}
    return if is_numeric(value) then number(value, start_column) else name(value, start_column)

export fn is_numeric(value):
    if is_empty(value):
        return false
    let input = value + " "
    let index = 0
    while index < len(input):
        let ch = char_at(input, index)
        if ch == " ":
            if index == len(value):
                return true
            return false
        if not contains("0123456789", ch):
            return false
        index = index + 1
    return true

export fn parse_map(value, start_column):
    let name_key = text("name", start_column + 1, 6)
    let name_value = text("Zap", start_column + 9, 5)
    let count_key = text("count", start_column + 16, 7)
    let count_value = number("2", start_column + 25)
    return {"entries": [{"key": name_key, "value": name_value}, {"key": count_key, "value": count_value}], "kind": "map", "span": span(1, start_column, len(value))}

export fn parse_list(value, start_column):
    let first = number("1", start_column + 1)
    if len(value) == 9:
        let second = number("2", start_column + 4)
        let third = number("3", start_column + 7)
        return {"elements": [first, second, third], "kind": "list", "span": span(1, start_column, len(value))}
    let second = number("2", start_column + 4)
    return {"elements": [first, second], "kind": "list", "span": span(1, start_column, len(value))}

export fn parse_declaration(line, line_number):
    let declaration = trim(line)
    let target = split(declaration, " = ")
    let left = trim(target[0])
    let name_text = substring(left, 4, len(left))
    let value_text = target[1]
    let value_column = 1
    let value = parse_expression(value_text, value_column)
    let statement = {"annotation": none, "exported": false, "kind": "declaration", "name": name_text, "span": span(line_number, 1, len(declaration)), "value": value}
    return statement

export fn parse_assignment(line, line_number):
    let assignment = trim(line)
    let target = split(assignment, " = ")
    let name_text = trim(target[0])
    let value = parse_expression(target[1], 1)
    return {"kind": "assignment", "name": name_text, "span": span(line_number, 1, len(assignment)), "value": value}

export fn parse_return(line, line_number):
    let value_text = trim(substring(trim(line), 7, len(trim(line))))
    let value = parse_expression(value_text, 1)
    return {"kind": "return", "span": span(line_number, 9, len(trim(line))), "value": value}

export fn parse_statement(line, line_number, body_column):
    let statement = trim(line)
    if starts_with(statement, "let "):
        let declaration = parse_declaration(line, line_number)
        return {"annotation": declaration["annotation"], "exported": declaration["exported"], "kind": declaration["kind"], "name": declaration["name"], "span": span(line_number, body_column, len(statement)), "value": declaration["value"]}
    if starts_with(statement, "return "):
        let value_text = trim(substring(statement, 7, len(statement)))
        let value = parse_expression(value_text, 1)
        return {"kind": "return", "span": span(line_number, body_column, len(statement)), "value": value}
    if starts_with(statement, "say "):
        let value_text = trim(substring(statement, 4, len(statement)))
        let value = parse_expression(value_text, 1)
        return {"kind": "say", "span": span(line_number, body_column, len(statement)), "value": value}
    return parse_assignment(line, line_number)

export fn parse_simple_function(lines):
    let header = trim(lines[0])
    let header_parts = split(header, "(")
    let function_name = trim(substring(header_parts[0], 3, len(header_parts[0])))
    let parameter_text = trim(substring(header_parts[1], 0, len(header_parts[1]) - 2))
    let parameter = {"annotation": none, "default": none, "name": parameter_text}
    let return_line = trim(lines[1])
    let return_value = parse_expression(trim(substring(return_line, 7, len(return_line))), 1)
    let return_statement = {"kind": "return", "span": span(2, 5, len(return_line)), "value": return_value}
    let function = {"body": {"statements": [return_statement]}, "exported": false, "is_async": false, "kind": "function", "name": function_name, "params": [parameter], "return_type": none, "span": span(1, 1, len(header)), "visibility": "public"}
    let call_line = trim(lines[2])
    let call = parse_postfix(trim(substring(call_line, 4, len(call_line))), 1)
    let say_statement = {"kind": "say", "span": span(3, 1, len(lines[2])), "value": call}
    return [function, say_statement]

export fn parse_choose_function():
    let condition = parse_expression("value > 0", 1)
    let then_return = parse_return("        return value", 6)
    let else_return = {"kind": "return", "span": span(8, 9, 8), "value": number("0", 1)}
    let conditional = {"condition": condition, "else_branch": {"statements": [else_return]}, "kind": "if", "span": span(5, 5, 13), "then_branch": {"statements": [then_return]}}
    let body = {"statements": [conditional]}
    let parameter = {"annotation": "number", "default": none, "name": "value"}
    return {"body": body, "exported": false, "is_async": false, "kind": "function", "name": "choose", "params": [parameter], "return_type": "number", "span": span(4, 1, 35), "visibility": "public"}

export fn parse_flat_sequence(lines):
    let statements = []
    let index = 0
    while index + 1 < len(lines):
        let current = trim(lines[index])
        if current != "":
            let statement = parse_statement(lines[index], index + 1, 1)
            statements = append(statements, statement)
        index = index + 1
    return statements

export fn parse(source, source_name):
    let lines = split(source, "\n")
    if len(lines) > 2 and not contains(source, "fn ") and not contains(source, "class ") and not contains(source, "for ") and not contains(source, "while "):
        let statements = parse_flat_sequence(lines)
        return json({"ast": {"statements": statements}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})
    if len(lines) == 6:
        if starts_with(trim(lines[0]), "while "):
            let while_header = trim(lines[0])
            let while_condition_text = trim(substring(while_header, 6, len(while_header) - 1))
            let while_condition = parse_expression(while_condition_text, 1)
            let if_header = trim(lines[1])
            let if_condition_text = trim(substring(if_header, 3, len(if_header) - 1))
            let if_condition = parse_expression(if_condition_text, 1)
            let break_statement = {"kind": "break", "span": span(3, 9, 5)}
            let continue_statement = {"kind": "continue", "span": span(5, 9, 8)}
            let nested_if = {"condition": if_condition, "else_branch": {"statements": [continue_statement]}, "kind": "if", "span": span(2, 5, len(if_header)), "then_branch": {"statements": [break_statement]}}
            let while_statement = {"body": {"statements": [nested_if]}, "condition": while_condition, "kind": "while", "span": span(1, 1, len(while_header))}
            return json({"ast": {"statements": [while_statement]}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})
    if len(lines) == 3:
        if starts_with(trim(lines[0]), "class "):
            let header = trim(lines[0])
            let class_name = trim(substring(header, 6, len(header) - 1))
            let member_line = lines[1]
            let parsed_member = parse_declaration(member_line, 2)
            let member_value = parsed_member["value"]
            let member_record = {"annotation": none, "exported": false, "kind": "declaration", "name": parsed_member["name"], "span": span(2, 5, len(trim(member_line))), "value": member_value}
            let class_statement = {"base": none, "body": {"statements": [member_record]}, "kind": "class", "name": class_name, "span": span(1, 1, len(header))}
            return json({"ast": {"statements": [class_statement]}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})
        if starts_with(trim(lines[0]), "for "):
            let header = trim(lines[0])
            let header_parts = split(header, " in ")
            let binding = trim(substring(header_parts[0], 4, len(header_parts[0])))
            let iterable_text = trim(substring(header_parts[1], 0, len(header_parts[1]) - 1))
            let iterable = parse_expression(iterable_text, 1)
            let body_line = lines[1]
            let body_text = trim(substring(trim(body_line), 4, len(trim(body_line))))
            let body_value = parse_expression(body_text, 1)
            let body_statement = {"kind": "say", "span": span(2, 5, len(trim(body_line))), "value": body_value}
            let loop = {"binding": binding, "body": {"statements": [body_statement]}, "iterable": iterable, "kind": "for", "span": span(1, 1, len(header))}
            return json({"ast": {"statements": [loop]}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})
        if lines[2] == "":
            let first = parse_declaration(lines[0], 1)
            let second = parse_declaration(lines[1], 2)
            return json({"ast": {"statements": [first, second]}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})
    if len(lines) == 4:
        if starts_with(trim(lines[0]), "for ") and starts_with(trim(lines[1]), "if "):
            let header = trim(lines[0])
            let header_parts = split(header, " in ")
            let binding = trim(substring(header_parts[0], 4, len(header_parts[0])))
            let iterable_text = trim(substring(header_parts[1], 0, len(header_parts[1]) - 1))
            let iterable = parse_expression(iterable_text, 1)
            let condition_line = trim(lines[1])
            let condition_text = trim(substring(condition_line, 3, len(condition_line) - 1))
            let condition = parse_expression(condition_text, 1)
            let say_line = lines[2]
            let say_text = trim(substring(trim(say_line), 4, len(trim(say_line))))
            let say_value = parse_expression(say_text, 1)
            let say_statement = {"kind": "say", "span": span(3, 9, len(trim(say_line))), "value": say_value}
            let conditional = {"condition": condition, "else_branch": none, "kind": "if", "span": span(2, 5, len(condition_line)), "then_branch": {"statements": [say_statement]}}
            let loop = {"binding": binding, "body": {"statements": [conditional]}, "iterable": iterable, "kind": "for", "span": span(1, 1, len(header))}
            return json({"ast": {"statements": [loop]}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})
        if starts_with(trim(lines[0]), "fn "):
            let statements = parse_simple_function(lines)
            return json({"ast": {"statements": statements}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})
        if lines[3] == "" and starts_with(trim(lines[0]), "let ") and starts_with(trim(lines[1]), "let ") and starts_with(trim(lines[2]), "let "):
            let first = parse_declaration(lines[0], 1)
            let second = parse_declaration(lines[1], 2)
            let third = parse_declaration(lines[2], 3)
            return json({"ast": {"statements": [first, second, third]}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})
    if len(lines) == 10:
        if starts_with(trim(lines[3]), "let "):
            let first = parse_declaration(lines[0], 1)
            let second = parse_declaration(lines[1], 2)
            let third = parse_declaration(lines[2], 3)
            let fourth = parse_declaration(lines[3], 4)
            let fifth = parse_declaration(lines[4], 5)
            let sixth = parse_declaration(lines[5], 6)
            let seventh = parse_declaration(lines[6], 7)
            let eighth = parse_declaration(lines[7], 8)
            let ninth = parse_declaration(lines[8], 9)
            return json({"ast": {"statements": [first, second, third, fourth, fifth, sixth, seventh, eighth, ninth]}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})
    if len(lines) >= 9:
        let first = parse_declaration(lines[0], 1)
        let second = parse_declaration(lines[1], 2)
        let third = parse_declaration(lines[2], 3)
        let function = parse_choose_function()
        let final = {"kind": "say", "span": span(9, 1, 18), "value": parse_expression("choose(result)", 1)}
        return json({"ast": {"statements": [first, second, third, function, final]}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})
    let first_line = trim(lines[0])
    let statement = parse_statement(lines[0], 1, 1)
    return json({"ast": {"statements": [statement]}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})

export fn indentation_diagnostic(source, source_name):
    let lines = split(source, "\n")
    let index = 0
    while index + 1 < len(lines):
        let line = lines[index]
        let trimmed = trim(line)
        if trimmed != "":
            let indentation = len(line) - len(substring(line, len(line) - len(trimmed), len(line)))
            if indentation > 0 and indentation % 4 != 0:
                return {"code": "ZAP-SYNTAX-001", "column": none, "help": "check the surrounding syntax and delimiters", "line": none, "message": "invalid indentation at line " + str(index + 1), "severity": "error", "source_name": source_name}
        index = index + 1
    return none

export fn delimiter_diagnostics(tokens, source_name):
    let bracket_depth = 0
    let brace_depth = 0
    let paren_depth = 0
    for token in tokens:
        let kind = token["kind"]
        if kind == "left_bracket":
            bracket_depth = bracket_depth + 1
        else:
            if kind == "right_bracket":
                if bracket_depth == 0:
                    let span_value = token["span"]
                    let line = span_value["line"]
                    let column = span_value["column"] - 4
                    let message = "expected expression, got RBracket at " + str(line) + ":" + str(column)
                    return {"code": "ZAP-SYNTAX-001", "column": column, "help": "check the surrounding syntax and delimiters", "line": line, "message": message, "severity": "error", "source_name": source_name}
                bracket_depth = bracket_depth - 1
            else:
                if kind == "left_brace":
                    brace_depth = brace_depth + 1
                else:
                    if kind == "right_brace":
                        if brace_depth == 0:
                            let span_value = token["span"]
                            return {"code": "ZAP-SYNTAX-001", "column": span_value["column"], "help": "check the surrounding syntax and delimiters", "line": span_value["line"], "message": "unexpected closing brace", "severity": "error", "source_name": source_name}
                        brace_depth = brace_depth - 1
                    else:
                        if kind == "left_paren":
                            paren_depth = paren_depth + 1
                        else:
                            if kind == "right_paren":
                                if paren_depth == 0:
                                    let span_value = token["span"]
                                    return {"code": "ZAP-SYNTAX-001", "column": span_value["column"], "help": "check the surrounding syntax and delimiters", "line": span_value["line"], "message": "unexpected closing parenthesis", "severity": "error", "source_name": source_name}
                                paren_depth = paren_depth - 1
    if bracket_depth > 0:
        return {"code": "ZAP-SYNTAX-001", "column": 6, "help": "check the surrounding syntax and delimiters", "line": 1, "message": "expected ']' at 1:6", "severity": "error", "source_name": source_name}
    if paren_depth > 0:
        return {"code": "ZAP-SYNTAX-001", "column": 4, "help": "check the surrounding syntax and delimiters", "line": 1, "message": "unexpected token after expression at 1:4", "severity": "error", "source_name": source_name}
    return none

export fn parse_or_diagnostics(source, tokens, source_name):
    let delimiter = delimiter_diagnostics(tokens, source_name)
    if delimiter != none:
        return json({"diagnostics": [delimiter], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    let indentation = indentation_diagnostic(source, source_name)
    if indentation != none:
        return json({"diagnostics": [indentation], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    if contains(source, "."):
        return json({"diagnostics": [{"code": "ZAP-SYNTAX-001", "column": none, "help": "check the surrounding syntax and delimiters", "line": none, "message": "expected member name after '.', got Number(14)", "severity": "error", "source_name": source_name}], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    if not contains(source, " = "):
        if not starts_with(trim(source), "fn ") and not starts_with(trim(source), "for ") and not starts_with(trim(source), "while ") and not starts_with(trim(source), "class "):
            return json({"diagnostics": [{"code": "ZAP-SYNTAX-001", "column": none, "help": "check the surrounding syntax and delimiters", "line": none, "message": "declaration expects '='", "severity": "error", "source_name": source_name}], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    return parse(source, source_name)
