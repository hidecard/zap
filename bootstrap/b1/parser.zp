# B1 candidate parser written in Zap.
# B1 parser implementation: the general entry owns token/indentation-driven
# AST assembly while the Rust implementation remains the differential reference.
import "bootstrap/b1/lexer.zp"

export fn span(line, column, length):
    return {"column": column, "length": length, "line": line}

export fn rebase_map_entries(entries, index, line_delta, column_delta, result):
    if index >= len(entries):
        return result
    let entry = entries[index]
    let rebased_entry = {"key": rebase_expression_span(entry["key"], line_delta, column_delta), "value": rebase_expression_span(entry["value"], line_delta, column_delta)}
    return rebase_map_entries(entries, index + 1, line_delta, column_delta, append(result, rebased_entry))

export fn rebase_expression_list(elements, index, line_delta, column_delta, result):
    if index >= len(elements):
        return result
    return rebase_expression_list(elements, index + 1, line_delta, column_delta, append(result, rebase_expression_span(elements[index], line_delta, column_delta)))

export fn rebase_call_arguments(arguments, index, line_delta, column_delta, result):
    if index >= len(arguments):
        return result
    let argument = arguments[index]
    let rebased_value = rebase_expression_span(argument["value"], line_delta, column_delta)
    let rebased_argument = {"kind": "positional", "value": rebased_value}
    if argument["kind"] == "named":
        rebased_argument = {"kind": "named", "name": argument["name"], "value": rebased_value}
    return rebase_call_arguments(arguments, index + 1, line_delta, column_delta, append(result, rebased_argument))

export fn rebase_expression_span(node, line_delta, column_delta):
    if node == none:
        return none
    let node_span = node["span"]
    let rebased = span(node_span["line"] + line_delta, node_span["column"] + column_delta, node_span["length"])
    let kind = node["kind"]
    if kind == "literal":
        return {"kind": kind, "literal_kind": node["literal_kind"], "span": rebased, "value": node["value"]}
    if kind == "name":
        return {"kind": kind, "name": node["name"], "span": rebased}
    if kind == "unary":
        return {"kind": kind, "op": node["op"], "span": rebased, "value": rebase_expression_span(node["value"], line_delta, column_delta)}
    if kind == "conditional":
        return {"condition": rebase_expression_span(node["condition"], line_delta, column_delta), "else_value": rebase_expression_span(node["else_value"], line_delta, column_delta), "kind": kind, "span": rebased, "then_value": rebase_expression_span(node["then_value"], line_delta, column_delta)}
    if kind == "binary":
        return {"kind": kind, "left": rebase_expression_span(node["left"], line_delta, column_delta), "op": node["op"], "right": rebase_expression_span(node["right"], line_delta, column_delta), "span": rebased}
    if kind == "call":
        let arguments = rebase_call_arguments(node["args"], 0, line_delta, column_delta, [])
        return {"args": arguments, "callee": rebase_expression_span(node["callee"], line_delta, column_delta), "kind": kind, "span": rebased, "type_args": node["type_args"]}
    if kind == "index":
        return {"index": rebase_expression_span(node["index"], line_delta, column_delta), "kind": kind, "span": rebased, "target": rebase_expression_span(node["target"], line_delta, column_delta)}
    if kind == "map":
        let entries = rebase_map_entries(node["entries"], 0, line_delta, column_delta, [])
        return {"entries": entries, "kind": kind, "span": rebased}
    if kind == "list":
        let elements = rebase_expression_list(node["elements"], 0, line_delta, column_delta, [])
        return {"elements": elements, "kind": kind, "span": rebased}
    return node

export fn parsed_expression_at(raw, line_number, column):
    return rebase_expression_span(parse_expression(raw, column), line_number - 1, 0)

export fn parse_declaration_rebased(line, line_number):
    let statement = parse_declaration(line, line_number)
    return {"annotation": statement["annotation"], "exported": statement["exported"], "kind": statement["kind"], "name": statement["name"], "span": statement["span"], "value": rebase_expression_span(statement["value"], line_number - 1, 0)}

export fn parsed_function_constraints(node):
    if contains(json(node), "\"constraints\":"):
        return node["constraints"]
    return []

export fn rebase_statement_spans_list_at(statements, index, line_delta, result):
    if index >= len(statements):
        return result
    let next_result = append(result, rebase_statement_spans(statements[index], line_delta))
    return rebase_statement_spans_list_at(statements, index + 1, line_delta, next_result)

export fn rebase_statement_spans_list(statements, line_delta):
    return rebase_statement_spans_list_at(statements, 0, line_delta, [])

export fn rebase_statement_spans(node, line_delta):
    let node_span = node["span"]
    let rebased_span = span(node_span["line"] + line_delta, node_span["column"], node_span["length"])
    let kind = node["kind"]
    if kind == "function":
        if contains(json(node), "\"required\""):
            return {"body": {"statements": rebase_statement_spans_list(node["body"]["statements"], line_delta)}, "exported": node["exported"], "is_async": node["is_async"], "kind": kind, "name": node["name"], "params": node["params"], "required": node["required"], "return_type": node["return_type"], "span": rebased_span, "type_params": node["type_params"], "constraints": parsed_function_constraints(node), "visibility": node["visibility"]}
        return {"body": {"statements": rebase_statement_spans_list(node["body"]["statements"], line_delta)}, "exported": node["exported"], "is_async": node["is_async"], "kind": kind, "name": node["name"], "params": node["params"], "return_type": node["return_type"], "span": rebased_span, "type_params": node["type_params"], "constraints": parsed_function_constraints(node), "visibility": node["visibility"]}
    if kind == "trait" or kind == "interface":
        return {"body": {"statements": rebase_statement_spans_list(node["body"]["statements"], line_delta)}, "kind": kind, "name": node["name"], "span": rebased_span}
    if kind == "trait_use":
        return {"kind": kind, "method": node["method"], "name": node["name"], "span": rebased_span, "trait": node["trait"]}
    if kind == "class":
        let traits = []
        let interfaces = []
        let trait_selections = []
        if contains(json(node), "\"traits\""):
            traits = node["traits"]
        if contains(json(node), "\"interfaces\""):
            interfaces = node["interfaces"]
        if contains(json(node), "\"trait_selections\""):
            trait_selections = node["trait_selections"]
        if contains(json(node), "\"parents\""):
            return {"base": node["base"], "body": {"statements": rebase_statement_spans_list(node["body"]["statements"], line_delta)}, "interfaces": interfaces, "kind": kind, "name": node["name"], "parents": node["parents"], "span": rebased_span, "trait_selections": trait_selections, "traits": traits}
        return {"base": node["base"], "body": {"statements": rebase_statement_spans_list(node["body"]["statements"], line_delta)}, "interfaces": interfaces, "kind": kind, "name": node["name"], "span": rebased_span, "trait_selections": trait_selections, "traits": traits}
    if kind == "if":
        let else_branch = none
        if node["else_branch"] != none:
            else_branch = {"statements": rebase_statement_spans_list(node["else_branch"]["statements"], line_delta)}
        return {"condition": node["condition"], "else_branch": else_branch, "kind": kind, "span": rebased_span, "then_branch": {"statements": rebase_statement_spans_list(node["then_branch"]["statements"], line_delta)}}
    if kind == "try_catch":
        let body = {"statements": rebase_statement_spans_list(node["body"]["statements"], line_delta)}
        let catch_body = {"statements": rebase_statement_spans_list(node["catch_body"]["statements"], line_delta)}
        if contains(json(node), "\"catch_binding\""):
            return {"body": body, "catch_binding": node["catch_binding"], "catch_body": catch_body, "kind": kind, "span": rebased_span}
        return {"body": body, "catch_body": catch_body, "kind": kind, "span": rebased_span}
    if kind == "for":
        return {"binding": node["binding"], "body": {"statements": rebase_statement_spans_list(node["body"]["statements"], line_delta)}, "iterable": node["iterable"], "kind": kind, "span": rebased_span}
    if kind == "while":
        return {"body": {"statements": rebase_statement_spans_list(node["body"]["statements"], line_delta)}, "condition": node["condition"], "kind": kind, "span": rebased_span}
    if kind == "return":
        return {"kind": kind, "span": rebased_span, "value": node["value"]}
    if kind == "say":
        return {"kind": kind, "payload": node["payload"], "span": rebased_span, "value": node["value"]}
    if kind == "raise":
        return {"kind": kind, "payload": node["payload"], "span": rebased_span, "value": node["value"]}
    if kind == "expression":
        return {"kind": kind, "payload": node["payload"], "span": rebased_span, "value": node["value"]}
    if kind == "declaration":
        return {"annotation": node["annotation"], "exported": node["exported"], "kind": kind, "name": node["name"], "span": rebased_span, "value": node["value"]}
    if kind == "assignment":
        return {"kind": kind, "name": node["name"], "span": rebased_span, "value": node["value"]}
    if kind == "type_alias":
        return {"kind": kind, "name": node["name"], "span": rebased_span, "target": node["target"], "type_params": node["type_params"]}
    return {"kind": kind, "span": rebased_span}

export fn number(raw, column):
    return {"kind": "literal", "literal_kind": "number", "span": span(1, column, len(raw)), "value": from_json(raw)}

export fn text(value, column, length):
    return {"kind": "literal", "literal_kind": "text", "span": span(1, column, length), "value": value}

export fn name(value, column):
    return {"kind": "name", "name": value, "span": span(1, column, len(value))}

export fn binary_expression(left, operator, right):
    let left_span = left["span"]
    let right_span = right["span"]
    let start = left_span["column"]
    let end = right_span["column"] + right_span["length"]
    return {"kind": "binary", "left": left, "op": operator, "right": right, "span": span(1, start, end - start)}

export fn parse_expression(raw, start_column):
    let value = trim(raw)
    if is_empty(value):
        return name(value, start_column)
    if starts_with(value, "if ") and contains(value, " then ") and contains(value, " else "):
        let then_parts = split(value, " then ")
        if len(then_parts) >= 2:
            let condition_text = trim(substring(then_parts[0], 3, len(then_parts[0])))
            let value_parts = split(then_parts[1], " else ")
            if len(value_parts) >= 2:
                let condition = parse_expression(condition_text, start_column + 3)
                let then_value = parse_expression(trim(value_parts[0]), start_column + len(then_parts[0]) + 6)
                let else_value = parse_expression(trim(value_parts[1]), start_column + len(then_parts[0]) + 6 + len(value_parts[0]) + 6)
                return {"condition": condition, "else_value": else_value, "kind": "conditional", "span": span(1, start_column, len(value)), "then_value": then_value}
    if starts_with(value, "[") and ends_with(value, "]"):
        return parse_list(value, start_column)
    if starts_with(value, "{") and ends_with(value, "}"):
        return parse_map(value, start_column)
    if starts_with(value, "not "):
        let operand_text = trim(substring(value, 4, len(value)))
        let operand = parse_expression(operand_text, start_column + 4)
        let unary_length = len(value)
        if starts_with(operand_text, "("):
            unary_length = unary_length - 1
        return {"kind": "unary", "op": "not", "span": span(1, start_column, unary_length), "value": operand}
    if starts_with(value, "(") and contains(value, ")"):
        let grouped_close = find_matching_close(value, 0)
        if grouped_close != none and grouped_close == len(value) - 1:
            let grouped_text = substring(value, 1, len(value) - 1)
            return parse_expression(grouped_text, start_column + 1)
    if contains(value, " or "):
        let parts = split(value, " or ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 4, len(value))), start_column + len(parts[0]) + 4)
        return binary_expression(left, "or", right)
    if contains(value, " and "):
        let parts = split(value, " and ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 5, len(value))), start_column + len(parts[0]) + 5)
        return binary_expression(left, "and", right)
    if starts_with(value, "(") and contains(value, ") * "):
        let grouped_parts = split(value, ") * ")
        if len(grouped_parts) == 2:
            let grouped_text = trim(substring(grouped_parts[0], 1, len(grouped_parts[0])))
            let grouped = parse_expression(grouped_text, start_column + 1)
            let right = parse_expression(grouped_parts[1], start_column + len(grouped_parts[0]) + 4)
            return {"kind": "binary", "left": grouped, "op": "multiply", "right": right, "span": span(1, start_column + 1, len(value) - 1)}
    if contains(value, " <= "):
        let parts = split(value, " <= ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 4, len(value))), start_column + len(parts[0]) + 4)
        return binary_expression(left, "less_equal", right)
    if contains(value, " >= "):
        let parts = split(value, " >= ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 4, len(value))), start_column + len(parts[0]) + 4)
        return binary_expression(left, "greater_equal", right)
    if contains(value, " == "):
        let parts = split(value, " == ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 4, len(value))), start_column + len(parts[0]) + 4)
        return binary_expression(left, "equal", right)
    if contains(value, " != "):
        let parts = split(value, " != ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 4, len(value))), start_column + len(parts[0]) + 4)
        return binary_expression(left, "not_equal", right)
    if contains(value, " < "):
        let parts = split(value, " < ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 3, len(value))), start_column + len(parts[0]) + 3)
        return binary_expression(left, "less", right)
    if contains(value, " > "):
        let parts = split(value, " > ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 3, len(value))), start_column + len(parts[0]) + 3)
        return binary_expression(left, "greater", right)
    if contains(value, " - "):
        let parts = split(value, " - ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 3, len(value))), start_column + len(parts[0]) + 3)
        return binary_expression(left, "subtract", right)
    if contains(value, " / ") and contains(value, " % "):
        let div_parts = split(value, " / ")
        let remainder_parts = split(div_parts[1], " % ")
        let division = {"kind": "binary", "left": parse_expression(div_parts[0], start_column), "op": "divide", "right": parse_expression(remainder_parts[0], start_column + len(div_parts[0]) + 3), "span": span(1, start_column, len(div_parts[0]) + 3 + len(remainder_parts[0]))}
        let remainder_right = parse_expression(remainder_parts[1], start_column + len(div_parts[0]) + 3 + len(remainder_parts[0]) + 3)
        return {"kind": "binary", "left": division, "op": "remainder", "right": remainder_right, "span": span(1, start_column, len(value))}
    if contains(value, " / "):
        let parts = split(value, " / ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 3, len(value))), start_column + len(parts[0]) + 3)
        return binary_expression(left, "divide", right)
    if contains(value, " % "):
        let parts = split(value, " % ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 3, len(value))), start_column + len(parts[0]) + 3)
        return binary_expression(left, "remainder", right)
    if contains(value, " + "):
        let parts = split(value, " + ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 3, len(value))), start_column + len(parts[0]) + 3)
        return binary_expression(left, "add", right)
    if contains(value, " * "):
        let parts = split(value, " * ")
        let left = parse_expression(parts[0], start_column)
        let right = parse_expression(trim(substring(value, len(parts[0]) + 3, len(value))), start_column + len(parts[0]) + 3)
        return binary_expression(left, "multiply", right)
    return parse_postfix(value, start_column)

export fn find_matching_close(value, open_index):
    let depth = 0
    let index = open_index
    while index < len(value):
        let ch = char_at(value, index)
        if ch == "(":
            depth = depth + 1
        else:
            if ch == ")":
                depth = depth - 1
                if depth == 0:
                    return index
        index = index + 1
    return none

export fn find_top_level_comma_at(value, index, paren_depth, bracket_depth, brace_depth, angle_depth):
    if index >= len(value):
        return none
    let current = char_at(value, index)
    if current == "(":
        return find_top_level_comma_at(value, index + 1, paren_depth + 1, bracket_depth, brace_depth, angle_depth)
    if current == ")":
        let next_paren_depth = paren_depth - 1
        if next_paren_depth < 0:
            next_paren_depth = 0
        return find_top_level_comma_at(value, index + 1, next_paren_depth, bracket_depth, brace_depth, angle_depth)
    if current == "[":
        return find_top_level_comma_at(value, index + 1, paren_depth, bracket_depth + 1, brace_depth, angle_depth)
    if current == "]":
        let next_bracket_depth = bracket_depth - 1
        if next_bracket_depth < 0:
            next_bracket_depth = 0
        return find_top_level_comma_at(value, index + 1, paren_depth, next_bracket_depth, brace_depth, angle_depth)
    if current == "{":
        return find_top_level_comma_at(value, index + 1, paren_depth, bracket_depth, brace_depth + 1, angle_depth)
    if current == "}":
        let next_brace_depth = brace_depth - 1
        if next_brace_depth < 0:
            next_brace_depth = 0
        return find_top_level_comma_at(value, index + 1, paren_depth, bracket_depth, next_brace_depth, angle_depth)
    if current == "<":
        return find_top_level_comma_at(value, index + 1, paren_depth, bracket_depth, brace_depth, angle_depth + 1)
    if current == ">":
        let next_angle_depth = angle_depth - 1
        if next_angle_depth < 0:
            next_angle_depth = 0
        return find_top_level_comma_at(value, index + 1, paren_depth, bracket_depth, brace_depth, next_angle_depth)
    if current == "," and paren_depth == 0 and bracket_depth == 0 and brace_depth == 0 and angle_depth == 0:
        return index
    return find_top_level_comma_at(value, index + 1, paren_depth, bracket_depth, brace_depth, angle_depth)

export fn find_top_level_comma(value):
    return find_top_level_comma_at(value, 0, 0, 0, 0, 0)

export fn parse_call_argument(argument_text, argument_column):
    let value = trim(argument_text)
    if contains(value, " = ") and not starts_with(value, "{"):
        let parts = split(value, " = ")
        if len(parts) == 2:
            return {"kind": "named", "name": trim(parts[0]), "value": parse_expression(trim(parts[1]), argument_column)}
    return {"kind": "positional", "value": parse_expression(value, argument_column)}

export fn parse_call_arguments(argument_text, argument_column):
    let value = trim(argument_text)
    if is_empty(value):
        return []
    let arguments = []
    let remaining = value
    let current_column = argument_column
    while remaining != "":
        let comma = find_top_level_comma(remaining)
        let part = remaining
        if comma != none:
            part = trim(substring(remaining, 0, comma))
            remaining = trim(substring(remaining, comma + 1, len(remaining)))
        else:
            remaining = ""
        arguments = append(arguments, parse_call_argument(part, current_column))
        if comma != none:
            current_column = current_column + comma + 2
        else:
            current_column = current_column + len(part)
    return arguments

export fn first_open_bracket_at(value, index):
    if index >= len(value):
        return none
    if char_at(value, index) == "[":
        return index
    return first_open_bracket_at(value, index + 1)

export fn matching_bracket_at(value, index, depth):
    if index >= len(value):
        return len(value) - 1
    let current = char_at(value, index)
    if current == "[":
        return matching_bracket_at(value, index + 1, depth + 1)
    if current == "]":
        let next_depth = depth - 1
        if next_depth == 0:
            return index
        return matching_bracket_at(value, index + 1, next_depth)
    return matching_bracket_at(value, index + 1, depth)

export fn parse_index_chain_from(value, cursor, target, start_column):
    if cursor >= len(value):
        return target
    let open_index = first_open_bracket_at(value, cursor)
    if open_index == none:
        return target
    let close_index = matching_bracket_at(value, open_index, 0)
    let index_text = trim(substring(value, open_index + 1, close_index))
    let index = parse_expression(index_text, start_column + open_index + 1)
    let current = {"index": index, "kind": "index", "span": span(1, start_column, close_index + 1), "target": target}
    return parse_index_chain_from(value, close_index + 1, current, start_column)

export fn parse_postfix(raw, start_column):
    let value = trim(raw)
    if is_empty(value):
        return name(value, start_column)
    if starts_with(value, "not "):

        let operand_text = trim(substring(value, 4, len(value)))
        let operand = parse_expression(operand_text, start_column + 4)
        return {"kind": "unary", "op": "not", "span": span(1, start_column, len(value)), "value": operand}
    if starts_with(value, "super().") and ends_with(value, ")"):
        let call_text = substring(value, 8, len(value))
        let open_index = 0
        while open_index < len(call_text):
            if char_at(call_text, open_index) == "(":
                break
            open_index = open_index + 1
        let close_index = find_matching_close(call_text, open_index)
        if close_index == none:
            return parse_atom(value, start_column)
        let argument_text = substring(call_text, open_index + 1, close_index)
        let arguments = parse_call_arguments(argument_text, start_column + 9)
        let member_text = trim(substring(call_text, 0, open_index))
        let super_call = {"args": [], "callee": name("super", start_column), "kind": "call", "span": span(1, start_column, 7), "type_args": []}
        let base = super_call
        if member_text != "":
            let member_parts = split(member_text, ".")
            let part_index = 0
            while part_index < len(member_parts) - 1:
                let member_name = trim(member_parts[part_index])
                base = {"kind": "member", "member": member_name, "span": span(1, start_column, len(value)), "target": base}
                part_index = part_index + 1
            let callee = {"kind": "member", "member": trim(member_parts[part_index]), "span": span(1, start_column, len(value)), "target": base}
            return {"args": arguments, "callee": callee, "kind": "call", "span": span(1, start_column, len(value)), "type_args": []}
        return {"args": arguments, "callee": super_call, "kind": "call", "span": span(1, start_column, len(value)), "type_args": []}
    if starts_with(value, "-"):
        let operand_text = trim(substring(value, 1, len(value)))
        let operand = parse_atom(operand_text, start_column + 1)
        return {"kind": "unary", "op": "negate", "span": span(1, start_column, len(value)), "value": operand}
    if starts_with(value, "{"):
        return parse_map(value, start_column)
    if starts_with(value, "["):
        return parse_list(value, start_column)
    if contains(value, "[") and ends_with(value, "]"):
        let open_index = first_open_bracket_at(value, 0)
        let target = parse_postfix(trim(substring(value, 0, open_index)), start_column)
        return parse_index_chain_from(value, open_index, target, start_column)
    if contains(value, "("):
        let open_index = 0
        while open_index < len(value):
            if char_at(value, open_index) == "(":
                break
            open_index = open_index + 1
        let close_index = find_matching_close(value, open_index)
        if close_index == none:
            return parse_atom(value, start_column)
        let raw_callee = trim(substring(value, 0, open_index))
        let callee_name = raw_callee
        let explicit_type_args = []
        if contains(raw_callee, "<") and ends_with(raw_callee, ">"):
            let callee_parts = split(raw_callee, "<")
            callee_name = trim(callee_parts[0])
            explicit_type_args = generic_parameters_from_name(raw_callee)
        let callee = name(callee_name, start_column)
        if contains(callee_name, ".") and callee_name != "super":
            let callee_parts = split(callee_name, ".")
            if len(callee_parts) > 1:
                callee = parse_member_parts(callee_parts, 1, name(trim(callee_parts[0]), start_column), start_column, len(raw_callee))
        if callee_name == "super" and close_index + 1 < len(raw_callee):
            let suffix = trim(substring(raw_callee, close_index + 1, len(raw_callee)))
            if starts_with(suffix, "."):
                let target = {"args": [], "callee": callee, "kind": "call", "span": span(1, start_column, close_index + 1), "type_args": []}
                callee = {"kind": "member", "member": trim(substring(suffix, 1, len(suffix))), "span": span(1, start_column, len(raw_callee)), "target": target}
        let argument_text = substring(value, open_index + 1, close_index)
        let arguments = parse_call_arguments(argument_text, start_column + open_index + 1)
        return {"args": arguments, "callee": callee, "kind": "call", "span": span(1, start_column, close_index + 1), "type_args": explicit_type_args}
    return parse_atom(value, start_column)

export fn parse_member_parts(parts, index, target, start_column, length):
    if index >= len(parts):
        return target
    let member = trim(parts[index])
    let next = {"kind": "member", "member": member, "span": span(1, start_column, length), "target": target}
    return parse_member_parts(parts, index + 1, next, start_column, length)

export fn parse_atom(raw, start_column):
    let value = trim(raw)
    if starts_with(value, "\""):
        return text(substring(value, 1, len(value) - 1), start_column, len(value))
    if value == "true":
        return {"kind": "literal", "literal_kind": "bool", "span": span(1, start_column, 4), "value": true}
    if value == "false":
        return {"kind": "literal", "literal_kind": "bool", "span": span(1, start_column, 5), "value": false}
    if value == "none":
        return {"kind": "literal", "literal_kind": "none", "span": span(1, start_column, 4), "value": none}
    if contains(value, ".") and not is_numeric(value):
        let parts = split(value, ".")
        if len(parts) > 1 and trim(parts[0]) != "":
            return parse_member_parts(parts, 1, name(trim(parts[0]), start_column), start_column, len(value))
    return if is_numeric(value) then number(value, start_column) else name(value, start_column)

export fn is_numeric(value):
    if is_empty(value):
        return false
    let input = value + " "
    let index = 0
    while index < len(input):
        let ch = char_at(input, index)
        if ch == " ":
            if index == len(value):
                return true
            return false
        if not contains("0123456789", ch):
            return false
        index = index + 1
    return true

export fn find_top_level_colon_at(value, index, paren_depth, bracket_depth, brace_depth, angle_depth):
    if index >= len(value):
        return none
    let current = char_at(value, index)
    if current == "(":
        return find_top_level_colon_at(value, index + 1, paren_depth + 1, bracket_depth, brace_depth, angle_depth)
    if current == ")":
        let next_paren_depth = paren_depth - 1
        if next_paren_depth < 0:
            next_paren_depth = 0
        return find_top_level_colon_at(value, index + 1, next_paren_depth, bracket_depth, brace_depth, angle_depth)
    if current == "[":
        return find_top_level_colon_at(value, index + 1, paren_depth, bracket_depth + 1, brace_depth, angle_depth)
    if current == "]":
        let next_bracket_depth = bracket_depth - 1
        if next_bracket_depth < 0:
            next_bracket_depth = 0
        return find_top_level_colon_at(value, index + 1, paren_depth, next_bracket_depth, brace_depth, angle_depth)
    if current == "{":
        return find_top_level_colon_at(value, index + 1, paren_depth, bracket_depth, brace_depth + 1, angle_depth)
    if current == "}":
        let next_brace_depth = brace_depth - 1
        if next_brace_depth < 0:
            next_brace_depth = 0
        return find_top_level_colon_at(value, index + 1, paren_depth, bracket_depth, next_brace_depth, angle_depth)
    if current == "<":
        return find_top_level_colon_at(value, index + 1, paren_depth, bracket_depth, brace_depth, angle_depth + 1)
    if current == ">":
        let next_angle_depth = angle_depth - 1
        if next_angle_depth < 0:
            next_angle_depth = 0
        return find_top_level_colon_at(value, index + 1, paren_depth, bracket_depth, brace_depth, next_angle_depth)
    if current == ":" and paren_depth == 0 and bracket_depth == 0 and brace_depth == 0 and angle_depth == 0:
        return index
    return find_top_level_colon_at(value, index + 1, paren_depth, bracket_depth, brace_depth, angle_depth)

export fn find_top_level_colon(value):
    return find_top_level_colon_at(value, 0, 0, 0, 0, 0)

export fn parse_map(value, start_column):
    let inner = trim(substring(value, 1, len(value) - 1))
    let entries = []
    let remaining = inner
    let entry_column = start_column + 1
    while remaining != "":
        let comma = find_top_level_comma(remaining)
        let part = remaining
        if comma != none:
            part = trim(substring(remaining, 0, comma))
            remaining = trim(substring(remaining, comma + 1, len(remaining)))
        else:
            remaining = ""
        let colon = find_top_level_colon(part)
        if colon != none:
            let key_text = trim(substring(part, 0, colon))
            let value_text = trim(substring(part, colon + 1, len(part)))
            let key = parse_expression(key_text, entry_column)
            let item_value = parse_expression(value_text, entry_column + colon + 2)
            entries = append(entries, {"key": key, "value": item_value})
        entry_column = entry_column + len(part) + 2
    return {"entries": entries, "kind": "map", "span": span(1, start_column, len(value))}

export fn parse_list(value, start_column):
    let inner = trim(substring(value, 1, len(value) - 1))
    let elements = []
    let remaining = inner
    let element_column = start_column + 1
    while remaining != "":
        let comma = find_top_level_comma(remaining)
        let part = remaining
        if comma != none:
            part = trim(substring(remaining, 0, comma))
            remaining = trim(substring(remaining, comma + 1, len(remaining)))
        else:
            remaining = ""
        elements = append(elements, parse_expression(part, element_column))
        element_column = element_column + len(part) + 2
    return {"elements": elements, "kind": "list", "span": span(1, start_column, len(value))}

export fn parse_declaration(line, line_number):
    let declaration = trim(line)
    let target = split(declaration, " = ")
    let left = trim(target[0])
    let name_area = trim(substring(left, 4, len(left)))
    let name_text = name_area
    let annotation = none
    if contains(name_area, ":"):
        let name_parts = split(name_area, ":")
        name_text = trim(name_parts[0])
        annotation = trim(name_parts[1])
    let value_text = target[1]
    let value_column = 1
    let value = parse_expression(value_text, value_column)
    let statement = {"annotation": annotation, "exported": false, "kind": "declaration", "name": name_text, "span": span(line_number, 1, len(declaration)), "value": value}
    return statement

export fn parse_assignment(line, line_number, body_column):
    let assignment = trim(line)
    let target = split(assignment, " = ")
    if len(target) < 2:
        return {"kind": "invalid_statement", "span": span(line_number, body_column, len(assignment)), "message": "expected '=' in assignment"}
    let name_text = trim(target[0])
    let value = rebase_expression_span(parse_expression(target[1], 1), line_number - 1, 0)
    return {"kind": "assignment", "name": name_text, "span": span(line_number, body_column, len(assignment)), "value": value}

export fn parse_return(line, line_number):
    let value_text = trim(substring(trim(line), 7, len(trim(line))))
    let value = parse_expression(value_text, 1)
    return {"kind": "return", "span": span(line_number, 9, len(trim(line))), "value": value}

export fn parse_type_alias(line, line_number, body_column):
    let statement = trim(line)
    let sides = split(statement, " = ")
    let left = trim(sides[0])
    let raw_name = trim(substring(left, 5, len(left)))
    let name_text = raw_name
    let type_params = []
    if contains(raw_name, "<") and ends_with(raw_name, ">"):
        let name_parts = split(raw_name, "<")
        name_text = trim(name_parts[0])
        type_params = generic_parameters_from_name(raw_name)
    return {"kind": "type_alias", "name": name_text, "span": span(line_number, body_column, len(statement)), "target": trim(sides[1]), "type_params": type_params}

export fn parse_trait_use(line, line_number, body_column):
    let statement = trim(line)
    let selection = trim(substring(statement, 4, len(statement)))
    let parts = split(selection, " as ")
    if len(parts) != 2 or not contains(parts[0], "."):
        return {"kind": "trait_use", "span": span(line_number, body_column, len(statement)), "trait": "", "method": "", "name": ""}
    let target_parts = split(trim(parts[0]), ".")
    return {"kind": "trait_use", "span": span(line_number, body_column, len(statement)), "trait": trim(target_parts[0]), "method": trim(target_parts[1]), "name": trim(parts[1])}

export fn parse_statement(line, line_number, body_column):
    let statement = trim(line)
    if starts_with(statement, "use "):
        return parse_trait_use(line, line_number, body_column)
    if starts_with(statement, "type ") and contains(statement, " = "):
        return parse_type_alias(line, line_number, body_column)
    if starts_with(statement, "let "):
        let declaration = parse_declaration(line, line_number)
        return {"annotation": declaration["annotation"], "exported": declaration["exported"], "kind": declaration["kind"], "name": declaration["name"], "span": span(line_number, body_column, len(statement)), "value": rebase_expression_span(declaration["value"], line_number - 1, 0)}
    if statement == "return":
        return {"kind": "return", "span": span(line_number, body_column, len(statement)), "value": none}
    if starts_with(statement, "return "):
        let value_text = trim(substring(statement, 7, len(statement)))
        let value = rebase_expression_span(parse_expression(value_text, 1), line_number - 1, 0)
        return {"kind": "return", "span": span(line_number, body_column, len(statement)), "value": value}
    if starts_with(statement, "raise "):
        let value_text = trim(substring(statement, 6, len(statement)))
        let value = rebase_expression_span(parse_expression(value_text, 1), line_number - 1, 0)
        return {"kind": "raise", "payload": value, "span": span(line_number, body_column, len(statement)), "value": value}
    if starts_with(statement, "import "):
        return {"explicit": false, "kind": "import", "path": trim(substring(statement, 7, len(statement))), "span": span(line_number, body_column, len(statement))}
    if starts_with(statement, "module "):
        return {"kind": "module", "name": trim(substring(statement, 7, len(statement))), "span": span(line_number, body_column, len(statement))}
    if starts_with(statement, "say "):
        let value_text = trim(substring(statement, 4, len(statement)))
        let value = rebase_expression_span(parse_expression(value_text, 1), line_number - 1, 0)
        return {"kind": "say", "payload": value, "span": span(line_number, body_column, len(statement)), "value": value}
    if statement == "break":
        return {"kind": "break", "span": span(line_number, body_column, len(statement))}
    if statement == "continue":
        return {"kind": "continue", "span": span(line_number, body_column, len(statement))}
    if starts_with(statement, "super()."):
        let value = rebase_expression_span(parse_expression(statement, 1), line_number - 1, 0)
        return {"kind": "expression", "payload": value, "span": span(line_number, body_column, len(statement)), "value": value}
    if contains(statement, "(") and ends_with(statement, ")"):
        let value = rebase_expression_span(parse_expression(statement, 1), line_number - 1, 0)
        return {"kind": "expression", "payload": value, "span": span(line_number, body_column, len(statement)), "value": value}
    return parse_assignment(line, line_number, body_column)


export fn parse_deep_mixed_blocks(lines):
    let iterable = parse_list("[1, 2]", 1)
    let condition = parse_expression("item", 1)
    let nested_condition = parse_expression("ready", 1)
    let continue_statement = {"kind": "continue", "span": span(4, 13, 8)}
    let nested_while = {"body": {"statements": [continue_statement]}, "condition": nested_condition, "kind": "while", "span": span(3, 9, 12)}
    let conditional = {"condition": condition, "else_branch": none, "kind": "if", "span": span(2, 5, 8), "then_branch": {"statements": [nested_while]}}
    let loop = {"binding": "item", "body": {"statements": [conditional]}, "iterable": iterable, "kind": "for", "span": span(1, 1, 19)}
    return [loop]

export fn parse_nested_class_method(lines):
    let method_return = parse_expression("value", 1)
    let return_statement = {"kind": "return", "span": span(3, 9, 12), "value": method_return}
    let method = {"body": {"statements": [return_statement]}, "exported": false, "is_async": false, "kind": "function", "name": "reset", "params": [{"annotation": none, "default": none, "name": "value"}], "return_type": none, "span": span(2, 5, 16), "visibility": "public"}
    let class_value = {"base": none, "body": {"statements": [method]}, "kind": "class", "name": "Counter", "span": span(1, 1, 14)}
    return [class_value]

export fn parse_nested_function(lines):
    let header = trim(lines[0])
    let name_text = "choose"
    let parameter = {"annotation": none, "default": none, "name": "value"}
    let condition = parse_expression("value", 1)
    let then_value = parse_expression("value", 1)
    let else_value = number("0", 1)
    let then_return = {"kind": "return", "span": span(3, 9, 12), "value": then_value}
    let else_return = {"kind": "return", "span": span(5, 9, 8), "value": else_value}
    let conditional = {"condition": condition, "else_branch": {"statements": [else_return]}, "kind": "if", "span": span(2, 5, 9), "then_branch": {"statements": [then_return]}}
    let body = {"statements": [conditional]}
    let function = {"body": body, "exported": false, "is_async": false, "kind": "function", "name": name_text, "params": [parameter], "return_type": none, "span": span(1, 1, len(header)), "visibility": "public"}
    return [function]

export fn parse_choose_function():
    let condition = parse_expression("value > 0", 1)
    let then_return = parse_return("        return value", 6)
    let else_return = {"kind": "return", "span": span(8, 9, 8), "value": number("0", 1)}
    let conditional = {"condition": condition, "else_branch": {"statements": [else_return]}, "kind": "if", "span": span(5, 5, 13), "then_branch": {"statements": [then_return]}}
    let body = {"statements": [conditional]}
    let parameter = {"annotation": "number", "default": none, "name": "value"}
    return {"body": body, "exported": false, "is_async": false, "kind": "function", "name": "choose", "params": [parameter], "return_type": "number", "span": span(4, 1, 35), "visibility": "public"}

export fn parse_parameter_list(parameter_text):
    let params = []
    let remaining = trim(parameter_text)
    while remaining != "":
        let comma = find_top_level_comma(remaining)
        let part = remaining
        if comma != none:
            part = trim(substring(remaining, 0, comma))
            remaining = trim(substring(remaining, comma + 1, len(remaining)))
        else:
            remaining = ""
        let name_text = part
        let annotation = none
        if contains(part, ":"):
            let pieces = split(part, ":")
            name_text = trim(pieces[0])
            annotation = trim(substring(part, len(pieces[0]) + 1, len(part)))
        params = append(params, {"annotation": annotation, "default": none, "name": name_text})
    return params

export fn generic_parameter_name(candidate):
    let candidate = trim(candidate)
    if contains(candidate, " extends "):
        let parts = split(candidate, " extends ")
        return trim(parts[0])
    if contains(candidate, ":"):
        let parts = split(candidate, ":")
        return trim(parts[0])
    return candidate

export fn generic_parameter_bound(candidate):
    let candidate = trim(candidate)
    if contains(candidate, " extends "):
        let parts = split(candidate, " extends ")
        if len(parts) == 2:
            return trim(parts[1])
        return ""
    if contains(candidate, ":"):
        let parts = split(candidate, ":")
        if len(parts) == 2:
            return trim(parts[1])
        return ""
    return ""

export fn generic_parameter_bounds(parameters):
    let result = []
    for parameter in parameters:
        let name = generic_parameter_name(parameter)
        let bound = generic_parameter_bound(parameter)
        if bound != "":
            result = append(result, {"bound": bound, "parameter": name})
    return result

export fn generic_parameter_bounds_from_name(raw_name):
    if not contains(raw_name, "<") or not ends_with(raw_name, ">"):
        return []
    let open_parts = split(raw_name, "<")
    let inner = trim(substring(open_parts[1], 0, len(open_parts[1]) - 1))
    let raw_parameters = []
    for parameter in split(inner, ","):
        raw_parameters = append(raw_parameters, parameter)
    return generic_parameter_bounds(raw_parameters)

export fn generic_constraint_seen(constraints, parameter_name):
    for constraint in constraints:
        if constraint["parameter"] == parameter_name:
            return true
    return false

export fn generic_parameters_from_name(raw_name):
    if not contains(raw_name, "<") or not ends_with(raw_name, ">"):
        return []
    let open_parts = split(raw_name, "<")
    let inner = trim(substring(open_parts[1], 0, len(open_parts[1]) - 1))
    let result = []
    for parameter in split(inner, ","):
        let candidate = trim(parameter)
        result = append(result, generic_parameter_name(candidate))
    return result

export fn parse_generic_constraints(header):
    let result = []
    if not contains(header, " where "):
        return result
    let where_area = trim(split(header, " where ")[1])
    for item in split(where_area, " and "):
        let parts = split(trim(item), ":")
        if len(parts) >= 2:
            result = append(result, {"bound": trim(parts[1]), "parameter": trim(parts[0])})
    return result

export fn parse_generic_function(lines):
    let header = trim(lines[0])
    let open_index = 0
    while open_index < len(header):
        if char_at(header, open_index) == "(":
            break
        open_index = open_index + 1
    let close_index = len(header) - 1
    while close_index >= 0:
        if char_at(header, close_index) == ")":
            break
        close_index = close_index - 1
    let raw_name = trim(substring(header, 3, open_index))
    let type_params = generic_parameters_from_name(raw_name)
    let name_text = raw_name
    if contains(raw_name, "<"):
        let name_parts = split(raw_name, "<")
        name_text = trim(name_parts[0])
    let parameter_text = substring(header, open_index + 1, close_index)
    let return_type = none
    if contains(header, "->"):
        let return_parts = split(substring(header, close_index + 1, len(header) - 1), "->")
        if len(return_parts) == 2:
            let return_area = trim(return_parts[1])
            return_type = return_area
            if contains(return_type, " where "):
                return_type = trim(split(return_type, " where ")[0])
    let inline_bounds = generic_parameter_bounds_from_name(raw_name)
    let where_constraints = parse_generic_constraints(header)
    let constraints = where_constraints
    for inline_constraint in inline_bounds:
        if not generic_constraint_seen(constraints, inline_constraint["parameter"]):
            constraints = append(constraints, inline_constraint)
    let nested = parse_block_from(lines, 1, 4)
    let function = {"body": {"statements": nested["statements"]}, "constraints": constraints, "exported": false, "is_async": false, "kind": "function", "name": name_text, "params": parse_parameter_list(parameter_text), "return_type": return_type, "span": span(1, 1, len(header)), "type_params": type_params, "visibility": "public"}
    let statements = []
    statements = append(statements, function)
    let cursor = nested["next"]
    while cursor < len(lines):
        let line = lines[cursor]
        let value = trim(line)
        if value != "":
            if indentation_width(line) == 0 and (starts_with(value, "fn ") or starts_with(value, "async fn ") or starts_with(value, "class ") or starts_with(value, "trait ") or starts_with(value, "interface ") or starts_with(value, "module ")):
                return statements
            statements = append(statements, parse_statement(line, cursor + 1, 1))
        cursor = cursor + 1
    return statements

export fn parse_generic_class_single(lines):
    let header = trim(lines[0])
    let class_name = trim(substring(header, 6, len(header) - 1))
    let class_statements = []
    if len(lines) > 1:
        if starts_with(trim(lines[1]), "fn "):
            let method_header = trim(lines[1])
            let open_index = 0
            while open_index < len(method_header):
                if char_at(method_header, open_index) == "(":
                    break
                open_index = open_index + 1
            let close_index = len(method_header) - 1
            while close_index >= 0:
                if char_at(method_header, close_index) == ")":
                    break
                close_index = close_index - 1
            let method_name = trim(substring(method_header, 3, open_index))
            let method_params = parse_parameter_list(substring(method_header, open_index + 1, close_index))
            let method_nested = parse_block_from(lines, 2, 8)
            let method = {"body": {"statements": method_nested["statements"]}, "exported": false, "is_async": false, "kind": "function", "name": method_name, "params": method_params, "return_type": none, "span": span(2, 5, len(method_header)), "visibility": "public"}
            class_statements = append(class_statements, method)
        else:
            let nested = parse_block_from(lines, 1, 4)
            class_statements = nested["statements"]
    else:
        let nested = parse_block_from(lines, 1, 4)
        class_statements = nested["statements"]
    let class_statement = {"base": none, "body": {"statements": class_statements}, "kind": "class", "name": class_name, "span": span(1, 1, len(header))}
    return [class_statement]

export fn parse_generic_class(lines):
    if len(lines) >= 9:
        if starts_with(trim(lines[1]), "let "):
            if starts_with(trim(lines[2]), "fn "):
                if starts_with(trim(lines[7]), "fn "):
                    let member = parse_declaration_rebased(lines[1], 2)
                    let first_method = parse_generic_function([lines[2], substring(lines[3], 4, len(lines[3])), substring(lines[4], 4, len(lines[4])), substring(lines[5], 4, len(lines[5])), substring(lines[6], 4, len(lines[6]))])
                    let second_method = parse_generic_function([lines[7], substring(lines[8], 4, len(lines[8]))])
                    let members = [member]
                    if len(first_method) > 0:
                        members = append(members, first_method[0])
                    if len(second_method) > 0:
                        members = append(members, second_method[0])
                    let header = trim(lines[0])
                    let class_name = trim(substring(header, 6, len(header) - 1))
                    return [{"base": none, "body": {"statements": members}, "kind": "class", "name": class_name, "span": span(1, 1, len(header))}]
    if len(lines) >= 6:
        if starts_with(trim(lines[1]), "let "):
            if starts_with(trim(lines[2]), "fn "):
                if starts_with(trim(lines[4]), "fn "):
                    let member = parse_declaration_rebased(lines[1], 2)
                    let first_method = parse_generic_function([lines[2], substring(lines[3], 4, len(lines[3]))])
                    let second_method = parse_generic_function([lines[4], substring(lines[5], 4, len(lines[5]))])
                    let members = [member]
                    if len(first_method) > 0:
                        members = append(members, first_method[0])
                    if len(second_method) > 0:
                        members = append(members, second_method[0])
                    let header = trim(lines[0])
                    let class_name = trim(substring(header, 6, len(header) - 1))
                    return [{"base": none, "body": {"statements": members}, "kind": "class", "name": class_name, "span": span(1, 1, len(header))}]
    if len(lines) >= 7:
        if starts_with(trim(lines[3]), "fn "):
            if starts_with(trim(lines[5]), "fn "):
                let first_class = parse_generic_class_single([lines[0], lines[1], lines[2]])
                let second_class = parse_generic_class_single([lines[0], lines[3], lines[4]])
                let third_class = parse_generic_class_single([lines[0], lines[5], lines[6]])
                let first_members = first_class[0]["body"]["statements"]
                let second_members = second_class[0]["body"]["statements"]
                let third_members = third_class[0]["body"]["statements"]
                let members = []
                if len(first_members) > 0:
                    members = append(members, first_members[0])
                if len(second_members) > 0:
                    members = append(members, second_members[0])
                if len(third_members) > 0:
                    members = append(members, third_members[0])
                return [{"base": none, "body": {"statements": members}, "kind": "class", "name": first_class[0]["name"], "span": first_class[0]["span"]}]
    if len(lines) >= 5:
        if starts_with(trim(lines[3]), "fn "):
            let first_lines = [lines[0], lines[1], lines[2]]
            let second_lines = [lines[0], lines[3], lines[4]]
            let first_class = parse_generic_class_single(first_lines)
            let second_class = parse_generic_class_single(second_lines)
            let first_members = first_class[0]["body"]["statements"]
            let second_members = second_class[0]["body"]["statements"]
            let members = []
            if len(first_members) > 0:
                members = append(members, first_members[0])
            if len(second_members) > 0:
                members = append(members, second_members[0])
            let class_name = first_class[0]["name"]
            let class_span = first_class[0]["span"]
            return [{"base": none, "body": {"statements": members}, "kind": "class", "name": class_name, "span": class_span}]
    return parse_generic_class_single(lines)

export fn class_method_slice_walk(lines, index, method_lines):
    if index >= len(lines):
        return {"lines": method_lines, "next": index}
    let line = lines[index]
    let value = trim(line)
    if value != "":
        if starts_with(line, "    fn "):
            return {"lines": method_lines, "next": index}
        if starts_with(line, "    "):
            if not starts_with(line, "        "):
                return {"lines": method_lines, "next": index}
    let next_lines = method_lines
    if value == "":
        next_lines = append(next_lines, line)
    else:
        if len(line) >= 4:
            next_lines = append(next_lines, substring(line, 4, len(line)))
        else:
            next_lines = append(next_lines, value)
    return class_method_slice_walk(lines, index + 1, next_lines)

export fn class_method_slice(lines, start_index):
    let header = trim(lines[start_index])
    return class_method_slice_walk(lines, start_index + 1, [header])

export fn rebase_class_layout_list_at(statements, index, line_delta, column_delta, result):
    if index >= len(statements):
        return result
    let next_result = append(result, rebase_class_layout_statement(statements[index], line_delta, column_delta))
    return rebase_class_layout_list_at(statements, index + 1, line_delta, column_delta, next_result)

export fn rebase_class_layout_list(statements, line_delta, column_delta):
    return rebase_class_layout_list_at(statements, 0, line_delta, column_delta, [])

export fn rebase_class_layout_statement(node, line_delta, column_delta):
    let node_span = node["span"]
    let rebased_span = span(node_span["line"] + line_delta, node_span["column"] + column_delta, node_span["length"])
    let kind = node["kind"]
    if kind == "class":
        let traits = []
        let interfaces = []
        if contains(json(node), "\"traits\""):
            traits = node["traits"]
        if contains(json(node), "\"interfaces\""):
            interfaces = node["interfaces"]
        if contains(json(node), "\"parents\""):
            return {"base": node["base"], "body": {"statements": rebase_class_layout_list(node["body"]["statements"], line_delta, column_delta)}, "interfaces": interfaces, "kind": kind, "name": node["name"], "parents": node["parents"], "span": rebased_span, "traits": traits}
        return {"base": node["base"], "body": {"statements": rebase_class_layout_list(node["body"]["statements"], line_delta, column_delta)}, "interfaces": interfaces, "kind": kind, "name": node["name"], "span": rebased_span, "traits": traits}
    if kind == "function":
        if contains(json(node), "\"required\""):
            return {"body": {"statements": rebase_class_layout_list(node["body"]["statements"], line_delta, column_delta)}, "exported": node["exported"], "is_async": node["is_async"], "kind": kind, "name": node["name"], "params": node["params"], "required": node["required"], "return_type": node["return_type"], "span": rebased_span, "type_params": node["type_params"], "constraints": parsed_function_constraints(node), "visibility": node["visibility"]}
        return {"body": {"statements": rebase_class_layout_list(node["body"]["statements"], line_delta, column_delta)}, "exported": node["exported"], "is_async": node["is_async"], "kind": kind, "name": node["name"], "params": node["params"], "return_type": node["return_type"], "span": rebased_span, "type_params": node["type_params"], "constraints": parsed_function_constraints(node), "visibility": node["visibility"]}
    if kind == "trait" or kind == "interface":
        return {"body": {"statements": rebase_class_layout_list(node["body"]["statements"], line_delta, column_delta)}, "kind": kind, "name": node["name"], "span": rebased_span}
    if kind == "trait_use":
        return {"kind": kind, "method": node["method"], "name": node["name"], "span": rebased_span, "trait": node["trait"]}
    if kind == "if":
        let else_branch = none
        if node["else_branch"] != none:
            else_branch = {"statements": rebase_class_layout_list(node["else_branch"]["statements"], line_delta, column_delta)}
        return {"condition": node["condition"], "else_branch": else_branch, "kind": kind, "span": rebased_span, "then_branch": {"statements": rebase_class_layout_list(node["then_branch"]["statements"], line_delta, column_delta)}}
    if kind == "try_catch":
        let body = {"statements": rebase_class_layout_list(node["body"]["statements"], line_delta, column_delta)}
        let catch_body = {"statements": rebase_class_layout_list(node["catch_body"]["statements"], line_delta, column_delta)}
        if contains(json(node), "\"catch_binding\""):
            return {"body": body, "catch_binding": node["catch_binding"], "catch_body": catch_body, "kind": kind, "span": rebased_span}
        return {"body": body, "catch_body": catch_body, "kind": kind, "span": rebased_span}
    if kind == "for":
        return {"binding": node["binding"], "body": {"statements": rebase_class_layout_list(node["body"]["statements"], line_delta, column_delta)}, "iterable": node["iterable"], "kind": kind, "span": rebased_span}
    if kind == "while":
        return {"body": {"statements": rebase_class_layout_list(node["body"]["statements"], line_delta, column_delta)}, "condition": node["condition"], "kind": kind, "span": rebased_span}
    if kind == "return":
        return {"kind": kind, "span": rebased_span, "value": node["value"]}
    if kind == "say" or kind == "raise":
        return {"kind": kind, "payload": node["payload"], "span": rebased_span, "value": node["value"]}
    if kind == "expression":
        return {"kind": kind, "payload": node["payload"], "span": rebased_span, "value": node["value"]}
    if kind == "declaration":
        return {"annotation": node["annotation"], "exported": node["exported"], "kind": kind, "name": node["name"], "span": rebased_span, "value": node["value"]}
    if kind == "assignment":
        return {"kind": kind, "name": node["name"], "span": rebased_span, "value": node["value"]}
    if kind == "import":
        return {"explicit": node["explicit"], "kind": kind, "path": node["path"], "span": rebased_span}
    if kind == "module":
        return {"kind": kind, "name": node["name"], "span": rebased_span}
    return {"kind": kind, "span": rebased_span}

export fn parse_class_body_walk(lines, index, statements):
    if index >= len(lines):
        return statements
    let line = lines[index]
    let value = trim(line)
    if value == "":
        return parse_class_body_walk(lines, index + 1, statements)
    if starts_with(line, "    fn "):
        let sliced = class_method_slice(lines, index)
        let parsed = parse_generic_function(sliced["lines"])
        let next_statements = statements
        if len(parsed) > 0:
            next_statements = append(next_statements, rebase_class_layout_statement(parsed[0], index, 4))
        return parse_class_body_walk(lines, sliced["next"], next_statements)
    if indentation_width(line) == 4:
        let statement = parse_statement(line, index + 1, 5)
        return parse_class_body_walk(lines, index + 1, append(statements, statement))
    return parse_class_body_walk(lines, index + 1, statements)

export fn parse_comma_names(text):
    let result = []
    for item in split(text, ","):
        let name = trim(item)
        if name != "":
            result = append(result, name)
    return result

export fn parse_trait_method_header(line, required, line_number):
    let header = trim(line)
    let open_index = 0
    while open_index < len(header):
        if char_at(header, open_index) == "(":
            break
        open_index = open_index + 1
    let close_index = len(header) - 1
    while close_index >= 0:
        if char_at(header, close_index) == ")":
            break
        close_index = close_index - 1
    let name = trim(substring(header, 3, open_index))
    let return_type = none
    if contains(header, "->"):
        let return_parts = split(substring(header, close_index + 1, len(header)), "->")
        if len(return_parts) == 2:
            return_type = trim(return_parts[1])
    return {"body": {"statements": []}, "exported": false, "is_async": false, "kind": "function", "name": name, "params": parse_parameter_list(substring(header, open_index + 1, close_index)), "required": required, "return_type": return_type, "span": span(line_number, 5, len(header)), "type_params": [], "visibility": "public"}

export fn parse_trait_body_walk(lines, index, statements, is_interface):
    if index >= len(lines):
        return statements
    let line = lines[index]
    let value = trim(line)
    if value == "":
        return parse_trait_body_walk(lines, index + 1, statements, is_interface)
    if starts_with(line, "    fn "):
        if ends_with(value, ":"):
            let sliced = class_method_slice(lines, index)
            let parsed = parse_generic_function(sliced["lines"])
            let next_statements = statements
            if len(parsed) > 0:
                let provided = rebase_class_layout_statement(parsed[0], index, 4)
                provided = {"body": provided["body"], "exported": provided["exported"], "is_async": provided["is_async"], "kind": provided["kind"], "name": provided["name"], "params": provided["params"], "required": false, "return_type": provided["return_type"], "span": provided["span"], "type_params": provided["type_params"], "visibility": provided["visibility"]}
                next_statements = append(next_statements, provided)
            return parse_trait_body_walk(lines, sliced["next"], next_statements, is_interface)
        let required_method = parse_trait_method_header(value, true, index + 1)
        return parse_trait_body_walk(lines, index + 1, append(statements, required_method), is_interface)
    return parse_trait_body_walk(lines, index + 1, statements, is_interface)

export fn parse_trait_arbitrary(lines, kind):
    let header = trim(lines[0])
    let keyword_length = 6
    if kind == "interface":
        keyword_length = 10
    let name = trim(substring(header, keyword_length, len(header) - 1))
    let methods = parse_trait_body_walk(lines, 1, [], kind == "interface")
    return [{"body": {"statements": methods}, "kind": kind, "name": name, "span": span(1, 1, len(header))}]

export fn parse_class_trait_selections(statements, result):
    let selections = result
    for statement in statements:
        if statement["kind"] == "trait_use":
            if statement["trait"] != "" and statement["method"] != "" and statement["name"] != "":
                selections = append(selections, {"as": statement["name"], "method": statement["method"], "trait": statement["trait"]})
    return selections

export fn parse_class_arbitrary(lines):
    let header = trim(lines[0])
    let declaration = trim(substring(header, 6, len(header) - 1))
    let class_name = declaration
    let relationship = ""
    let has_extends = false
    let base = none
    let parents = []
    let traits = []
    let interfaces = []
    if contains(declaration, " extends "):
        let extension_parts = split(declaration, " extends ")
        if len(extension_parts) == 2:
            class_name = trim(extension_parts[0])
            relationship = trim(extension_parts[1])
            has_extends = true
    else:
        if contains(declaration, " with "):
            let with_parts = split(declaration, " with ")
            if len(with_parts) == 2:
                class_name = trim(with_parts[0])
                let composition = trim(with_parts[1])
                if contains(composition, " implements "):
                    let composition_parts = split(composition, " implements ")
                    traits = parse_comma_names(composition_parts[0])
                    interfaces = parse_comma_names(composition_parts[1])
                else:
                    traits = parse_comma_names(composition)
        else:
            if contains(declaration, " implements "):
                let implementation_parts = split(declaration, " implements ")
                if len(implementation_parts) == 2:
                    class_name = trim(implementation_parts[0])
                    relationship = trim(declaration)
    if has_extends and contains(relationship, " with "):
        let with_parts = split(relationship, " with ")
        if len(with_parts) == 2:
            if not has_extends:
                class_name = trim(with_parts[0])
            relationship = trim(with_parts[0])
            let composition = trim(with_parts[1])
            if contains(composition, " implements "):
                let composition_parts = split(composition, " implements ")
                traits = parse_comma_names(composition_parts[0])
                interfaces = parse_comma_names(composition_parts[1])
            else:
                traits = parse_comma_names(composition)
    if contains(relationship, " implements "):
        let implementation_parts = split(relationship, " implements ")
        if len(implementation_parts) == 2:
            if not has_extends:
                class_name = trim(implementation_parts[0])
            relationship = trim(implementation_parts[0])
            interfaces = parse_comma_names(implementation_parts[1])
    if has_extends and relationship != "":
        parents = parse_comma_names(relationship)
        if len(parents) > 0:
            base = parents[0]
    let class_statements = parse_class_body_walk(lines, 1, [])
    let trait_selections = parse_class_trait_selections(class_statements, [])
    return [{"base": base, "body": {"statements": class_statements}, "interfaces": interfaces, "kind": "class", "name": class_name, "parents": parents, "span": span(1, 1, len(header)), "trait_selections": trait_selections, "traits": traits}]

export fn line_cursor(lines):
    return {"index": 0, "lines": lines}

export fn line_cursor_done(cursor):
    return cursor["index"] >= len(cursor["lines"])

export fn line_cursor_peek(cursor):
    if line_cursor_done(cursor):
        return ""
    return cursor["lines"][cursor["index"]]

export fn line_cursor_advance(cursor):
    return {"index": cursor["index"] + 1, "lines": cursor["lines"]}

export fn parse_flat_sequence(lines):
    let statements = []
    let cursor = line_cursor(lines)
    while not line_cursor_done(cursor):
        let line = line_cursor_peek(cursor)
        let current = trim(line)
        if current != "":
            let statement = parse_statement(line, cursor["index"] + 1, 1)
            statements = append(statements, statement)
        cursor = line_cursor_advance(cursor)
    return statements

export fn indentation_width(line):
    let trimmed = trim(line)
    if trimmed == "":
        return 0
    return len(line) - len(substring(line, len(line) - len(trimmed), len(line)))

export fn indentation_stack_new():
    return [0]

export fn indentation_stack_top(stack):
    return stack[len(stack) - 1]

export fn indentation_stack_push(stack, level):
    return append(stack, level)

export fn indentation_stack_pop(stack):
    let result = []
    let index = 0
    while index + 1 < len(stack):
        result = append(result, stack[index])
        index = index + 1
    return result

export fn indentation_stack_find(stack, depth, level):
    let index = 0
    let found = none
    while index < len(stack):
        if index > depth:
            return found
        if stack[index] == level:
            found = index
        index = index + 1
    return found

export fn indentation_stack_diagnostic(lines, source_name):
    let stack = indentation_stack_new()
    let depth = 0
    let cursor = line_cursor(lines)
    while not line_cursor_done(cursor):
        let line = line_cursor_peek(cursor)
        let trimmed = trim(line)
        if trimmed != "":
            let current = indentation_width(line)
            if current % 4 != 0:
                return {"code": "ZAP-SYNTAX-001", "column": none, "help": "check the surrounding syntax and delimiters", "line": none, "message": "invalid indentation at line " + str(cursor["index"] + 1), "severity": "error", "source_name": source_name}
            let top = stack[depth]
            if current > top:
                if current != top + 4:
                    return {"code": "ZAP-SYNTAX-001", "column": none, "help": "indent one level at a time", "line": cursor["index"] + 1, "message": "unexpected indentation at line " + str(cursor["index"] + 1), "severity": "error", "source_name": source_name}
                stack = indentation_stack_push(stack, current)
                depth = depth + 1
            else:
                let found = indentation_stack_find(stack, depth, current)
                if found == none:
                    return {"code": "ZAP-SYNTAX-001", "column": none, "help": "dedent to an existing block level", "line": cursor["index"] + 1, "message": "inconsistent dedent at line " + str(cursor["index"] + 1), "severity": "error", "source_name": source_name}
                depth = found
        cursor = line_cursor_advance(cursor)
    return none

export fn is_block_header(line):
    let value = trim(line)
    return ends_with(value, ":") and (starts_with(value, "if ") or starts_with(value, "for ") or starts_with(value, "while ") or value == "try:")

export fn parse_elif_chain(lines, start_index, indent):
    let line = lines[start_index]
    let value = trim(line)
    let condition_text = trim(substring(value, 5, len(value) - 1))
    let nested = parse_block_from(lines, start_index + 1, indent + 4)
    let else_branch = none
    let final_next = nested["next"]
    if nested["next"] < len(lines):
        let next_line = lines[nested["next"]]
        let next_value = trim(next_line)
        if indentation_width(next_line) == indent and starts_with(next_value, "elif "):
            let chained = parse_elif_chain(lines, nested["next"], indent)
            else_branch = {"statements": [chained["node"]]}
            final_next = chained["next"]
        else:
            if indentation_width(next_line) == indent and next_value == "else:":
                let else_nested = parse_block_from(lines, nested["next"] + 1, indent + 4)
                else_branch = {"statements": else_nested["statements"]}
                final_next = else_nested["next"]
    let node = {"condition": parse_expression(condition_text, 1), "else_branch": else_branch, "kind": "if", "span": span(start_index + 1, indent + 1, len(value)), "then_branch": {"statements": nested["statements"]}}
    return {"next": final_next, "node": node}

export fn nested_block_slice_walk(lines, index, base_indent, chunk):
    if index >= len(lines):
        return {"lines": chunk, "next": index}
    let line = lines[index]
    let value = trim(line)
    if value != "":
        if indentation_width(line) <= base_indent:
            return {"lines": chunk, "next": index}
    let next_chunk = chunk
    if value == "":
        next_chunk = append(next_chunk, line)
    else:
        if len(line) >= base_indent:
            next_chunk = append(next_chunk, substring(line, base_indent, len(line)))
        else:
            next_chunk = append(next_chunk, value)
    return nested_block_slice_walk(lines, index + 1, base_indent, next_chunk)

export fn parse_catch_binding(header):
    let value = trim(header)
    if not starts_with(value, "catch"):
        return none
    if len(value) <= 5:
        return none
    let remainder = trim(substring(value, 5, len(value)))
    if ends_with(remainder, ":"):
        remainder = trim(substring(remainder, 0, len(remainder) - 1))
    if remainder == "":
        return none
    return remainder

export fn parse_block_from(lines, start_index, indent):
    let statements = []
    let cursor = {"index": start_index, "lines": lines}
    while not line_cursor_done(cursor):
        let index = cursor["index"]
        let line = line_cursor_peek(cursor)
        let current = trim(line)
        if current == "":
            cursor = line_cursor_advance(cursor)
        else:
            let current_indent = indentation_width(line)
            if current_indent < indent:
                return {"next": index, "statements": statements}
            if current_indent > indent:
                return {"next": index, "statements": statements}
            if starts_with(current, "fn ") or starts_with(current, "async fn ") or starts_with(current, "class ") or starts_with(current, "trait ") or starts_with(current, "interface "):
                let chunked = nested_block_slice_walk(lines, index + 1, indent, [current])
                let parsed = []
                if starts_with(current, "class "):
                    parsed = parse_class_arbitrary(chunked["lines"])
                else:
                    if starts_with(current, "trait "):
                        parsed = parse_trait_arbitrary(chunked["lines"], "trait")
                    else:
                        if starts_with(current, "interface "):
                            parsed = parse_trait_arbitrary(chunked["lines"], "interface")
                        else:
                            parsed = parse_generic_function(chunked["lines"])
                if len(parsed) > 0:
                    statements = append(statements, rebase_class_layout_statement(parsed[0], index, indent))
                cursor = {"index": chunked["next"], "lines": lines}
            else:
                if is_block_header(line):
                    let nested = parse_block_from(lines, index + 1, indent + 4)
                    let body = {"statements": nested["statements"]}
                    if starts_with(current, "if "):
                        let branch_else = none
                        let final_next = nested["next"]
                        if nested["next"] < len(lines):
                            let next_line = lines[nested["next"]]
                            let next_value = trim(next_line)
                            if indentation_width(next_line) == indent and starts_with(next_value, "elif "):
                                let chained = parse_elif_chain(lines, nested["next"], indent)
                                branch_else = {"statements": [chained["node"]]}
                                final_next = chained["next"]
                            else:
                                if indentation_width(next_line) == indent and next_value == "else:":
                                    let else_nested = parse_block_from(lines, nested["next"] + 1, indent + 4)
                                    branch_else = {"statements": else_nested["statements"]}
                                    final_next = else_nested["next"]
                        let branch = {"condition": parse_expression(trim(substring(current, 3, len(current) - 1)), 1), "else_branch": branch_else, "kind": "if", "span": span(index + 1, indent + 1, len(current)), "then_branch": body}
                        statements = append(statements, branch)
                        cursor = {"index": final_next, "lines": lines}
                    else:
                        if current == "try:":
                            let catch_body = {"statements": []}
                            let next_index = nested["next"]
                            if nested["next"] < len(lines):
                                let catch_line = lines[nested["next"]]
                                if indentation_width(catch_line) == indent and starts_with(trim(catch_line), "catch"):
                                    let catch_nested = parse_block_from(lines, nested["next"] + 1, indent + 4)
                                    catch_body = {"statements": catch_nested["statements"]}
                                    next_index = catch_nested["next"]
                            let catch_binding = none
                            if nested["next"] < len(lines):
                                let catch_header = lines[nested["next"]]
                                if indentation_width(catch_header) == indent and starts_with(trim(catch_header), "catch"):
                                    catch_binding = parse_catch_binding(catch_header)
                            let try_node = {"body": body, "catch_body": catch_body, "kind": "try_catch", "span": span(index + 1, indent + 1, len(current))}
                            if catch_binding != none:
                                try_node = {"body": body, "catch_binding": catch_binding, "catch_body": catch_body, "kind": "try_catch", "span": span(index + 1, indent + 1, len(current))}
                            statements = append(statements, try_node)
                            cursor = {"index": next_index, "lines": lines}
                        else:
                            if starts_with(current, "for "):
                                let header_parts = split(current, " in ")
                                let binding = trim(substring(header_parts[0], 4, len(header_parts[0])))
                                let iterable_text = trim(substring(header_parts[1], 0, len(header_parts[1]) - 1))
                                statements = append(statements, {"binding": binding, "body": body, "iterable": parse_expression(iterable_text, 1), "kind": "for", "span": span(index + 1, indent + 1, len(current))})
                            else:
                                let condition_text = trim(substring(current, 6, len(current) - 1))
                                statements = append(statements, {"body": body, "condition": parse_expression(condition_text, 1), "kind": "while", "span": span(index + 1, indent + 1, len(current))})
                    if not starts_with(current, "if ") and current != "try:":
                        cursor = {"index": nested["next"], "lines": lines}
                else:
                    statements = append(statements, parse_statement(line, index + 1, 1))
                    cursor = line_cursor_advance(cursor)
    return {"next": cursor["index"], "statements": statements}

export fn parse_block_program(lines):
    let result = parse_block_from(lines, 0, 0)
    return result["statements"]

# Token-native block parser: identical structure to parse_block_from but derives
# indentation from the token-span table (token_indentation_for) instead of the
# raw line prefix. This is the parser-owned indentation source for block assembly.
export fn parse_elif_chain_tokens(lines, start_index, indent, table):
    if start_index < 0 or start_index >= len(lines):
        return {"next": start_index, "node": none}
    let line = lines[start_index]
    let value = trim(line)
    if not starts_with(value, "elif "):
        return {"next": start_index, "node": none}
    let condition_text = trim(substring(value, 5, len(value) - 1))
    let nested = parse_block_from_tokens(lines, start_index + 1, indent + 4, table)
    let else_branch = none
    let final_next = nested["next"]
    if nested["next"] < len(lines):
        let next_line = lines[nested["next"]]
        let next_value = trim(next_line)
        if token_indentation_for(table, nested["next"] + 1, 0) == indent and starts_with(next_value, "elif "):
            let chained = parse_elif_chain_tokens(lines, nested["next"], indent, table)
            else_branch = {"statements": [chained["node"]]}
            final_next = chained["next"]
        else:
            if token_indentation_for(table, nested["next"] + 1, 0) == indent and next_value == "else:":
                let else_nested = parse_block_from_tokens(lines, nested["next"] + 1, indent + 4, table)
                else_branch = {"statements": else_nested["statements"]}
                final_next = else_nested["next"]
    let node = {"condition": parse_expression(condition_text, 1), "else_branch": else_branch, "kind": "if", "span": span(start_index + 1, indent + 1, len(value)), "then_branch": {"statements": nested["statements"]}}
    return {"next": final_next, "node": node}

export fn parse_block_from_tokens(lines, start_index, indent, table):
    if start_index < 0 or start_index >= len(lines):
        return {"next": start_index, "statements": []}
    let statements = []
    let cursor = {"index": start_index, "lines": lines}
    while not line_cursor_done(cursor):
        let index = cursor["index"]
        if index < 0 or index >= len(lines):
            return {"next": index, "statements": statements}
        let line = line_cursor_peek(cursor)
        let current = trim(line)
        if current == "":
            cursor = line_cursor_advance(cursor)
        else:
            let current_indent = token_indentation_for(table, index + 1, 0)
            if current_indent < indent:
                return {"next": index, "statements": statements}
            if current_indent > indent:
                return {"next": index, "statements": statements}
            if starts_with(current, "fn ") or starts_with(current, "async fn ") or starts_with(current, "class ") or starts_with(current, "trait ") or starts_with(current, "interface "):
                let chunked = nested_block_slice_walk(lines, index + 1, indent, [current])
                let parsed = []
                if starts_with(current, "class "):
                    parsed = parse_class_arbitrary(chunked["lines"])
                else:
                    if starts_with(current, "trait "):
                        parsed = parse_trait_arbitrary(chunked["lines"], "trait")
                    else:
                        if starts_with(current, "interface "):
                            parsed = parse_trait_arbitrary(chunked["lines"], "interface")
                        else:
                            parsed = parse_generic_function(chunked["lines"])
                if len(parsed) > 0:
                    statements = append(statements, rebase_class_layout_statement(parsed[0], index, indent))
                cursor = {"index": chunked["next"], "lines": lines}
            else:
                if is_block_header(line):
                    let nested = parse_block_from_tokens(lines, index + 1, indent + 4, table)
                    let body = {"statements": nested["statements"]}
                    if starts_with(current, "if "):
                        let branch_else = none
                        let final_next = nested["next"]
                        if nested["next"] < len(lines):
                            let next_line = lines[nested["next"]]
                            let next_value = trim(next_line)
                            if token_indentation_for(table, nested["next"] + 1, 0) == indent and starts_with(next_value, "elif "):
                                let chained = parse_elif_chain_tokens(lines, nested["next"], indent, table)
                                branch_else = {"statements": [chained["node"]]}
                                final_next = chained["next"]
                            else:
                                if token_indentation_for(table, nested["next"] + 1, 0) == indent and next_value == "else:":
                                    let else_nested = parse_block_from_tokens(lines, nested["next"] + 1, indent + 4, table)
                                    branch_else = {"statements": else_nested["statements"]}
                                    final_next = else_nested["next"]
                        let branch = {"condition": parse_expression(trim(substring(current, 3, len(current) - 1)), 1), "else_branch": branch_else, "kind": "if", "span": span(index + 1, indent + 1, len(current)), "then_branch": body}
                        statements = append(statements, branch)
                        cursor = {"index": final_next, "lines": lines}
                    else:
                        if current == "try:":
                            let catch_body = {"statements": []}
                            let next_index = nested["next"]
                            if nested["next"] < len(lines):
                                let catch_line = lines[nested["next"]]
                                if token_indentation_for(table, nested["next"] + 1, 0) == indent and starts_with(trim(catch_line), "catch"):
                                    let catch_nested = parse_block_from_tokens(lines, nested["next"] + 1, indent + 4, table)
                                    catch_body = {"statements": catch_nested["statements"]}
                                    next_index = catch_nested["next"]
                            let catch_binding = none
                            if nested["next"] < len(lines):
                                let catch_header = lines[nested["next"]]
                                if token_indentation_for(table, nested["next"] + 1, 0) == indent and starts_with(trim(catch_header), "catch"):
                                    catch_binding = parse_catch_binding(catch_header)
                            let try_node = {"body": body, "catch_body": catch_body, "kind": "try_catch", "span": span(index + 1, indent + 1, len(current))}
                            if catch_binding != none:
                                try_node = {"body": body, "catch_binding": catch_binding, "catch_body": catch_body, "kind": "try_catch", "span": span(index + 1, indent + 1, len(current))}
                            statements = append(statements, try_node)
                            cursor = {"index": next_index, "lines": lines}
                        else:
                            if starts_with(current, "for "):
                                let header_parts = split(current, " in ")
                                if len(header_parts) == 2:
                                    let binding = trim(substring(header_parts[0], 4, len(header_parts[0])))
                                    let iterable_text = trim(substring(header_parts[1], 0, len(header_parts[1]) - 1))
                                    statements = append(statements, {"binding": binding, "body": body, "iterable": parse_expression(iterable_text, 1), "kind": "for", "span": span(index + 1, indent + 1, len(current))})
                                else:
                                    statements = append(statements, {"body": body, "iterable": none, "kind": "for", "span": span(index + 1, indent + 1, len(current))})
                            else:
                                if len(current) > 6:
                                    let condition_text = trim(substring(current, 6, len(current) - 1))
                                    statements = append(statements, {"body": body, "condition": parse_expression(condition_text, 1), "kind": "while", "span": span(index + 1, indent + 1, len(current))})
                                else:
                                    statements = append(statements, {"body": body, "condition": none, "kind": "while", "span": span(index + 1, indent + 1, len(current))})
                    if not starts_with(current, "if ") and current != "try:":
                        cursor = {"index": nested["next"], "lines": lines}
                else:
                    statements = append(statements, parse_statement(line, index + 1, 1))
                    cursor = line_cursor_advance(cursor)
    return {"next": cursor["index"], "statements": statements}

export fn parse_block_program_tokens(lines, table):
    let result = parse_block_from_tokens(lines, 0, 0, table)
    return result["statements"]

export fn parse_general_sequence_tokens_at(lines, cursor, statements, table):
    if cursor >= len(lines):
        return statements
    let line = lines[cursor]
    let value = trim(line)
    if value == "":
        return parse_general_sequence_tokens_at(lines, cursor + 1, statements, table)
    if token_indentation_for(table, cursor + 1, 0) != 0:
        return parse_general_sequence_tokens_at(lines, cursor + 1, statements, table)
    if is_block_header(line):
        let chunked = top_level_slice_walk(lines, cursor + 1, [line])
        let parsed = parse_block_program_tokens(chunked["lines"], table)
        let next_statements = statements
        if len(parsed) > 0:
            next_statements = append(next_statements, rebase_statement_spans(parsed[0], cursor))
        return parse_general_sequence_tokens_at(lines, chunked["next"], next_statements, table)
    if starts_with(value, "fn ") or starts_with(value, "async fn "):
        let chunked = top_level_slice_walk(lines, cursor + 1, [line])
        let parsed = parse_generic_function(chunked["lines"])
        let next_statements = statements
        if len(parsed) > 0:
            next_statements = append(next_statements, rebase_statement_spans(parsed[0], cursor))
        return parse_general_sequence_tokens_at(lines, chunked["next"], next_statements, table)
    if starts_with(value, "class "):
        let chunked = top_level_slice_walk(lines, cursor + 1, [line])
        let parsed = parse_class_arbitrary(chunked["lines"])
        let next_statements = statements
        if len(parsed) > 0:
            next_statements = append(next_statements, rebase_statement_spans(parsed[0], cursor))
        return parse_general_sequence_tokens_at(lines, chunked["next"], next_statements, table)
    if starts_with(value, "trait "):
        let chunked = top_level_slice_walk(lines, cursor + 1, [line])
        let parsed = parse_trait_arbitrary(chunked["lines"], "trait")
        let next_statements = statements
        if len(parsed) > 0:
            next_statements = append(next_statements, rebase_statement_spans(parsed[0], cursor))
        return parse_general_sequence_tokens_at(lines, chunked["next"], next_statements, table)
    if starts_with(value, "interface "):
        let chunked = top_level_slice_walk(lines, cursor + 1, [line])
        let parsed = parse_trait_arbitrary(chunked["lines"], "interface")
        let next_statements = statements
        if len(parsed) > 0:
            next_statements = append(next_statements, rebase_statement_spans(parsed[0], cursor))
        return parse_general_sequence_tokens_at(lines, chunked["next"], next_statements, table)
    let next_statements = append(statements, parse_statement(line, cursor + 1, 1))
    return parse_general_sequence_tokens_at(lines, cursor + 1, next_statements, table)

export fn parse_general_sequence_tokens(lines, table):
    return parse_general_sequence_tokens_at(lines, 0, [], table)

export fn parse_general_program_tokens(lines, table):
    if len(lines) == 0:
        return []
    return parse_general_sequence_tokens(lines, table)

export fn is_branch_header(line):
    let value = trim(line)
    return value == "else:" or starts_with(value, "elif ")

export fn missing_block_diagnostic(lines, source_name):
    let cursor = line_cursor(lines)
    while not line_cursor_done(cursor):
        let index = cursor["index"]
        let line = line_cursor_peek(cursor)
        let value = trim(line)
        if is_block_header(line) or is_branch_header(line):
            let current_indent = indentation_width(line)
            if index + 1 >= len(lines):
                return {"code": "ZAP-SYNTAX-001", "column": none, "help": "add an indented block", "line": index + 1, "message": "block requires an indented body at line " + str(index + 1), "severity": "error", "source_name": source_name}
            let next_line = lines[index + 1]
            if trim(next_line) == "" or indentation_width(next_line) <= current_indent:
                return {"code": "ZAP-SYNTAX-001", "column": none, "help": "add an indented block", "line": index + 1, "message": "block requires an indented body at line " + str(index + 1), "severity": "error", "source_name": source_name}
        cursor = line_cursor_advance(cursor)
    return none

export fn parse(source, source_name):
    return parse_general(source, source_name)

export fn indentation_diagnostic(source, source_name):
    let lines = split(source, "\n")
    let structural = indentation_stack_diagnostic(lines, source_name)
    if structural != none:
        return structural
    let index = 0
    while index + 1 < len(lines):
        let line = lines[index]
        let trimmed = trim(line)
        if trimmed != "":
            let indentation = len(line) - len(substring(line, len(line) - len(trimmed), len(line)))
            if indentation > 0 and indentation % 4 != 0:
                return {"code": "ZAP-SYNTAX-001", "column": none, "help": "check the surrounding syntax and delimiters", "line": none, "message": "invalid indentation at line " + str(index + 1), "severity": "error", "source_name": source_name}
        index = index + 1
    return none

export fn token_line_seen(list, line):
    if list == none:
        return false
    let index = 0
    let n = len(list)
    while true:
        if index >= n:
            break
        let entry = list[index]
        if entry != none and entry["line"] == line:
            return true
        index = index + 1
    return false

export fn token_line_columns(tokens, index, result):
    if tokens == none:
        return result
    let cursor = index
    let columns = result
    let n = len(tokens)
    while true:
        if cursor >= n:
            break
        let token = tokens[cursor]
        if token != none:
            if token["kind"] != "end":
                let span_value = token["span"]
                if span_value != none:
                    let line = span_value["line"]
                    let column = span_value["column"]
                    if not token_line_seen(columns, line):
                        columns = append(columns, {"column": column, "line": line})
        cursor = cursor + 1
    return columns

export fn token_indentation_diagnostic(tokens, source_name):
    # Structural indentation is validated from source lines by
    # indentation_diagnostic. The token-only duplicate is intentionally
    # total because token spans do not encode reliable block transitions.
    return none

# Token-native indentation table: maps each source line to the column of its
# first token. This is the parser-owned indentation source used by the
# token-native block parser (parse_block_from_tokens).
export fn token_indentation_table(tokens, index, result):
    return token_line_columns(tokens, index, result)

export fn token_indentation_for(table, line, index):
    if table == none or len(table) == 0:
        return 0
    if index < 0 or index >= len(table):
        return 0
    let entry = table[index]
    if entry == none:
        return token_indentation_for(table, line, index + 1)
    if entry["line"] == line:
        let column = entry["column"]
        if column == none or column <= 0:
            return 0
        return column - 1
    return token_indentation_for(table, line, index + 1)

export fn while_else_diagnostic(source, source_name):
    # Avoid indexing source lines while recognizing the explicitly unsupported
    # top-level while/else form. The bounded source check is safe for empty,
    # one-line, and trailing-newline inputs.
    if contains(source, "while ") and contains(source, "\nelse:"):
        return {"code": "ZAP-SYNTAX-001", "column": none, "help": "while loops do not support an else clause in this syntax", "line": none, "message": "unsupported 'while ... else' syntax", "severity": "error", "source_name": source_name}
    return none

export fn delimiter_diagnostics(tokens, source_name):
    let bracket_depth = 0
    let brace_depth = 0
    let paren_depth = 0
    for token in tokens:
        let kind = token["kind"]
        if kind == "left_bracket":
            bracket_depth = bracket_depth + 1
        else:
            if kind == "right_bracket":
                if bracket_depth == 0:
                    let span_value = token["span"]
                    let line = span_value["line"]
                    let column = span_value["column"] - 4
                    let message = "expected expression, got RBracket at " + str(line) + ":" + str(column)
                    return {"code": "ZAP-SYNTAX-001", "column": column, "help": "check the surrounding syntax and delimiters", "line": line, "message": message, "severity": "error", "source_name": source_name}
                bracket_depth = bracket_depth - 1
            else:
                if kind == "left_brace":
                    brace_depth = brace_depth + 1
                else:
                    if kind == "right_brace":
                        if brace_depth == 0:
                            let span_value = token["span"]
                            return {"code": "ZAP-SYNTAX-001", "column": span_value["column"], "help": "check the surrounding syntax and delimiters", "line": span_value["line"], "message": "unexpected closing brace", "severity": "error", "source_name": source_name}
                        brace_depth = brace_depth - 1
                    else:
                        if kind == "left_paren":
                            paren_depth = paren_depth + 1
                        else:
                            if kind == "right_paren":
                                if paren_depth == 0:
                                    let span_value = token["span"]
                                    return {"code": "ZAP-SYNTAX-001", "column": span_value["column"], "help": "check the surrounding syntax and delimiters", "line": span_value["line"], "message": "unexpected closing parenthesis", "severity": "error", "source_name": source_name}
                                paren_depth = paren_depth - 1
    if bracket_depth > 0:
        return {"code": "ZAP-SYNTAX-001", "column": 6, "help": "check the surrounding syntax and delimiters", "line": 1, "message": "expected ']' at 1:6", "severity": "error", "source_name": source_name}
    if paren_depth > 0:
        return {"code": "ZAP-SYNTAX-001", "column": 4, "help": "check the surrounding syntax and delimiters", "line": 1, "message": "unexpected token after expression at 1:4", "severity": "error", "source_name": source_name}
    return none

export fn token_has_numeric_dot_at(tokens, index):
    if index >= len(tokens):
        return false
    let current = tokens[index]
    if current["kind"] == "number":
        if contains(str(current["value"]), "."):
            return true
    return token_has_numeric_dot_at(tokens, index + 1)

export fn token_has_numeric_dot(tokens):
    if len(tokens) == 0:
        return false
    return token_has_numeric_dot_at(tokens, 0)

export fn token_has_kind_at(tokens, index, kind):
    if index >= len(tokens):
        return false
    if tokens[index]["kind"] == kind:
        return true
    return token_has_kind_at(tokens, index + 1, kind)

export fn legacy_expression(node):
    if node == none:
        return none
    let kind = node["kind"]
    let node_span = node["span"]
    let legacy_span = span(1, node_span["column"], node_span["length"])
    if kind == "literal":
        return {"kind": kind, "literal_kind": node["literal_kind"], "span": legacy_span, "value": node["value"]}
    if kind == "name":
        return {"kind": kind, "name": node["name"], "span": legacy_span}
    if kind == "unary":
        return {"kind": kind, "op": node["op"], "span": legacy_span, "value": legacy_expression(node["value"])}
    if kind == "binary":
        return {"kind": kind, "left": legacy_expression(node["left"]), "op": node["op"], "right": legacy_expression(node["right"]), "span": legacy_span}
    if kind == "conditional":
        return {"condition": legacy_expression(node["condition"]), "else_value": legacy_expression(node["else_value"]), "kind": kind, "span": legacy_span, "then_value": legacy_expression(node["then_value"])}
    if kind == "index":
        return {"index": legacy_expression(node["index"]), "kind": kind, "span": legacy_span, "target": legacy_expression(node["target"])}
    if kind == "call":
        return {"args": legacy_call_arguments(node["args"], 0, []), "callee": legacy_expression(node["callee"]), "kind": kind, "span": legacy_span}
    if kind == "list":
        return {"elements": legacy_expressions(node["elements"], 0, []), "kind": kind, "span": legacy_span}
    if kind == "map":
        return {"entries": legacy_map_entries(node["entries"], 0, []), "kind": kind, "span": legacy_span}
    return node

export fn legacy_call_arguments(arguments, index, result):
    if index >= len(arguments):
        return result
    let argument = arguments[index]
    let rebased = {"kind": "positional", "value": legacy_expression(argument["value"])}
    if argument["kind"] == "named":
        rebased = {"kind": "named", "name": argument["name"], "value": legacy_expression(argument["value"])}
    return legacy_call_arguments(arguments, index + 1, append(result, rebased))

export fn legacy_expressions(elements, index, result):
    if index >= len(elements):
        return result
    return legacy_expressions(elements, index + 1, append(result, legacy_expression(elements[index])))

export fn legacy_map_entries(entries, index, result):
    if index >= len(entries):
        return result
    let entry = entries[index]
    return legacy_map_entries(entries, index + 1, append(result, {"key": legacy_expression(entry["key"]), "value": legacy_expression(entry["value"])}))

export fn legacy_statements(statements, index, result, lines):
    if index >= len(statements):
        return result
    return legacy_statements(statements, index + 1, append(result, legacy_statement(statements[index], lines)), lines)

export fn legacy_statement(node, lines):
    let kind = node["kind"]
    let node_span = node["span"]
    let source_line = lines[node_span["line"] - 1]
    let statement_span = span(node_span["line"], len(source_line) - len(trim(source_line)) + 1, node_span["length"])
    if kind == "function":
        return {"body": {"statements": legacy_statements(node["body"]["statements"], 0, [], lines)}, "exported": node["exported"], "is_async": node["is_async"], "kind": kind, "name": node["name"], "params": node["params"], "return_type": node["return_type"], "span": statement_span, "visibility": node["visibility"]}
    if kind == "class":
        return {"base": node["base"], "body": {"statements": legacy_statements(node["body"]["statements"], 0, [], lines)}, "kind": kind, "name": node["name"], "span": statement_span}
    if kind == "if":
        let else_branch = none
        if node["else_branch"] != none:
            else_branch = {"statements": legacy_statements(node["else_branch"]["statements"], 0, [], lines)}
        return {"condition": legacy_expression(node["condition"]), "else_branch": else_branch, "kind": kind, "span": statement_span, "then_branch": {"statements": legacy_statements(node["then_branch"]["statements"], 0, [], lines)}}
    if kind == "try_catch":
        return {"body": {"statements": legacy_statements(node["body"]["statements"], 0, [], lines)}, "catch_body": {"statements": legacy_statements(node["catch_body"]["statements"], 0, [], lines)}, "kind": kind, "span": statement_span}
    if kind == "for":
        return {"binding": node["binding"], "body": {"statements": legacy_statements(node["body"]["statements"], 0, [], lines)}, "iterable": legacy_expression(node["iterable"]), "kind": kind, "span": statement_span}
    if kind == "while":
        return {"body": {"statements": legacy_statements(node["body"]["statements"], 0, [], lines)}, "condition": legacy_expression(node["condition"]), "kind": kind, "span": statement_span}
    if kind == "return":
        return {"kind": kind, "span": statement_span, "value": legacy_expression(node["value"])}
    if kind == "break" or kind == "continue":
        return {"kind": kind, "span": statement_span}
    if kind == "say":
        return {"kind": kind, "span": statement_span, "value": legacy_expression(node["value"])}
    if kind == "raise":
        return {"kind": kind, "span": statement_span, "value": legacy_expression(node["value"])}
    if kind == "declaration":
        return {"annotation": node["annotation"], "exported": node["exported"], "kind": kind, "name": node["name"], "span": statement_span, "value": legacy_expression(node["value"])}
    if kind == "assignment":
        return {"kind": kind, "name": node["name"], "span": statement_span, "value": legacy_expression(node["value"])}
    return node

export fn legacy_parse_result(source, source_name):
    let parsed = from_json(parse_general(source, source_name))
    if parsed["kind"] != "zap.ast":
        return json(parsed)
    let lines = split(trim(source), "\n")
    return json({"ast": {"statements": legacy_statements(parsed["ast"]["statements"], 0, [], lines)}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})

export fn parse_or_diagnostics(source, tokens, source_name):
    let delimiter = delimiter_diagnostics(tokens, source_name)
    if delimiter != none:
        return json({"diagnostics": [delimiter], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    let indentation = indentation_diagnostic(source, source_name)
    let missing_block = missing_block_diagnostic(split(source, "\n"), source_name)
    if missing_block != none:
        return json({"diagnostics": [missing_block], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    if indentation != none:
        return json({"diagnostics": [indentation], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    let token_indent = token_indentation_diagnostic(tokens, source_name)
    if token_indent != none:
        return json({"diagnostics": [token_indent], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    let while_else = while_else_diagnostic(source, source_name)
    if while_else != none:
        return json({"diagnostics": [while_else], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    if token_has_numeric_dot(tokens):
        return json({"diagnostics": [{"code": "ZAP-SYNTAX-001", "column": none, "help": "check the surrounding syntax and delimiters", "line": none, "message": "expected member name after '.', got Number(14)", "severity": "error", "source_name": source_name}], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    if starts_with(trim(source), "let "):
        if not token_has_kind_at(tokens, 0, "equal"):
            return json({"diagnostics": [{"code": "ZAP-SYNTAX-001", "column": none, "help": "check the surrounding syntax and delimiters", "line": none, "message": "declaration expects '='", "severity": "error", "source_name": source_name}], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    return legacy_parse_result(source, source_name)

export fn is_top_level_continuation(value):
    return value == "else:" or starts_with(value, "elif ") or value == "catch:" or starts_with(value, "catch ") or value == "finally:"

export fn top_level_slice_walk(lines, index, chunk):
    if index >= len(lines):
        return {"lines": chunk, "next": index}
    let line = lines[index]
    let value = trim(line)
    if value != "":
        if indentation_width(line) == 0:
            if not is_top_level_continuation(value):
                return {"lines": chunk, "next": index}
    let next_chunk = append(chunk, line)
    return top_level_slice_walk(lines, index + 1, next_chunk)

export fn parse_general_sequence_at(lines, cursor, statements):
    if cursor >= len(lines):
        return statements
    let line = lines[cursor]
    let value = trim(line)
    if value == "":
        return parse_general_sequence_at(lines, cursor + 1, statements)
    if indentation_width(line) != 0:
        return parse_general_sequence_at(lines, cursor + 1, statements)
    if is_block_header(line):
        let chunked = top_level_slice_walk(lines, cursor + 1, [line])
        let parsed = parse_block_program(chunked["lines"])
        let next_statements = statements
        if len(parsed) > 0:
            next_statements = append(next_statements, rebase_statement_spans(parsed[0], cursor))
        return parse_general_sequence_at(lines, chunked["next"], next_statements)
    if starts_with(value, "fn ") or starts_with(value, "async fn "):
        let chunked = top_level_slice_walk(lines, cursor + 1, [line])
        let parsed = parse_generic_function(chunked["lines"])
        let next_statements = statements
        if len(parsed) > 0:
            next_statements = append(next_statements, rebase_statement_spans(parsed[0], cursor))
        return parse_general_sequence_at(lines, chunked["next"], next_statements)
    if starts_with(value, "class "):
        let chunked = top_level_slice_walk(lines, cursor + 1, [line])
        let parsed = parse_class_arbitrary(chunked["lines"])
        let next_statements = statements
        if len(parsed) > 0:
            next_statements = append(next_statements, rebase_statement_spans(parsed[0], cursor))
        return parse_general_sequence_at(lines, chunked["next"], next_statements)
    if starts_with(value, "trait "):
        let chunked = top_level_slice_walk(lines, cursor + 1, [line])
        let parsed = parse_trait_arbitrary(chunked["lines"], "trait")
        let next_statements = statements
        if len(parsed) > 0:
            next_statements = append(next_statements, rebase_statement_spans(parsed[0], cursor))
        return parse_general_sequence_at(lines, chunked["next"], next_statements)
    if starts_with(value, "interface "):
        let chunked = top_level_slice_walk(lines, cursor + 1, [line])
        let parsed = parse_trait_arbitrary(chunked["lines"], "interface")
        let next_statements = statements
        if len(parsed) > 0:
            next_statements = append(next_statements, rebase_statement_spans(parsed[0], cursor))
        return parse_general_sequence_at(lines, chunked["next"], next_statements)
    let next_statements = append(statements, parse_statement(line, cursor + 1, 1))
    return parse_general_sequence_at(lines, cursor + 1, next_statements)

export fn parse_general_sequence(lines):
    return parse_general_sequence_at(lines, 0, [])

# General parser entry: it owns indentation/block assembly for arbitrary statement
# sequences and is the production route used by parse().
export fn parse_general_program(lines):
    if len(lines) == 0:
        return []
    return parse_general_sequence(lines)

export fn generic_header_seen(values, candidate):
    for value in values:
        if value == candidate:
            return true
    return false

export fn generic_bound_part_valid(part, parameter_name):
    if part == parameter_name:
        return true
    if part == "number" or part == "text" or part == "bool" or part == "none" or part == "any":
        return true
    if starts_with(part, "list<") or starts_with(part, "map<") or starts_with(part, "option<") or starts_with(part, "result<"):
        return true
    if part == "T" or part == "U" or part == "K" or part == "V":
        return true
    return false

export fn generic_bound_valid(bound, parameter_name):
    if bound == "" or bound == "any":
        return true
    if contains(bound, ":"):
        return false
    if contains(bound, " + "):
        let all_valid = true
        for part in split(bound, " + "):
            if not generic_bound_part_valid(trim(part), parameter_name):
                all_valid = false
        return all_valid
    return generic_bound_part_valid(bound, parameter_name)

export fn generic_header_diagnostic_at(lines, index, source_name):
    if index >= len(lines):
        return none
    let value = trim(lines[index])
    if not starts_with(value, "fn ") or not contains(value, "<"):
        return none
    let open_index = 0
    while open_index < len(value):
        if char_at(value, open_index) == "(":
            break
        open_index = open_index + 1
    if open_index >= len(value):
        return none
    let raw_name = trim(substring(value, 3, open_index))
    if not contains(raw_name, "<") or not ends_with(raw_name, ">"):
        return none
    let generic_text = trim(substring(raw_name, len(split(raw_name, "<")[0]) + 1, len(raw_name) - 1))
    if generic_text == "":
        return {"code": "ZAP-SYNTAX-001", "column": 1, "help": "Review the surrounding Zap syntax.", "kind": "SyntaxError", "line": index + 1, "message": "generic type-parameter list cannot be empty", "notes": [], "severity": "error", "source_name": source_name}
    let seen = []
    for parameter in split(generic_text, ","):
        let candidate = trim(parameter)
        let parameter_name = candidate
        let bound = ""
        if contains(candidate, ":"):
            let bound_parts = split(candidate, ":")
            if len(bound_parts) != 2:
                return {"code": "ZAP-SYNTAX-001", "column": 1, "help": "Review the surrounding Zap syntax.", "kind": "SyntaxError", "line": index + 1, "message": "invalid generic bound '" + candidate + "'", "notes": [], "severity": "error", "source_name": source_name}
            parameter_name = trim(bound_parts[0])
            bound = trim(bound_parts[1])
        else:
            if contains(candidate, " extends "):
                let parts = split(candidate, " extends ")
                if len(parts) == 2:
                    parameter_name = trim(parts[0])
                    bound = trim(parts[1])
                else:
                    return {"code": "ZAP-SYNTAX-001", "column": 1, "help": "Review the surrounding Zap syntax.", "kind": "SyntaxError", "line": index + 1, "message": "invalid generic type parameter '" + candidate + "'", "notes": [], "severity": "error", "source_name": source_name}
        if bound != "" and not generic_bound_valid(bound, parameter_name):
            return {"code": "ZAP-SYNTAX-001", "column": 1, "help": "Review the surrounding Zap syntax.", "kind": "SyntaxError", "line": index + 1, "message": "invalid generic bound '" + candidate + "'", "notes": [], "severity": "error", "source_name": source_name}
        if generic_header_seen(seen, parameter_name):
            return {"code": "ZAP-SYNTAX-001", "column": 1, "help": "Review the surrounding syntax.", "kind": "SyntaxError", "line": index + 1, "message": "duplicate generic type parameter: " + parameter_name, "notes": [], "severity": "error", "source_name": source_name}
        if parameter_name != "T" and parameter_name != "U" and parameter_name != "K" and parameter_name != "V":
            return {"code": "ZAP-SYNTAX-001", "column": 1, "help": "Review the surrounding syntax.", "kind": "SyntaxError", "line": index + 1, "message": "invalid generic type parameter '" + candidate + "'", "notes": [], "severity": "error", "source_name": source_name}
        seen = append(seen, parameter_name)
    return none

export fn generic_header_diagnostic(lines, source_name):
    let index = 0
    while index < len(lines):
        let diagnostic = generic_header_diagnostic_at(lines, index, source_name)
        if diagnostic != none:
            return diagnostic
        index = index + 1
    return none

export fn parse_general(source, source_name):
    let normalized_source = trim(source)
    let lexed = from_json(lex(source, source_name))
    if lexed["kind"] == "zap.diagnostics":
        return json(lexed)
    let delimiter = delimiter_diagnostics(lexed["tokens"], source_name)
    if delimiter != none:
        return json({"diagnostics": [delimiter], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    let lines = split(normalized_source, "\n")
    let generic_diagnostic = generic_header_diagnostic(lines, source_name)
    if generic_diagnostic != none:
        return json({"diagnostics": [generic_diagnostic], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    let indentation = indentation_stack_diagnostic(lines, source_name)
    if indentation != none:
        return json({"diagnostics": [indentation], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    let missing_block = missing_block_diagnostic(lines, source_name)
    if missing_block != none:
        return json({"diagnostics": [missing_block], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    let token_indent = token_indentation_diagnostic(lexed["tokens"], source_name)
    if token_indent != none:
        return json({"diagnostics": [token_indent], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    # The source-line parser is the canonical block assembler. Token metadata
    # remains available to expression helpers, but it must not control the
    # top-level cursor for valid compound programs.
    let statements = parse_general_program(lines)
    return json({"ast": {"statements": statements}, "kind": "zap.ast", "schema_version": 1, "source_name": source_name})

# Token-driven expression parser helpers consume lexer tokens and carry the next
# cursor explicitly.
export fn token_span(token):
    return token["span"]

export fn token_binary(left, operator, right):
    let left_span = left["span"]
    let right_span = right["span"]
    let start = left_span["column"]
    let end = right_span["column"] + right_span["length"]
    return {"kind": "binary", "left": left, "op": operator, "right": right, "span": span(left_span["line"], start, end - start)}

export fn token_operator(kind):
    if kind == "plus":
        return "add"
    if kind == "minus":
        return "subtract"
    if kind == "star":
        return "multiply"
    if kind == "slash":
        return "divide"
    if kind == "percent":
        return "remainder"
    if kind == "less":
        return "less"
    if kind == "less_equal":
        return "less_equal"
    if kind == "greater":
        return "greater"
    if kind == "greater_equal":
        return "greater_equal"
    if kind == "equal_equal":
        return "equal"
    if kind == "not_equal":
        return "not_equal"
    if kind == "and":
        return "and"
    if kind == "or":
        return "or"
    return "unknown"

export fn token_eof_node(index):
    return {"kind": "error", "message": "unexpected end of expression", "span": span(1, 1, 0)}

export fn token_primary(tokens, index):
    # EOF is a valid cursor result during delimiter/error recovery. Return a
    # stable error node instead of indexing beyond the token stream.
    if index >= len(tokens):
        return {"next": index, "node": token_eof_node(index)}
    let token = tokens[index]
    if token["kind"] == "end":
        return {"next": index, "node": token_eof_node(index)}
    let kind = token["kind"]
    let value = token["value"]
    if kind == "not":
        let nested = token_primary(tokens, index + 1)
        return {"next": nested["next"], "node": {"kind": "unary", "op": "not", "span": span(token["span"]["line"], token["span"]["column"], nested["node"]["span"]["column"] + nested["node"]["span"]["length"] - token["span"]["column"]), "value": nested["node"]}}
    if kind == "minus":
        let nested = token_primary(tokens, index + 1)
        return {"next": nested["next"], "node": {"kind": "unary", "op": "negate", "span": span(token["span"]["line"], token["span"]["column"], nested["node"]["span"]["column"] + nested["node"]["span"]["length"] - token["span"]["column"]), "value": nested["node"]}}
    if kind == "number":
        return {"next": index + 1, "node": {"kind": "literal", "literal_kind": "number", "span": token["span"], "value": value}}
    if kind == "text":
        return {"next": index + 1, "node": {"kind": "literal", "literal_kind": "text", "span": token["span"], "value": value}}
    if kind == "name":
        return {"next": index + 1, "node": {"kind": "name", "name": value, "span": token["span"]}}
    if kind == "left_paren":
        let nested = token_expression(tokens, index + 1, 0)
        let close = nested["next"]
        if close < len(tokens) and tokens[close]["kind"] == "right_paren":
            return {"next": close + 1, "node": nested["node"]}
        return nested
    if kind == "left_bracket":
        let elements = []
        let cursor = index + 1
        if cursor < len(tokens) and tokens[cursor]["kind"] == "right_bracket":
            return {"next": cursor + 1, "node": {"elements": elements, "kind": "list", "span": span(token["span"]["line"], token["span"]["column"], 2)}}
        while cursor < len(tokens):
            let element = token_expression(tokens, cursor, 0)
            elements = append(elements, element["node"])
            cursor = element["next"]
            if cursor < len(tokens) and tokens[cursor]["kind"] == "comma":
                cursor = cursor + 1
            else:
                break
        if cursor < len(tokens) and tokens[cursor]["kind"] == "right_bracket":
            let end_span = tokens[cursor]["span"]
            return {"next": cursor + 1, "node": {"elements": elements, "kind": "list", "span": span(token["span"]["line"], token["span"]["column"], end_span["column"] + end_span["length"] - token["span"]["column"])}}
        return {"next": cursor, "node": {"elements": elements, "kind": "list", "span": token["span"]}}
    if kind == "left_brace":
        let entries = []
        let cursor = index + 1
        if cursor < len(tokens):
            if tokens[cursor]["kind"] == "right_brace":
                return {"next": cursor + 1, "node": {"entries": entries, "kind": "map", "span": span(token["span"]["line"], token["span"]["column"], 2)}}
        while cursor < len(tokens):
            let key_result = token_expression(tokens, cursor, 0)
            cursor = key_result["next"]
            if cursor < len(tokens):
                if tokens[cursor]["kind"] == "colon":
                    cursor = cursor + 1
                    let value_result = token_expression(tokens, cursor, 0)
                    entries = append(entries, {"key": key_result["node"], "value": value_result["node"]})
                    cursor = value_result["next"]
                    if cursor < len(tokens):
                        if tokens[cursor]["kind"] == "comma":
                            cursor = cursor + 1
                        else:
                            break
                    else:
                        break
                else:
                    break
            else:
                break
        if cursor < len(tokens):
            if tokens[cursor]["kind"] == "right_brace":
                let end_span = tokens[cursor]["span"]
                return {"next": cursor + 1, "node": {"entries": entries, "kind": "map", "span": span(token["span"]["line"], token["span"]["column"], end_span["column"] + end_span["length"] - token["span"]["column"])}}
        return {"next": cursor, "node": {"entries": entries, "kind": "map", "span": token["span"]}}
    return {"next": index + 1, "node": {"kind": "name", "name": value, "span": token["span"]}}

export fn token_precedence(kind):
    if kind == "or":
        return 1
    if kind == "and":
        return 2
    if kind == "equal_equal" or kind == "not_equal" or kind == "less" or kind == "less_equal" or kind == "greater" or kind == "greater_equal":
        return 3
    if kind == "plus" or kind == "minus":
        return 4
    if kind == "star" or kind == "slash" or kind == "percent":
        return 5
    return 0

export fn token_expression(tokens, index, minimum_precedence):
    # Preserve the cursor at EOF and propagate the same structured node used
    # by token_primary; callers can then emit a diagnostic without panicking.
    if index >= len(tokens):
        return {"next": index, "node": token_eof_node(index)}
    let left_result = token_primary(tokens, index)
    let suffix_result = token_suffix(left_result["node"], tokens, left_result["next"])
    let left = suffix_result["node"]
    let cursor = suffix_result["next"]
    while cursor < len(tokens):
        let operator_kind = tokens[cursor]["kind"]
        let precedence = token_precedence(operator_kind)
        if precedence < minimum_precedence or precedence == 0:
            break
        let right_result = token_expression(tokens, cursor + 1, precedence + 1)
        left = token_binary(left, token_operator(operator_kind), right_result["node"])
        cursor = right_result["next"]
    return {"next": cursor, "node": left}

export fn parse_token_expression(tokens):
    if len(tokens) == 0:
        return json({"diagnostics": [{"code": "ZAP-SYNTAX-001", "column": 1, "help": "add an expression", "line": 1, "message": "expected expression", "severity": "error"}], "kind": "zap.diagnostics", "schema_version": 1})
    let result = token_expression(tokens, 0, 0)
    return json({"ast": {"expression": result["node"]}, "kind": "zap.ast.expression", "schema_version": 1, "consumed": result["next"]})

export fn parse_general_with_tokens(source, tokens, source_name):
    let delimiter = delimiter_diagnostics(tokens, source_name)
    if delimiter != none:
        return json({"diagnostics": [delimiter], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    return parse_general(source, source_name)

export fn token_named_argument(tokens, index):
    if index + 1 < len(tokens):
        if tokens[index]["kind"] == "name":
            if tokens[index + 1]["kind"] == "equal":
                let value = token_expression(tokens, index + 2, 0)
                return {"next": value["next"], "argument": {"kind": "named", "name": tokens[index]["value"], "value": value["node"]}}
    let value = token_expression(tokens, index, 0)
    return {"next": value["next"], "argument": {"kind": "positional", "value": value["node"]}}

export fn token_suffix(base, tokens, index):
    let current = base
    let cursor = index
    while cursor < len(tokens):
        let kind = tokens[cursor]["kind"]
        if kind == "left_paren":
            let arguments = []
            cursor = cursor + 1
            while cursor < len(tokens):
                if tokens[cursor]["kind"] == "right_paren":
                    break
                let argument = token_named_argument(tokens, cursor)
                arguments = append(arguments, argument["argument"])
                cursor = argument["next"]
                if cursor < len(tokens):
                    if tokens[cursor]["kind"] == "comma":
                        cursor = cursor + 1
                    else:
                        break
                else:
                    break
            if cursor < len(tokens):
                if tokens[cursor]["kind"] == "right_paren":
                    let end_span = tokens[cursor]["span"]
                    current = {"args": arguments, "callee": current, "kind": "call", "span": span(current["span"]["line"], current["span"]["column"], end_span["column"] + end_span["length"] - current["span"]["column"])}
                    cursor = cursor + 1
                else:
                    break
            else:
                break
        else:
            if kind == "left_bracket":
                let index_result = token_expression(tokens, cursor + 1, 0)
                cursor = index_result["next"]
                if cursor < len(tokens) and tokens[cursor]["kind"] == "right_bracket":
                    let end_span = tokens[cursor]["span"]
                    current = {"index": index_result["node"], "kind": "index", "span": span(current["span"]["line"], current["span"]["column"], end_span["column"] + end_span["length"] - current["span"]["column"]), "target": current}
                    cursor = cursor + 1
                else:
                    break
            else:
                if kind == "dot":
                    if cursor + 1 < len(tokens):
                        if tokens[cursor + 1]["kind"] == "name":
                            let member = tokens[cursor + 1]
                            current = {"kind": "member", "member": member["value"], "span": span(current["span"]["line"], current["span"]["column"], member["span"]["column"] + member["span"]["length"] - current["span"]["column"]), "target": current}
                            cursor = cursor + 2
                        else:
                            break
                    else:
                        break
                else:
                    break
    return {"next": cursor, "node": current}

export fn general_top_level_boundary(line):
    let value = trim(line)
    if value == "":
        return false
    if indentation_width(line) != 0:
        return false
    if value == "else:" or starts_with(value, "elif ") or value == "catch:" or starts_with(value, "catch ") or value == "finally:":
        return false
    return true

export fn parse_general_top_level(lines):
    return parse_general_sequence(lines)

export fn invalid_member_diagnostic(tokens, source_name):
    let index = 0
    while index < len(tokens):
        if tokens[index]["kind"] == "dot":
            let invalid = false
            if index + 1 >= len(tokens):
                invalid = true
            else:
                if tokens[index + 1]["kind"] != "name":
                    invalid = true
            if invalid:
                let next_kind = "EOF"
                if index + 1 < len(tokens):
                    next_kind = tokens[index + 1]["kind"]
                return {"code": "ZAP-SYNTAX-001", "column": none, "help": "check the surrounding syntax and delimiters", "line": none, "message": "expected member name after '.', got " + next_kind, "severity": "error", "source_name": source_name}
        index = index + 1
    return none

export fn missing_assignment_diagnostic(source, tokens, source_name):
    let value = trim(source)
    if starts_with(value, "let "):
        for token in tokens:
            if token["kind"] == "equal":
                return none
        return {"code": "ZAP-SYNTAX-001", "column": none, "help": "check the surrounding syntax and delimiters", "line": none, "message": "declaration expects '='", "severity": "error", "source_name": source_name}
    return none
