# B3 candidate package layer. Native Rust remains the reference owner until B4.

export fn manifest(name, version, main, dependencies):
    return {"dependencies": dependencies, "main": main, "name": name, "version": version}

export fn trait_feature_metadata():
    return {"canonical_parser": true, "checker_registry": true, "release_supported": false, "runtime_dispatch": false, "schema_version": 1}

export fn manifest_with_traits(name, version, main, dependencies):
    return {"dependencies": dependencies, "features": {"traits": trait_feature_metadata()}, "main": main, "name": name, "version": version}

export fn manifest_traits_compatible(manifest_value):
    if not contains(json(manifest_value), "\"features\""):
        return true
    if not contains(json(manifest_value["features"]), "\"traits\""):
        return true
    let feature = manifest_value["features"]["traits"]
    return feature["canonical_parser"] and feature["checker_registry"] and not feature["release_supported"] and not feature["runtime_dispatch"]

export fn dependency(name, version, checksum):
    return {"checksum": checksum, "name": name, "version": version}

export fn trait_dependency(name, version, checksum, required_traits):
    return {"checksum": checksum, "name": name, "required_traits": required_traits, "version": version}

export fn registry_trait_entry(name, version, checksum, provided_traits):
    return {"checksum": checksum, "name": name, "provided_traits": provided_traits, "version": version}

export fn dependency_traits_match(required, registry_entry):
    if required["name"] != registry_entry["name"] or required["version"] != registry_entry["version"] or required["checksum"] != registry_entry["checksum"]:
        return false
    if not contains(json(required), "\"required_traits\""):
        return true
    if not contains(json(registry_entry), "\"provided_traits\""):
        return false
    for required_trait in required["required_traits"]:
        let found = false
        for provided_trait in registry_entry["provided_traits"]:
            if required_trait == provided_trait:
                found = true
        if not found:
            return false
    return true

export fn registry_lock_satisfies_trait_dependencies(manifest_value, registry_entries):
    for required in manifest_value["dependencies"]:
        if contains(json(required), "\"required_traits\""):
            let found = false
            for entry in registry_entries:
                if dependency_traits_match(required, entry):
                    found = true
            if not found:
                return false
    return true

export fn lock_entry(name, version, checksum, source):
    return {"checksum": checksum, "name": name, "source": source, "version": version}

# B3 bounded registry package record. Resolution intentionally uses exact versions;
# range solving and registry transport remain outside this candidate contract.
export fn registry_package(name, version, checksum, dependencies):
    return {"checksum": checksum, "dependencies": dependencies, "name": name, "source": "registry", "version": version}

export fn graph_package_key(name, version):
    return name + "@" + version

export fn graph_find_resolved(resolved, name):
    for entry in resolved:
        if entry["name"] == name:
            return entry
    return none

export fn graph_find_registry(registry, name, version):
    for entry in registry:
        if entry["name"] == name and entry["version"] == version:
            return entry
    return none

export fn graph_error(errors, code, name, version, message):
    return append(errors, {"code": code, "message": message, "name": name, "version": version})

export fn graph_resolve_node(required, registry, visiting, resolved, errors):
    let name = required["name"]
    let version = required["version"]
    let checksum = required["checksum"]
    let key = graph_package_key(name, version)
    if contains(visiting, key):
        return {"errors": graph_error(errors, "ZAP-PKG-CYCLE-001", name, version, "dependency cycle detected at " + key), "resolved": resolved}
    let existing = graph_find_resolved(resolved, name)
    if existing != none:
        if existing["version"] != version:
            return {"errors": graph_error(errors, "ZAP-PKG-VERSION-001", name, version, "version conflict for '" + name + "': " + existing["version"] + " and " + version), "resolved": resolved}
        if existing["checksum"] != checksum:
            return {"errors": graph_error(errors, "ZAP-PKG-CHECKSUM-001", name, version, "checksum conflict for '" + name + "' version " + version), "resolved": resolved}
        return {"errors": errors, "resolved": resolved}
    let package = graph_find_registry(registry, name, version)
    if package == none:
        return {"errors": graph_error(errors, "ZAP-PKG-MISSING-001", name, version, "missing registry package '" + name + "' version " + version), "resolved": resolved}
    if package["checksum"] != checksum:
        return {"errors": graph_error(errors, "ZAP-PKG-CHECKSUM-001", name, version, "checksum mismatch for '" + name + "' version " + version), "resolved": resolved}
    let next_resolved = append(resolved, {"checksum": checksum, "name": name, "source": package["source"], "version": version})
    let next_visiting = append(visiting, key)
    let next_errors = errors
    for child in package["dependencies"]:
        let child_result = graph_resolve_node(child, registry, next_visiting, next_resolved, next_errors)
        next_resolved = child_result["resolved"]
        next_errors = child_result["errors"]
    return {"errors": next_errors, "resolved": next_resolved}

export fn graph_resolved_key(entry):
    return graph_package_key(entry["name"], entry["version"])

export fn graph_sort_resolved(resolved):
    let keys = []
    for entry in resolved:
        keys = append(keys, graph_resolved_key(entry))
    let sorted_keys = sort(keys)
    let result = []
    for key in sorted_keys:
        for entry in resolved:
            if graph_resolved_key(entry) == key:
                result = append(result, entry)
    return result

export fn resolve_dependency_graph(requirements, registry):
    let resolved = []
    let errors = []
    for required in requirements:
        let result = graph_resolve_node(required, registry, [], resolved, errors)
        resolved = result["resolved"]
        errors = result["errors"]
    let status = "resolved"
    if len(errors) > 0:
        status = "rejected"
    return {"errors": errors, "ok": len(errors) == 0, "resolved": graph_sort_resolved(resolved), "status": status}

export fn resolved_graph_lockfile(manifest_value, graph_result):
    return lockfile(manifest_value, graph_result["resolved"])

export fn lockfile(manifest_value, entries):
    return {"dependencies": entries, "manifest": manifest_value, "schema_version": 1}

export fn package_identity(entry):
    return entry["name"] + "@" + entry["version"] + ":" + entry["checksum"]

export fn offline_policy(manifest_value):
    return {"allow_network": false, "main": manifest_value["main"], "package": manifest_value["name"], "schema_version": 1}

export fn lock_is_reproducible(first, second):
    return first == second

export fn manifest_valid(manifest_value):
    return trim(manifest_value["name"]) != "" and trim(manifest_value["version"]) != "" and trim(manifest_value["main"]) != ""

export fn lock_entry_matches_dependency(entry, required):
    return entry["name"] == required["name"] and entry["version"] == required["version"] and entry["checksum"] == required["checksum"]

export fn dependency_names_unique(entries):
    let seen = ""
    for entry in entries:
        let marker = "|" + entry["name"] + "|"
        if contains(seen, marker):
            return false
        seen = seen + marker
    return true

export fn lock_entries_unique(entries):
    if not dependency_names_unique(entries):
        return false
    let seen = ""
    for entry in entries:
        let marker = "|" + package_identity(entry) + "|"
        if contains(seen, marker):
            return false
        seen = seen + marker
    return true

export fn lock_satisfies_manifest(manifest_value, entries):
    if not dependency_names_unique(manifest_value["dependencies"]):
        return false
    if not lock_entries_unique(entries):
        return false
    if len(manifest_value["dependencies"]) > len(entries):
        return false
    for required in manifest_value["dependencies"]:
        let found = false
        for entry in entries:
            if lock_entry_matches_dependency(entry, required):
                found = true
        if not found:
            return false
    return true

export fn package_offline_contract(manifest_value, entries):
    let policy = offline_policy(manifest_value)
    return {"allow_network": policy["allow_network"], "lock_matches": lock_satisfies_manifest(manifest_value, entries), "manifest_valid": manifest_valid(manifest_value)}
