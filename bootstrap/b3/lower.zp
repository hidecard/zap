
export fn lower_literal(node):
    let instructions = []
    return append(instructions, {"op": "const", "value": node["value"]})

export fn lower_expression(node):
    let kind = node["kind"]
    if kind == "literal":
        return {"error": none, "instructions": lower_literal(node)}
    if kind == "name":
        if contains(node["name"], "."):
            let pieces = split(node["name"], ".")
            if len(pieces) == 2:
                return {"error": none, "instructions": [{"field": trim(pieces[1]), "op": "field_load", "receiver": trim(pieces[0])}]}
        let instructions = []
        return {"error": none, "instructions": append(instructions, {"op": "load", "name": node["name"]})}
    if kind == "unary":
        let operand = lower_expression(node["value"])
        if operand["error"] != none:
            return operand
        if node["op"] == "not":
            return {"error": none, "instructions": append(operand["instructions"], {"op": "not"})}
        return {"error": "unsupported_unary_operator:" + node["op"], "instructions": []}
    if kind == "index":
        let target = lower_expression(node["target"])
        if target["error"] != none:
            return target
        let index = lower_expression(node["index"])
        if index["error"] != none:
            return index
        let instructions = target["instructions"]
        for instruction in index["instructions"]:
            instructions = append(instructions, instruction)
        return {"error": none, "instructions": append(instructions, {"op": "index"})}
    if kind == "member":
        let target = lower_expression(node["target"])
        if target["error"] != none:
            return target
        if node["target"]["kind"] == "name":
            return {"error": none, "instructions": [{"field": node["member"], "op": "field_load", "receiver": node["target"]["name"]}]}
        let instructions = target["instructions"]
        return {"error": none, "instructions": append(instructions, {"field": node["member"], "op": "field_load_value"})}
    if kind == "call":
        let instructions = []
        for argument in node["args"]:
            let lowered_argument = lower_expression(argument["value"])
            if lowered_argument["error"] != none:
                return lowered_argument
            for instruction in lowered_argument["instructions"]:
                instructions = append(instructions, instruction)
        if node["callee"]["kind"] == "member":
            let receiver = node["callee"]["target"]
            if receiver["kind"] == "call" and receiver["callee"]["kind"] == "name" and receiver["callee"]["name"] == "super":
                return {"error": none, "instructions": append(instructions, {"argc": len(node["args"]), "method": node["callee"]["member"], "op": "super_call"})}
            if receiver["kind"] != "name":
                return {"error": "unsupported_method_receiver", "instructions": []}
            return {"error": none, "instructions": append(instructions, {"argc": len(node["args"]), "method": node["callee"]["member"], "op": "method_call", "receiver": receiver["name"]})}
        if contains(node["callee"]["name"], "."):
            let pieces = split(node["callee"]["name"], ".")
            if len(pieces) == 2:
                return {"error": none, "instructions": append(instructions, {"argc": len(node["args"]), "method": trim(pieces[1]), "op": "method_call", "receiver": trim(pieces[0])})}
        let call_instruction = {"argc": len(node["args"]), "name": node["callee"]["name"], "op": "call"}
        return {"error": none, "instructions": append(instructions, call_instruction)}
    if kind == "binary" and (node["op"] == "and" or node["op"] == "or"):
        let left = lower_expression(node["left"])
        if left["error"] != none:
            return left
        let right = lower_expression(node["right"])
        if right["error"] != none:
            return right
        let instructions = left["instructions"]
        instructions = append(instructions, {"op": "dup"})
        let branch_index = len(instructions)
        if node["op"] == "and":
            instructions = append(instructions, {"op": "jump_if_false", "target": 0})
        else:
            instructions = append(instructions, {"op": "jump_if_true", "target": 0})
        instructions = append(instructions, {"op": "pop"})
        for instruction in right["instructions"]:
            instructions = append(instructions, instruction)
        instructions = patch_jump(instructions, branch_index, len(instructions))
        return {"error": none, "instructions": instructions}
    if kind == "binary":
        let left = lower_expression(node["left"])
        if left["error"] != none:
            return left
        let right = lower_expression(node["right"])
        if right["error"] != none:
            return right
        let instructions = left["instructions"]
        for instruction in right["instructions"]:
            instructions = append(instructions, instruction)
        let op = node["op"]
        if op == "add" or op == "subtract" or op == "multiply" or op == "divide" or op == "remainder" or op == "equal" or op == "not_equal" or op == "less" or op == "less_equal" or op == "greater" or op == "greater_equal" or op == "and" or op == "or":
            return {"error": none, "instructions": append(instructions, {"op": op})}
        return {"error": "unsupported_binary_operator:" + op, "instructions": []}
    return {"error": "unsupported_expression:" + kind, "instructions": []}

export fn lower_loop_body(body, loop_start):
    let instructions = []
    for node in body["statements"]:
        let lowering_node = node
        if node["kind"] == "continue":
            lowering_node = {"kind": "continue", "target": loop_start}
        let lowered = lower_node(lowering_node)
        if lowered["error"] != none:
            return lowered
        for instruction in lowered["instructions"]:
            instructions = append(instructions, instruction)
    return {"error": none, "instructions": instructions}

export fn patch_breaks(instructions, target):
    let patched = []
    for instruction in instructions:
        if instruction["op"] == "break_jump":
            patched = append(patched, {"op": "jump", "target": target})
        else:
            patched = append(patched, instruction)
    return patched

export fn lower_block(body):
    let instructions = []
    for node in body["statements"]:
        let lowering_node = node
        if node["kind"] == "while":
            lowering_node = {"body": node["body"], "condition": node["condition"], "kind": "while", "loop_start": len(instructions)}
        let lowered = lower_node(lowering_node)
        if lowered["error"] != none:
            return lowered
        for instruction in lowered["instructions"]:
            instructions = append(instructions, instruction)
    return {"error": none, "instructions": instructions}

export fn patch_jump(instructions, index, target):
    let patched = []
    let cursor = 0
    for instruction in instructions:
        if cursor == index:
            patched = append(patched, {"op": instruction["op"], "target": target})
        else:
            patched = append(patched, instruction)
        cursor = cursor + 1
    return patched

export fn patch_function(instructions, index, entry, end):
    let patched = []
    let cursor = 0
    for instruction in instructions:
        if cursor == index:
            let required = false
            if contains(json(instruction), "\"required\":true"):
                required = true
            patched = append(patched, {"binding": instruction["binding"], "captures": instruction["captures"], "end": end, "entry": entry, "name": instruction["name"], "op": "function_def", "owner": instruction["owner"], "params": instruction["params"], "required": required})
        else:
            patched = append(patched, instruction)
        cursor = cursor + 1
    return patched

export fn lower_class_parents(node):
    if contains(json(node), "\"parents\""):
        return node["parents"]
    if node["base"] == none:
        return []
    return [node["base"]]

export fn lower_class_traits(node):
    if contains(json(node), "\"traits\""):
        return node["traits"]
    return []

export fn lower_class_interfaces(node):
    if contains(json(node), "\"interfaces\""):
        return node["interfaces"]
    return []

export fn lower_class_trait_selections(node):
    if contains(json(node), "\"trait_selections\""):
        return node["trait_selections"]
    return []

export fn patch_class(instructions, index, end):
    let patched = []
    let cursor = 0
    for instruction in instructions:
        if cursor == index:
            let parents = lower_class_parents(instruction)
            let traits = lower_class_traits(instruction)
            let interfaces = lower_class_interfaces(instruction)
            let trait_selections = lower_class_trait_selections(instruction)
            patched = append(patched, {"base": instruction["base"], "end": end, "interfaces": interfaces, "name": instruction["name"], "op": "class_def", "parents": parents, "trait_selections": trait_selections, "traits": traits})
        else:
            patched = append(patched, instruction)
        cursor = cursor + 1
    return patched

export fn lower_parameter_names(params):
    let names = []
    for parameter in params:
        names = append(names, parameter["name"])
    return names

export fn lower_function_node_owned(node, prefix, owner):
    let definition_index = len(prefix)
    let entry = definition_index + 1
    let params = lower_parameter_names(node["params"])
    let required = false
    if contains(json(node), "\"required\":true"):
        required = true
    let with_definition = append(prefix, {"binding": none, "captures": [], "end": 0, "entry": entry, "name": node["name"], "op": "function_def", "owner": owner, "params": params, "required": required})
    let body = lower_ast_block_with_prefix(node["body"], with_definition)
    if body["error"] != none:
        return body
    let with_return = body["instructions"]
    with_return = append(with_return, {"op": "return_none"})
    let end = len(with_return)
    return {"error": none, "instructions": patch_function(with_return, definition_index, entry, end), "next": end}

export fn lower_function_node(node, prefix):
    return lower_function_node_owned(node, prefix, none)

export fn lower_class_body(body, prefix, owner):
    let instructions = prefix
    for node in body["statements"]:
        let lowered = none
        if node["kind"] == "function":
            lowered = lower_function_node_owned(node, instructions, owner)
        else:
            if node["kind"] == "trait_use":
                lowered = {"error": none, "instructions": instructions}
            else:
                lowered = lower_ast_node_with_prefix(node, instructions)
        if lowered["error"] != none:
            return lowered
        instructions = lowered["instructions"]
    return {"error": none, "instructions": instructions}

export fn patch_trait(instructions, index, end):
    let patched = []
    let cursor = 0
    for instruction in instructions:
        if cursor == index:
            patched = append(patched, {"end": end, "kind": instruction["kind"], "name": instruction["name"], "op": "trait_def"})
        else:
            patched = append(patched, instruction)
        cursor = cursor + 1
    return patched

export fn lower_trait_node(node, prefix):
    let trait_index = len(prefix)
    let with_trait = append(prefix, {"end": 0, "kind": node["kind"], "name": node["name"], "op": "trait_def"})
    let body = lower_class_body(node["body"], with_trait, node["name"])
    if body["error"] != none:
        return body
    let combined = body["instructions"]
    return {"error": none, "instructions": patch_trait(combined, trait_index, len(combined)), "next": len(combined)}

export fn lower_class_node(node, prefix):
    let class_index = len(prefix)
    let parents = lower_class_parents(node)
    let traits = lower_class_traits(node)
    let interfaces = lower_class_interfaces(node)
    let trait_selections = lower_class_trait_selections(node)
    let with_class = append(prefix, {"base": node["base"], "end": 0, "interfaces": interfaces, "name": node["name"], "op": "class_def", "parents": parents, "trait_selections": trait_selections, "traits": traits})
    let body = lower_class_body(node["body"], with_class, node["name"])
    if body["error"] != none:
        return body
    let combined = body["instructions"]
    return {"error": none, "instructions": patch_class(combined, class_index, len(combined)), "next": len(combined)}

export fn lower_node(node):
    let kind = node["kind"]
    if kind == "if":
        let condition = lower_expression(node["condition"])
        if condition["error"] != none:
            return condition
        let then_branch = lower_block(node["then_branch"])
        if then_branch["error"] != none:
            return then_branch
        let else_branch = {"error": none, "instructions": []}
        if node["else_branch"] != none:
            else_branch = lower_block(node["else_branch"])
            if else_branch["error"] != none:
                return else_branch
        let instructions = condition["instructions"]
        let false_jump_index = len(instructions)
        instructions = append(instructions, {"op": "jump_if_false", "target": 0})
        for instruction in then_branch["instructions"]:
            instructions = append(instructions, instruction)
        let end_jump_index = len(instructions)
        instructions = append(instructions, {"op": "jump", "target": 0})
        let else_start = len(instructions)
        for instruction in else_branch["instructions"]:
            instructions = append(instructions, instruction)
        let end_target = len(instructions)
        instructions = patch_jump(instructions, false_jump_index, else_start)
        instructions = patch_jump(instructions, end_jump_index, end_target)
        return {"error": none, "instructions": instructions}
    if kind == "while":
        let condition = lower_expression(node["condition"])
        if condition["error"] != none:
            return condition
        let body = lower_loop_body(node["body"], node["loop_start"])
        if body["error"] != none:
            return body
        let instructions = condition["instructions"]
        let false_jump_index = len(instructions)
        instructions = append(instructions, {"op": "jump_if_false", "target": 0})
        for instruction in body["instructions"]:
            instructions = append(instructions, instruction)
        instructions = append(instructions, {"op": "jump", "target": 0})
        let end_target = len(instructions)
        instructions = patch_jump(instructions, false_jump_index, node["loop_start"] + end_target)
        instructions = patch_jump(instructions, end_target - 1, node["loop_start"])
        instructions = patch_breaks(instructions, node["loop_start"] + end_target)
        return {"error": none, "instructions": instructions}
    if kind == "for":
        let iterable = lower_expression(node["iterable"])
        if iterable["error"] != none:
            return iterable
        let body = lower_loop_body(node["body"], node["loop_start"])
        if body["error"] != none:
            return body
        let instructions = iterable["instructions"]
        let loop_start = len(instructions)
        instructions = append(instructions, {"op": "dup"})
        let length_jump_index = len(instructions)
        instructions = append(instructions, {"op": "jump_if_false", "target": 0})
        let index_jump_index = len(instructions)
        instructions = append(instructions, {"op": "jump", "target": 0})
        let item_target = len(instructions)
        instructions = append(instructions, {"op": "index", "field": node["binding"]})
        instructions = append(instructions, {"op": "store", "name": node["binding"]})
        for instruction in body["instructions"]:
            instructions = append(instructions, instruction)
        let continue_target = len(instructions)
        instructions = append(instructions, {"op": "const", "value": 1})
        instructions = append(instructions, {"op": "add"})
        instructions = patch_jump(instructions, index_jump_index, item_target)
        instructions = patch_jump(instructions, length_jump_index, continue_target)
        instructions = patch_breaks(instructions, continue_target)
        return {"error": none, "instructions": instructions}
    if kind == "try_catch":
        let try_begin_index = len(instructions)
        let with_begin = append(instructions, {"op": "try_begin", "target": 0})
        let try_body = lower_block(node["body"])
        if try_body["error"] != none:
            return try_body
        let with_end = append(try_body["instructions"], {"op": "try_end"})
        let exit_jump_index = len(with_end)
        let with_exit_jump = append(with_end, {"op": "jump", "target": 0})
        let catch_binding = none
        if contains(json(node), "\"catch_binding\""):
            catch_binding = node["catch_binding"]
        let catch_locals = []
        if catch_binding != none:
            catch_locals = [{"name": catch_binding, "value": none}]
        let catch_body = lower_block_with_prefix(node["catch_body"], catch_locals)
        if catch_body["error"] != none:
            return catch_body
        let catch_target = exit_jump_index + 1
        let patched_begin = patch_jump(with_exit_jump, try_begin_index, catch_target)
        let patched_exit = patch_jump(patched_begin, exit_jump_index, catch_target + len(catch_body["instructions"]))
        return {"error": none, "instructions": patched_exit}
    if kind == "break":
        let instructions = []
        return {"error": none, "instructions": append(instructions, {"op": "break_jump"})}
    if kind == "continue":
        let instructions = []
        return {"error": none, "instructions": append(instructions, {"op": "jump", "target": node["target"]})}
    if kind == "declaration" or kind == "assignment":
        let lowered_value = lower_expression(node["value"])
        if lowered_value["error"] != none:
            return lowered_value
        return {"error": none, "instructions": append(lowered_value["instructions"], {"op": "store", "name": node["name"]})}
    if kind == "say" or kind == "return" or kind == "raise" or kind == "expression":
        let payload = node["payload"]
        if kind == "return" and payload == none:
            return {"error": none, "instructions": [{"op": "return_none"}]}
        if payload == none:
            return {"error": "missing_payload:" + kind, "instructions": []}
        let lowered = lower_expression(payload)
        if lowered["error"] != none:
            return lowered
        if kind == "say":
            return {"error": none, "instructions": append(lowered["instructions"], {"op": "print"})}
        if kind == "return":
            return {"error": none, "instructions": append(lowered["instructions"], {"op": "return_value"})}
        if kind == "raise":
            return {"error": none, "instructions": append(lowered["instructions"], {"op": "raise"})}
        return lowered
    return {"error": "unsupported_statement:" + kind, "instructions": []}

export fn lower_ast_block_with_prefix(body, prefix):
    let instructions = prefix
    for node in body["statements"]:
        let lowered = lower_ast_node_with_prefix(node, instructions)
        if lowered["error"] != none:
            return lowered
        instructions = lowered["instructions"]
    return {"error": none, "instructions": instructions}

export fn lower_ast_block(body):
    return lower_ast_block_with_prefix(body, [])

export fn lower_ast_node_with_prefix(node, prefix):
    let kind = node["kind"]
    if kind == "function":
        return lower_function_node(node, prefix)
    if kind == "class":
        return lower_class_node(node, prefix)
    if kind == "trait" or kind == "interface":
        return lower_trait_node(node, prefix)
    let lowered = lower_ast_node(node)
    if lowered["error"] != none:
        return lowered
    let combined = prefix
    for instruction in lowered["instructions"]:
        combined = append(combined, instruction)
    return {"error": none, "instructions": combined}

export fn lower_ast_node(node):
    let kind = node["kind"]
    if kind == "function":
        return lower_function_node(node, [])
    if kind == "class":
        return lower_class_node(node, [])
    if kind == "trait" or kind == "interface":
        return lower_trait_node(node, [])
    if kind == "if":
        let condition = lower_expression(node["condition"])
        if condition["error"] != none:
            return condition
        let then_branch = lower_ast_block(node["then_branch"])
        if then_branch["error"] != none:
            return then_branch
        let else_branch = {"error": none, "instructions": []}
        if node["else_branch"] != none:
            else_branch = lower_ast_block(node["else_branch"])
            if else_branch["error"] != none:
                return else_branch
        let instructions = condition["instructions"]
        let false_jump_index = len(instructions)
        instructions = append(instructions, {"op": "jump_if_false", "target": 0})
        for instruction in then_branch["instructions"]:
            instructions = append(instructions, instruction)
        let end_jump_index = len(instructions)
        instructions = append(instructions, {"op": "jump", "target": 0})
        let else_start = len(instructions)
        for instruction in else_branch["instructions"]:
            instructions = append(instructions, instruction)
        let end_target = len(instructions)
        instructions = patch_jump(instructions, false_jump_index, else_start)
        instructions = patch_jump(instructions, end_jump_index, end_target)
        return {"error": none, "instructions": instructions}
    if kind == "while":
        let condition = lower_expression(node["condition"])
        if condition["error"] != none:
            return condition
        let body = lower_ast_block(node["body"])
        if body["error"] != none:
            return body
        let instructions = condition["instructions"]
        let false_jump_index = len(instructions)
        instructions = append(instructions, {"op": "jump_if_false", "target": 0})
        for instruction in body["instructions"]:
            instructions = append(instructions, instruction)
        instructions = append(instructions, {"op": "jump", "target": 0})
        let end_target = len(instructions)
        instructions = patch_jump(instructions, false_jump_index, end_target)
        instructions = patch_jump(instructions, end_target - 1, 0)
        return {"error": none, "instructions": instructions}
    if kind == "declaration" or kind == "assignment":
        let lowered_value = lower_expression(node["value"])
        if lowered_value["error"] != none:
            return lowered_value
        if kind == "assignment" and contains(node["name"], "."):
            let pieces = split(node["name"], ".")
            if len(pieces) == 2:
                return {"error": none, "instructions": append(lowered_value["instructions"], {"field": trim(pieces[1]), "op": "field_store", "receiver": trim(pieces[0])})}
            if len(pieces) > 2:
                return {"error": none, "instructions": append(lowered_value["instructions"], {"op": "field_store_path", "path": pieces})}
        return {"error": none, "instructions": append(lowered_value["instructions"], {"op": "store", "name": node["name"]})}
    if kind == "say" or kind == "return" or kind == "raise" or kind == "expression":
        if kind == "return" and node["value"] == none:
            return {"error": none, "instructions": [{"op": "return_none"}]}
        let lowered = lower_expression(node["value"])
        if lowered["error"] != none:
            return lowered
        if kind == "expression":
            return {"error": none, "instructions": append(lowered["instructions"], {"op": "pop"})}
        if kind == "say":
            return {"error": none, "instructions": append(lowered["instructions"], {"op": "print"})}
        if kind == "return":
            return {"error": none, "instructions": append(lowered["instructions"], {"op": "return_value"})}
        return {"error": none, "instructions": append(lowered["instructions"], {"op": "raise"})}
    return {"error": "unsupported_ast_statement:" + kind, "instructions": []}

export fn lower_ast_program(ast):
    if ast["kind"] != "zap.ast":
        return {"error": "invalid_ast_kind", "instructions": []}
    let lowered = lower_ast_block({"statements": ast["ast"]["statements"]})
    if lowered["error"] != none:
        return {"error": lowered["error"], "instructions": []}
    return {"error": none, "instructions": append(lowered["instructions"], {"op": "halt"}), "kind": "zap.bytecode", "schema_version": 1}

export fn lower_typed_ir(ir):
    if ir["kind"] != "zap.typed_ir":
        return {"error": "invalid_typed_ir_kind", "instructions": []}
    let instructions = []
    for node in ir["ir"]["nodes"]:
        let lowering_node = node
        if node["kind"] == "while":
            lowering_node = {"body": node["body"], "condition": node["condition"], "kind": "while", "loop_start": len(instructions)}
        let lowered = lower_node(lowering_node)
        if lowered["error"] != none:
            return {"error": lowered["error"], "instructions": []}
        for instruction in lowered["instructions"]:
            instructions = append(instructions, instruction)
    let final_instructions = append(instructions, {"op": "halt"})
    return {"error": none, "instructions": final_instructions, "kind": "zap.bytecode", "schema_version": 1}
