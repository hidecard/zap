# B3 candidate build planner. Native Rust remains the reference owner until B4.

export fn build_plan(package_manifest, lockfile_value, target, seed_version):
    return {"artifacts": ["typed_ir", "bytecode", "runtime"], "lock_schema": lockfile_value["schema_version"], "package": package_manifest["name"], "seed_version": seed_version, "target": target}

export fn artifact_descriptor(plan, kind, digest):
    return {"digest": digest, "kind": kind, "package": plan["package"], "target": plan["target"]}

export fn build_manifest(plan, artifacts):
    return {"artifacts": artifacts, "lock_schema": plan["lock_schema"], "package": plan["package"], "seed_version": plan["seed_version"], "target": plan["target"]}

export fn build_is_reproducible(first, second):
    return first == second

export fn build_manifest_bytes(plan, artifacts):
    return json(build_manifest(plan, artifacts))

export fn build_bytes_reproducible(plan, first_artifacts, second_artifacts):
    return build_manifest_bytes(plan, first_artifacts) == build_manifest_bytes(plan, second_artifacts)

export fn build_artifact_valid(plan, artifact):
    return trim(artifact["digest"]) != "" and artifact["package"] == plan["package"] and artifact["target"] == plan["target"]

export fn build_artifacts_valid(plan, artifacts):
    if len(artifacts) != len(plan["artifacts"]):
        return false
    let index = 0
    while index < len(artifacts):
        if not build_artifact_valid(plan, artifacts[index]):
            return false
        let other = index + 1
        while other < len(artifacts):
            if artifacts[index]["kind"] == artifacts[other]["kind"]:
                return false
            other = other + 1
        index = index + 1
    for expected_kind in plan["artifacts"]:
        let found = false
        for artifact in artifacts:
            if artifact["kind"] == expected_kind and build_artifact_valid(plan, artifact):
                found = true
        if not found:
            return false
    return true

export fn build_network_policy():
    return {"allow_network": false, "require_lock": true, "require_seed": true}
