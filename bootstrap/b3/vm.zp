
export fn vm_state_with(error, halted, handlers, ip, locals, output, stack, frames, functions):
    return {"error": error, "halted": halted, "handlers": handlers, "ip": ip, "locals": locals, "output": output, "stack": stack, "frames": frames, "functions": functions}

export fn vm_state():
    return vm_state_with(none, false, [], 0, [], [], [], [], [])

export fn vm_handlers_without_last(handlers):
    let remaining = []
    let index = 0
    while index < len(handlers):
        if index < len(handlers) - 1:
            remaining = append(remaining, handlers[index])
        index = index + 1
    return remaining

export fn vm_array_without_last(values):
    let remaining = []
    let index = 0
    while index < len(values):
        if index < len(values) - 1:
            remaining = append(remaining, values[index])
        index = index + 1
    return remaining

export fn vm_push(state, value):
    return vm_state_with(state["error"], state["halted"], state["handlers"], state["ip"], state["locals"], state["output"], append(state["stack"], value), state["frames"], state["functions"])

export fn vm_store(state, name, value):
    return vm_state_with(state["error"], state["halted"], state["handlers"], state["ip"], append(state["locals"], {"name": name, "value": value}), state["output"], state["stack"], state["frames"], state["functions"])

export fn vm_load(state, name):
    let found = none
    for item in state["locals"]:
        if item["name"] == name:
            found = item["value"]
    if found == none:
        return {"error": "unknown_local:" + name, "value": none, "state": state}
    return {"error": none, "value": found, "state": state}

export fn vm_stack_without_last(stack):
    return vm_array_without_last(stack)

export fn vm_pop(state):
    let stack = state["stack"]
    if len(stack) == 0:
        return {"error": "stack_underflow", "value": none, "state": state}
    let index = len(stack) - 1
    let next = vm_state_with(state["error"], state["halted"], state["handlers"], state["ip"], state["locals"], state["output"], vm_stack_without_last(stack), state["frames"], state["functions"])
    return {"error": none, "value": stack[index], "state": next}

export fn vm_fail(state, message):
    return vm_state_with(message, true, state["handlers"], state["ip"], state["locals"], state["output"], state["stack"], state["frames"], state["functions"])

export fn vm_reverse(values, index, result):
    if index < 0:
        return result
    return vm_reverse(values, index - 1, append(result, values[index]))

export fn vm_pop_arguments(state, remaining, values):
    if remaining == 0:
        return {"error": none, "state": state, "values": vm_reverse(values, len(values) - 1, [])}
    let popped = vm_pop(state)
    if popped["error"] != none:
        return {"error": popped["error"], "state": state, "values": []}
    return vm_pop_arguments(popped["state"], remaining - 1, append(values, popped["value"]))

export fn vm_bind_arguments(state, params, values, index):
    if index >= len(params):
        return state
    let bound = vm_store(state, params[index], values[index])
    return vm_bind_arguments(bound, params, values, index + 1)

export fn vm_find_function(functions, name, index):
    if index >= len(functions):
        return none
    if functions[index]["name"] == name:
        return functions[index]
    return vm_find_function(functions, name, index + 1)

export fn vm_collect_functions(program, index, result):
    if index >= len(program):
        return result
    let instruction = program[index]
    if instruction["op"] == "function_def":
        result = append(result, instruction)
    return vm_collect_functions(program, index + 1, result)

export fn vm_raise_value(state, value):
    if len(state["handlers"]) > 0:
        let handlers = state["handlers"]
        let handler = handlers[len(handlers) - 1]
        let bound_state = vm_state_with(none, false, vm_handlers_without_last(handlers), handler["target"], state["locals"], state["output"], state["stack"], state["frames"], state["functions"])
        if handler["binding"] != none:
            bound_state = vm_store(bound_state, handler["binding"], value)
        return bound_state
    if len(state["frames"]) > 0:
        let frame = state["frames"][len(state["frames"]) - 1]
        let restored = vm_state_with(none, false, frame["handlers"], frame["return_ip"], frame["locals"], state["output"], frame["stack"], vm_array_without_last(state["frames"]), state["functions"])
        return vm_raise_value(restored, value)
    return vm_fail(state, "raised")

export fn vm_return_value(state, value):
    if len(state["frames"]) == 0:
        return vm_fail(state, "return_without_frame")
    let frame = state["frames"][len(state["frames"]) - 1]
    return vm_state_with(none, false, frame["handlers"], frame["return_ip"], frame["locals"], state["output"], append(frame["stack"], value), vm_array_without_last(state["frames"]), state["functions"])

export fn vm_step(state, instruction):
    let op = instruction["op"]
    let advanced = vm_state_with(state["error"], state["halted"], state["handlers"], state["ip"] + 1, state["locals"], state["output"], state["stack"], state["frames"], state["functions"])
    if op == "function_def":
        return vm_state_with(none, false, advanced["handlers"], instruction["end"], advanced["locals"], advanced["output"], advanced["stack"], advanced["frames"], advanced["functions"])
    if op == "jump":
        return vm_state_with(none, false, advanced["handlers"], instruction["target"], advanced["locals"], advanced["output"], advanced["stack"], advanced["frames"], advanced["functions"])
    if op == "jump_if_true":
        let condition = vm_pop(advanced)
        if condition["error"] != none:
            return vm_fail(advanced, condition["error"])
        if condition["value"]:
            return vm_state_with(none, false, condition["state"]["handlers"], instruction["target"], condition["state"]["locals"], condition["state"]["output"], condition["state"]["stack"], condition["state"]["frames"], condition["state"]["functions"])
        return condition["state"]
    if op == "jump_if_false":
        let condition = vm_pop(advanced)
        if condition["error"] != none:
            return vm_fail(advanced, condition["error"])
        if not condition["value"]:
            return vm_state_with(none, false, condition["state"]["handlers"], instruction["target"], condition["state"]["locals"], condition["state"]["output"], condition["state"]["stack"], condition["state"]["frames"], condition["state"]["functions"])
        return condition["state"]
    if op == "try_begin":
        let handler = {"binding": instruction["binding"], "target": instruction["target"]}
        return vm_state_with(none, false, append(advanced["handlers"], handler), advanced["ip"], advanced["locals"], advanced["output"], advanced["stack"], advanced["frames"], advanced["functions"])
    if op == "try_end":
        return vm_state_with(none, false, vm_handlers_without_last(advanced["handlers"]), advanced["ip"], advanced["locals"], advanced["output"], advanced["stack"], advanced["frames"], advanced["functions"])
    if op == "raise":
        let raised = vm_pop(advanced)
        if raised["error"] != none:
            return vm_fail(advanced, raised["error"])
        return vm_raise_value(raised["state"], raised["value"])
    if op == "return_value":
        let returned = vm_pop(advanced)
        if returned["error"] != none:
            return vm_fail(advanced, returned["error"])
        return vm_return_value(returned["state"], returned["value"])
    if op == "return_none":
        return vm_return_value(advanced, none)
    if op == "dup":
        let top = vm_pop(advanced)
        if top["error"] != none:
            return vm_fail(advanced, top["error"])
        let restored = vm_push(top["state"], top["value"])
        return vm_push(restored, top["value"])
    if op == "pop":
        let discarded = vm_pop(advanced)
        if discarded["error"] != none:
            return vm_fail(advanced, discarded["error"])
        return discarded["state"]
    if op == "load":
        let loaded = vm_load(advanced, instruction["name"])
        if loaded["error"] != none:
            return vm_fail(advanced, loaded["error"])
        return vm_push(loaded["state"], loaded["value"])
    if op == "store":
        let stored = vm_pop(advanced)
        if stored["error"] != none:
            return vm_fail(advanced, stored["error"])
        return vm_store(stored["state"], instruction["name"], stored["value"])
    if op == "const":
        return vm_push(advanced, instruction["value"])
    if op == "not":
        let operand = vm_pop(advanced)
        if operand["error"] != none:
            return vm_fail(advanced, operand["error"])
        return vm_push(operand["state"], not operand["value"])
    if op == "call":
        let arguments = vm_pop_arguments(advanced, instruction["argc"], [])
        if arguments["error"] != none:
            return vm_fail(advanced, arguments["error"])
        let name = instruction["name"]
        if name == "identity" and instruction["argc"] == 1:
            return vm_push(arguments["state"], arguments["values"][0])
        if name == "abs" and instruction["argc"] == 1:
            let value = arguments["values"][0]
            if value < 0:
                value = 0 - value
            return vm_push(arguments["state"], value)
        let definition = vm_find_function(advanced["functions"], name, 0)
        if definition == none:
            return vm_fail(advanced, "unknown_call:" + name)
        if len(definition["params"]) != instruction["argc"]:
            return vm_fail(advanced, "arity_error:" + name)
        let frame = {"function": name, "handlers": arguments["state"]["handlers"], "locals": arguments["state"]["locals"], "return_ip": arguments["state"]["ip"], "stack": arguments["state"]["stack"]}
        let callee = vm_state_with(none, false, [], definition["entry"], [], arguments["state"]["output"], [], append(arguments["state"]["frames"], frame), arguments["state"]["functions"])
        return vm_bind_arguments(callee, definition["params"], arguments["values"], 0)
    if op == "add" or op == "subtract" or op == "multiply" or op == "divide" or op == "remainder" or op == "equal" or op == "not_equal" or op == "less" or op == "less_equal" or op == "greater" or op == "greater_equal" or op == "and" or op == "or":
        let right = vm_pop(advanced)
        if right["error"] != none:
            return vm_fail(advanced, right["error"])
        let left = vm_pop(right["state"])
        if left["error"] != none:
            return vm_fail(advanced, left["error"])
        let value = none
        if op == "add":
            value = left["value"] + right["value"]
        if op == "subtract":
            value = left["value"] - right["value"]
        if op == "multiply":
            value = left["value"] * right["value"]
        if op == "divide":
            value = left["value"] / right["value"]
        if op == "remainder":
            value = left["value"] % right["value"]
        if op == "equal":
            value = left["value"] == right["value"]
        if op == "not_equal":
            value = left["value"] != right["value"]
        if op == "less":
            value = left["value"] < right["value"]
        if op == "less_equal":
            value = left["value"] <= right["value"]
        if op == "greater":
            value = left["value"] > right["value"]
        if op == "greater_equal":
            value = left["value"] >= right["value"]
        if op == "and":
            value = left["value"] and right["value"]
        if op == "or":
            value = left["value"] or right["value"]
        return vm_push(left["state"], value)
    if op == "print":
        let item = vm_pop(advanced)
        if item["error"] != none:
            return vm_fail(advanced, item["error"])
        return vm_state_with(none, false, item["state"]["handlers"], item["state"]["ip"], item["state"]["locals"], append(item["state"]["output"], item["value"]), item["state"]["stack"], item["state"]["frames"], item["state"]["functions"])
    if op == "halt":
        return vm_state_with(none, true, advanced["handlers"], advanced["ip"], advanced["locals"], advanced["output"], advanced["stack"], advanced["frames"], advanced["functions"])
    return vm_fail(advanced, "unknown_opcode:" + op)

export fn vm_run(program):
    let functions = vm_collect_functions(program, 0, [])
    let state = vm_state_with(none, false, [], 0, [], [], [], [], functions)
    while state["ip"] < len(program):
        if state["halted"]:
            break
        state = vm_step(state, program[state["ip"]])
    return state
