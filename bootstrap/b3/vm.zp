# B3 candidate VM layer. Native evaluator remains the reference owner until B4.

export fn vm_state():
    return {"error": none, "halted": false, "ip": 0, "output": [], "stack": []}

export fn vm_push(state, value):
    return {"halted": state["halted"], "ip": state["ip"], "output": state["output"], "stack": append(state["stack"], value)}

export fn vm_stack_without_last(stack):
    let remaining = []
    let index = 0
    while index < len(stack):
        if index < len(stack) - 1:
            remaining = append(remaining, stack[index])
        index = index + 1
    return remaining

export fn vm_pop(state):
    let stack = state["stack"]
    if len(stack) == 0:
        return {"error": "stack_underflow", "value": none, "state": state}
    let index = len(stack) - 1
    let remaining = vm_stack_without_last(stack)
    return {"error": none, "value": stack[index], "state": {"halted": state["halted"], "ip": state["ip"], "output": state["output"], "stack": remaining}}

export fn vm_step(state, instruction):
    let op = instruction["op"]
    let advanced = {"halted": state["halted"], "ip": state["ip"] + 1, "output": state["output"], "stack": state["stack"]}
    if op == "const":
        return vm_push(advanced, instruction["value"])
    if op == "add" or op == "subtract" or op == "multiply" or op == "divide":
        let right = vm_pop(advanced)
        if right["error"] != none:
            return {"error": right["error"], "halted": true, "ip": advanced["ip"], "output": advanced["output"], "stack": advanced["stack"]}
        let left = vm_pop(right["state"])
        if left["error"] != none:
            return {"error": left["error"], "halted": true, "ip": advanced["ip"], "output": advanced["output"], "stack": advanced["stack"]}
        let value = left["value"] + right["value"]
        if op == "subtract":
            value = left["value"] - right["value"]
        if op == "multiply":
            value = left["value"] * right["value"]
        if op == "divide":
            value = left["value"] / right["value"]
        return vm_push(left["state"], value)
    if op == "print":
        let item = vm_pop(advanced)
        if item["error"] != none:
            return {"error": item["error"], "halted": true, "ip": advanced["ip"], "output": advanced["output"], "stack": advanced["stack"]}
        return {"error": none, "halted": item["state"]["halted"], "ip": item["state"]["ip"], "output": append(item["state"]["output"], item["value"]), "stack": item["state"]["stack"]}
    if op == "halt":
        return {"error": none, "halted": true, "ip": advanced["ip"], "output": advanced["output"], "stack": advanced["stack"]}
    return advanced

export fn vm_run(program):
    let state = vm_state()
    for instruction in program:
        if not state["halted"]:
            state = vm_step(state, instruction)
    return state
