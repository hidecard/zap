# Native-independent seed pipeline description.
# The current repository validates the deterministic stage contract;
# an actual Zap compiler binary is required before full self-hosting.

export fn seed_stage(name, input_kind, output_kind):
    return {"input_kind": input_kind, "name": name, "output_kind": output_kind, "owner": "zap"}

export fn seed_pipeline_stages():
    let stages = []
    stages = append(stages, seed_stage("lexer", "source", "tokens"))
    stages = append(stages, seed_stage("parser", "tokens", "ast"))
    stages = append(stages, seed_stage("typecheck", "ast", "typed_ast"))
    stages = append(stages, seed_stage("typed_ir", "typed_ast", "typed_ir"))
    stages = append(stages, seed_stage("bytecode", "typed_ir", "bytecode"))
    stages = append(stages, seed_stage("vm", "bytecode", "execution"))
    return stages

export fn seed_pipeline_plan(seed):
    return {"compiler_stage": "B4", "network": false, "seed": seed, "stages": seed_pipeline_stages(), "version": 1}

export fn seed_execute_stage(stage, input_kind, input_digest, output_digest):
    if stage["owner"] != "zap":
        return {"error": "native_owner", "status": "rejected"}
    if stage["input_kind"] != input_kind:
        return {"error": "input_kind_mismatch", "status": "rejected"}
    return {"input_digest": input_digest, "native_owner": false, "output_digest": output_digest, "output_kind": stage["output_kind"], "stage": stage["name"], "status": "executed"}

export fn seed_pipeline_execute(seed, source_digest, stage_digests):
    let plan = seed_pipeline_plan(seed)
    if len(stage_digests) != len(plan["stages"]):
        return {"error": "digest_count_mismatch", "status": "rejected"}
    let executions = []
    let current_kind = "source"
    let current_digest = source_digest
    let index = 0
    for stage in plan["stages"]:
        let execution = seed_execute_stage(stage, current_kind, current_digest, stage_digests[index])
        if execution["status"] != "executed":
            return {"error": execution["error"], "status": "rejected"}
        executions = append(executions, execution)
        current_kind = stage["output_kind"]
        current_digest = stage_digests[index]
        index = index + 1
    return {"executions": executions, "final_digest": current_digest, "final_kind": current_kind, "status": "executed"}

export fn seed_pipeline_artifacts(plan, stage_digests):
    let artifacts = []
    let index = 0
    for stage in plan["stages"]:
        artifacts = append(artifacts, {"artifact_kind": stage["output_kind"], "bytes": stage["name"] + ":artifact", "compiler_stage": plan["compiler_stage"], "digest": stage_digests[index], "stage": stage["name"], "version": plan["version"]})
        index = index + 1
    return artifacts

export fn seed_pipeline_manifest(seed, source_digest, stage_digests):
    let plan = seed_pipeline_plan(seed)
    let execution = seed_pipeline_execute(seed, source_digest, stage_digests)
    let artifacts = seed_pipeline_artifacts(plan, stage_digests)
    return {"artifacts": artifacts, "execution": execution, "native_independent": false, "seed": seed, "status": "contract_only"}

export fn seed_platform_record(target, artifact_bytes, artifact_digest, execution_status):
    return {"artifact_bytes": artifact_bytes, "artifact_digest": artifact_digest, "execution_status": execution_status, "target": target}

export fn seed_platform_target_seen(records, target):
    for record in records:
        if record["target"] == target:
            return true
    return false

export fn seed_platform_target_count(records, target):
    let count = 0
    for record in records:
        if record["target"] == target:
            count = count + 1
    return count

export fn seed_platform_expected_count(targets, target):
    let count = 0
    for value in targets:
        if value == target:
            count = count + 1
    return count

export fn seed_platform_matrix_valid(records, expected_targets):
    if len(records) != len(expected_targets) or len(records) == 0:
        return false
    let first = records[0]
    if first["execution_status"] != "executed" or trim(first["artifact_bytes"]) == "" or trim(first["artifact_digest"]) == "":
        return false
    for target in expected_targets:
        if not seed_platform_target_seen(records, target) or seed_platform_expected_count(expected_targets, target) != 1:
            return false
    let index = 0
    for record in records:
        if seed_platform_target_count(records, record["target"]) != 1:
            return false
        if record["execution_status"] != "executed" or trim(record["artifact_bytes"]) == "" or trim(record["artifact_digest"]) == "":
            return false
        if index > 0 and (record["artifact_bytes"] != first["artifact_bytes"] or record["artifact_digest"] != first["artifact_digest"]):
            return false
        index = index + 1
    return true

export fn seed_platform_acceptance(seed, records, expected_targets):
    return {"artifact_equal": seed_platform_matrix_valid(records, expected_targets), "native_independent": false, "seed": seed, "status": "contract_only", "targets": len(records)}

export fn seed_platform_record_evidence(target, artifact_bytes, artifact_digest, execution_status, source_digest, toolchain_digest, environment, execution_mode):
    return {"artifact_bytes": artifact_bytes, "artifact_digest": artifact_digest, "execution_mode": execution_mode, "execution_status": execution_status, "environment": environment, "source_digest": source_digest, "target": target, "toolchain_digest": toolchain_digest}

export fn seed_platform_evidence_record_valid(record):
    if not contains(json(record), "\"source_digest\""):
        return false
    if not contains(json(record), "\"toolchain_digest\""):
        return false
    if not contains(json(record), "\"environment\""):
        return false
    if not contains(json(record), "\"execution_mode\""):
        return false
    if record["execution_status"] != "executed":
        return false
    if record["environment"] != "clean":
        return false
    if record["execution_mode"] != "bootstrap-artifact":
        return false
    if trim(record["artifact_bytes"]) == "" or trim(record["artifact_digest"]) == "":
        return false
    if trim(record["source_digest"]) == "" or trim(record["toolchain_digest"]) == "":
        return false
    return true

export fn seed_platform_evidence_matrix_valid(records, expected_targets):
    if not seed_platform_matrix_valid(records, expected_targets):
        return false
    for record in records:
        if not seed_platform_evidence_record_valid(record):
            return false
    return true

export fn seed_self_rebuild_evidence(first_artifact, second_artifact, platform_records, expected_targets):
    let byte_equal = first_artifact == second_artifact
    let platform_evidence = seed_platform_evidence_matrix_valid(platform_records, expected_targets)
    let status = "candidate_self_rebuild_evidence"
    if not byte_equal or not platform_evidence:
        status = "candidate_self_rebuild_blocked"
    return {"byte_equal": byte_equal, "native_independent": false, "platform_evidence": platform_evidence, "status": status, "supported": byte_equal and platform_evidence}
