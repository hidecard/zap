# B4 executable seed compiler slice.
#
# This module intentionally keeps the native_independent flag false: the code is
# Zap-owned and executable through the bootstrap VM, but full self-hosting still
# requires the compiler to rebuild itself from Zap source.

import "bootstrap/b1/parser.zp"
import "bootstrap/b2/typed_ir.zp"
import "bootstrap/b3/lower.zp"
import "bootstrap/b4/ast_control.zp"
import "bootstrap/b3/vm.zp"
import "bootstrap/b3/package.zp"

export fn seed_is_digit(character):
    return contains("0123456789", character)

export fn seed_is_number(value):
    let text = trim(value)
    if text == "":
        return false
    let index = 0
    if substring(text, 0, 1) == "-":
        index = 1
    if index >= len(text):
        return false
    let digits = 0
    let dots = 0
    while index < len(text):
        let character = substring(text, index, index + 1)
        if character == ".":
            dots = dots + 1
            if dots > 1:
                return false
        else:
            if not seed_is_digit(character):
                return false
            digits = digits + 1
        index = index + 1
    return digits > 0

export fn seed_number(value):
    return from_json(trim(value))

export fn seed_string_literal(value):
    return substring(value, 1, len(value) - 1)

export fn seed_append_all(left, right):
    let result = left
    for instruction in right:
        result = append(result, instruction)
    return result

export fn seed_find_open_paren(value, index):
    if index >= len(value):
        return -1
    if substring(value, index, index + 1) == "(":
        return index
    return seed_find_open_paren(value, index + 1)

export fn seed_parse_parameters(parameter_text):
    let result = []
    let value = trim(parameter_text)
    if value == "":
        return result
    for item in split(value, ","):
        let name = trim(item)
        if contains(name, ":"):
            name = trim(split(name, ":")[0])
        result = append(result, name)
    return result

export fn seed_merge_names(left, right, index, result):
    if index >= len(left):
        if len(right) == 0:
            return result
        return seed_merge_names(right, [], len(right), append(result, right[0]))
    let next = result
    let found = false
    for item in next:
        if item == left[index]:
            found = true
    if not found:
        next = append(next, left[index])
    return seed_merge_names(left, right, index + 1, next)

export fn seed_merge_name_lists(left, right):
    let result = []
    for item in left:
        let found = false
        for existing in result:
            if existing == item:
                found = true
        if not found:
            result = append(result, item)
    for item in right:
        let found = false
        for existing in result:
            if existing == item:
                found = true
        if not found:
            result = append(result, item)
    return result

export fn seed_find_top_level_operator(value, operator, index, depth):
    if index >= len(value):
        return -1
    let current = substring(value, index, index + 1)
    if current == "(":
        return seed_find_top_level_operator(value, operator, index + 1, depth + 1)
    if current == ")":
        return seed_find_top_level_operator(value, operator, index + 1, depth - 1)
    if depth == 0 and starts_with(substring(value, index, index + len(operator)), operator):
        return index
    return seed_find_top_level_operator(value, operator, index + 1, depth)

export fn seed_expression(source, locals):
    let value = trim(source)
    if value == "":
        return {"error": "empty_expression", "instructions": []}
    if starts_with(value, "identity(") and ends_with(value, ")"):
        let inner = substring(value, 9, len(value) - 1)
        let lowered = seed_expression(inner, locals)
        if lowered["error"] != none:
            return lowered
        return {"error": none, "instructions": append(lowered["instructions"], {"argc": 1, "name": "identity", "op": "call"})}
    if starts_with(value, "abs(") and ends_with(value, ")"):
        let inner = substring(value, 4, len(value) - 1)
        let lowered = seed_expression(inner, locals)
        if lowered["error"] != none:
            return lowered
        return {"error": none, "instructions": append(lowered["instructions"], {"argc": 1, "name": "abs", "op": "call"})}
    if starts_with(value, "super().") and ends_with(value, ")"):
        let call_text = substring(value, 8, len(value))
        let open_index = seed_find_open_paren(call_text, 0)
        if open_index <= 0:
            return {"error": "invalid_super_call", "instructions": []}
        let method = trim(substring(call_text, 0, open_index))
        let argument_text = trim(substring(call_text, open_index + 1, len(call_text) - 1))
        let instructions = []
        let argc = 0
        if argument_text != "":
            for argument in split(argument_text, ","):
                let lowered_argument = seed_expression(argument, locals)
                if lowered_argument["error"] != none:
                    return lowered_argument
                instructions = seed_append_all(instructions, lowered_argument["instructions"])
                argc = argc + 1
        return {"error": none, "instructions": append(instructions, {"argc": argc, "method": method, "op": "super_call"})}
    if starts_with(value, "not "):
        let inner = substring(value, 4, len(value))
        let lowered = seed_expression(inner, locals)
        if lowered["error"] != none:
            return lowered
        return {"error": none, "instructions": append(lowered["instructions"], {"op": "not"})}
    let operators = [" or ", " and ", " == ", " != ", " <= ", " >= ", " < ", " > ", " + ", " - ", " * ", " / ", " % "]
    let op_names = ["or", "and", "equal", "not_equal", "less_equal", "greater_equal", "less", "greater", "add", "subtract", "multiply", "divide", "remainder"]
    let operator_index = 0
    for operator in operators:
        let operator_position = seed_find_top_level_operator(value, operator, 0, 0)
        if operator_position >= 0:
            let left = seed_expression(substring(value, 0, operator_position), locals)
            if left["error"] != none:
                return left
            let right = seed_expression(substring(value, operator_position + len(operator), len(value)), locals)
            if right["error"] != none:
                return right
            let instructions = seed_append_all(left["instructions"], right["instructions"])
            return {"error": none, "instructions": append(instructions, {"op": op_names[operator_index]})}
        operator_index = operator_index + 1
    let open_index = seed_find_open_paren(value, 0)
    if open_index > 0 and ends_with(value, ")"):
        let call_name = trim(substring(value, 0, open_index))
        if contains(call_name, " "):
            open_index = -1
    if open_index > 0 and ends_with(value, ")"):
        let call_name = trim(substring(value, 0, open_index))
        let argument_text = trim(substring(value, open_index + 1, len(value) - 1))
        let instructions = []
        let argc = 0
        if argument_text != "":
            for argument in split(argument_text, ","):
                let lowered_argument = seed_expression(argument, locals)
                if lowered_argument["error"] != none:
                    return lowered_argument
                instructions = seed_append_all(instructions, lowered_argument["instructions"])
                argc = argc + 1
        if contains(call_name, "."):
            let pieces = split(call_name, ".")
            if len(pieces) == 2:
                return {"error": none, "instructions": append(instructions, {"argc": argc, "method": trim(pieces[1]), "op": "method_call", "receiver": trim(pieces[0])})}
        return {"error": none, "instructions": append(instructions, {"argc": argc, "name": call_name, "op": "call"})}
    if starts_with(value, "[") and ends_with(value, "]"):
        return {"error": none, "instructions": [{"op": "const", "value": from_json(value)}]}
    if contains(value, ".") and not contains(value, " "):
        let pieces = split(value, ".")
        if len(pieces) == 2:
            return {"error": none, "instructions": [{"field": trim(pieces[1]), "op": "field_load", "receiver": trim(pieces[0])}]}
        if len(pieces) > 2:
            return {"error": none, "instructions": [{"op": "field_load_path", "path": pieces}]}
    if starts_with(value, "{") and ends_with(value, "}"):
        return {"error": none, "instructions": [{"op": "const", "value": from_json(value)}]}
    if starts_with(value, "\"") and ends_with(value, "\""):
        return {"error": none, "instructions": [{"op": "const", "value": seed_string_literal(value)}]}
    if value == "true" or value == "false":
        return {"error": none, "instructions": [{"op": "const", "value": value == "true"}]}
    if seed_is_number(value):
        return {"error": none, "instructions": [{"op": "const", "value": seed_number(value)}]}
    for name in locals:
        if name == value:
            return {"error": none, "instructions": [{"op": "load", "name": value}]}
    return {"error": "unknown_name:" + value, "instructions": []}

export fn seed_add_local(locals, name):
    for item in locals:
        if item == name:
            return locals
    return append(locals, name)

export fn seed_compile_line(line, instructions, locals):
    let value = trim(line)
    if value == "":
        return {"error": none, "instructions": instructions, "locals": locals}
    if starts_with(value, "let ") and contains(value, " = "):
        let assignment = split(value, " = ")
        if len(assignment) != 2:
            return {"error": "invalid_declaration", "instructions": instructions, "locals": locals}
        let left = trim(substring(assignment[0], 4, len(assignment[0])))
        let name = left
        if contains(left, ":"):
            name = trim(split(left, ":")[0])
        let lowered = seed_expression(assignment[1], locals)
        if lowered["error"] != none:
            return {"error": lowered["error"], "instructions": instructions, "locals": locals}
        let next = seed_append_all(instructions, lowered["instructions"])
        next = append(next, {"name": name, "op": "store"})
        return {"error": none, "instructions": next, "locals": seed_add_local(locals, name)}
    if starts_with(value, "say "):
        let lowered = seed_expression(substring(value, 4, len(value)), locals)
        if lowered["error"] != none:
            return {"error": lowered["error"], "instructions": instructions, "locals": locals}
        let next = seed_append_all(instructions, lowered["instructions"])
        return {"error": none, "instructions": append(next, {"op": "print"}), "locals": locals}
    if starts_with(value, "raise "):
        let lowered = seed_expression(substring(value, 6, len(value)), locals)
        if lowered["error"] != none:
            return {"error": lowered["error"], "instructions": instructions, "locals": locals}
        let next = seed_append_all(instructions, lowered["instructions"])
        return {"error": none, "instructions": append(next, {"op": "raise"}), "locals": locals}
    if starts_with(value, "super()."):
        let lowered = seed_expression(value, locals)
        if lowered["error"] != none:
            return {"error": lowered["error"], "instructions": instructions, "locals": locals}
        let next = seed_append_all(instructions, lowered["instructions"])
        return {"error": none, "instructions": append(next, {"op": "pop"}), "locals": locals}
    if starts_with(value, "set ") and contains(value, " = "):
        let assignment = split(value, " = ")
        if len(assignment) != 2:
            return {"error": "invalid_field_assignment", "instructions": instructions, "locals": locals}
        let target = trim(substring(assignment[0], 4, len(assignment[0])))
        let pieces = split(target, ".")
        if len(pieces) < 2:
            return {"error": "invalid_field_assignment", "instructions": instructions, "locals": locals}
        let lowered = seed_expression(assignment[1], locals)
        if lowered["error"] != none:
            return {"error": lowered["error"], "instructions": instructions, "locals": locals}
        let next = seed_append_all(instructions, lowered["instructions"])
        if len(pieces) == 2:
            return {"error": none, "instructions": append(next, {"field": trim(pieces[1]), "op": "field_store", "receiver": trim(pieces[0])}), "locals": locals}
        return {"error": none, "instructions": append(next, {"op": "field_store_path", "path": pieces}), "locals": locals}
    if value == "return":
        return {"error": none, "instructions": append(instructions, {"op": "return_none"}), "locals": locals}
    if starts_with(value, "return "):
        let lowered = seed_expression(substring(value, 7, len(value)), locals)
        if lowered["error"] != none:
            return {"error": lowered["error"], "instructions": instructions, "locals": locals}
        let next = seed_append_all(instructions, lowered["instructions"])
        return {"error": none, "instructions": append(next, {"op": "return_value"}), "locals": locals}
    if value == "break":
        return {"error": none, "instructions": append(instructions, {"op": "break_jump"}), "locals": locals}
    if value == "continue":
        return {"error": none, "instructions": append(instructions, {"op": "continue_jump"}), "locals": locals}
    if contains(value, " = "):
        let assignment = split(value, " = ")
        if len(assignment) == 2:
            let name = trim(assignment[0])
            let lowered = seed_expression(assignment[1], locals)
            if lowered["error"] != none:
                return {"error": lowered["error"], "instructions": instructions, "locals": locals}
            let next = seed_append_all(instructions, lowered["instructions"])
            return {"error": none, "instructions": append(next, {"name": name, "op": "store"}), "locals": seed_add_local(locals, name)}
    return {"error": "unsupported_statement:" + value, "instructions": instructions, "locals": locals}

export fn seed_indent(line):
    return len(line) - len(trim(line))

export fn seed_patch_target(instructions, target_index, target, index, result):
    if index >= len(instructions):
        return result
    let instruction = instructions[index]
    if index == target_index:
        instruction = {"op": instruction["op"], "target": target}
    return seed_patch_target(instructions, target_index, target, index + 1, append(result, instruction))

export fn seed_patch_function(instructions, target_index, entry, end, index, result):
    if index >= len(instructions):
        return result
    let instruction = instructions[index]
    if index == target_index:
        instruction = {"binding": instruction["binding"], "captures": instruction["captures"], "end": end, "entry": entry, "name": instruction["name"], "op": "function_def", "owner": instruction["owner"], "params": instruction["params"]}
    return seed_patch_function(instructions, target_index, entry, end, index + 1, append(result, instruction))

export fn seed_patch_class(instructions, target_index, end, base, parents, index, result):
    if index >= len(instructions):
        return result
    let instruction = instructions[index]
    if index == target_index:
        instruction = {"base": base, "end": end, "name": instruction["name"], "op": "class_def", "parents": parents}
    return seed_patch_class(instructions, target_index, end, base, parents, index + 1, append(result, instruction))

export fn seed_patch_class_methods(instructions, start_index, end_index, owner, index, result):
    if index >= len(instructions):
        return result
    let instruction = instructions[index]
    if index >= start_index and index < end_index and instruction["op"] == "function_def":
        instruction = {"binding": instruction["binding"], "captures": instruction["captures"], "end": instruction["end"], "entry": instruction["entry"], "name": instruction["name"], "op": "function_def", "owner": owner, "params": instruction["params"]}
    return seed_patch_class_methods(instructions, start_index, end_index, owner, index + 1, append(result, instruction))

export fn seed_compile_class(lines, index, instructions, locals, indent, loop_depth, function_depth):
    if loop_depth > 0 or function_depth > 0:
        return {"error": "nested_class_unsupported", "instructions": instructions, "locals": locals, "next": index}
    let header = trim(lines[index])
    let declaration = trim(substring(header, 6, len(header) - 1))
    let name = declaration
    let base = none
    let parents = []
    if contains(declaration, " extends "):
        let parts = split(declaration, " extends ")
        if len(parts) != 2:
            return {"error": "invalid_class_header", "instructions": instructions, "locals": locals, "next": index}
        name = trim(parts[0])
        for parent in split(trim(parts[1]), ","):
            let parent_name = trim(parent)
            if parent_name == "":
                return {"error": "invalid_class_parent", "instructions": instructions, "locals": locals, "next": index}
            parents = append(parents, parent_name)
        if len(parents) > 0:
            base = parents[0]
    if name == "":
        return {"error": "invalid_class_name", "instructions": instructions, "locals": locals, "next": index}
    let class_index = len(instructions)
    let with_class = append(instructions, {"base": base, "end": 0, "name": name, "op": "class_def", "parents": parents})
    let body = seed_compile_lines(lines, index + 1, with_class, locals, indent, loop_depth, function_depth)
    if body["error"] != none:
        return body
    if body["next"] == index + 1:
        return {"error": "missing_class_body", "instructions": instructions, "locals": locals, "next": index}
    let owned = seed_patch_class_methods(body["instructions"], class_index + 1, len(body["instructions"]), name, 0, [])
    let patched = seed_patch_class(owned, class_index, len(owned), base, parents, 0, [])
    return {"error": none, "instructions": patched, "locals": body["locals"], "next": body["next"]}

export fn seed_compile_function(lines, index, instructions, locals, indent, loop_depth, function_depth):
    if loop_depth > 0:
        return {"error": "nested_function_unsupported", "instructions": instructions, "locals": locals, "next": index}
    let header = trim(lines[index])
    let open_index = seed_find_open_paren(header, 3)
    if open_index < 0 or not ends_with(header, ":"):
        return {"error": "invalid_function_header", "instructions": instructions, "locals": locals, "next": index}
    let close_index = len(header) - 2
    if substring(header, close_index, close_index + 1) != ")":
        return {"error": "invalid_function_header", "instructions": instructions, "locals": locals, "next": index}
    let name = trim(substring(header, 3, open_index))
    if name == "":
        return {"error": "invalid_function_name", "instructions": instructions, "locals": locals, "next": index}
    let params = seed_parse_parameters(substring(header, open_index + 1, close_index))
    let captures = []
    let body_locals = params
    let binding = none
    if function_depth > 0:
        captures = locals
        body_locals = seed_merge_name_lists(params, captures)
        binding = name
    let definition_index = len(instructions)
    let entry = definition_index + 1
    let with_definition = append(instructions, {"binding": binding, "captures": captures, "end": 0, "entry": entry, "name": name, "op": "function_def", "owner": none, "params": params})
    let body = seed_compile_lines(lines, index + 1, with_definition, body_locals, indent, 0, function_depth + 1)
    if body["error"] != none:
        return body
    if body["next"] == index + 1:
        return {"error": "missing_function_body", "instructions": instructions, "locals": locals, "next": index}
    let with_fallthrough = append(body["instructions"], {"op": "return_none"})
    let end = len(with_fallthrough)
    let patched = seed_patch_function(with_fallthrough, definition_index, entry, end, 0, [])
    let next_locals = locals
    if binding != none:
        next_locals = seed_add_local(next_locals, binding)
    return {"error": none, "instructions": patched, "locals": next_locals, "next": body["next"]}

export fn seed_patch_loop_controls_range(instructions, start_index, end_index, break_target, continue_target, index, result):
    if index >= len(instructions):
        return result
    let instruction = instructions[index]
    if index >= start_index and index < end_index:
        if instruction["op"] == "break_jump" and break_target >= 0:
            instruction = {"op": "jump", "target": break_target}
        if instruction["op"] == "continue_jump" and continue_target >= 0:
            instruction = {"op": "jump", "target": continue_target}
    return seed_patch_loop_controls_range(instructions, start_index, end_index, break_target, continue_target, index + 1, append(result, instruction))

export fn seed_compile_while(lines, index, instructions, locals, indent, loop_depth, function_depth):
    let header = trim(lines[index])
    let condition_text = trim(substring(header, 6, len(header) - 1))
    let condition = seed_expression(condition_text, locals)
    if condition["error"] != none:
        return {"error": condition["error"], "instructions": instructions, "locals": locals, "next": index}
    let condition_index = len(instructions)
    let prefix = seed_append_all(instructions, condition["instructions"])
    let jump_false_index = len(prefix)
    let with_false = append(prefix, {"op": "jump_if_false", "target": 0})
    let body_start = len(with_false)
    let body = seed_compile_lines(lines, index + 1, with_false, locals, indent, loop_depth + 1, function_depth)
    if body["next"] == index + 1:
        return {"error": "missing_while_body", "instructions": instructions, "locals": locals, "next": index}
    if body["error"] != none:
        return body
    let with_back = append(body["instructions"], {"op": "jump", "target": condition_index})
    let patched_controls = seed_patch_loop_controls_range(with_back, body_start, len(with_back) - 1, len(with_back), condition_index, 0, [])
    let patched = seed_patch_target(patched_controls, jump_false_index, len(patched_controls), 0, [])
    return {"error": none, "instructions": patched, "locals": body["locals"], "next": body["next"]}

export fn seed_compile_for(lines, index, instructions, locals, indent, loop_depth, function_depth):
    let header = trim(lines[index])
    let body = trim(substring(header, 4, len(header) - 1))
    let parts = split(body, " in ")
    if len(parts) != 2:
        return {"error": "invalid_for_header", "instructions": instructions, "locals": locals, "next": index}
    let binding = trim(parts[0])
    let iterable_text = trim(parts[1])
    if not (starts_with(iterable_text, "[") and ends_with(iterable_text, "]")):
        return {"error": "unsupported_for_iterable", "instructions": instructions, "locals": locals, "next": index}
    let items = from_json(iterable_text)
    let probe = seed_compile_lines(lines, index + 1, instructions, seed_add_local(locals, binding), indent, loop_depth + 1, function_depth)
    if probe["next"] == index + 1:
        return {"error": "missing_for_body", "instructions": instructions, "locals": locals, "next": index}
    if probe["error"] != none:
        return probe
    let current_instructions = instructions
    let current_locals = locals
    let loop_body_start = len(instructions)
    for item in items:
        let iteration_start = len(current_instructions)
        let with_value = append(current_instructions, {"op": "const", "value": item})
        with_value = append(with_value, {"name": binding, "op": "store"})
        let iteration = seed_compile_lines(lines, index + 1, with_value, seed_add_local(current_locals, binding), indent, loop_depth + 1, function_depth)
        if iteration["error"] != none:
            return iteration
        let patched_iteration = seed_patch_loop_controls_range(iteration["instructions"], iteration_start, len(iteration["instructions"]), -1, len(iteration["instructions"]), 0, [])
        current_instructions = patched_iteration
        current_locals = iteration["locals"]
    let patched_breaks = seed_patch_loop_controls_range(current_instructions, loop_body_start, len(current_instructions), len(current_instructions), -1, 0, [])
    return {"error": none, "instructions": patched_breaks, "locals": current_locals, "next": probe["next"]}

export fn seed_patch_handler_binding(instructions, target_index, binding, index, result):
    if index >= len(instructions):
        return result
    let instruction = instructions[index]
    if index == target_index:
        instruction = {"binding": binding, "op": instruction["op"], "target": instruction["target"]}
    return seed_patch_handler_binding(instructions, target_index, binding, index + 1, append(result, instruction))

export fn seed_compile_try(lines, index, instructions, locals, indent, loop_depth, function_depth):
    let try_index = len(instructions)
    let with_begin = append(instructions, {"binding": none, "op": "try_begin", "target": 0})
    let body = seed_compile_lines(lines, index + 1, with_begin, locals, indent, loop_depth, function_depth)
    if body["next"] == index + 1:
        return {"error": "missing_try_body", "instructions": instructions, "locals": locals, "next": index}
    if body["error"] != none:
        return body
    let catch_index = body["next"]
    if catch_index >= len(lines) or seed_indent(lines[catch_index]) != indent:
        return {"error": "missing_catch", "instructions": instructions, "locals": locals, "next": index}
    let catch_header = trim(lines[catch_index])
    let catch_binding = none
    if catch_header == "catch:":
        catch_binding = none
    else:
        if starts_with(catch_header, "catch ") and ends_with(catch_header, ":"):
            catch_binding = trim(substring(catch_header, 6, len(catch_header) - 1))
        else:
            return {"error": "invalid_catch_binding", "instructions": instructions, "locals": locals, "next": index}
    let with_end = append(body["instructions"], {"op": "try_end"})
    let jump_index = len(with_end)
    let with_jump = append(with_end, {"op": "jump", "target": 0})
    let catch_locals = body["locals"]
    if catch_binding != none:
        catch_locals = seed_add_local(catch_locals, catch_binding)
    let alternate = seed_compile_lines(lines, catch_index + 1, with_jump, catch_locals, indent, loop_depth, function_depth)
    if alternate["next"] == catch_index + 1:
        return {"error": "missing_catch_body", "instructions": instructions, "locals": locals, "next": index}
    if alternate["error"] != none:
        return alternate
    let catch_target = jump_index + 1
    let patched_begin = seed_patch_target(alternate["instructions"], try_index, catch_target, 0, [])
    let with_binding = seed_patch_handler_binding(patched_begin, try_index, catch_binding, 0, [])
    let patched_jump = seed_patch_target(with_binding, jump_index, len(with_binding), 0, [])
    return {"error": none, "instructions": patched_jump, "locals": alternate["locals"], "next": alternate["next"]}

export fn seed_compile_lines(lines, index, instructions, locals, base_indent, loop_depth, function_depth):
    if index >= len(lines):
        return {"error": none, "instructions": instructions, "locals": locals, "next": index}
    let line = lines[index]
    let value = trim(line)
    if value == "":
        return seed_compile_lines(lines, index + 1, instructions, locals, base_indent, loop_depth, function_depth)
    let indent = seed_indent(line)
    if indent <= base_indent:
        return {"error": none, "instructions": instructions, "locals": locals, "next": index}
    if value == "while:":
        return {"error": "invalid_while_header", "instructions": instructions, "locals": locals, "next": index}
    if starts_with(value, "class ") and ends_with(value, ":"):
        let class = seed_compile_class(lines, index, instructions, locals, indent, loop_depth, function_depth)
        if class["error"] != none:
            return class
        return seed_compile_lines(lines, class["next"], class["instructions"], class["locals"], base_indent, loop_depth, function_depth)
    if starts_with(value, "fn "):
        let function = seed_compile_function(lines, index, instructions, locals, indent, loop_depth, function_depth)
        if function["error"] != none:
            return function
        return seed_compile_lines(lines, function["next"], function["instructions"], function["locals"], base_indent, loop_depth, function_depth)
    if starts_with(value, "while ") and ends_with(value, ":"):
        let looping = seed_compile_while(lines, index, instructions, locals, indent, loop_depth, function_depth)
        if looping["error"] != none:
            return looping
        return seed_compile_lines(lines, looping["next"], looping["instructions"], looping["locals"], base_indent, loop_depth, function_depth)
    if starts_with(value, "for ") and ends_with(value, ":"):
        let looping = seed_compile_for(lines, index, instructions, locals, indent, loop_depth, function_depth)
        if looping["error"] != none:
            return looping
        return seed_compile_lines(lines, looping["next"], looping["instructions"], looping["locals"], base_indent, loop_depth, function_depth)
    if value == "try:":
        let guarded = seed_compile_try(lines, index, instructions, locals, indent, loop_depth, function_depth)
        if guarded["error"] != none:
            return guarded
        return seed_compile_lines(lines, guarded["next"], guarded["instructions"], guarded["locals"], base_indent, loop_depth, function_depth)
    if starts_with(value, "if ") and ends_with(value, ":"):
        let conditional = seed_compile_if(lines, index, instructions, locals, indent, loop_depth, function_depth)
        if conditional["error"] != none:
            return conditional
        return seed_compile_lines(lines, conditional["next"], conditional["instructions"], conditional["locals"], base_indent, loop_depth, function_depth)
    if value == "else:":
        return {"error": "unexpected_else", "instructions": instructions, "locals": locals, "next": index}
    if value == "break" and loop_depth <= 0:
        return {"error": "break_outside_loop", "instructions": instructions, "locals": locals, "next": index}
    if value == "continue" and loop_depth <= 0:
        return {"error": "continue_outside_loop", "instructions": instructions, "locals": locals, "next": index}
    if value == "return" or starts_with(value, "return "):
        if function_depth <= 0:
            return {"error": "return_outside_function", "instructions": instructions, "locals": locals, "next": index}
    let compiled = seed_compile_line(line, instructions, locals)
    if compiled["error"] != none:
        return {"error": compiled["error"], "instructions": instructions, "locals": locals, "next": index}
    return seed_compile_lines(lines, index + 1, compiled["instructions"], compiled["locals"], base_indent, loop_depth, function_depth)

export fn seed_compile_if(lines, index, instructions, locals, indent, loop_depth, function_depth):
    let header = trim(lines[index])
    let condition_text = trim(substring(header, 3, len(header) - 1))
    let condition = seed_expression(condition_text, locals)
    if condition["error"] != none:
        return {"error": condition["error"], "instructions": instructions, "locals": locals, "next": index}
    let prefix = seed_append_all(instructions, condition["instructions"])
    let jump_false_index = len(prefix)
    let with_false = append(prefix, {"op": "jump_if_false", "target": 0})
    let body = seed_compile_lines(lines, index + 1, with_false, locals, indent, loop_depth, function_depth)
    if body["next"] == index + 1:
        return {"error": "missing_if_body", "instructions": instructions, "locals": locals, "next": index}
    if body["error"] != none:
        return body
    let next_index = body["next"]
    let body_instructions = body["instructions"]
    let body_locals = body["locals"]
    if next_index < len(lines) and seed_indent(lines[next_index]) == indent and trim(lines[next_index]) == "else:":
        let jump_end_index = len(body_instructions)
        let with_end_jump = append(body_instructions, {"op": "jump", "target": 0})
        let alternate = seed_compile_lines(lines, next_index + 1, with_end_jump, body_locals, indent, loop_depth, function_depth)
        if alternate["next"] == next_index + 1:
            return {"error": "missing_else_body", "instructions": instructions, "locals": locals, "next": index}
        if alternate["error"] != none:
            return alternate
        let false_target = jump_end_index + 1
        let patched_false = seed_patch_target(alternate["instructions"], jump_false_index, false_target, 0, [])
        let patched_end = seed_patch_target(patched_false, jump_end_index, len(patched_false), 0, [])
        return {"error": none, "instructions": patched_end, "locals": alternate["locals"], "next": alternate["next"]}
    let patched = seed_patch_target(body_instructions, jump_false_index, len(body_instructions), 0, [])
    return {"error": none, "instructions": patched, "locals": body_locals, "next": next_index}

export fn seed_compile_source(source, source_name):
    let lines = split(source, "\n")
    let compiled = seed_compile_lines(lines, 0, [], [], -1, 0, 0)
    if compiled["error"] != none:
        return {"artifact_kind": "bytecode", "error": compiled["error"], "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    return {"artifact_kind": "bytecode", "instructions": append(compiled["instructions"], {"op": "halt"}), "native_independent": false, "source_name": source_name, "status": "compiled_slice"}

export fn seed_compile_bytes(artifact):
    return json(artifact)

export fn seed_compile_typed_ir(ir, source_name):
    let lowered = lower_typed_ir(ir)
    if lowered["error"] != none:
        return {"artifact_kind": "bytecode", "error": lowered["error"], "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    return {"artifact_kind": "bytecode", "error": none, "instructions": lowered["instructions"], "native_independent": false, "source_name": source_name, "status": "compiled_typed_ir_slice"}

export fn seed_compile_typed_ir_source(source, source_name):
    let emitted = from_json(emit(source, source_name))
    if emitted["kind"] != "zap.typed_ir":
        return {"artifact_kind": "bytecode", "error": "typed_ir_emit_error", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    let artifact = seed_compile_typed_ir(emitted, source_name)
    return {"artifact_kind": artifact["artifact_kind"], "error": artifact["error"], "instructions": artifact["instructions"], "native_independent": false, "source_name": source_name, "status": artifact["status"], "typed_ir": emitted}

export fn seed_self_rebuild_typed_ir(source, source_name):
    let first = seed_compile_typed_ir_source(source, source_name)
    let second = seed_compile_typed_ir_source(source, source_name)
    let first_bytes = seed_compile_bytes(first)
    let second_bytes = seed_compile_bytes(second)
    let status = "mismatch"
    if first_bytes == second_bytes and first["status"] == "compiled_typed_ir_slice":
        status = "reproducible_typed_ir_slice"
    return {"byte_equal": first_bytes == second_bytes, "first": first, "native_independent": false, "second": second, "status": status}

export fn seed_typed_ir_ast_statements(nodes, result):
    for node in nodes:
        if contains(json(node), "\"ast\":"):
            result = append(result, node["ast"])
    return result

export fn seed_compile_inferred_typed_ir(typed, source_name):
    if typed["kind"] != "zap.typed_ir":
        return {"artifact_kind": "bytecode", "error": "invalid_typed_ir_kind", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    let ast = {"ast": {"statements": seed_typed_ir_ast_statements(typed["ir"]["nodes"], [])}, "kind": "zap.ast"}
    let lowered = lower_ast_program(ast)
    if lowered["error"] != none:
        return {"artifact_kind": "bytecode", "error": lowered["error"], "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    return {"artifact_kind": "bytecode", "error": none, "instructions": lowered["instructions"], "native_independent": false, "source_name": source_name, "status": "compiled_inferred_typed_ir_slice", "typed_ir": typed}

export fn seed_incomplete_assignment_diagnostic(source, source_name):
    let declaration = contains(source, "let ")
    if not declaration:
        declaration = contains(source, "set ")
    if declaration:
        let has_assignment = contains(source, " =")
        if has_assignment:
            let has_value = contains(source, " = ")
            if not has_value:
                return json({"diagnostics": [{"code": "ZAP-SYNTAX-001", "column": len(source) + 1, "help": "add an expression after '='", "line": 1, "message": "expected expression after '='", "severity": "error", "source_name": source_name}], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    return none
export fn seed_emit_inferred_program_typed_ir(source, source_name):
    let preflight = seed_incomplete_assignment_diagnostic(source, source_name)
    if preflight != none:
        return preflight
    return emit_inferred_program_typed_ir(source, source_name)

export fn seed_compile_inferred_typed_ir_source(source, source_name):
    let preflight = seed_incomplete_assignment_diagnostic(source, source_name)
    if preflight != none:
        return {"artifact_kind": "bytecode", "diagnostics": [from_json(preflight)], "error": "syntax_diagnostic", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    let emitted = from_json(seed_emit_inferred_program_typed_ir(source, source_name))
    if emitted["kind"] != "zap.typed_ir":
        return {"artifact_kind": "bytecode", "error": "typed_ir_emit_error", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    return seed_compile_inferred_typed_ir(emitted, source_name)

export fn seed_self_rebuild_inferred_typed_ir(source, source_name):
    let first = seed_compile_inferred_typed_ir_source(source, source_name)
    let second = seed_compile_inferred_typed_ir_source(source, source_name)
    let first_bytes = seed_compile_bytes(first)
    let second_bytes = seed_compile_bytes(second)
    let status = "mismatch"
    if first_bytes == second_bytes and first["status"] == "compiled_inferred_typed_ir_slice":
        status = "reproducible_inferred_typed_ir_slice"
    return {"byte_equal": first_bytes == second_bytes, "first": first, "native_independent": false, "second": second, "status": status}

export fn seed_self_compile_acceptance(source, source_name):
    let rebuild = seed_self_rebuild_inferred_typed_ir(source, source_name)
    return {"byte_equal": rebuild["byte_equal"], "native_independent": false, "status": rebuild["status"], "supported": rebuild["status"] == "reproducible_inferred_typed_ir_slice"}

export fn seed_compile_ast_source(source, source_name):
    let preflight = seed_incomplete_assignment_diagnostic(source, source_name)
    if preflight != none:
        return {"artifact_kind": "bytecode", "diagnostics": [from_json(preflight)], "error": "syntax_diagnostic", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    let parsed = from_json(parse_general(source, source_name))
    if parsed["kind"] != "zap.ast":
        return {"artifact_kind": "bytecode", "error": "parse_error", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    let lowered = lower_ast_program(parsed)
    if lowered["error"] != none:
        return {"artifact_kind": "bytecode", "error": lowered["error"], "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    return {"artifact_kind": "bytecode", "instructions": lowered["instructions"], "native_independent": false, "source_name": source_name, "status": "compiled_ast_slice"}

export fn seed_self_rebuild(source, source_name):
    let first = seed_compile_source(source, source_name)
    let second = seed_compile_source(source, source_name)
    let first_bytes = seed_compile_bytes(first)
    let second_bytes = seed_compile_bytes(second)
    let status = "mismatch"
    if first_bytes == second_bytes:
        status = "reproducible"
    return {"byte_equal": first_bytes == second_bytes, "first": first, "second": second, "status": status}

export fn seed_self_rebuild_ast(source, source_name):
    let first = seed_compile_ast_source(source, source_name)
    let second = seed_compile_ast_source(source, source_name)
    let first_bytes = seed_compile_bytes(first)
    let second_bytes = seed_compile_bytes(second)
    let status = "mismatch"
    if first_bytes == second_bytes and first["status"] == "compiled_ast_slice":
        status = "reproducible_ast_slice"
    return {"byte_equal": first_bytes == second_bytes, "first": first, "native_independent": false, "second": second, "status": status}

export fn seed_rebuild_acceptance_ast(source, source_name):
    let rebuild = seed_self_rebuild_ast(source, source_name)
    return {"byte_equal": rebuild["byte_equal"], "native_independent": false, "status": rebuild["status"], "supported": rebuild["status"] == "reproducible_ast_slice"}

export fn seed_pipeline_digest(kind, payload):
    return kind + ":" + json(payload)

export fn seed_execute_owned_pipeline(source, source_name):
    let preflight = seed_incomplete_assignment_diagnostic(source, source_name)
    if preflight != none:
        return {"artifacts": [], "diagnostics": [from_json(preflight)], "error": "syntax_diagnostic", "execution": {"error": "syntax_diagnostic", "output": []}, "native_independent": false, "source_name": source_name, "stage_chain_valid": false, "status": "compile_error"}
    let typed = from_json(seed_emit_inferred_program_typed_ir(source, source_name))
    if typed["kind"] != "zap.typed_ir":
        return {"artifacts": [], "error": "typed_ir_emit_error", "execution": {"error": "typed_ir_emit_error", "output": []}, "native_independent": false, "source_name": source_name, "stage_chain_valid": false, "status": "compile_error"}
    let typed_digest = seed_pipeline_digest("typed_ir", typed)
    let compiled = seed_compile_inferred_typed_ir(typed, source_name)
    if compiled["status"] != "compiled_inferred_typed_ir_slice":
        return {"artifacts": [{"bytes": json(typed), "digest": typed_digest, "kind": "typed_ir"}], "error": compiled["error"], "execution": {"error": compiled["error"], "output": []}, "native_independent": false, "source_name": source_name, "stage_chain_valid": false, "status": "compile_error"}
    let bytecode_digest = seed_pipeline_digest("bytecode", compiled["instructions"])
    let execution = vm_run(compiled["instructions"])
    let source_digest = seed_pipeline_digest("source", source)
    let stages = [{"input_digest": source_digest, "input_kind": "source", "output_digest": typed_digest, "output_kind": "typed_ir", "stage": "source_to_typed_ir"}, {"input_digest": typed_digest, "input_kind": "typed_ir", "output_digest": bytecode_digest, "output_kind": "bytecode", "stage": "typed_ir_to_bytecode"}, {"input_digest": bytecode_digest, "input_kind": "bytecode", "output_digest": seed_pipeline_digest("execution", execution), "output_kind": "execution", "stage": "bytecode_to_vm"}]
    let status = "candidate_pipeline_executed"
    if execution["error"] != none:
        status = "candidate_pipeline_error"
    return {"artifacts": [{"bytes": json(typed), "digest": typed_digest, "kind": "typed_ir"}, {"bytes": json(compiled["instructions"]), "digest": bytecode_digest, "kind": "bytecode"}], "error": execution["error"], "execution": execution, "native_independent": false, "source_name": source_name, "stage_chain_valid": true, "stages": stages, "status": status}

export fn seed_pipeline_replay(source, source_name):
    let first = seed_execute_owned_pipeline(source, source_name)
    let second = seed_execute_owned_pipeline(source, source_name)
    return {"byte_equal": json(first) == json(second), "first": first, "native_independent": false, "second": second, "status": "candidate_pipeline_replay"}

export fn seed_supported_subset_run(sources, source_names, index, result):
    if index >= len(sources):
        return result
    result = append(result, seed_execute_owned_pipeline(sources[index], source_names[index]))
    return seed_supported_subset_run(sources, source_names, index + 1, result)

export fn seed_supported_subset_rebuild(sources, source_names):
    let first = seed_supported_subset_run(sources, source_names, 0, [])
    let second = seed_supported_subset_run(sources, source_names, 0, [])
    let all_successful = true
    for result in first:
        if result["status"] != "candidate_pipeline_executed":
            all_successful = false
    return {"all_successful": all_successful, "byte_equal": json(first) == json(second), "count": len(first), "first": first, "native_independent": false, "second": second, "status": "candidate_supported_subset_rebuild"}

export fn seed_build_package_owned(package_name, package_version, main, requirements, registry, source, source_name):
    let manifest_value = manifest(package_name, package_version, main, requirements)
    let graph = resolve_dependency_graph(requirements, registry)
    if not graph["ok"]:
        return {"artifact_bytes": "", "artifact_digest": "", "dependency_graph": graph["resolved"], "diagnostics": graph["errors"], "lockfile": resolved_graph_lockfile(manifest_value, graph), "native_independent": false, "status": "package_dependency_error"}
    let pipeline = seed_execute_owned_pipeline(source, source_name)
    if pipeline["status"] != "candidate_pipeline_executed":
        return {"artifact_bytes": "", "artifact_digest": "", "dependency_graph": graph["resolved"], "diagnostics": [{"code": "ZAP-BUILD-001", "message": pipeline["error"]}], "lockfile": resolved_graph_lockfile(manifest_value, graph), "native_independent": false, "status": "package_pipeline_error"}
    let artifact_bytes = json(pipeline["artifacts"])
    let artifact_digest = seed_pipeline_digest("package_artifact", artifact_bytes)
    return {"artifact_bytes": artifact_bytes, "artifact_digest": artifact_digest, "dependency_graph": graph["resolved"], "diagnostics": [], "execution": pipeline["execution"], "lockfile": resolved_graph_lockfile(manifest_value, graph), "native_independent": false, "status": "candidate_package_build_executed"}

export fn seed_a13_supported_rebuild_evidence(sources, source_names, platform_records, expected_targets):
    let rebuild = seed_supported_subset_rebuild(sources, source_names)
    let platform_valid = seed_platform_evidence_matrix_valid(platform_records, expected_targets)
    let supported = rebuild["all_successful"]
    if not rebuild["byte_equal"]:
        supported = false
    if not platform_valid:
        supported = false
    let status = "candidate_a13_supported_rebuild"
    if not supported:
        status = "candidate_a13_rebuild_blocked"
    return {"byte_equal": rebuild["byte_equal"], "native_independent": false, "platform_evidence": platform_valid, "source_count": rebuild["count"], "status": status, "supported": supported, "vm_outputs": rebuild["first"]}

export fn seed_artifact_record_valid(record):
    if not contains(json(record), "\"kind\""):
        return false
    if not contains(json(record), "\"bytes\""):
        return false
    if not contains(json(record), "\"digest\""):
        return false
    if record["kind"] == "":
        return false
    if record["bytes"] == "":
        return false
    return record["digest"] == record["kind"] + ":" + record["bytes"]

export fn seed_pipeline_artifacts_valid(artifacts, index):
    if index >= len(artifacts):
        return true
    if not seed_artifact_record_valid(artifacts[index]):
        return false
    return seed_pipeline_artifacts_valid(artifacts, index + 1)

export fn seed_owned_pipeline_contract(pipeline):
    let valid = pipeline["native_independent"] == false
    if pipeline["status"] != "candidate_pipeline_executed":
        valid = false
    if not pipeline["stage_chain_valid"]:
        valid = false
    if len(pipeline["artifacts"]) != 2:
        valid = false
    if not seed_pipeline_artifacts_valid(pipeline["artifacts"], 0):
        valid = false
    if not contains(json(pipeline), "\"stages\""):
        valid = false
    let status = "candidate_owned_pipeline_contract"
    if not valid:
        status = "candidate_owned_pipeline_contract_error"
    return {"artifact_count": len(pipeline["artifacts"]), "native_independent": pipeline["native_independent"], "stage_count": len(pipeline["stages"]), "status": status, "valid": valid}

export fn seed_package_artifact_contract(artifact_bytes, artifact_digest):
    let valid = artifact_bytes != ""
    if artifact_digest != seed_pipeline_digest("package_artifact", artifact_bytes):
        valid = false
    let status = "candidate_package_artifact_contract"
    if not valid:
        status = "candidate_package_artifact_contract_error"
    return {"artifact_bytes_nonempty": artifact_bytes != "", "artifact_digest": artifact_digest, "status": status, "valid": valid}
