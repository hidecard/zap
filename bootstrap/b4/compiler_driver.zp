# Candidate compiler driver boundary.
#
# This module fixes the user-facing command contract while the underlying
# compiler stages are migrated from candidate slices to the complete language.
import "bootstrap/b4/runner.zp"
import "bootstrap/b1/lexer.zp"
import "bootstrap/b1/parser.zp"
import "bootstrap/b2/typed_ir.zp"
import "bootstrap/b3/lower.zp"
import "bootstrap/b3/vm.zp"
import "bootstrap/b3/package.zp"
import "bootstrap/b4/seed_pipeline.zp"
import "bootstrap/b4/ast_control.zp"

export fn driver_frontend_ownership():
    return {"acceptance": {"lexer_corpus": {"fixture_count": 192, "status": "verified_deterministic_token_streams"}, "module_resolution": {"diagnostic_count": 5, "status": "verified_deterministic_graph_and_errors"}, "parser_corpus": {"fixture_count": 62, "status": "verified_deterministic_ast_and_diagnostics"}}, "components": [{"owner": "zap", "source": "bootstrap/b1/lexer.zp", "status": "zap_owned"}, {"owner": "zap", "source": "bootstrap/b1/parser.zp", "status": "zap_owned"}, {"owner": "zap", "source": "bootstrap/b4/compiler_driver.zp", "status": "zap_owned"}], "complete_language": false, "reference_owner": "rust", "schema_version": 1, "status": "frontend_ownership_slice"}

export fn driver_verified_frontend_acceptance():
    return {"complete_language": false, "components": [{"acceptance": "192 lexer fixtures with deterministic token streams", "owner": "zap", "source": "bootstrap/b1/lexer.zp", "status": "zap_owned"}, {"acceptance": "62 parser fixtures with deterministic AST/diagnostic replay", "owner": "zap", "source": "bootstrap/b1/parser.zp", "status": "zap_owned"}, {"acceptance": "5 module diagnostic families with deterministic graph replay", "owner": "zap", "source": "bootstrap/b4/compiler_driver.zp", "status": "zap_owned"}], "reference_owner": "rust", "schema_version": 1, "status": "verified_frontend_components_candidate_language"}

export fn driver_module_resolution_ownership():
    return {"canonicalization": ["backslash-to-slash", "duplicate-separator-collapse", "zp-extension-strip"], "diagnostics": ["ZAP-MODULE-001", "ZAP-MODULE-002", "ZAP-MODULE-003", "ZAP-MODULE-004", "ZAP-MODULE-005"], "owner": "zap", "source": "bootstrap/b4/compiler_driver.zp", "status": "zap_owned", "schema_version": 1, "reference_owner": "rust"}

export fn driver_typed_ir_backend_ownership():
    return {"components": [{"owner": "zap", "source": "bootstrap/b2/typed_ir.zp", "stage": "typed_ir", "status": "promotion_required"}, {"owner": "zap", "source": "bootstrap/b3/lower.zp", "stage": "lowering", "status": "zap_owned"}, {"owner": "zap", "source": "bootstrap/b3/vm.zp", "stage": "backend_vm", "status": "zap_owned"}], "complete_language": false, "promotion_boundary": "driver_promote_typed_ir", "reference_owner": "rust", "schema_version": 1, "status": "zap_owned_backend_candidate_surface"}

export fn driver_normalize_source(source):
    let without_bom = replace(source, "\ufeff", "")
    return replace(replace(without_bom, "\r\n", "\n"), "\r", "\n")

export fn driver_result(command, source_name, status, diagnostics, artifacts, execution):
    return {"artifacts": artifacts, "command": command, "diagnostics": diagnostics, "execution": execution, "native_independent": false, "schema_version": 1, "source_name": source_name, "status": status}

export fn driver_parse_source(source, source_name):
    let normalized = driver_normalize_source(source)
    let parsed = from_json(parse_general(normalized, source_name))
    if parsed["kind"] != "zap.ast":
        return {"diagnostics": [parsed], "kind": "zap.parse_result", "status": "error", "source_name": source_name}
    return {"ast": parsed, "diagnostics": [], "kind": "zap.parse_result", "status": "ok", "source_name": source_name}

export fn driver_typecheck_source(source, source_name):
    let normalized = driver_normalize_source(source)
    let emitted = from_json(emit_inferred_program_typed_ir(normalized, source_name))
    if emitted["kind"] != "zap.typed_ir":
        return {"diagnostics": [emitted], "kind": "zap.typecheck_result", "status": "error", "source_name": source_name}
    return {"diagnostics": [], "kind": "zap.typecheck_result", "status": "ok", "source_name": source_name, "typed_ir": emitted}

export fn driver_normalize_module_name(source_name):
    let normalized = replace(source_name, "\\", "/")
    while contains(normalized, "//"):
        normalized = replace(normalized, "//", "/")
    if ends_with(normalized, ".zp"):
        return substring(normalized, 0, len(normalized) - 3)
    return normalized

export fn driver_module_name_matches(source_name, module_name):
    let normalized_source = driver_normalize_module_name(source_name)
    let normalized_module = driver_normalize_module_name(module_name)
    if normalized_source == normalized_module:
        return true
    return ends_with(normalized_source, "/" + normalized_module)

export fn driver_module_match_count(modules, imported):
    let count = 0
    for candidate in modules:
        if driver_module_name_matches(candidate["source_name"], imported):
            count = count + 1
    return count

export fn driver_module_index(modules, imported, index):
    if index >= len(modules):
        return -1
    if driver_module_name_matches(modules[index]["source_name"], imported):
        return index
    return driver_module_index(modules, imported, index + 1)

export fn driver_order_module(modules, index, visiting, visited, ordered):
    let module = modules[index]
    let key = module["module"]
    if contains(visiting, key):
        return {"diagnostics": [{"code": "ZAP-MODULE-005", "message": "module dependency cycle: " + key, "source_name": module["source_name"]}], "ordered": ordered, "status": "module_resolution_error", "visited": visited}
    if contains(visited, key):
        return {"diagnostics": [], "ordered": ordered, "status": "ok", "visited": visited}
    let next_visiting = append(visiting, key)
    let imports = sort(module["imports"])
    for imported in imports:
        let dependency_index = driver_module_index(modules, imported, 0)
        let dependency = driver_order_module(modules, dependency_index, next_visiting, visited, ordered)
        if dependency["status"] != "ok":
            return dependency
        ordered = dependency["ordered"]
        visited = dependency["visited"]
    ordered = append(ordered, module)
    visited = append(visited, key)
    return {"diagnostics": [], "ordered": ordered, "status": "ok", "visited": visited}

export fn driver_order_modules(modules):
    let keys = []
    for module in modules:
        keys = append(keys, module["module"])
    let ordered_keys = sort(keys)
    let ordered = []
    let visited = []
    for key in ordered_keys:
        let index = driver_module_index(modules, key, 0)
        let result = driver_order_module(modules, index, [], visited, ordered)
        if result["status"] != "ok":
            return result
        ordered = result["ordered"]
        visited = result["visited"]
    return {"diagnostics": [], "ordered": ordered, "status": "ok", "visited": visited}

export fn driver_module_graph_manifest(modules):
    let module_records = []
    let edges = []
    for module in modules:
        let imports = sort(module["imports"])
        module_records = append(module_records, {"imports": imports, "module": module["module"], "source_name": module["source_name"]})
        for imported in imports:
            let dependency_index = driver_module_index(modules, imported, 0)
            edges = append(edges, {"from": module["module"], "to": modules[dependency_index]["module"]})
    return {"edges": edges, "modules": module_records, "schema_version": 1, "status": "canonical_module_graph"}

export fn driver_collect_imports(statements, result):
    for statement in statements:
        if statement["kind"] == "import":
            result = append(result, replace(statement["path"], "\"", ""))
    return result

export fn driver_resolve_modules(sources, source_names):
    if len(sources) != len(source_names):
        return {"diagnostics": [{"code": "ZAP-MODULE-001", "message": "source and source-name counts differ"}], "modules": [], "status": "module_resolution_error"}
    let modules = []
    for index in range(0, len(sources)):
        let parsed = driver_parse_source(sources[index], source_names[index])
        if parsed["status"] != "ok":
            return {"diagnostics": parsed["diagnostics"], "modules": [], "status": "module_resolution_error"}
        let imports = driver_collect_imports(parsed["ast"]["ast"]["statements"], [])
        let module_name = driver_normalize_module_name(source_names[index])
        for existing in modules:
            if existing["module"] == module_name:
                return {"diagnostics": [{"code": "ZAP-MODULE-002", "message": "duplicate module: " + module_name, "source_name": source_names[index]}], "modules": [], "status": "module_resolution_error"}
        modules = append(modules, {"imports": imports, "module": module_name, "source_name": replace(source_names[index], "\\", "/")})
    let keys = []
    for module in modules:
        keys = append(keys, module["module"])
    let ordered_keys = sort(keys)
    let ordered = []
    for key in ordered_keys:
        for module in modules:
            if module["module"] == key:
                ordered = append(ordered, module)
    for module in ordered:
        for imported in module["imports"]:
            let matches = driver_module_match_count(ordered, imported)
            if matches == 0:
                return {"diagnostics": [{"code": "ZAP-MODULE-003", "message": "module not found: " + imported, "source_name": module["source_name"]}], "modules": [], "status": "module_resolution_error"}
            if matches > 1:
                return {"diagnostics": [{"code": "ZAP-MODULE-004", "message": "ambiguous module import: " + imported, "source_name": module["source_name"]}], "modules": [], "status": "module_resolution_error"}
    let dependency_order = driver_order_modules(ordered)
    if dependency_order["status"] != "ok":
        return {"diagnostics": dependency_order["diagnostics"], "modules": [], "status": "module_resolution_error"}
    return {"diagnostics": [], "modules": dependency_order["ordered"], "status": "modules_resolved"}

export fn driver_modules_graph_replay(sources, source_names):
    let first = driver_resolve_modules(sources, source_names)
    if first["status"] != "modules_resolved":
        return {"byte_equal": false, "first": first, "native_independent": false, "second": first, "status": "candidate_module_graph_error"}
    let second = driver_resolve_modules(sources, source_names)
    if second["status"] != "modules_resolved":
        return {"byte_equal": false, "first": first, "native_independent": false, "second": second, "status": "candidate_module_graph_error"}
    let first_manifest = json(driver_module_graph_manifest(first["modules"]))
    let second_manifest = json(driver_module_graph_manifest(second["modules"]))
    let status = "candidate_module_graph_replay"
    if first_manifest != second_manifest:
        status = "candidate_module_graph_error"
    return {"byte_equal": first_manifest == second_manifest, "first": first, "first_manifest": first_manifest, "native_independent": false, "second": second, "second_manifest": second_manifest, "status": status}

export fn driver_source_index(source_names, source_name, index):
    if index >= len(source_names):
        return -1
    if replace(source_names[index], "\\", "/") == source_name:
        return index
    return driver_source_index(source_names, source_name, index + 1)

export fn driver_check_modules(sources, source_names):
    let resolution = driver_resolve_modules(sources, source_names)
    if resolution["status"] != "modules_resolved":
        return {"artifacts": [], "command": "check", "diagnostics": resolution["diagnostics"], "execution": {"error": "module_resolution_error", "output": []}, "native_independent": false, "schema_version": 1, "source_name": "<module-set>", "status": "error"}
    let artifacts = []
    for module in resolution["modules"]:
        let typed = driver_typecheck_source(sources[driver_source_index(source_names, module["source_name"], 0)], module["source_name"])
        if typed["status"] != "ok":
            return {"artifacts": [], "command": "check", "diagnostics": typed["diagnostics"], "execution": {"error": "typecheck_error", "output": []}, "native_independent": false, "schema_version": 1, "source_name": module["source_name"], "status": "error"}
        artifacts = append(artifacts, {"bytes": json(typed["typed_ir"]), "kind": "typed_ir", "source_name": module["source_name"]})
    return {"artifacts": artifacts, "command": "check", "diagnostics": [], "execution": {"error": none, "output": []}, "module_order": resolution["modules"], "native_independent": false, "schema_version": 1, "source_name": "<module-set>", "status": "ok"}

export fn driver_build_modules(sources, source_names):
    let resolution = driver_resolve_modules(sources, source_names)
    if resolution["status"] != "modules_resolved":
        return {"artifacts": [], "command": "build", "diagnostics": resolution["diagnostics"], "execution": {"error": "module_resolution_error", "output": []}, "native_independent": false, "schema_version": 1, "source_name": "<module-set>", "status": "error"}
    let artifacts = []
    for module in resolution["modules"]:
        let index = driver_source_index(source_names, module["source_name"], 0)
        let built = driver_build_source(sources[index], module["source_name"])
        if built["status"] != "ok":
            return {"artifacts": [], "command": "build", "diagnostics": built["diagnostics"], "execution": built["execution"], "native_independent": false, "schema_version": 1, "source_name": module["source_name"], "status": "error"}
        for artifact in built["artifacts"]:
            artifacts = append(artifacts, {"bytes": artifact["bytes"], "kind": artifact["kind"], "source_name": module["source_name"]})
    return {"artifacts": artifacts, "command": "build", "diagnostics": [], "execution": {"error": none, "output": []}, "module_order": resolution["modules"], "native_independent": false, "schema_version": 1, "source_name": "<module-set>", "status": "ok"}

export fn driver_module_build_manifest(build_result):
    let artifacts = []
    for artifact in build_result["artifacts"]:
        artifacts = append(artifacts, {"bytes": artifact["bytes"], "digest": artifact["kind"] + ":" + artifact["bytes"], "kind": artifact["kind"], "source_name": replace(artifact["source_name"], "\\", "/")})
    return {"artifacts": artifacts, "command": build_result["command"], "module_order": build_result["module_order"], "schema_version": 1, "source_name": build_result["source_name"], "status": build_result["status"]}

export fn driver_modules_rebuild(sources, source_names):
    let first = driver_build_modules(sources, source_names)
    if first["status"] != "ok":
        return {"byte_equal": false, "first": first, "native_independent": false, "second": first, "status": "candidate_module_rebuild_error"}
    let second = driver_build_modules(sources, source_names)
    if second["status"] != "ok":
        return {"byte_equal": false, "first": first, "native_independent": false, "second": second, "status": "candidate_module_rebuild_error"}
    let first_bytes = json(driver_module_build_manifest(first))
    let second_bytes = json(driver_module_build_manifest(second))
    let status = "candidate_module_rebuild"
    if first_bytes != second_bytes:
        status = "candidate_module_rebuild_error"
    return {"byte_equal": first_bytes == second_bytes, "first": first, "first_manifest": first_bytes, "native_independent": false, "second": second, "second_manifest": second_bytes, "status": status}

export fn driver_typed_ir_semantics(first, second):
    let valid = first["kind"] == "zap.typed_ir"
    if not contains(json(first), "\"source_name\""):
        valid = false
    if not contains(json(first), "\"ir\"") or not contains(json(first["ir"]), "\"nodes\""):
        valid = false
    let deterministic = json(first) == json(second)
    if not deterministic:
        valid = false
    let ownership = driver_typed_ir_ownership(first, second)
    let status = "candidate_typed_ir_semantics"
    if ownership["ownership"] == "zap_owned":
        status = "zap_owned_typed_ir_semantics"
    if not valid:
        status = "typed_ir_semantics_error"
    return {"candidate_only": first["candidate_only"], "deterministic": deterministic, "executable": ownership["executable"], "kind": first["kind"], "node_count": len(first["ir"]["nodes"]), "ownership": ownership["ownership"], "reference_owner": ownership["reference_owner"], "schema_version": first["schema_version"], "status": status, "valid": valid}

export fn driver_typed_ir_ast_statements(nodes, result):
    for node in nodes:
        if contains(json(node), "\"ast\""):
            result = append(result, node["ast"])
    return result

export fn driver_typed_ir_nested_coverage_valid(value, index):
    if value == none:
        return true
    let encoded = json(value)
    if contains(encoded, "\"statements\""):
        return driver_typed_ir_nodes_coverage_valid(value["statements"], 0)
    if index >= len(value):
        return true
    if not driver_typed_ir_node_coverage_valid(value[index]):
        return false
    return driver_typed_ir_nested_coverage_valid(value, index + 1)

export fn driver_typed_ir_expression_coverage_valid(expression):
    if expression == none or not contains(json(expression), "\"kind\""):
        return false
    let kind = expression["kind"]
    if kind == "typed_expression":
        return driver_typed_ir_expression_coverage_valid(expression["ast"])
    let known = kind == "literal" or kind == "name" or kind == "binary" or kind == "unary" or kind == "conditional" or kind == "list" or kind == "map" or kind == "call" or kind == "member" or kind == "index" or kind == "await" or kind == "propagate"
    if not known:
        return false
    if kind == "binary":
        return driver_typed_ir_expression_coverage_valid(expression["left"]) and driver_typed_ir_expression_coverage_valid(expression["right"])
    if kind == "unary" or kind == "await" or kind == "propagate":
        return driver_typed_ir_expression_coverage_valid(expression["value"])
    if kind == "conditional":
        return driver_typed_ir_expression_coverage_valid(expression["condition"]) and driver_typed_ir_expression_coverage_valid(expression["then_branch"]) and driver_typed_ir_expression_coverage_valid(expression["else_branch"])
    if kind == "list":
        for element in expression["elements"]:
            if not driver_typed_ir_expression_coverage_valid(element):
                return false
    if kind == "map":
        for entry in expression["entries"]:
            if not driver_typed_ir_expression_coverage_valid(entry["key"]) or not driver_typed_ir_expression_coverage_valid(entry["value"]):
                return false
    if kind == "call":
        if not driver_typed_ir_expression_coverage_valid(expression["callee"]):
            return false
        for argument in expression["args"]:
            if not driver_typed_ir_expression_coverage_valid(argument["value"]):
                return false
    if kind == "member":
        return driver_typed_ir_expression_coverage_valid(expression["target"])
    if kind == "index":
        return driver_typed_ir_expression_coverage_valid(expression["target"]) and driver_typed_ir_expression_coverage_valid(expression["index"])
    return true

export fn driver_typed_ir_node_coverage_valid(node):
    if not contains(json(node), "\"kind\""):
        return false
    let kind = node["kind"]
    let known = kind == "declaration" or kind == "assignment" or kind == "function" or kind == "if" or kind == "while" or kind == "for" or kind == "say" or kind == "return" or kind == "raise" or kind == "expression" or kind == "try_catch" or kind == "class" or kind == "trait" or kind == "interface" or kind == "type_alias" or kind == "break" or kind == "continue" or kind == "import" or kind == "module" or kind == "else" or kind == "try"
    if not known:
        return false
    if kind == "function" or kind == "class" or kind == "trait" or kind == "interface":
        return driver_typed_ir_nested_coverage_valid(node["body"], 0)
    if kind == "declaration" or kind == "assignment" or kind == "say" or kind == "return" or kind == "raise" or kind == "expression":
        if not driver_typed_ir_expression_coverage_valid(node["value"]):
            return false
    if kind == "if" or kind == "while":
        if not driver_typed_ir_expression_coverage_valid(node["condition"]):
            return false
    if kind == "for" and not driver_typed_ir_expression_coverage_valid(node["iterable"]):
        return false
    if kind == "if":
        if not driver_typed_ir_nested_coverage_valid(node["then_branch"], 0):
            return false
        if contains(json(node), "\"else_branch\"") and not driver_typed_ir_nested_coverage_valid(node["else_branch"], 0):
            return false
    if kind == "while" or kind == "for" or kind == "try_catch":
        if not driver_typed_ir_nested_coverage_valid(node["body"], 0):
            return false
        if kind == "try_catch" and not driver_typed_ir_nested_coverage_valid(node["catch_body"], 0):
            return false
    return true

export fn driver_typed_ir_nodes_coverage_valid(nodes, index):
    if index >= len(nodes):
        return true
    if not driver_typed_ir_node_coverage_valid(nodes[index]):
        return false
    return driver_typed_ir_nodes_coverage_valid(nodes, index + 1)

export fn driver_typed_ir_ownership(first, second):
    let deterministic = json(first) == json(second)
    let promotable = first["kind"] == "zap.typed_ir"
    if first["schema_version"] < 4:
        promotable = false
    if not contains(json(first), "\"typed_metadata\"") or not first["typed_metadata"]:
        promotable = false
    if not contains(json(first), "\"coverage\"") or first["coverage"] != "owned_ast_with_checker_inferred_types":
        promotable = false
    if not contains(json(first), "\"diagnostics\"") or len(first["diagnostics"]) != 0:
        promotable = false
    if not contains(json(first), "\"ir\"") or not contains(json(first["ir"]), "\"nodes\""):
        promotable = false
    if promotable and not typed_ir_nodes_shape_valid(first["ir"]["nodes"], 0):
        promotable = false
    let coverage_valid = driver_typed_ir_nodes_coverage_valid(first["ir"]["nodes"], 0)
    if not coverage_valid:
        promotable = false
    if not deterministic:
        promotable = false
    let ownership = "candidate"
    let reference_owner = "rust"
    let status = "candidate_typed_ir_ownership"
    let candidate_only = false
    if contains(json(first), "\"candidate_only\""):
        candidate_only = first["candidate_only"]
    if promotable:
        ownership = "zap_owned"
        reference_owner = "zap"
        status = "zap_owned_typed_ir"
        candidate_only = false
    return {"candidate_only": candidate_only, "coverage_valid": coverage_valid, "deterministic": deterministic, "executable": promotable, "kind": first["kind"], "node_count": len(first["ir"]["nodes"]), "ownership": ownership, "reference_owner": reference_owner, "schema_version": first["schema_version"], "status": status, "valid": promotable}

export fn driver_finalize_typed_ir(first, ownership):
    return {"candidate_only": false, "coverage": first["coverage"], "diagnostics": first["diagnostics"], "ir": first["ir"], "kind": first["kind"], "ownership": ownership["ownership"], "reference_owner": ownership["reference_owner"], "schema_version": first["schema_version"], "source_name": first["source_name"], "typed_metadata": first["typed_metadata"]}

export fn driver_promote_typed_ir(source, source_name):
    let normalized = driver_normalize_source(source)
    let first = from_json(emit_inferred_program_typed_ir(normalized, source_name))
    let second = from_json(emit_inferred_program_typed_ir(normalized, source_name))
    let ownership = driver_typed_ir_ownership(first, second)
    if ownership["ownership"] != "zap_owned":
        return {"diagnostics": [{"code": "ZAP-TYPED-IR-001", "message": "typed IR promotion failed closed", "ownership": ownership["ownership"], "source_name": source_name}], "ownership": ownership, "status": "typed_ir_promotion_blocked", "typed_ir": first}
    let finalized = driver_finalize_typed_ir(first, ownership)
    return {"diagnostics": [], "ownership": ownership, "status": "typed_ir_promoted", "typed_ir": finalized}

export fn driver_compile_backend(source, source_name):
    let typed = driver_promote_typed_ir(source, source_name)
    if typed["status"] != "typed_ir_promoted":
        return {"bytecode": {"artifact_kind": "bytecode", "error": "typed_ir_promotion_error", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}, "diagnostics": typed["diagnostics"], "execution": {"error": "typed_ir_promotion_error", "output": []}, "ownership": "blocked", "reference_owner": "rust", "status": "error", "typed_ir": typed["typed_ir"]}
    # Inferred typed-IR wraps parser AST under node["ast"]. Lower the recovered
    # AST program — the same path as seed_compile_inferred_typed_ir — because
    # lower_typed_ir does not accept typed_expression wrappers.
    let statements = driver_typed_ir_ast_statements(typed["typed_ir"]["ir"]["nodes"], [])
    let ast = {"ast": {"statements": statements}, "kind": "zap.ast"}
    let lowered = lower_ast_program(ast)
    if lowered["error"] != none:
        return {"bytecode": {"artifact_kind": "bytecode", "error": lowered["error"], "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}, "diagnostics": [], "execution": {"error": lowered["error"], "output": []}, "ownership": "zap_owned", "reference_owner": "zap", "status": "error", "typed_ir": typed["typed_ir"]}
    let execution = vm_run(lowered["instructions"])
    let status = "ok"
    if execution["error"] != none:
        status = "error"
    return {"bytecode": {"artifact_kind": "bytecode", "error": none, "instructions": lowered["instructions"], "native_independent": false, "source_name": source_name, "status": "compiled_driver_backend"}, "diagnostics": [], "execution": execution, "ownership": "zap_owned", "reference_owner": "zap", "status": status, "typed_ir": typed["typed_ir"]}

export fn driver_execute_owned_pipeline(source, source_name):
    let backend = driver_compile_backend(source, source_name)
    if backend["status"] != "ok":
        return {"artifacts": [], "diagnostics": backend["diagnostics"], "error": backend["execution"]["error"], "execution": backend["execution"], "native_independent": false, "ownership": backend["ownership"], "reference_owner": backend["reference_owner"], "source_name": source_name, "stage_chain_valid": false, "status": "compile_error"}
    let typed_bytes = json(backend["typed_ir"])
    let bytecode_bytes = json(backend["bytecode"]["instructions"])
    let typed_digest = driver_seed_pipeline_digest("typed_ir", typed_bytes)
    let bytecode_digest = driver_seed_pipeline_digest("bytecode", bytecode_bytes)
    let source_digest = driver_seed_pipeline_digest("source", source)
    let execution_digest = driver_seed_pipeline_digest("execution", backend["execution"])
    let stages = [{"input_digest": source_digest, "input_kind": "source", "output_digest": typed_digest, "output_kind": "typed_ir", "stage": "source_to_typed_ir"}, {"input_digest": typed_digest, "input_kind": "typed_ir", "output_digest": bytecode_digest, "output_kind": "bytecode", "stage": "typed_ir_to_bytecode"}, {"input_digest": bytecode_digest, "input_kind": "bytecode", "output_digest": execution_digest, "output_kind": "execution", "stage": "bytecode_to_vm"}]
    let status = "candidate_pipeline_executed"
    if backend["execution"]["error"] != none:
        status = "candidate_pipeline_error"
    return {"artifacts": [{"bytes": typed_bytes, "digest": typed_digest, "kind": "typed_ir"}, {"bytes": bytecode_bytes, "digest": bytecode_digest, "kind": "bytecode"}], "error": backend["execution"]["error"], "execution": backend["execution"], "native_independent": false, "ownership": backend["ownership"], "reference_owner": backend["reference_owner"], "source_name": source_name, "stage_chain_valid": true, "stages": stages, "status": status}

export fn driver_check_source(source, source_name):
    let parsed = driver_parse_source(source, source_name)
    if parsed["status"] != "ok":
        return driver_result("check", source_name, "error", parsed["diagnostics"], [], {"error": "parse_error", "output": []})
    let typed = driver_typecheck_source(source, source_name)
    if typed["status"] != "ok":
        return driver_result("check", source_name, "error", typed["diagnostics"], [], {"error": "typecheck_error", "output": []})
    return driver_result("check", source_name, "ok", [], [{"bytes": json(typed["typed_ir"]), "kind": "typed_ir"}], {"error": none, "output": []})

export fn driver_build_source(source, source_name):
    let backend = driver_compile_backend(source, source_name)
    if backend["status"] != "ok":
        return driver_result("build", source_name, "error", backend["diagnostics"], [], backend["execution"])
    let artifacts = [{"bytes": json(backend["typed_ir"]), "kind": "typed_ir"}, {"bytes": json(backend["bytecode"]["instructions"]), "kind": "bytecode"}]
    return driver_result("build", source_name, "ok", [], artifacts, {"error": none, "output": []})

export fn driver_run_source(source, source_name):
    let backend = driver_compile_backend(source, source_name)
    if backend["status"] != "ok":
        return driver_result("run", source_name, "error", backend["diagnostics"], [], backend["execution"])
    let artifacts = [{"bytes": json(backend["typed_ir"]), "kind": "typed_ir"}, {"bytes": json(backend["bytecode"]["instructions"]), "kind": "bytecode"}]
    return driver_result("run", source_name, "ok", [], artifacts, backend["execution"])

export fn driver_test_source(source, source_name):
    let result = driver_run_source(source, source_name)
    if result["status"] != "ok":
        return result
    let plan = {"network": false, "stages": [{"input_kind": "source", "name": "test_discovery", "output_kind": "test_result", "owner": "zap"}]}
    let acceptance = runner_acceptance(plan)
    return {"artifacts": result["artifacts"], "command": "test", "diagnostics": result["diagnostics"], "execution": result["execution"], "native_independent": false, "runner_contract": acceptance, "schema_version": 1, "source_name": result["source_name"], "status": "ok", "tests": 1, "passed": 1}

export fn driver_command(command, source, source_name):
    if command == "check":
        return driver_check_source(source, source_name)
    if command == "build":
        return driver_build_source(source, source_name)
    if command == "run":
        return driver_run_source(source, source_name)
    if command == "test":
        return driver_test_source(source, source_name)
    return driver_result(command, source_name, "error", [{"code": "ZAP-DRIVER-001", "message": "unsupported driver command: " + command, "severity": "error", "source_name": source_name}], [], {"error": "unsupported_command", "output": []})

export fn driver_build_package(package_name, package_version, main, requirements, registry, source, source_name):
    let manifest_value = manifest(package_name, package_version, main, requirements)
    let graph = resolve_dependency_graph(requirements, registry)
    if not graph["ok"]:
        return {"artifact_bytes": "", "artifact_digest": "", "dependency_graph": graph["resolved"], "diagnostics": graph["errors"], "lockfile": resolved_graph_lockfile(manifest_value, graph), "native_independent": false, "status": "package_dependency_error"}
    let built = driver_build_source(source, source_name)
    if built["status"] != "ok":
        return {"artifact_bytes": "", "artifact_digest": "", "dependency_graph": graph["resolved"], "diagnostics": built["diagnostics"], "lockfile": resolved_graph_lockfile(manifest_value, graph), "native_independent": false, "status": "package_pipeline_error"}
    let artifact_bytes = json(built["artifacts"])
    return {"artifact_bytes": artifact_bytes, "artifact_digest": "package_artifact:" + artifact_bytes, "dependency_graph": graph["resolved"], "diagnostics": [], "lockfile": resolved_graph_lockfile(manifest_value, graph), "native_independent": false, "status": "driver_package_build_executed"}

export fn driver_artifact_record(kind, bytes):
    return {"bytes": bytes, "digest": kind + ":" + bytes, "kind": kind}

export fn driver_canonical_artifacts(build_result):
    let result = []
    for artifact in build_result["artifacts"]:
        if artifact["kind"] == "typed_ir":
            result = append(result, driver_artifact_record("typed_ir", artifact["bytes"]))
    for artifact in build_result["artifacts"]:
        if artifact["kind"] == "bytecode":
            result = append(result, driver_artifact_record("bytecode", artifact["bytes"]))
    return result

export fn driver_artifact_manifest(build_result):
    return {"artifacts": driver_canonical_artifacts(build_result), "command": build_result["command"], "schema_version": 1, "source_name": replace(build_result["source_name"], "\\", "/"), "status": build_result["status"]}

export fn driver_rebuild(source, source_name):
    let first = driver_build_source(source, source_name)
    if first["status"] != "ok":
        return {"byte_equal": false, "first": first, "native_independent": false, "second": first, "status": "candidate_driver_rebuild_error"}
    let second = driver_build_source(source, source_name)
    if second["status"] != "ok":
        return {"byte_equal": false, "first": first, "native_independent": false, "second": second, "status": "candidate_driver_rebuild_error"}
    let first_bytes = json(driver_artifact_manifest(first))
    let second_bytes = json(driver_artifact_manifest(second))
    let byte_equal = first_bytes == second_bytes
    let status = "candidate_driver_rebuild"
    if not byte_equal:
        status = "candidate_driver_rebuild_error"
    return {"byte_equal": byte_equal, "first": first, "native_independent": false, "second": second, "status": status}

export fn driver_subset_run(sources, source_names, index, result):
    if index >= len(sources):
        return result
    let next = append(result, driver_execute_owned_pipeline(sources[index], source_names[index]))
    return driver_subset_run(sources, source_names, index + 1, next)

export fn driver_subset_rebuild(sources, source_names):
    let first = driver_subset_run(sources, source_names, 0, [])
    let second = driver_subset_run(sources, source_names, 0, [])
    let all_successful = true
    for result in first:
        if result["status"] != "candidate_pipeline_executed":
            all_successful = false
    for result in second:
        if result["status"] != "candidate_pipeline_executed":
            all_successful = false
    let byte_equal = json(first) == json(second)
    let status = "candidate_driver_subset_rebuild"
    if not all_successful or not byte_equal:
        status = "candidate_driver_subset_rebuild_error"
    return {"all_successful": all_successful, "byte_equal": byte_equal, "count": len(first), "first": first, "native_independent": false, "second": second, "status": status}
export fn driver_contract_status():
    return "candidate"

# Seed adapter functions for migration from native_independent.zp
# These provide Zap-owned equivalents of the bounded seed slice functions

export fn driver_seed_pipeline_digest(kind, payload):
    return kind + ":" + json(payload)

export fn driver_seed_compile_bytes(artifact):
    return json(artifact)

export fn driver_seed_compile_source(source, source_name):
    # Use the full driver pipeline instead of the bounded seed slice
    let backend = driver_compile_backend(source, source_name)
    if backend["status"] != "ok":
        return {"artifact_kind": "bytecode", "error": backend["execution"]["error"], "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    return {"artifact_kind": "bytecode", "instructions": backend["bytecode"]["instructions"], "native_independent": false, "source_name": source_name, "status": "compiled_slice"}

export fn driver_seed_pipeline_replay(source, source_name):
    let first = driver_execute_owned_pipeline(source, source_name)
    let second = driver_execute_owned_pipeline(source, source_name)
    return {"byte_equal": json(first) == json(second), "first": first, "native_independent": false, "second": second, "status": "candidate_pipeline_replay"}

export fn driver_seed_self_rebuild(source, source_name):
    let first = driver_seed_compile_source(source, source_name)
    let second = driver_seed_compile_source(source, source_name)
    let first_bytes = driver_seed_compile_bytes(first)
    let second_bytes = driver_seed_compile_bytes(second)
    let status = "mismatch"
    if first_bytes == second_bytes:
        status = "reproducible"
    return {"byte_equal": first_bytes == second_bytes, "first": first, "second": second, "status": status}

export fn driver_seed_self_rebuild_ast(source, source_name):
    let first = driver_seed_compile_ast_source(source, source_name)
    let second = driver_seed_compile_ast_source(source, source_name)
    let first_bytes = driver_seed_compile_bytes(first)
    let second_bytes = driver_seed_compile_bytes(second)
    let status = "mismatch"
    if first_bytes == second_bytes and first["status"] == "compiled_ast_slice":
        status = "reproducible_ast_slice"
    return {"byte_equal": first_bytes == second_bytes, "first": first, "native_independent": false, "second": second, "status": status}

export fn driver_seed_compile_ast_source(source, source_name):
    let preflight = driver_seed_incomplete_assignment_diagnostic(source, source_name)
    if preflight != none:
        return {"artifact_kind": "bytecode", "diagnostics": [from_json(preflight)], "error": "syntax_diagnostic", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    let parsed = from_json(parse_general(source, source_name))
    if parsed["kind"] != "zap.ast":
        return {"artifact_kind": "bytecode", "error": "parse_error", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    let lowered = lower_ast_program(parsed)
    if lowered["error"] != none:
        return {"artifact_kind": "bytecode", "error": lowered["error"], "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    return {"artifact_kind": "bytecode", "instructions": lowered["instructions"], "native_independent": false, "source_name": source_name, "status": "compiled_ast_slice"}

export fn driver_seed_compile_typed_ir(ir, source_name):
    if ir["kind"] != "zap.typed_ir":
        return {"artifact_kind": "bytecode", "error": "invalid_typed_ir", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    let lowered = lower_typed_ir(ir)
    if lowered["error"] != none:
        return {"artifact_kind": "bytecode", "error": lowered["error"], "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    return {"artifact_kind": "bytecode", "error": none, "instructions": lowered["instructions"], "native_independent": false, "source_name": source_name, "status": "compiled_typed_ir_slice"}

export fn driver_seed_compile_typed_ir_source(source, source_name):
    let emitted = from_json(emit(source, source_name))
    if emitted["kind"] != "zap.typed_ir":
        return {"artifact_kind": "bytecode", "error": "typed_ir_emit_error", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    let artifact = driver_seed_compile_typed_ir(emitted, source_name)
    return {"artifact_kind": artifact["artifact_kind"], "error": artifact["error"], "instructions": artifact["instructions"], "native_independent": false, "source_name": source_name, "status": artifact["status"], "typed_ir": emitted}

export fn driver_seed_compile_inferred_typed_ir(typed, source_name):
    if typed["kind"] != "zap.typed_ir":
        return {"artifact_kind": "bytecode", "error": "invalid_typed_ir_kind", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    let ast_nodes = driver_seed_typed_ir_ast_statements(typed["ir"]["nodes"], [])
    let ast = {"ast": {"statements": ast_nodes}, "kind": "zap.ast"}
    let lowered = lower_ast_program(ast)
    if lowered["error"] != none:
        return {"artifact_kind": "bytecode", "error": lowered["error"], "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    return {"artifact_kind": "bytecode", "error": none, "instructions": lowered["instructions"], "native_independent": false, "source_name": source_name, "status": "compiled_inferred_typed_ir_slice", "typed_ir": typed}

export fn driver_seed_typed_ir_ast_statements(nodes, result):
    for node in nodes:
        if contains(json(node), "\"ast\":"):
            result = append(result, node["ast"])
    return result

export fn driver_seed_self_compile_acceptance(source, source_name):
    let rebuild = driver_seed_self_rebuild_inferred_typed_ir(source, source_name)
    return {"byte_equal": rebuild["byte_equal"], "native_independent": false, "status": rebuild["status"], "supported": rebuild["status"] == "reproducible_inferred_typed_ir_slice"}

export fn driver_seed_rebuild_acceptance_ast(source, source_name):
    let rebuild = driver_seed_self_rebuild_ast(source, source_name)
    return {"byte_equal": rebuild["byte_equal"], "native_independent": false, "status": rebuild["status"], "supported": rebuild["status"] == "reproducible_ast_slice"}

export fn driver_seed_platform_record_evidence(target, artifact_bytes, artifact_digest, execution_status, source_digest, toolchain_digest, environment, execution_mode):
    return seed_platform_record_evidence(target, artifact_bytes, artifact_digest, execution_status, source_digest, toolchain_digest, environment, execution_mode)

export fn driver_seed_platform_evidence_matrix_valid(records, expected_targets):
    return seed_platform_evidence_matrix_valid(records, expected_targets)

export fn driver_seed_incomplete_assignment_diagnostic(source, source_name):
    let declaration = contains(source, "let ")
    if not declaration:
        declaration = contains(source, "set ")
    if declaration:
        let has_assignment = contains(source, " =")
        if has_assignment:
            let has_value = contains(source, " = ")
            if not has_value:
                return json({"diagnostics": [{"code": "ZAP-SYNTAX-001", "column": len(source) + 1, "help": "add an expression after '='", "line": 1, "message": "expected expression after '='", "severity": "error", "source_name": source_name}], "kind": "zap.diagnostics", "schema_version": 1, "source_name": source_name})
    return none

export fn driver_seed_emit_inferred_program_typed_ir(source, source_name):
    let preflight = driver_seed_incomplete_assignment_diagnostic(source, source_name)
    if preflight != none:
        return preflight
    return emit_inferred_program_typed_ir(source, source_name)

export fn driver_seed_compile_inferred_typed_ir_source(source, source_name):
    let preflight = driver_seed_incomplete_assignment_diagnostic(source, source_name)
    if preflight != none:
        return {"artifact_kind": "bytecode", "diagnostics": [from_json(preflight)], "error": "syntax_diagnostic", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    let emitted = from_json(driver_seed_emit_inferred_program_typed_ir(source, source_name))
    if emitted["kind"] != "zap.typed_ir":
        return {"artifact_kind": "bytecode", "error": "typed_ir_emit_error", "instructions": [], "native_independent": false, "source_name": source_name, "status": "compile_error"}
    return driver_seed_compile_inferred_typed_ir(emitted, source_name)

export fn driver_seed_self_rebuild_inferred_typed_ir(source, source_name):
    let first = driver_seed_compile_inferred_typed_ir_source(source, source_name)
    let second = driver_seed_compile_inferred_typed_ir_source(source, source_name)
    let first_bytes = driver_seed_compile_bytes(first)
    let second_bytes = driver_seed_compile_bytes(second)
    let status = "mismatch"
    if first_bytes == second_bytes and first["status"] == "compiled_inferred_typed_ir_slice":
        status = "reproducible_inferred_typed_ir_slice"
    return {"byte_equal": first_bytes == second_bytes, "first": first, "native_independent": false, "second": second, "status": status}

export fn driver_seed_supported_subset_run(sources, source_names, index, result):
    if index >= len(sources):
        return result
    result = append(result, driver_execute_owned_pipeline(sources[index], source_names[index]))
    return driver_seed_supported_subset_run(sources, source_names, index + 1, result)

export fn driver_seed_supported_subset_rebuild(sources, source_names):
    let first = driver_seed_supported_subset_run(sources, source_names, 0, [])
    let second = driver_seed_supported_subset_run(sources, source_names, 0, [])
    let all_successful = true
    for result in first:
        if result["status"] != "candidate_pipeline_executed":
            all_successful = false
    return {"all_successful": all_successful, "byte_equal": json(first) == json(second), "count": len(first), "first": first, "native_independent": false, "second": second, "status": "candidate_supported_subset_rebuild"}

export fn driver_seed_a13_supported_rebuild_evidence(sources, source_names, platform_records, expected_targets):
    let rebuild = driver_seed_supported_subset_rebuild(sources, source_names)
    let platform_valid = driver_seed_platform_evidence_matrix_valid(platform_records, expected_targets)
    let supported = rebuild["all_successful"]
    if not rebuild["byte_equal"]:
        supported = false
    if not platform_valid:
        supported = false
    let status = "candidate_a13_supported_rebuild"
    if not supported:
        status = "candidate_a13_rebuild_blocked"
    return {"byte_equal": rebuild["byte_equal"], "native_independent": false, "platform_evidence": platform_valid, "source_count": rebuild["count"], "status": status, "supported": supported, "vm_outputs": rebuild["first"]}

export fn driver_seed_artifact_record_valid(record):
    if not contains(json(record), "\"kind\""):
        return false
    if not contains(json(record), "\"bytes\""):
        return false
    if not contains(json(record), "\"digest\""):
        return false
    if record["kind"] == "":
        return false
    if record["bytes"] == "":
        return false
    return record["digest"] == record["kind"] + ":" + record["bytes"]

export fn driver_seed_pipeline_artifacts_valid(artifacts, index):
    if index >= len(artifacts):
        return true
    if not driver_seed_artifact_record_valid(artifacts[index]):
        return false
    return driver_seed_pipeline_artifacts_valid(artifacts, index + 1)

export fn driver_seed_owned_pipeline_contract(pipeline):
    let valid = pipeline["native_independent"] == false
    if pipeline["status"] != "candidate_pipeline_executed":
        valid = false
    if not pipeline["stage_chain_valid"]:
        valid = false
    if len(pipeline["artifacts"]) != 2:
        valid = false
    if not driver_seed_pipeline_artifacts_valid(pipeline["artifacts"], 0):
        valid = false
    if not contains(json(pipeline), "\"stages\""):
        valid = false
    let status = "candidate_owned_pipeline_contract"
    if not valid:
        status = "candidate_owned_pipeline_contract_error"
    return {"artifact_count": len(pipeline["artifacts"]), "native_independent": pipeline["native_independent"], "stage_count": len(pipeline["stages"]), "status": status, "valid": valid}

export fn driver_seed_package_artifact_contract(artifact_bytes, artifact_digest):
    let valid = artifact_bytes != ""
    if artifact_digest != driver_seed_pipeline_digest("package_artifact", artifact_bytes):
        valid = false
    let status = "candidate_package_artifact_contract"
    if not valid:
        status = "candidate_package_artifact_contract_error"
    return {"artifact_bytes_nonempty": artifact_bytes != "", "artifact_digest": artifact_digest, "status": status, "valid": valid}
