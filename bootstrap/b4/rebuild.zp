# B4 rebuild orchestration contract. Execution is still provisional until a
# native-independent Zap compiler runner consumes this plan.

export fn rebuild_stage(name, input_kind, output_kind, owner):
    return {"input_kind": input_kind, "name": name, "output_kind": output_kind, "owner": owner}

export fn rebuild_plan(seed, stages):
    return {"compiler_stage": "B4", "network": false, "seed": seed, "stages": stages, "version": 1}

export fn rebuild_artifact(plan, stage_name, digest):
    return {"compiler_stage": plan["compiler_stage"], "digest": digest, "stage": stage_name, "version": plan["version"]}

export fn rebuild_compiler_artifact(plan, stage_name, artifact_kind, artifact_bytes, digest):
    return {"artifact_kind": artifact_kind, "bytes": artifact_bytes, "compiler_stage": plan["compiler_stage"], "digest": digest, "stage": stage_name, "version": plan["version"]}

export fn rebuild_artifact_bytes(artifact):
    return json({"artifact_kind": artifact["artifact_kind"], "bytes": artifact["bytes"], "compiler_stage": artifact["compiler_stage"], "digest": artifact["digest"], "stage": artifact["stage"], "version": artifact["version"]})

export fn rebuild_two_pass(first, second):
    let first_bytes = rebuild_artifact_bytes(first)
    let second_bytes = rebuild_artifact_bytes(second)
    let status = "mismatch"
    if first_bytes == second_bytes:
        status = "reproducible"
    return {"byte_equal": first_bytes == second_bytes, "first_bytes": first_bytes, "second_bytes": second_bytes, "status": status}

export fn rebuild_stage_execution(stage, input_digest, output_digest):
    return {"input_digest": input_digest, "native_owner": false, "output_digest": output_digest, "owner": stage["owner"], "stage": stage["name"], "status": "planned"}

export fn rebuild_execution_manifest(plan, executions):
    return {"compiler_stage": plan["compiler_stage"], "executions": executions, "seed": plan["seed"], "version": plan["version"]}

export fn rebuild_manifest(plan, artifacts):
    return {"artifacts": artifacts, "compiler_stage": plan["compiler_stage"], "seed": plan["seed"], "version": plan["version"]}

export fn rebuild_is_reproducible(first, second):
    return first == second

export fn rebuild_manifest_bytes(manifest):
    return json(manifest)

export fn rebuild_bytes_reproducible(first, second):
    return rebuild_manifest_bytes(first) == rebuild_manifest_bytes(second)

export fn rebuild_owner_policy(stages):
    let zap_owned = true
    for stage in stages:
        if stage["owner"] != "zap":
            zap_owned = false
    return {"all_zap_owned": zap_owned, "native_owner_allowed": false}

export fn rebuild_acceptance(plan, expected_seed, expected_stage):
    let ownership = rebuild_owner_policy(plan["stages"])
    return {"all_zap_owned": ownership["all_zap_owned"], "native_independent": false, "native_owner_allowed": ownership["native_owner_allowed"], "seed_matches": plan["seed"] == expected_seed, "stage_matches": plan["compiler_stage"] == expected_stage}
