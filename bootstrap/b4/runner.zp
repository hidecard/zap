# B4 platform-seed runner contract. It describes execution boundaries without claiming native independence.

export fn runner_capabilities():
    return {"clock": true, "console": true, "file": true, "memory": true, "network": false, "process": false}

export fn runner_capability_allowed(capability):
    let capabilities = runner_capabilities()
    if capability == "clock":
        return capabilities["clock"]
    if capability == "console":
        return capabilities["console"]
    if capability == "file":
        return capabilities["file"]
    if capability == "memory":
        return capabilities["memory"]
    return false

export fn runner_stage_record(stage, input_digest, output_digest):
    return {"input_digest": input_digest, "native_owner": false, "output_digest": output_digest, "owner": stage["owner"], "stage": stage["name"], "status": "planned"}

export fn runner_plan_structurally_valid(plan):
    if plan["network"]:
        return false
    if len(plan["stages"]) == 0:
        return false
    for stage in plan["stages"]:
        if stage["owner"] != "zap":
            return false
        if stage["input_kind"] == "" or stage["output_kind"] == "":
            return false
    return true

export fn runner_plan_is_executable(plan):
    return false

export fn runner_artifact_handoff(stage, input_digest, output_digest):
    return {"input_digest": input_digest, "native_owner": false, "output_digest": output_digest, "owner": stage["owner"], "stage": stage["name"], "status": "produced"}

export fn runner_execute_stage(stage, input_kind, input_digest, output_digest):
    if stage["owner"] != "zap":
        return {"error": "native_owner", "status": "rejected"}
    if stage["input_kind"] != input_kind:
        return {"error": "input_kind_mismatch", "status": "rejected"}
    return {"input_digest": input_digest, "native_owner": false, "output_digest": output_digest, "output_kind": stage["output_kind"], "stage": stage["name"], "status": "executed"}

export fn runner_execute_plan(plan, initial_kind, initial_digest, output_digests):
    if not runner_plan_structurally_valid(plan):
        return {"error": "invalid_plan", "status": "rejected"}
    if len(output_digests) != len(plan["stages"]):
        return {"error": "digest_count_mismatch", "status": "rejected"}
    let executions = []
    let current_kind = initial_kind
    let current_digest = initial_digest
    let index = 0
    for stage in plan["stages"]:
        let execution = runner_execute_stage(stage, current_kind, current_digest, output_digests[index])
        if execution["status"] != "executed":
            return {"error": execution["error"], "status": "rejected"}
        executions = append(executions, execution)
        current_kind = stage["output_kind"]
        current_digest = output_digests[index]
        index = index + 1
    return {"executions": executions, "final_digest": current_digest, "final_kind": current_kind, "status": "executed"}

export fn runner_acceptance(plan):
    return {"capabilities": runner_capabilities(), "native_independent": false, "structurally_valid": runner_plan_structurally_valid(plan), "status": "contract_only"}
