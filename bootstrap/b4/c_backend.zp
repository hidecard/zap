# Zap-owned C backend foundation.
#
# This module owns validation and emission for the canonical scalar bytecode
# slice. The Python backend remains the reference for the wider runtime until
# each opcode family is migrated behind the same validation boundary.

export fn c_backend_supported_opcode(op):
    return op == "const" or op == "print" or op == "pop" or op == "halt" or op == "add" or op == "subtract" or op == "multiply" or op == "divide" or op == "remainder" or op == "equal" or op == "not_equal" or op == "less" or op == "less_equal" or op == "greater" or op == "greater_equal" or op == "and" or op == "or" or op == "not" or op == "dup" or op == "jump" or op == "jump_if_false" or op == "jump_if_true" or op == "str_concat" or op == "in" or op == "index" or op == "option_none" or op == "option_some" or op == "option_is_none" or op == "option_is_some" or op == "option_unwrap" or op == "option_unwrap_or" or op == "error_new" or op == "error_message" or op == "error_is_error" or op == "error_unwrap" or op == "store" or op == "load" or op == "make_list" or op == "list_len" or op == "list_get" or op == "list_set" or op == "list_append" or op == "list_contains" or op == "list_reverse" or op == "make_map" or op == "map_set_pair" or op == "map_get" or op == "map_set" or op == "map_has_key" or op == "map_keys" or op == "map_values" or op == "struct_new" or op == "struct_get" or op == "struct_set" or op == "struct_has_field" or op == "struct_field_names"

export fn c_backend_validation_supported_opcode(op):
    return op == "add" or op == "and" or op == "async_new" or op == "await" or op == "call" or op == "const" or op == "divide" or op == "dup" or op == "equal" or op == "error_is_error" or op == "error_message" or op == "error_new" or op == "error_unwrap" or op == "export_value" or op == "function_def" or op == "greater" or op == "greater_equal" or op == "halt" or op == "import_module" or op == "import_symbol" or op == "in" or op == "index" or op == "jump" or op == "jump_if_false" or op == "jump_if_true" or op == "less" or op == "less_equal" or op == "list_append" or op == "list_contains" or op == "list_get" or op == "list_len" or op == "list_reverse" or op == "list_set" or op == "make_list" or op == "make_map" or op == "map_get" or op == "map_has_key" or op == "map_keys" or op == "map_set" or op == "map_set_pair" or op == "map_values" or op == "multiply" or op == "not" or op == "not_equal" or op == "option_is_none" or op == "option_is_some" or op == "option_none" or op == "option_some" or op == "option_unwrap" or op == "option_unwrap_or" or op == "or" or op == "pop" or op == "print" or op == "remainder" or op == "return_none" or op == "return_value" or op == "str_concat" or op == "struct_field_names" or op == "struct_get" or op == "struct_has_field" or op == "struct_new" or op == "struct_set" or op == "store" or op == "subtract" or op == "load"

export fn c_backend_validation_opcode_manifest():
    return ["add", "and", "async_new", "await", "call", "const", "divide", "dup", "equal", "error_is_error", "error_message", "error_new", "error_unwrap", "export_value", "function_def", "greater", "greater_equal", "halt", "import_module", "import_symbol", "in", "index", "jump", "jump_if_false", "jump_if_true", "less", "less_equal", "list_append", "list_contains", "list_get", "list_len", "list_reverse", "list_set", "load", "make_list", "make_map", "map_get", "map_has_key", "map_keys", "map_set", "map_set_pair", "map_values", "multiply", "not", "not_equal", "option_is_none", "option_is_some", "option_none", "option_some", "option_unwrap", "option_unwrap_or", "or", "pop", "print", "remainder", "return_none", "return_value", "store", "str_concat", "struct_field_names", "struct_get", "struct_has_field", "struct_new", "struct_set", "subtract"]

export fn c_backend_validation_target_opcode(op):
    return op == "jump" or op == "jump_if_false" or op == "jump_if_true"

export fn c_backend_scalar_value_valid(value):
    let encoded = json(value)
    return value == none or value == true or value == false or (starts_with(encoded, "\"") and ends_with(encoded, "\"")) or (not starts_with(encoded, "[") and not starts_with(encoded, "{") and not contains(encoded, "\""))

export fn c_backend_instruction_valid(instruction):
    if not contains(json(instruction), "\"op\""):
        return false
    let op = instruction["op"]
    if not c_backend_supported_opcode(op):
        return false
    if op == "const" and not contains(json(instruction), "\"value\""):
        return false
    if op == "const" and not c_backend_scalar_value_valid(instruction["value"]):
        return false
    if op == "make_list" and not contains(json(instruction), "\"count\""):
        return false
    if (op == "jump" or op == "jump_if_false" or op == "jump_if_true") and not contains(json(instruction), "\"target\""):
        return false
    return true

export fn c_backend_canonical_instruction_valid(instruction, instruction_count):
    let encoded = json(instruction)
    if not contains(encoded, "\"op\""):
        return false
    let op = instruction["op"]
    if not c_backend_validation_supported_opcode(op):
        return false
    if op == "const" and (not contains(encoded, "\"value\"") or not c_backend_scalar_value_valid(instruction["value"])):
        return false
    if c_backend_validation_target_opcode(op) and not contains(encoded, "\"target\""):
        return false
    if op == "call" and not contains(encoded, "\"name\""):
        return false
    if op == "function_def" and (not contains(encoded, "\"name\"") or not contains(encoded, "\"params\"") or not contains(encoded, "\"entry\"") or not contains(encoded, "\"end\"")):
        return false
    if op == "make_list" and not contains(encoded, "\"count\""):
        return false
    return true

export fn c_backend_validate_instructions(bytecode, index):
    if index >= len(bytecode):
        return {"error": none, "instruction_count": len(bytecode), "status": "validated"}
    if not c_backend_canonical_instruction_valid(bytecode[index], len(bytecode)):
        return {"error": "unsupported_or_malformed_instruction:" + str(index), "instruction_count": index, "status": "rejected"}
    return c_backend_validate_instructions(bytecode, index + 1)

export fn c_backend_validate_bytecode(bytecode):
    let checked = c_backend_validate_instructions(bytecode, 0)
    if checked["status"] != "validated":
        return {"error": checked["error"], "instruction_count": checked["instruction_count"], "ownership": "zap", "reference_owner": "zap", "status": "rejected"}
    return {"error": none, "instruction_count": checked["instruction_count"], "ownership": "zap", "reference_owner": "zap", "schema_version": 1, "status": "validated"}

export fn c_backend_emittable_instructions(bytecode, index):
    if index >= len(bytecode):
        return true
    if not c_backend_instruction_valid(bytecode[index]) or not c_backend_emittable_instruction_valid(bytecode[index]):
        return false
    return c_backend_emittable_instructions(bytecode, index + 1)

export fn c_backend_artifact_instructions(artifact):
    let encoded = json(artifact)
    if contains(encoded, "\"kind\":\"zap.bytecode\"") and contains(encoded, "\"instructions\""):
        return artifact["instructions"]
    if contains(encoded, "\"artifact_kind\":\"bytecode\"") and contains(encoded, "\"instructions\""):
        return artifact["instructions"]
    return none

export fn c_backend_validate_artifact(artifact):
    let instructions = c_backend_artifact_instructions(artifact)
    if instructions == none:
        return {"error": "invalid_canonical_bytecode_artifact", "instruction_count": 0, "ownership": "zap", "reference_owner": "zap", "status": "rejected"}
    let checked = c_backend_validate_bytecode(instructions)
    if checked["status"] != "validated":
        return checked
    return {"artifact_kind": "bytecode", "error": none, "instruction_count": checked["instruction_count"], "ownership": "zap", "reference_owner": "zap", "schema_version": 1, "status": "validated"}

export fn c_backend_validation_contract():
    return {"artifact_kinds": ["zap.bytecode", "bytecode"], "complete_language": false, "instruction_validation": "zap_owned", "reference_owner": "python_c_backend", "schema_version": 1, "status": "zap_owned_validation_slice"}

export fn c_backend_c_scalar(value):
    if value == none:
        return "0"
    if value == true:
        return "1"
    if value == false:
        return "0"
    if starts_with(json(value), "\""):
        return "zap_string_new(" + json(value) + ")"
    return json(value)

export fn c_backend_emittable_value_valid(value):
    let encoded = json(value)
    return value == none or value == true or value == false or (starts_with(encoded, "\"") and ends_with(encoded, "\"")) or (not starts_with(encoded, "[") and not starts_with(encoded, "{") and not contains(encoded, "\""))

export fn c_backend_emittable_instruction_valid(instruction):
    if instruction["op"] == "const":
        return c_backend_emittable_value_valid(instruction["value"])
    if instruction["op"] == "jump" or instruction["op"] == "jump_if_false" or instruction["op"] == "jump_if_true":
        return not starts_with(json(instruction["target"]), "\"")
    if instruction["op"] == "make_list":
        return instruction["count"] >= 0
    return true

export fn c_backend_emit_header():
    let lines = ["#include <stdio.h>", "#include <stdlib.h>", "#include <stdbool.h>", "#include <string.h>", "", "#define ZAP_LIST_MAX 32", "#define ZAP_LIST_ITEMS_MAX 64", "#define ZAP_MAP_MAX 32", "#define ZAP_MAP_ENTRIES_MAX 64", "#define ZAP_STRING_MAX 64", "static long zap_stack[256];", "static int zap_sp = 0;", "static char zap_strings[ZAP_STRING_MAX][256];", "static int zap_string_count = 0;", "static long zap_lists[ZAP_LIST_MAX][ZAP_LIST_ITEMS_MAX];", "static int zap_list_lengths[ZAP_LIST_MAX];", "static int zap_list_count = 0;", "static long zap_map_keys[ZAP_MAP_MAX][ZAP_MAP_ENTRIES_MAX];", "static long zap_map_values[ZAP_MAP_MAX][ZAP_MAP_ENTRIES_MAX];", "static int zap_map_lengths[ZAP_MAP_MAX];", "static int zap_map_count = 0;", "static long zap_pop(void) { return zap_stack[--zap_sp]; }", "static void zap_push(long value) { zap_stack[zap_sp++] = value; }", "static long zap_string_new(const char *text) { if (zap_string_count >= ZAP_STRING_MAX) { fprintf(stderr, \"string limit exceeded\\n\"); exit(1); } strncpy(zap_strings[zap_string_count], text, 255); zap_strings[zap_string_count][255] = 0; zap_string_count += 1; return -zap_string_count; }", "static int zap_string_index(long handle) { if (handle >= 0 || handle < -zap_string_count) { fprintf(stderr, \"string handle invalid\\n\"); exit(1); } return (int)(-handle - 1); }", "static const char *zap_string_get(long handle) { return zap_strings[zap_string_index(handle)]; }", "static int zap_is_string(long value) { return value < 0 && -value <= zap_string_count; }", "static int zap_value_equal(long left, long right) { if (zap_is_string(left) && zap_is_string(right)) return strcmp(zap_string_get(left), zap_string_get(right)) == 0; return left == right; }", "static long zap_list_new(void) { if (zap_list_count >= ZAP_LIST_MAX) { fprintf(stderr, \"list limit exceeded\\n\"); exit(1); } zap_list_count += 1; zap_list_lengths[zap_list_count - 1] = 0; return zap_list_count; }", "static int zap_list_index(long handle) { if (handle <= 0 || handle > zap_list_count) { fprintf(stderr, \"list handle invalid\\n\"); exit(1); } return (int)(handle - 1); }", "static long zap_list_len(long handle) { return zap_list_lengths[zap_list_index(handle)]; }", "static long zap_list_get(long handle, long index) { int list = zap_list_index(handle); if (index < 0 || index >= zap_list_lengths[list]) { fprintf(stderr, \"list index out of range\\n\"); exit(1); } return zap_lists[list][index]; }", "static void zap_list_set(long handle, long index, long value) { int list = zap_list_index(handle); if (index < 0 || index >= ZAP_LIST_ITEMS_MAX) { fprintf(stderr, \"list index out of range\\n\"); exit(1); } if (index >= zap_list_lengths[list]) zap_list_lengths[list] = (int)(index + 1); zap_lists[list][index] = value; }", "static void zap_list_append(long handle, long value) { int list = zap_list_index(handle); if (zap_list_lengths[list] >= ZAP_LIST_ITEMS_MAX) { fprintf(stderr, \"list too large\\n\"); exit(1); } zap_lists[list][zap_list_lengths[list]++] = value; }", "static long zap_map_new(void) { if (zap_map_count >= ZAP_MAP_MAX) { fprintf(stderr, \"map limit exceeded\\n\"); exit(1); } zap_map_count += 1; zap_map_lengths[zap_map_count - 1] = 0; return 1000 + zap_map_count; }", "static int zap_is_map(long handle) { return handle >= 1001 && handle <= 1000 + zap_map_count; }", "static int zap_map_index(long handle) { if (!zap_is_map(handle)) { fprintf(stderr, \"map handle invalid\\n\"); exit(1); } return (int)(handle - 1001); }", "static int zap_map_find(long handle, long key) { int map = zap_map_index(handle); int i; for (i = 0; i < zap_map_lengths[map]; ++i) if (zap_value_equal(zap_map_keys[map][i], key)) return i; return -1; }", "static void zap_map_set(long handle, long key, long value) { int map = zap_map_index(handle); int found = zap_map_find(handle, key); if (found >= 0) { zap_map_values[map][found] = value; return; } if (zap_map_lengths[map] >= ZAP_MAP_ENTRIES_MAX) { fprintf(stderr, \"map too large\\n\"); exit(1); } found = zap_map_lengths[map]++; zap_map_keys[map][found] = key; zap_map_values[map][found] = value; }", "static long zap_map_get(long handle, long key) { int map = zap_map_index(handle); int found = zap_map_find(handle, key); return found < 0 ? 0 : zap_map_values[map][found]; }", "static long zap_map_has_key(long handle, long key) { return zap_map_find(handle, key) >= 0; }", "static long zap_map_keys_list(long handle) { int map = zap_map_index(handle); int i; long list = zap_list_new(); for (i = 0; i < zap_map_lengths[map]; ++i) zap_list_append(list, zap_map_keys[map][i]); return list; }", "static long zap_map_values_list(long handle) { int map = zap_map_index(handle); int i; long list = zap_list_new(); for (i = 0; i < zap_map_lengths[map]; ++i) zap_list_append(list, zap_map_values[map][i]); return list; }", ""]
    lines = append(lines, "static long zap_string_concat(long left, long right) { char buffer[256]; if (!zap_is_string(left) || !zap_is_string(right)) { fprintf(stderr, \"string concat requires strings\\n\"); exit(1); } snprintf(buffer, sizeof(buffer), \"%s%s\", zap_string_get(left), zap_string_get(right)); return zap_string_new(buffer); }")
    lines = append(lines, "static long zap_add(long left, long right) { if (zap_is_string(left) || zap_is_string(right)) return zap_string_concat(left, right); return left + right; }")
    lines = append(lines, "static long zap_less(long left, long right) { if (zap_is_string(left) && zap_is_string(right)) return strcmp(zap_string_get(left), zap_string_get(right)) < 0; if (zap_is_string(left) || zap_is_string(right)) { fprintf(stderr, \"comparison requires matching values\\n\"); exit(1); } return left < right; }")
    lines = append(lines, "static long zap_less_equal(long left, long right) { if (zap_is_string(left) && zap_is_string(right)) return strcmp(zap_string_get(left), zap_string_get(right)) <= 0; if (zap_is_string(left) || zap_is_string(right)) { fprintf(stderr, \"comparison requires matching values\\n\"); exit(1); } return left <= right; }")
    lines = append(lines, "static long zap_greater(long left, long right) { if (zap_is_string(left) && zap_is_string(right)) return strcmp(zap_string_get(left), zap_string_get(right)) > 0; if (zap_is_string(left) || zap_is_string(right)) { fprintf(stderr, \"comparison requires matching values\\n\"); exit(1); } return left > right; }")
    lines = append(lines, "static long zap_greater_equal(long left, long right) { if (zap_is_string(left) && zap_is_string(right)) return strcmp(zap_string_get(left), zap_string_get(right)) >= 0; if (zap_is_string(left) || zap_is_string(right)) { fprintf(stderr, \"comparison requires matching values\\n\"); exit(1); } return left >= right; }")
    lines = append(lines, "static long zap_index(long handle, long index) { if (zap_is_map(handle)) return zap_map_get(handle, index); return zap_list_get(handle, index); }")
    lines = append(lines, "static long zap_contains(long handle, long needle) { if (zap_is_map(handle)) return zap_map_has_key(handle, needle); { int list = zap_list_index(handle); int index; for (index = 0; index < zap_list_lengths[list]; ++index) if (zap_value_equal(zap_lists[list][index], needle)) return 1; return 0; } }")
    lines = append(lines, "static long zap_options[64]; static int zap_option_some[64]; static int zap_option_count = 0;")
    lines = append(lines, "static int zap_is_option(long handle) { return handle >= 2001 && handle <= 2000 + zap_option_count; }")
    lines = append(lines, "static int zap_option_index(long handle) { if (!zap_is_option(handle)) { fprintf(stderr, \"option handle invalid\\n\"); exit(1); } return (int)(handle - 2001); }")
    lines = append(lines, "static long zap_option_new(long value, int some) { if (zap_option_count >= 64) { fprintf(stderr, \"option limit exceeded\\n\"); exit(1); } zap_options[zap_option_count] = value; zap_option_some[zap_option_count] = some; zap_option_count += 1; return 2000 + zap_option_count; }")
    lines = append(lines, "static long zap_errors[64]; static int zap_error_count = 0;")
    lines = append(lines, "static int zap_is_error(long handle) { return handle >= 3001 && handle <= 3000 + zap_error_count; }")
    lines = append(lines, "static int zap_error_index(long handle) { if (!zap_is_error(handle)) { fprintf(stderr, \"error handle invalid\\n\"); exit(1); } return (int)(handle - 3001); }")
    lines = append(lines, "static long zap_error_new(long message) { if (zap_error_count >= 64) { fprintf(stderr, \"error limit exceeded\\n\"); exit(1); } zap_errors[zap_error_count] = message; zap_error_count += 1; return 3000 + zap_error_count; }")
    lines = append(lines, "static char zap_local_names[64][64]; static long zap_local_values[64]; static int zap_local_count = 0;")
    lines = append(lines, "static void zap_store(const char *name, long value) { int i; for (i = 0; i < zap_local_count; ++i) if (strcmp(zap_local_names[i], name) == 0) { zap_local_values[i] = value; return; } if (zap_local_count >= 64) { fprintf(stderr, \"local limit exceeded\\n\"); exit(1); } strncpy(zap_local_names[zap_local_count], name, 63); zap_local_names[zap_local_count][63] = 0; zap_local_values[zap_local_count++] = value; }")
    lines = append(lines, "static long zap_load(const char *name) { int i; for (i = zap_local_count - 1; i >= 0; --i) if (strcmp(zap_local_names[i], name) == 0) return zap_local_values[i]; fprintf(stderr, \"unknown local: %s\\n\", name); exit(1); }")
    return lines

export fn c_backend_emit_instruction(instruction):
    let op = instruction["op"]
    if op == "const":
        return ["zap_push(" + c_backend_c_scalar(instruction["value"]) + ");"]
    if op == "halt":
        return ["return 0;"]
    if op == "print":
        return ["{ long value = zap_pop(); if (zap_is_string(value)) printf(\"%s\\n\", zap_string_get(value)); else printf(\"%ld\\n\", value); }"]
    if op == "pop":
        return ["(void)zap_pop();"]
    if op == "store":
        return ["zap_store(" + json(instruction["name"]) + ", zap_pop());"]
    if op == "load":
        return ["zap_push(zap_load(" + json(instruction["name"]) + ")); "]
    if op == "add":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(zap_add(lhs, rhs)); }"]
    if op == "subtract":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(lhs - rhs); }"]
    if op == "multiply":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(lhs * rhs); }"]
    if op == "divide":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(rhs == 0 ? 0 : lhs / rhs); }"]
    if op == "remainder":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(rhs == 0 ? 0 : lhs % rhs); }"]
    if op == "equal":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(zap_value_equal(lhs, rhs)); }"]
    if op == "not_equal":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(!zap_value_equal(lhs, rhs)); }"]
    if op == "less":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(zap_less(lhs, rhs)); }"]
    if op == "less_equal":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(zap_less_equal(lhs, rhs)); }"]
    if op == "greater":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(zap_greater(lhs, rhs)); }"]
    if op == "greater_equal":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(zap_greater_equal(lhs, rhs)); }"]
    if op == "and":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(lhs && rhs); }"]
    if op == "or":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(lhs || rhs); }"]
    if op == "not":
        return ["{ long value = zap_pop(); zap_push(!value); }"]
    if op == "dup":
        return ["{ long value = zap_pop(); zap_push(value); zap_push(value); }"]
    if op == "jump":
        return ["goto zap_label_" + str(instruction["target"]) + ";"]
    if op == "jump_if_false":
        return ["if (!zap_pop()) goto zap_label_" + str(instruction["target"]) + ";"]
    if op == "jump_if_true":
        return ["if (zap_pop()) goto zap_label_" + str(instruction["target"]) + ";"]
    if op == "str_concat":
        return ["{ long rhs = zap_pop(); long lhs = zap_pop(); zap_push(zap_string_concat(lhs, rhs)); }"]
    if op == "make_list":
        return ["{ long handle = zap_list_new(); int index = " + str(instruction["count"]) + " - 1; while (index >= 0) { zap_list_set(handle, index, zap_pop()); index -= 1; } zap_push(handle); }"]
    if op == "list_len":
        return ["zap_push(zap_list_len(zap_pop()));"]
    if op == "list_get":
        return ["{ long index = zap_pop(); long handle = zap_pop(); zap_push(zap_list_get(handle, index)); }"]
    if op == "list_set":
        return ["{ long replacement = zap_pop(); long index = zap_pop(); long handle = zap_pop(); zap_list_set(handle, index, replacement); zap_push(handle); }"]
    if op == "list_append":
        return ["{ long value = zap_pop(); long handle = zap_pop(); zap_list_append(handle, value); zap_push(handle); }"]
    if op == "list_contains":
        return ["{ long needle = zap_pop(); long handle = zap_pop(); int index; long found = 0; int list = zap_list_index(handle); for (index = 0; index < zap_list_lengths[list]; ++index) if (zap_value_equal(zap_lists[list][index], needle)) found = 1; zap_push(found); }"]
    if op == "in":
        return ["{ long needle = zap_pop(); long handle = zap_pop(); zap_push(zap_contains(handle, needle)); }"]
    if op == "index":
        return ["{ long index = zap_pop(); long handle = zap_pop(); zap_push(zap_index(handle, index)); }"]
    if op == "option_none":
        return ["zap_push(zap_option_new(0, 0));"]
    if op == "option_some":
        return ["zap_push(zap_option_new(zap_pop(), 1));"]
    if op == "option_is_none":
        return ["{ long handle = zap_pop(); zap_push(!zap_option_some[zap_option_index(handle)]); }"]
    if op == "option_is_some":
        return ["{ long handle = zap_pop(); zap_push(zap_option_some[zap_option_index(handle)]); }"]
    if op == "option_unwrap":
        return ["{ long handle = zap_pop(); int option = zap_option_index(handle); if (!zap_option_some[option]) { fprintf(stderr, \"option unwrap none\\n\"); exit(1); } zap_push(zap_options[option]); }"]
    if op == "option_unwrap_or":
        return ["{ long fallback = zap_pop(); long handle = zap_pop(); int option = zap_option_index(handle); zap_push(zap_option_some[option] ? zap_options[option] : fallback); }"]
    if op == "error_new":
        return ["zap_push(zap_error_new(zap_pop()));"]
    if op == "error_message":
        return ["{ long handle = zap_pop(); zap_push(zap_errors[zap_error_index(handle)]); }"]
    if op == "error_is_error":
        return ["zap_push(zap_is_error(zap_pop()));"]
    if op == "error_unwrap":
        return ["{ long handle = zap_pop(); if (zap_is_error(handle)) { fprintf(stderr, \"error unwrap\\n\"); exit(1); } zap_push(handle); }"]
    if op == "list_reverse":
        return ["{ long source = zap_pop(); int index; int list = zap_list_index(source); long reversed = zap_list_new(); for (index = zap_list_lengths[list] - 1; index >= 0; --index) zap_list_append(reversed, zap_lists[list][index]); zap_push(reversed); }"]
    if op == "make_map" or op == "struct_new":
        return ["zap_push(zap_map_new());"]
    if op == "map_set_pair" or op == "map_set" or op == "struct_set":
        return ["{ long value = zap_pop(); long key = zap_pop(); long handle = zap_pop(); zap_map_set(handle, key, value); zap_push(handle); }"]
    if op == "map_get" or op == "struct_get":
        return ["{ long key = zap_pop(); long handle = zap_pop(); zap_push(zap_map_get(handle, key)); }"]
    if op == "map_has_key" or op == "struct_has_field":
        return ["{ long key = zap_pop(); long handle = zap_pop(); zap_push(zap_map_has_key(handle, key)); }"]
    if op == "map_keys" or op == "struct_field_names":
        return ["zap_push(zap_map_keys_list(zap_pop()));"]
    if op == "map_values":
        return ["zap_push(zap_map_values_list(zap_pop()));"]
    return []

export fn c_backend_emit(bytecode):
    let validation = c_backend_validate_bytecode(bytecode)
    if validation["status"] != "validated":
        return {"error": validation["error"], "lines": [], "ownership": "zap", "reference_owner": "zap", "status": "rejected"}
    if not c_backend_emittable_instructions(bytecode, 0):
        return {"error": "opcode_family_not_emitted_by_zap_slice", "lines": [], "ownership": "zap", "reference_owner": "zap", "status": "rejected"}
    let lines = c_backend_emit_header()
    lines = append(lines, "int main(void) {")
    let instruction_index = 0
    for instruction in bytecode:
        lines = append(lines, "  zap_label_" + str(instruction_index) + ":;")
        for line in c_backend_emit_instruction(instruction):
            lines = append(lines, "  " + line)
        instruction_index = instruction_index + 1
    lines = append(lines, "  zap_label_" + str(instruction_index) + ":;")
    lines = append(lines, "  return 0;")
    lines = append(lines, "}")
    return {"error": none, "lines": lines, "instruction_count": validation["instruction_count"], "ownership": "zap", "reference_owner": "zap", "schema_version": 1, "status": "zap_owned_scalar_backend_with_numeric_lists"}

export fn c_backend_generate(bytecode):
    let result = c_backend_emit(bytecode)
    if result["status"] == "rejected":
        return []
    return result["lines"]

export fn c_backend_ownership():
    return {"complete_language": false, "implemented_opcode_families": ["scalar_constants", "scalar_arithmetic", "scalar_boolean_logic", "scalar_comparison", "scalar_print", "scalar_stack_dup", "numeric_list_handles", "numeric_map_handles", "numeric_struct_handles"], "owner": "zap", "reference_owner": "python_c_backend", "status": "zap_owned_scalar_collection_object_backend_slice", "schema_version": 1}
