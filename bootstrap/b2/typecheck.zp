# B2 candidate type checker written in Zap.
# This is a provisional corpus-limited implementation. Native Rust remains the
# reference type checker and owns the complete language semantics.

import "bootstrap/b1/parser.zp"

export fn ast_lookup_type(environment, name):
    let result = "any"
    for binding in environment:
        if binding["name"] == name:
            result = binding["type"]
    return result

export fn symbol_environment_bind(environment, name, type):
    return append(environment, {"name": name, "type": type})

export fn symbol_environment_has(environment, name):
    for binding in environment:
        if binding["name"] == name:
            return true
    return false

export fn branch_local_declaration_merge(base, then_environment, else_environment, names):
    let merged = base
    for name in names:
        if symbol_environment_has(then_environment, name) and symbol_environment_has(else_environment, name):
            let then_type = ast_lookup_type(then_environment, name)
            let else_type = ast_lookup_type(else_environment, name)
            if then_type == else_type:
                merged = symbol_environment_bind(merged, name, then_type)
            else:
                merged = symbol_environment_bind(merged, name, "any")
    return merged

export fn symbol_environment_from_parameters(parameters):
    let environment = []
    for parameter in parameters:
        environment = symbol_environment_bind(environment, parameter["name"], parameter["type"])
    return environment

export fn symbol_environment_extend(environment, locals):
    let result = environment
    for binding in locals:
        result = symbol_environment_bind(result, binding["name"], binding["type"])
    return result

export fn branch_environment_merge(base, then_environment, else_environment):
    let merged = []
    for binding in base:
        let then_type = ast_lookup_type(then_environment, binding["name"])
        let else_type = ast_lookup_type(else_environment, binding["name"])
        if then_type == else_type:
            merged = symbol_environment_bind(merged, binding["name"], then_type)
        else:
            merged = symbol_environment_bind(merged, binding["name"], "any")
    return merged

export fn symbol_environment_snapshot(environment):
    return environment

export fn symbol_environment_restore(snapshot):
    return snapshot

export fn scope_enter(parent, bindings):
    return symbol_environment_extend(parent, bindings)

export fn scope_exit(parent, child):
    return symbol_environment_restore(parent)

export fn branch_environment_merge_paths(base, then_environment, else_environment, then_returns, else_returns):
    if then_returns and not else_returns:
        return else_environment
    if else_returns and not then_returns:
        return then_environment
    if then_returns and else_returns:
        return base
    return branch_environment_merge(base, then_environment, else_environment)

export fn function_body_environment(parameters, locals):
    return symbol_environment_extend(symbol_environment_from_parameters(parameters), locals)

export fn flow_guard_type(type_name, positive):
    let parts = type_wrapper_parts(type_name)
    if positive and parts["wrapper"] == "option":
        return parts["inner"]
    if positive and parts["wrapper"] == "result":
        return parts["inner"]
    if not positive and parts["wrapper"] == "option":
        return "none"
    if not positive and parts["wrapper"] == "result":
        return "error"
    return type_name

export fn condition_derived_environment(environment, name, guard, positive):
    let current = ast_lookup_type(environment, name)
    if guard == "is_some" or guard == "is_option_none" or guard == "is_ok" or guard == "is_err":
        return symbol_environment_bind(environment, name, flow_guard_type(current, positive))
    return environment

export fn condition_path_states(environment, name, guard):
    let positive = condition_derived_environment(environment, name, guard, true)
    let negative = condition_derived_environment(environment, name, guard, false)
    return {"then": positive, "else": negative}

export fn condition_expression_paths(environment, condition):
    if condition["kind"] == "guard":
        return condition_path_states(environment, condition["name"], condition["guard"])
    if condition["kind"] == "logical":
        let left_paths = condition_expression_paths(environment, condition["left"])
        if condition["operator"] == "and":
            let right_paths = condition_expression_paths(left_paths["then"], condition["right"])
            return {"then": right_paths["then"], "else": branch_environment_merge_many(environment, [left_paths["else"], right_paths["else"]])}
        if condition["operator"] == "or":
            let right_paths = condition_expression_paths(left_paths["else"], condition["right"])
            return {"then": branch_environment_merge_many(environment, [left_paths["then"], right_paths["then"]]), "else": right_paths["else"]}
    return {"then": environment, "else": environment}

export fn compound_condition_paths(environment, conditions):
    let then_environment = environment
    let else_environment = environment
    for condition in conditions:
        let paths = condition_path_states(then_environment, condition["name"], condition["guard"])
        then_environment = paths["then"]
        else_environment = paths["else"]
    return {"then": then_environment, "else": else_environment}

export fn short_circuit_condition_paths(environment, left, right, operator):
    let left_paths = condition_path_states(environment, left["name"], left["guard"])
    if operator == "and":
        let right_paths = condition_path_states(left_paths["then"], right["name"], right["guard"])
        return {"then": right_paths["then"], "else": branch_environment_merge_many(environment, [left_paths["else"], right_paths["else"]])}
    if operator == "or":
        let right_paths = condition_path_states(left_paths["else"], right["name"], right["guard"])
        return {"then": branch_environment_merge_many(environment, [left_paths["then"], right_paths["then"]]), "else": right_paths["else"]}
    return {"then": environment, "else": environment}

export fn nested_branch_flow(base, branches):
    let live_paths = []
    for branch in branches:
        if not branch["returns"]:
            live_paths = append(live_paths, branch["environment"])
    if len(live_paths) == 0:
        return base
    return branch_environment_merge_many(base, live_paths)

export fn branch_environment_merge_many(base, environments):
    let merged = base
    for binding in base:
        let candidate = ""
        let consistent = true
        for environment in environments:
            let current = ast_lookup_type(environment, binding["name"])
            if candidate == "":
                candidate = current
            if current != candidate:
                consistent = false
        if consistent:
            merged = symbol_environment_bind(merged, binding["name"], candidate)
        else:
            merged = symbol_environment_bind(merged, binding["name"], "any")
    return merged

export fn branch_path_declaration_merge(base, environments, names):
    let merged = base
    for name in names:
        let present = true
        let candidate = ""
        let consistent = true
        for environment in environments:
            if not symbol_environment_has(environment, name):
                present = false
            else:
                let current = ast_lookup_type(environment, name)
                if candidate == "":
                    candidate = current
                if current != candidate:
                    consistent = false
        if present:
            if consistent:
                merged = symbol_environment_bind(merged, name, candidate)
            else:
                merged = symbol_environment_bind(merged, name, "any")
    return merged

export fn flow_reassignment_invalidate(environment, name, assigned_type, narrowed_names):
    let result = environment
    if list_contains(narrowed_names, name):
        result = symbol_environment_bind(result, name, assigned_type)
        return result
    return symbol_environment_bind(result, name, assigned_type)

export fn cfg_node(identifier, kind, successors, environment):
    return {"environment": environment, "id": identifier, "kind": kind, "successors": successors}

export fn cfg_condition_node(identifier, condition, then_id, else_id, environment):
    return {"condition": condition, "environment": environment, "id": identifier, "kind": "condition", "successors": [then_id, else_id]}

export fn cfg_exception_node(identifier, body_id, catch_id, continuation, environment):
    return {"environment": environment, "id": identifier, "kind": "try_catch", "successors": [body_id, catch_id, continuation]}

export fn cfg_scope_node(identifier, scope_kind, entry_id, exit_id, environment):
    return {"environment": environment, "id": identifier, "kind": scope_kind, "successors": [entry_id, exit_id]}

export fn cfg_statement_category(kind):
    if kind == "if" or kind == "while" or kind == "for":
        return "control"
    if kind == "try_catch":
        return "exception"
    if kind == "function" or kind == "class" or kind == "module":
        return "scope"
    if kind == "assignment" or kind == "declaration":
        return "binding"
    return "effect"

export fn cfg_add_node(graph, node):
    return append(graph, node)

export fn cfg_append_graph(target, source):
    let result = target
    for node in source:
        result = append(result, node)
    return result

export fn cfg_add_edge(graph, from_id, to_id):
    let result = graph
    for node in graph:
        if node["id"] == from_id:
            let successors = append(node["successors"], to_id)
            result = append(result, cfg_node(node["id"], node["kind"], successors, node["environment"]))
            return result
    return result

export fn cfg_last_node(graph, identifier):
    let result = {"environment": [], "id": identifier, "kind": "missing", "successors": []}
    for node in graph:
        if node["id"] == identifier:
            result = node
    return result

export fn cfg_loop_edges(graph, condition_id, exit_id, break_ids, continue_ids):
    let result = graph
    for break_id in break_ids:
        result = cfg_add_edge(result, break_id, exit_id)
    for continue_id in continue_ids:
        result = cfg_add_edge(result, continue_id, condition_id)
    return result

export fn cfg_loop_back_edge(graph, body_exit_id, condition_id):
    return cfg_add_edge(graph, body_exit_id, condition_id)

export fn cfg_recursive_sequence(statements, path, loop_condition, loop_exit):
    let graph = []
    let index = 0
    for statement in statements:
        let statement_path = path + "." + str(index)
        let kind = statement["kind"]
        if kind == "if":
            let then_path = statement_path + ".then"
            let else_path = statement_path + ".else"
            let node = cfg_node(statement_path, "if", [then_path, else_path], [])
            graph = append(graph, node)
            graph = cfg_append_graph(graph, cfg_recursive_sequence(statement["then_branch"]["statements"], then_path, loop_condition, loop_exit))
            if statement["else_branch"] != none:
                graph = cfg_append_graph(graph, cfg_recursive_sequence(statement["else_branch"]["statements"], else_path, loop_condition, loop_exit))
        else:
            if kind == "while" or kind == "for":
                let body_path = statement_path + ".body"
                let exit_path = statement_path + ".exit"
                let node = cfg_node(statement_path, kind, [body_path, exit_path], [])
                graph = append(graph, node)
                let body_statements = statement["body"]["statements"]
                graph = cfg_append_graph(graph, cfg_recursive_sequence(body_statements, body_path, statement_path, exit_path))
                if len(body_statements) > 0:
                    let last_statement = body_statements[len(body_statements) - 1]
                    if last_statement["kind"] != "break" and last_statement["kind"] != "continue" and last_statement["kind"] != "return":
                        let body_last_id = body_path + "." + str(len(body_statements) - 1)
                        graph = cfg_add_edge(graph, body_last_id, statement_path)
                graph = append(graph, cfg_node(exit_path, "loop_exit", [], []))
            else:
                let successors = []
                if kind == "break" and loop_exit != "":
                    successors = [loop_exit]
                else:
                    if kind == "continue" and loop_condition != "":
                        successors = [loop_condition]
                    else:
                        if kind != "return" and kind != "break" and kind != "continue":
                            successors = [path + "." + str(index + 1)]
                graph = append(graph, cfg_node(statement_path, kind, successors, []))
        index = index + 1
    return graph

export fn cfg_recursive_block(statements, path, continuation, loop_condition, loop_exit):
    let graph = []
    let index = 0
    for statement in statements:
        let statement_path = path + "." + str(index)
        let next_path = continuation
        if index + 1 < len(statements):
            next_path = path + "." + str(index + 1)
        let kind = statement["kind"]
        if kind == "if":
            let then_path = statement_path + ".then"
            let else_path = statement_path + ".else"
            let successors = [then_path, next_path]
            if statement["else_branch"] != none:
                successors = [then_path, else_path]
            graph = append(graph, cfg_node(statement_path, "if", successors, []))
            graph = cfg_append_graph(graph, cfg_recursive_block(statement["then_branch"]["statements"], then_path, next_path, loop_condition, loop_exit))
            if statement["else_branch"] != none:
                graph = cfg_append_graph(graph, cfg_recursive_block(statement["else_branch"]["statements"], else_path, next_path, loop_condition, loop_exit))
        else:
            if kind == "while" or kind == "for":
                let body_path = statement_path + ".body"
                let exit_path = statement_path + ".exit"
                graph = append(graph, cfg_node(statement_path, kind, [body_path, exit_path], []))
                let body_graph = cfg_recursive_block(statement["body"]["statements"], body_path, statement_path, statement_path, exit_path)
                graph = cfg_append_graph(graph, body_graph)
                graph = append(graph, cfg_node(exit_path, "loop_exit", [next_path], []))
            else:
                let successors = [next_path]
                if kind == "return":
                    successors = []
                else:
                    if kind == "break":
                        successors = []
                        if loop_exit != "":
                            successors = [loop_exit]
                    else:
                        if kind == "continue":
                            successors = []
                            if loop_condition != "":
                                successors = [loop_condition]
                graph = append(graph, cfg_node(statement_path, kind, successors, []))
        index = index + 1
    return graph

export fn cfg_from_ast(statements, environment):
    let graph = cfg_recursive_block(statements, "root", "", "", "")
    let result = []
    for node in graph:
        result = append(result, cfg_node(node["id"], node["kind"], node["successors"], environment))
    return result

export fn cfg_flow_statement(statement, environment):
    let kind = statement["kind"]
    if kind == "try_catch":
        let body_state = cfg_flow_block(statement["body"]["statements"], environment)
        let catch_state = cfg_flow_block(statement["catch_body"]["statements"], environment)
        return branch_environment_merge_many(environment, [body_state, catch_state])
    if kind == "function" or kind == "class" or kind == "module" or kind == "import":
        return environment
    if kind == "assignment":
        return symbol_environment_bind(environment, statement["name"], ast_expression_type_env(statement["value"], environment))
    if kind == "declaration":
        let declared_type = statement["annotation"]
        if declared_type == none:
            declared_type = ast_expression_type_env(statement["value"], environment)
        return symbol_environment_bind(environment, statement["name"], declared_type)
    return environment

export fn cfg_flow_block(statements, environment):
    let current = environment
    for statement in statements:
        if statement["kind"] == "if":
            let then_state = cfg_flow_block(statement["then_branch"]["statements"], current)
            let else_state = current
            if statement["else_branch"] != none:
                else_state = cfg_flow_block(statement["else_branch"]["statements"], current)
            current = branch_environment_merge_many(current, [then_state, else_state])
        else:
            if statement["kind"] == "while" or statement["kind"] == "for":
                let body_state = cfg_flow_block(statement["body"]["statements"], current)
                let convergence = loop_backedge_converge(current, [body_state], [], 4)
                current = convergence["environment"]
            else:
                current = cfg_flow_statement(statement, current)
    return current

export fn cfg_flow_program(statements, environment):
    return cfg_flow_block(statements, environment)

export fn flow_reassignment_propagate(statements, environment, name):
    return ast_lookup_type(cfg_flow_program(statements, environment), name)

export fn flow_environment_equal(left, right, names):
    for name in names:
        if ast_lookup_type(left, name) != ast_lookup_type(right, name):
            return false
    return true

export fn loop_backedge_converge(before, body_states, mutated_names, max_iterations):
    let current = before
    let iterations = 0
    while iterations < max_iterations:
        let next = loop_fixpoint_many(current, body_states, mutated_names, 1)
        iterations = iterations + 1
        if flow_environment_equal(next, current, mutated_names):
            return {"converged": true, "environment": next, "iterations": iterations}
        current = next
    return {"converged": false, "environment": current, "iterations": iterations}

export fn cfg_sequence_nodes(statements, environment, start_id):
    let graph = []
    let current_id = start_id
    for statement in statements:
        let kind = statement["kind"]
        let next_id = current_id + 1
        let successors = []
        if kind != "return" and kind != "break" and kind != "continue":
            successors = [next_id]
        graph = cfg_add_node(graph, cfg_node(current_id, kind, successors, environment))
        current_id = next_id
    return graph

export fn symbol_graph_bind(graph, name, kind, type, scope):
    return append(graph, {"kind": kind, "name": name, "scope": scope, "type": type})

export fn nested_scope_bind(graph, scope, parent, name, kind, type):
    return append(graph, {"kind": kind, "name": name, "parent": parent, "scope": scope, "type": type})

export fn nested_scope_parent(graph, scope):
    for symbol in graph:
        if symbol["scope"] == scope:
            return symbol["parent"]
    return ""

export fn nested_scope_lookup(graph, scope, name):
    let result = {"kind": "unknown", "name": name, "parent": "", "scope": scope, "type": "any"}
    for symbol in graph:
        if symbol["scope"] == scope and symbol["name"] == name:
            result = symbol
    if result["kind"] != "unknown" or scope == "":
        return result
    let parent = nested_scope_parent(graph, scope)
    if parent == scope:
        return result
    return nested_scope_lookup(graph, parent, name)

export fn nested_scope_type(graph, scope, name):
    return nested_scope_lookup(graph, scope, name)["type"]

export fn symbol_graph_lookup(graph, name):
    let result = {"kind": "unknown", "name": name, "scope": "", "type": "any"}
    for symbol in graph:
        if symbol["name"] == name:
            result = symbol
    return result

export fn symbol_graph_type(graph, name):
    return symbol_graph_lookup(graph, name)["type"]

export fn symbol_graph_kind(graph, name):
    return symbol_graph_lookup(graph, name)["kind"]

export fn symbol_graph_reassign(graph, name, type, scope):
    return symbol_graph_bind(graph, name, "variable", type, scope)

export fn symbol_graph_collect(source):
    let graph = []
    let lines = split(source, "\n")
    let current_function = ""
    for line in lines:
        let declaration = trim(line)
        let indent = len(line) - len(declaration)
        if starts_with(declaration, "fn "):
            let function = function_signature_info(declaration)
            graph = symbol_graph_bind(graph, function["name"], "function", function["return_type"], "module")
            for parameter in function["params"]:
                graph = symbol_graph_bind(graph, parameter["name"], "parameter", parameter["type"], function["name"])
            current_function = function["name"]
        if indent == 0 and not starts_with(declaration, "fn ") and not starts_with(declaration, "let "):
            current_function = ""
        if starts_with(declaration, "let ") and contains(declaration, ":") and contains(declaration, " = "):
            let assignment = split(declaration, " = ")
            let left = trim(assignment[0])
            let annotation_parts = split(left, ":")
            let name = trim(substring(annotation_parts[0], 4, len(annotation_parts[0])))
            let type = trim(annotation_parts[1])
            let scope = "module"
            if indent > 0 and current_function != "":
                scope = current_function
            graph = symbol_graph_bind(graph, name, "variable", type, scope)
    return graph

export fn symbol_graph_scope(graph, name):
    return symbol_graph_lookup(graph, name)["scope"]

export fn infer_program_symbol_type(source, name):
    return symbol_graph_type(symbol_graph_collect(source), name)

export fn loop_mutation_update(before, body, mutated_names):
    let result = before
    for name in mutated_names:
        let before_type = ast_lookup_type(before, name)
        let body_type = ast_lookup_type(body, name)
        if before_type == body_type:
            result = symbol_environment_bind(result, name, body_type)
        else:
            result = symbol_environment_bind(result, name, "any")
    return result

export fn loop_mutation_type(before, body, name):
    return ast_lookup_type(loop_mutation_update(before, body, [name]), name)

export fn loop_fixpoint_update(before, body, mutated_names, remaining_iterations):
    let updated = loop_mutation_update(before, body, mutated_names)
    if remaining_iterations <= 1:
        return updated
    let changed = false
    for name in mutated_names:
        if ast_lookup_type(updated, name) != ast_lookup_type(before, name):
            changed = true
    if not changed:
        return updated
    return loop_fixpoint_update(updated, body, mutated_names, remaining_iterations - 1)

export fn loop_fixpoint_type(before, body, name, max_iterations):
    return ast_lookup_type(loop_fixpoint_update(before, body, [name], max_iterations), name)

export fn loop_exit_environment(before, body, mutated_names, max_iterations):
    return loop_fixpoint_update(before, body, mutated_names, max_iterations)

export fn reassignment_invalidate_many(environment, assignments):
    let result = environment
    for assignment in assignments:
        result = flow_reassignment_invalidate(result, assignment["name"], assignment["type"], assignment["narrowed_names"])
    return result

export fn scope_restore_after_loop(parent, loop_environment):
    return symbol_environment_restore(parent)

export fn loop_body_merge(body_states, name):
    let candidate = ""
    for state in body_states:
        let current = ast_lookup_type(state, name)
        if candidate == "":
            candidate = current
        if current != candidate:
            return "any"
    if candidate == "":
        return "any"
    return candidate

export fn loop_fixpoint_many(before, body_states, mutated_names, max_iterations):
    let result = before
    for name in mutated_names:
        let body_type = loop_body_merge(body_states, name)
        let before_type = ast_lookup_type(before, name)
        if body_type == before_type:
            result = symbol_environment_bind(result, name, body_type)
        else:
            result = symbol_environment_bind(result, name, "any")
    if max_iterations <= 1:
        return result
    if result == before:
        return result
    return loop_fixpoint_many(result, body_states, mutated_names, max_iterations - 1)

export fn list_contains(values, value):
    for item in values:
        if item == value:
            return true
    return false

export fn call_graph_bind(graph, caller, callee, return_type):
    return append(graph, {"caller": caller, "callee": callee, "return_type": return_type})

export fn call_graph_lookup(graph, caller, callee):
    let result = "unknown"
    for edge in graph:
        if edge["caller"] == caller and edge["callee"] == callee:
            result = edge["return_type"]
    return result

export fn call_graph_propagate(graph, functions, calls):
    let result = graph
    for call in calls:
        let return_type = infer_function_call(functions, call["callee"], call["argument_types"])
        result = call_graph_bind(result, call["caller"], call["callee"], return_type)
    return result

export fn call_graph_return_type(graph, caller, callee):
    return call_graph_lookup(graph, caller, callee)

export fn call_graph_propagate_fixpoint(graph, functions, calls, max_iterations):
    let updated = call_graph_propagate(graph, functions, calls)
    if max_iterations <= 1:
        return updated
    if len(updated) == len(graph) + len(calls):
        return updated
    return call_graph_propagate_fixpoint(updated, functions, calls, max_iterations - 1)

export fn call_graph_has_cycle_from(graph, start, current, visited):
    if list_contains(visited, current):
        return current == start
    let next_visited = append(visited, current)
    for edge in graph:
        if edge["caller"] == current:
            if call_graph_has_cycle_from(graph, start, edge["callee"], next_visited):
                return true
    return false

export fn call_graph_has_cycle(graph, start):
    return call_graph_has_cycle_from(graph, start, start, [])

export fn call_graph_cycle_kind(graph, start):
    if call_graph_has_cycle(graph, start):
        return "cycle"
    return "acyclic"

export fn infer_function_body_return(body_expression, parameters, locals, expected_type):
    let environment = function_body_environment(parameters, locals)
    return infer_return_type(body_expression, environment, expected_type)

export fn ast_list_type_env(elements, environment):
    if len(elements) == 0:
        return "list<any>"
    let first_type = ast_expression_type_env(elements[0], environment)
    for element in elements:
        if ast_expression_type_env(element, environment) != first_type:
            return "list<any>"
    return "list<" + first_type + ">"

export fn ast_map_type_env(entries, environment):
    if len(entries) == 0:
        return "map<any,any>"
    let first_key = ast_expression_type_env(entries[0]["key"], environment)
    let first_value = ast_expression_type_env(entries[0]["value"], environment)
    for entry in entries:
        if ast_expression_type_env(entry["key"], environment) != first_key:
            return "map<any,any>"
        if ast_expression_type_env(entry["value"], environment) != first_value:
            return "map<any,any>"
    return "map<" + first_key + "," + first_value + ">"

export fn ast_expression_type_env_functions(node, environment, functions):
    if node["kind"] == "call":
        return infer_ast_function_call(node, functions, environment)
    if node["kind"] == "binary":
        let left = ast_expression_type_env_functions(node["left"], environment, functions)
        let right = ast_expression_type_env_functions(node["right"], environment, functions)
        if node["op"] == "add" and left == "text" and right == "text":
            return "text"
        if (node["op"] == "add" or node["op"] == "subtract" or node["op"] == "multiply" or node["op"] == "divide" or node["op"] == "remainder") and left == "number" and right == "number":
            return "number"
        if node["op"] == "and" or node["op"] == "or" or node["op"] == "equal" or node["op"] == "not_equal" or node["op"] == "less" or node["op"] == "less_equal" or node["op"] == "greater" or node["op"] == "greater_equal":
            return "bool"
        return "any"
    if node["kind"] == "list":
        return ast_list_type_env(node["elements"], environment)
    if node["kind"] == "map":
        return ast_map_type_env(node["entries"], environment)
    return ast_expression_type_env(node, environment)

export fn infer_program_expression_types(nodes, environment, functions):
    let result = []
    for node in nodes:
        result = append(result, ast_expression_type_env_functions(node, environment, functions))
    return result

export fn ast_expression_type_env(node, environment):
    let kind = node["kind"]
    if kind == "literal":
        return node["literal_kind"]
    if kind == "name":
        return ast_lookup_type(environment, node["name"])
    if kind == "unary":
        if node["op"] == "not":
            return "bool"
        if node["op"] == "negate" and ast_expression_type_env(node["value"], environment) == "number":
            return "number"
        return "any"
    if kind == "binary":
        let operator = node["op"]
        if operator == "and" or operator == "or" or operator == "equal" or operator == "not_equal" or operator == "less" or operator == "less_equal" or operator == "greater" or operator == "greater_equal":
            return "bool"
        let left_type = ast_expression_type_env(node["left"], environment)
        let right_type = ast_expression_type_env(node["right"], environment)
        if operator == "add" and left_type == "text" and right_type == "text":
            return "text"
        if (operator == "add" or operator == "subtract" or operator == "multiply" or operator == "divide" or operator == "remainder") and left_type == "number" and right_type == "number":
            return "number"
        return "any"
    if kind == "list":
        return ast_list_type_env(node["elements"], environment)
    if kind == "map":
        return ast_map_type_env(node["entries"], environment)
    if kind == "call":
        let callee = node["callee"]["name"]
        if callee == "identity" and len(node["args"]) == 1:
            return ast_expression_type_env(node["args"][0]["value"], environment)
        return "any"
    if kind == "index":
        let target_type = ast_expression_type_env(node["target"], environment)
        let index_type = ast_expression_type_env(node["index"], environment)
        if starts_with(target_type, "list<") and ends_with(target_type, ">"):
            if index_type == "number":
                return substring(target_type, 5, len(target_type) - 1)
            return "any"
        if starts_with(target_type, "map<") and ends_with(target_type, ">"):
            let parts = split(substring(target_type, 4, len(target_type) - 1), ",")
            if len(parts) == 2 and index_type == trim(parts[0]):
                return trim(parts[1])
        return "any"
    if kind == "nested_call":
        return infer_nested_call_type(node, environment)
    if kind == "collection_element":
        return infer_collection_element_type(node, environment)
    return "any"

export fn infer_nested_call_type(node, environment):
    let callee = node["callee"]
    let args = node["args"]
    let callee_type = ast_expression_type_env(callee, environment)
    if starts_with(callee_type, "fn("):
        let return_part = split(callee_type, "->")[1]
        return trim(return_part)
    return "any"

export fn infer_collection_element_type(node, environment):
    let collection = node["collection"]
    let index = node["index"]
    let collection_type = ast_expression_type_env(collection, environment)
    let index_type = ast_expression_type_env(index, environment)
    if starts_with(collection_type, "list<") and ends_with(collection_type, ">"):
        if index_type == "number":
            return substring(collection_type, 5, len(collection_type) - 1)
        return "any"
    if starts_with(collection_type, "map<") and ends_with(collection_type, ">"):
        let parts = split(substring(collection_type, 4, len(collection_type) - 1), ",")
        if len(parts) == 2 and index_type == trim(parts[0]):
            return trim(parts[1])
    return "any"

export fn check_nested_call_type_mismatch(node, environment, expected_type):
    let actual_type = infer_nested_call_type(node, environment)
    if actual_type != expected_type and actual_type != "any" and expected_type != "any":
        return {"mismatch": true, "expected": expected_type, "actual": actual_type, "location": node["span"]}
    return {"mismatch": false}

export fn check_collection_element_type_mismatch(node, environment, expected_type):
    let actual_type = infer_collection_element_type(node, environment)
    if actual_type != expected_type and actual_type != "any" and expected_type != "any":
        return {"mismatch": true, "expected": expected_type, "actual": actual_type, "location": node["span"]}
    return {"mismatch": false}

export fn generic_parameter_names(line):
    let header = trim(line)
    let name_area = split(header, "(")[0]
    let name_parts = split(name_area, "<")
    if len(name_parts) < 2:
        return []
    let raw = split(name_parts[1], ">")
    if len(raw) == 0 or trim(raw[0]) == "":
        return []
    let result = []
    for parameter in split(raw[0], ","):
        result = append(result, trim(parameter))
    return result

export fn generic_parameter_valid(parameter):
    return parameter == "T" or parameter == "U" or parameter == "V" or parameter == "E"

export fn generic_parameters_valid(parameters):
    if len(parameters) == 0:
        return false
    let seen = "|"
    for parameter in parameters:
        if not generic_parameter_valid(parameter):
            return false
        if contains(seen, "|" + parameter + "|"):
            return false
        seen = seen + parameter + "|"
    return true

export fn generic_declaration_info(line):
    let parameters = generic_parameter_names(line)
    let header = trim(line)
    let name_parts = split(split(header, "(")[0], "<")
    let raw_name = trim(name_parts[0])
    if starts_with(raw_name, "fn "):
        raw_name = trim(substring(raw_name, 3, len(raw_name)))
    return {"generic": len(parameters) > 0, "name": raw_name, "parameters": parameters, "valid": generic_parameters_valid(parameters)}

export fn generic_function_instantiate(generic_info, type_arguments):
    if not generic_info["valid"]:
        return {"instantiated": false, "reason": "invalid_generic_declaration"}
    if len(generic_info["parameters"]) != len(type_arguments):
        return {"instantiated": false, "reason": "arity_mismatch"}
    return {"instantiated": true, "name": generic_info["name"], "type_arguments": type_arguments}

export fn generic_list_type(element_type):
    if element_type == "":
        return "list<any>"
    return "list<" + element_type + ">"

export fn generic_map_type(key_type, value_type):
    if key_type == "" or value_type == "":
        return "map<any,any>"
    return "map<" + key_type + "," + value_type + ">"

export fn generic_function_type(return_type, parameter_types):
    let params = ""
    if len(parameter_types) > 0:
        params = parameter_types[0]
        let index = 1
        while index < len(parameter_types):
            params = params + "," + parameter_types[index]
            index = index + 1
    return "fn(" + params + ")->" + return_type

export fn validate_generic_instantiation(generic_type, type_arguments):
    let parts = type_wrapper_parts(generic_type)
    if parts["wrapper"] == "":
        return {"valid": false, "reason": "not_generic"}
    if parts["wrapper"] == "list":
        if len(type_arguments) != 1:
            return {"valid": false, "reason": "list_requires_one_argument"}
        return {"valid": true, "instantiated": "list<" + type_arguments[0] + ">"}
    if parts["wrapper"] == "map":
        if len(type_arguments) != 2:
            return {"valid": false, "reason": "map_requires_two_arguments"}
        return {"valid": true, "instantiated": "map<" + type_arguments[0] + "," + type_arguments[1] + ">"}
    if parts["wrapper"] == "option":
        if len(type_arguments) != 1:
            return {"valid": false, "reason": "option_requires_one_argument"}
        return {"valid": true, "instantiated": "option<" + type_arguments[0] + ">"}
    if parts["wrapper"] == "result":
        if len(type_arguments) != 1:
            return {"valid": false, "reason": "result_requires_one_argument"}
        return {"valid": true, "instantiated": "result<" + type_arguments[0] + ">"}
    return {"valid": false, "reason": "unknown_generic_wrapper"}

export fn infer_generic_list_literal(elements, environment):
    if len(elements) == 0:
        return "list<any>"
    let first_type = ast_expression_type_env(elements[0], environment)
    for element in elements:
        if ast_expression_type_env(element, environment) != first_type:
            return "list<any>"
    return "list<" + first_type + ">"

export fn infer_generic_map_literal(entries, environment):
    if len(entries) == 0:
        return "map<any,any>"
    let first_key_type = ast_expression_type_env(entries[0]["key"], environment)
    let first_value_type = ast_expression_type_env(entries[0]["value"], environment)
    for entry in entries:
        if ast_expression_type_env(entry["key"], environment) != first_key_type:
            return "map<any,any>"
        if ast_expression_type_env(entry["value"], environment) != first_value_type:
            return "map<any,any>"
    return "map<" + first_key_type + "," + first_value_type + ">"

export fn check_generic_function_call(generic_function, type_arguments, argument_types):
    let info = generic_declaration_info(generic_function)
    if not info["generic"]:
        return {"valid": false, "reason": "not_generic_function"}
    if len(info["parameters"]) != len(type_arguments):
        return {"valid": false, "reason": "arity_mismatch"}
    let index = 0
    while index < len(argument_types):
        let expected = type_arguments[index]
        let actual = argument_types[index]
        if expected != actual and expected != "any" and actual != "any":
            return {"valid": false, "reason": "argument_type_mismatch"}
        index = index + 1
    return {"valid": true, "instantiated_type": generic_function_type(info["return_type"], type_arguments)}

export fn generic_type_compatible(type1, type2):
    if type1 == type2:
        return true
    if type1 == "any" or type2 == "any":
        return true
    let parts1 = type_wrapper_parts(type1)
    let parts2 = type_wrapper_parts(type2)
    if parts1["wrapper"] == parts2["wrapper"] and parts1["wrapper"] != "":
        if parts1["wrapper"] == "list":
            return generic_type_compatible(parts1["inner"], parts2["inner"])
        if parts1["wrapper"] == "option":
            return generic_type_compatible(parts1["inner"], parts2["inner"])
        if parts1["wrapper"] == "result":
            return generic_type_compatible(parts1["inner"], parts2["inner"])
        if parts1["wrapper"] == "map":
            return generic_type_compatible(parts1["key"], parts2["key"]) and generic_type_compatible(parts1["value"], parts2["value"])
    return false

export fn infer_generic_return_type(generic_return, type_arguments, parameter_mapping):
    if contains(generic_return, "<"):
        let parts = type_wrapper_parts(generic_return)
        if parts["wrapper"] == "list":
            let inner = substitute_type_parameters(parts["inner"], type_arguments, parameter_mapping)
            return "list<" + inner + ">"
        if parts["wrapper"] == "map":
            let key = substitute_type_parameters(parts["key"], type_arguments, parameter_mapping)
            let value = substitute_type_parameters(parts["value"], type_arguments, parameter_mapping)
            return "map<" + key + "," + value + ">"
        if parts["wrapper"] == "option":
            let inner = substitute_type_parameters(parts["inner"], type_arguments, parameter_mapping)
            return "option<" + inner + ">"
        if parts["wrapper"] == "result":
            let inner = substitute_type_parameters(parts["inner"], type_arguments, parameter_mapping)
            return "result<" + inner + ">"
    return substitute_type_parameters(generic_return, type_arguments, parameter_mapping)

export fn substitute_type_parameters(type_string, type_arguments, parameter_mapping):
    let result = type_string
    let index = 0
    while index < len(parameter_mapping):
        let param = parameter_mapping[index]
        if result == param:
            result = type_arguments[index]
        index = index + 1
    return result

export fn generic_type_declaration_info(line):
    let value = trim(line)
    if not starts_with(value, "type "):
        return {"name": "", "parameters": [], "body": "", "valid": false}
    let declaration = trim(substring(value, 5, len(value)))
    let name_area = trim(split(declaration, "=")[0])
    let name = trim(split(name_area, "<")[0])
    let parameters = []
    if contains(name_area, "<") and contains(name_area, ">"):
        let raw_parts = split(split(name_area, "<")[1], ">")
        for parameter in split(raw_parts[0], ","):
            parameters = append(parameters, trim(parameter))
    let body = ""
    if contains(declaration, "="):
        body = trim(split(declaration, "=")[1])
    let body_valid = generic_type_body_valid(body, parameters)
    return {"body": body, "body_valid": body_valid, "name": name, "parameters": parameters, "valid": generic_parameters_valid(parameters) and body != "" and body_valid}

export fn generic_type_declaration_instance(line, argument_types):
    let info = generic_type_declaration_info(line)
    if not info["valid"]:
        return "invalid_generic_type"
    if len(info["parameters"]) != len(argument_types):
        return "generic_arity_error"
    return generic_container_instantiate(info["body"], info["parameters"], argument_types)

export fn ast_expression_type(node):
    let kind = node["kind"]
    if kind == "literal":
        return node["literal_kind"]
    if kind == "name":
        return "any"
    if kind == "unary":
        if node["op"] == "not":
            return "bool"
        if node["op"] == "negate" and ast_expression_type(node["value"]) == "number":
            return "number"
        return "any"
    if kind == "binary":
        let operator = node["op"]
        if operator == "and" or operator == "or" or operator == "equal" or operator == "not_equal" or operator == "less" or operator == "less_equal" or operator == "greater" or operator == "greater_equal":
            return "bool"
        let left_type = ast_expression_type(node["left"])
        let right_type = ast_expression_type(node["right"])
        if operator == "add" and left_type == "text" and right_type == "text":
            return "text"
        if (operator == "add" or operator == "subtract" or operator == "multiply" or operator == "divide" or operator == "remainder") and left_type == "number" and right_type == "number":
            return "number"
        return "any"
    if kind == "list":
        if len(node["elements"]) == 0:
            return "list<any>"
        let element_type = ast_expression_type(node["elements"][0])
        for element in node["elements"]:
            if ast_expression_type(element) != element_type:
                return "list<any>"
        return "list<" + element_type + ">"
    if kind == "map":
        if len(node["entries"]) == 0:
            return "map<any,any>"
        let first_entry = node["entries"][0]
        let key_type = ast_expression_type(first_entry["key"])
        let value_type = ast_expression_type(first_entry["value"])
        for entry in node["entries"]:
            if ast_expression_type(entry["key"]) != key_type or ast_expression_type(entry["value"]) != value_type:
                return "map<any,any>"
        return "map<" + key_type + "," + value_type + ">"
    if kind == "call":
        let callee = node["callee"]["name"]
        if callee == "identity" and len(node["args"]) == 1:
            return ast_expression_type(node["args"][0]["value"])
        if callee == "first" and len(node["args"]) > 0:
            return ast_expression_type(node["args"][0]["value"])
        return "any"
    if kind == "index":
        let target_type = ast_expression_type(node["target"])
        return generic_container_element(target_type)
    return "any"

export fn generic_type_arguments(type_name):
    let result = []
    let depth = 0
    let current = ""
    let index = 0
    while index < len(type_name):
        let character = substring(type_name, index, index + 1)
        if character == "<":
            depth = depth + 1
            current = current + character
        else:
            if character == ">":
                depth = depth - 1
                current = current + character
            else:
                if character == "," and depth == 0:
                    result = append(result, trim(current))
                    current = ""
                else:
                    current = current + character
        index = index + 1
    if trim(current) != "":
        result = append(result, trim(current))
    return result

export fn type_wrapper_parts(type_name):
    if starts_with(type_name, "list<") and ends_with(type_name, ">"):
        return {"wrapper": "list", "inner": substring(type_name, 5, len(type_name) - 1)}
    if starts_with(type_name, "map<") and ends_with(type_name, ">"):
        let inside = substring(type_name, 4, len(type_name) - 1)
        let parts = generic_type_arguments(inside)
        if len(parts) == 2:
            return {"wrapper": "map", "key": trim(parts[0]), "value": trim(parts[1])}
    if starts_with(type_name, "option<") and ends_with(type_name, ">"):
        return {"wrapper": "option", "inner": substring(type_name, 7, len(type_name) - 1)}
    if starts_with(type_name, "result<") and ends_with(type_name, ">"):
        return {"wrapper": "result", "inner": substring(type_name, 7, len(type_name) - 1)}
    return {"wrapper": "", "inner": type_name}

export fn generic_parameter_present(parameters, name):
    for parameter in parameters:
        if parameter == name:
            return true
    return false

export fn generic_type_body_valid(type_name, parameters):
    let value = trim(type_name)
    if value == "any" or value == "number" or value == "text" or value == "bool" or value == "none":
        return true
    if generic_parameter_present(parameters, value):
        return true
    let parts = type_wrapper_parts(value)
    if parts["wrapper"] == "map":
        return generic_type_body_valid(parts["key"], parameters) and generic_type_body_valid(parts["value"], parameters)
    if parts["wrapper"] == "list" or parts["wrapper"] == "option" or parts["wrapper"] == "result":
        return generic_type_body_valid(parts["inner"], parameters)
    return false

export fn type_unify(expected, actual):

    if expected == "any" or actual == "any":
        return true
    if expected == actual:
        return true
    let expected_parts = type_wrapper_parts(expected)
    let actual_parts = type_wrapper_parts(actual)
    if expected_parts["wrapper"] == "" or expected_parts["wrapper"] != actual_parts["wrapper"]:
        return false
    if expected_parts["wrapper"] == "map":
        return type_unify(expected_parts["key"], actual_parts["key"]) and type_unify(expected_parts["value"], actual_parts["value"])
    return type_unify(expected_parts["inner"], actual_parts["inner"])

export fn generic_unify(expected, actual, parameters):
    if contains(parameters, expected):
        return true
    return type_unify(expected, actual)

export fn generic_return_from_call(return_template, parameters, argument_types):
    let result = return_template
    for parameter in parameters:
        let index = 0
        for candidate in parameters:
            if candidate == parameter:
                break
            index = index + 1
        if index < len(argument_types):
            result = generic_type_substitute(result, parameter, argument_types[index])
    return result

export fn generic_container_instantiate(type_template, parameters, argument_types):
    let result = type_template
    let index = 0
    for parameter in parameters:
        if index < len(argument_types):
            result = generic_type_substitute(result, parameter, argument_types[index])
        index = index + 1
    return result

export fn generic_container_valid(type_name):
    let parts = type_wrapper_parts(type_name)
    if parts["wrapper"] == "":
        return type_name == "any" or type_name == "number" or type_name == "text" or type_name == "bool" or type_name == "none"
    if parts["wrapper"] == "map":
        return generic_container_valid(parts["key"]) and generic_container_valid(parts["value"])
    return generic_container_valid(parts["inner"])

export fn generic_container_element(type_name):
    let parts = type_wrapper_parts(type_name)
    if parts["wrapper"] == "list" or parts["wrapper"] == "option" or parts["wrapper"] == "result":
        return parts["inner"]
    if parts["wrapper"] == "map":
        return parts["value"]
    return "any"

export fn generic_container_key(type_name):
    let parts = type_wrapper_parts(type_name)
    if parts["wrapper"] == "map":
        return parts["key"]
    return "any"

export fn generic_container_constraint(type_name, constraint):
    let element = generic_container_element(type_name)
    if constraint == "":
        return true
    return type_unify(element, constraint) or type_unify(type_name, constraint)

export fn generic_type_substitute(type_template, parameter, argument_type):
    if type_template == parameter:
        return argument_type
    if starts_with(type_template, "list<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 5, len(type_template) - 1)
        return "list<" + generic_type_substitute(inner, parameter, argument_type) + ">"
    if starts_with(type_template, "option<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 7, len(type_template) - 1)
        return "option<" + generic_type_substitute(inner, parameter, argument_type) + ">"
    if starts_with(type_template, "result<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 7, len(type_template) - 1)
        return "result<" + generic_type_substitute(inner, parameter, argument_type) + ">"
    if starts_with(type_template, "map<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 4, len(type_template) - 1)
        let parts = generic_type_arguments(inner)
        if len(parts) == 2:
            return "map<" + generic_type_substitute(trim(parts[0]), parameter, argument_type) + "," + generic_type_substitute(trim(parts[1]), parameter, argument_type) + ">"
    return type_template

export fn generic_identity_result(argument_type, return_template):
    return generic_type_substitute(return_template, "T", argument_type)

export fn generic_instantiate_return(parameters, argument_types, return_template):
    let result = return_template
    let index = 0
    for parameter in parameters:
        if index < len(argument_types):
            result = generic_type_substitute(result, parameter, argument_types[index])
        index = index + 1
    return result

export fn generic_constraint_satisfied(argument_types, constraint):
    for argument_type in argument_types:
        if constraint == "number" and argument_type != "number":
            return false
        if constraint == "text" and argument_type != "text":
            return false
    return true

export fn generic_constraints(line):
    let result = []
    if not contains(line, " where "):
        return result
    let where_area = split(line, " where ")[1]
    let constraint_text = trim(split(where_area, ":")[0])
    if contains(where_area, " and "):
        for item in split(where_area, " and "):
            let parts = split(trim(item), ":")
            if len(parts) >= 2:
                result = append(result, {"parameter": trim(parts[0]), "bound": trim(parts[1])})
        return result
    let parts = split(where_area, ":")
    if len(parts) >= 2:
        result = append(result, {"parameter": trim(parts[0]), "bound": trim(parts[1])})
    return result

export fn generic_constraints_satisfied(argument_types, parameters, constraints):
    for constraint in constraints:
        let index = 0
        for parameter in parameters:
            if parameter == constraint["parameter"]:
                break
            index = index + 1
        if index >= len(argument_types) or not type_unify(constraint["bound"], argument_types[index]):
            return false
    return true

export fn generic_constraints_well_formed(parameters, constraints):
    for constraint in constraints:
        if not generic_parameter_present(parameters, constraint["parameter"]):
            return false
        if not generic_type_body_valid(constraint["bound"], []):
            return false
    return true

export fn function_signature_info(signature):
    let value = trim(signature)
    let name_area = split(value, "(")[0]
    let raw_name = trim(substring(name_area, 3, len(name_area)))
    let name = trim(split(raw_name, "<")[0])
    let params_area = split(split(value, "(")[1], ")")[0]
    let params = []
    if trim(params_area) != "":
        for raw in split(params_area, ","):
            let parts = split(trim(raw), ":")
            if len(parts) == 2:
                params = append(params, {"name": trim(parts[0]), "type": trim(parts[1])})
    let return_type = "none"
    let constraint = ""
    if contains(value, " -> "):
        let return_parts = split(value, " -> ")
        let return_area = trim(return_parts[1])
        if contains(return_area, " where "):
            let where_parts = split(return_area, " where ")
            return_type = trim(split(where_parts[0], ":")[0])
            let constraint_parts = split(where_parts[1], ":")
            if len(constraint_parts) >= 2:
                constraint = trim(constraint_parts[1])
        else:
            return_type = trim(split(return_area, ":")[0])
    let generic = generic_declaration_info(value)
    return {"constraint": constraint, "constraints": generic_constraints(value), "generic_parameters": generic["parameters"], "name": name, "params": params, "return_type": return_type}

export fn type_compatible(expected, actual):
    return type_unify(expected, actual)

export fn infer_function_call(functions, callee, argument_types):
    for function in functions:
        if function["name"] != callee:
            continue
        let params = function["params"]
        if len(params) != len(argument_types):
            return "arity_error"
        let generic_parameters = function["generic_parameters"]
        if len(generic_parameters) > 0:
            if not generic_constraints_well_formed(generic_parameters, function["constraints"]):
                return "constraint_error"
            if not generic_constraint_satisfied(argument_types, function["constraint"]):
                return "constraint_error"
            if not generic_constraints_satisfied(argument_types, generic_parameters, function["constraints"]):
                return "constraint_error"
            return generic_instantiate_return(generic_parameters, argument_types, function["return_type"])
        let index = 0
        for parameter in params:
            if not type_compatible(parameter["type"], argument_types[index]):
                return "argument_error"
            index = index + 1
        return function["return_type"]
    return "unknown_function"

export fn generic_recursive_call_result(functions, callee, argument_types, parameters, return_template, remaining_depth):
    if remaining_depth <= 0:
        return "recursion_limit"
    let result = infer_function_call(functions, callee, argument_types)
    if result == "unknown_function" or result == "arity_error" or result == "argument_error" or result == "constraint_error":
        return result
    if len(parameters) == 0:
        return result
    return generic_instantiate_return(parameters, argument_types, return_template)

export fn generic_runtime_container_kind(type_name):
    let parts = type_wrapper_parts(type_name)
    return parts["wrapper"]

export fn generic_runtime_container_accepts(operation, container_type, value_type):
    let parts = type_wrapper_parts(container_type)
    if operation == "list_push" and parts["wrapper"] == "list":
        return type_unify(parts["inner"], value_type)
    if operation == "map_key" and parts["wrapper"] == "map":
        return type_unify(parts["key"], value_type)
    if operation == "map_value" and parts["wrapper"] == "map":
        return type_unify(parts["value"], value_type)
    if operation == "option_some" and parts["wrapper"] == "option":
        return type_unify(parts["inner"], value_type)
    if operation == "result_ok" and parts["wrapper"] == "result":
        return type_unify(parts["inner"], value_type)
    return false

export fn infer_ast_function_call(node, functions, environment):
    let argument_types = []
    for argument in node["args"]:
        let argument_value = argument["value"]
        if argument_value["kind"] == "call":
            argument_types = append(argument_types, infer_ast_function_call(argument_value, functions, environment))
        else:
            argument_types = append(argument_types, ast_expression_type_env(argument_value, environment))
    return infer_function_call(functions, node["callee"]["name"], argument_types)

export fn diagnostic_fields_equal(reference, candidate):
    let fields = ["kind", "code", "line", "column", "message", "severity"]
    for field in fields:
        if reference[field] != candidate[field]:
            return false
    return true

export fn diagnostic_parity(reference, candidate):
    return {"equal": diagnostic_fields_equal(reference, candidate), "reference": reference, "candidate": candidate}

export fn diagnostic_failure_parity(reference, candidate):
    if not diagnostic_fields_equal(reference, candidate):
        return {"equal": false, "failure": "field_mismatch"}
    if reference["severity"] == "error" and candidate["severity"] != "error":
        return {"equal": false, "failure": "failure_behavior_mismatch"}
    return {"equal": true, "failure": "none"}

export fn diagnostic(source_name, line, column, message):
    return {"code": "ZAP-TYPE-001", "column": column, "help": "Use a compatible value or update the type annotation.", "kind": "TypeError", "line": line, "message": message, "notes": ["Check the expression type and the expected annotation."], "severity": "error", "source_name": source_name}

export fn syntax_diagnostic(source_name, line, column, message):
    return {"code": "ZAP-SYNTAX-001", "column": column, "help": "Review the Zap syntax guide for the expected form.", "kind": "SyntaxError", "line": line, "message": message, "notes": ["Check the surrounding syntax and delimiters."], "severity": "error", "source_name": source_name}

export fn function_call_diagnostic(functions, callee, argument_types, source_name, line):
    let result = infer_function_call(functions, callee, argument_types)
    if result == "unknown_function":
        return diagnostic(source_name, line, 1, "unknown function '" + callee + "'")
    if result == "arity_error":
        return diagnostic(source_name, line, 1, "function '" + callee + "' received an invalid argument count")
    if result == "argument_error":
        return diagnostic(source_name, line, 1, "function '" + callee + "' received an incompatible argument")
    if result == "constraint_error":
        return diagnostic(source_name, line, 1, "generic constraint for '" + callee + "' is not satisfied")
    return none

export fn infer_return_type(return_node, environment, expected_type):
    let inferred = ast_expression_type_env(return_node, environment)
    if expected_type == "any" or expected_type == inferred:
        return inferred
    return "return_error"

export fn is_number_literal(value):
    if value == "0" or value == "1" or value == "2" or value == "3" or value == "4" or value == "5" or value == "6" or value == "7" or value == "8" or value == "9":
        return true
    if starts_with(value, "-") and len(value) > 1:
        let rest = substring(value, 1, len(value))
        return is_number_literal(rest)
    if contains(value, "."):
        let parts = split(value, ".")
        if len(parts) == 2 and is_number_literal(parts[0]) and is_number_literal(parts[1]):
            return true
    return false

export fn infer_list_literal(value, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type):
    let inner = trim(substring(value, 1, len(value) - 1))
    if inner == "":
        return "list<any>"
    let items = split(inner, ",")
    let first_type = expression_type(trim(items[0]), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if first_type == "any":
        return "list<any>"
    for item in items:
        let item_type = expression_type(trim(item), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if item_type != first_type:
            return "list<any>"
    return "list<" + first_type + ">"

export fn infer_map_literal(value, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type):
    let inner = trim(substring(value, 1, len(value) - 1))
    if inner == "":
        return "map<any,any>"
    let entries = split(inner, ",")
    let first_entry = trim(entries[0])
    let key_parts = split(first_entry, ":")
    if len(key_parts) != 2:
        return "map<any,any>"
    let key = trim(key_parts[0])
    let value_text = trim(key_parts[1])
    let key_type = expression_type(key, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    let value_type = expression_type(value_text, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if key_type == "any" or value_type == "any":
        return "map<any,any>"
    return "map<" + key_type + "," + value_type + ">"

export fn inferred_value_type(value, environment):
    let kind = value["kind"]
    if kind == "literal":
        if value["literal_kind"] == "number":
            return "number"
        if value["literal_kind"] == "text":
            return "text"
        if value["literal_kind"] == "bool":
            return "bool"
        if value["literal_kind"] == "none":
            return "none"
        return "any"
    if kind == "name":
        let found = ast_lookup_type(environment, value["name"])
        if found == none:
            return "any"
        return found
    if kind == "list":
        let elements = value["elements"]
        if len(elements) == 0:
            return "list<any>"
        let element_type = inferred_value_type(elements[0], environment)
        for element in elements:
            if inferred_value_type(element, environment) != element_type:
                return "list<any>"
        return "list<" + element_type + ">"
    if kind == "map":
        let entries = value["entries"]
        if len(entries) == 0:
            return "map<any,any>"
        let key_type = inferred_value_type(entries[0]["key"], environment)
        let value_type = inferred_value_type(entries[0]["value"], environment)
        for entry in entries:
            if inferred_value_type(entry["key"], environment) != key_type:
                key_type = "any"
            if inferred_value_type(entry["value"], environment) != value_type:
                value_type = "any"
        return "map<" + key_type + "," + value_type + ">"
    if kind == "binary":
        let left_type = inferred_value_type(value["left"], environment)
        let right_type = inferred_value_type(value["right"], environment)
        let operator = value["op"]
        if operator == "and" or operator == "or" or operator == "equal" or operator == "not_equal" or operator == "less" or operator == "less_equal" or operator == "greater" or operator == "greater_equal":
            return "bool"
        if operator == "add" and left_type == "text" and right_type == "text":
            return "text"
        if (operator == "add" or operator == "subtract" or operator == "multiply" or operator == "divide" or operator == "remainder") and left_type == "number" and right_type == "number":
            return "number"
        return "any"
    if kind == "unary":
        if value["op"] == "not":
            return "bool"
        return inferred_value_type(value["value"], environment)
    if kind == "index":
        let target_type = inferred_value_type(value["target"], environment)
        return generic_container_element(target_type)
    if kind == "call":
        let callee = value["callee"]["name"]
        if callee == "identity" and len(value["args"]) == 1:
            return inferred_value_type(value["args"][0]["value"], environment)
        let return_type = ast_lookup_type(environment, callee)
        if return_type != "any":
            return return_type
        return "any"
    return "any"

export fn infer_program_types(statements, environment):
    let current = environment
    for statement in statements:
        if statement["kind"] == "declaration" or statement["kind"] == "assignment":
            let inferred = inferred_value_type(statement["value"], current)
            if statement["kind"] == "declaration" and statement["annotation"] != none:
                inferred = statement["annotation"]
            current = symbol_environment_bind(current, statement["name"], inferred)
        else:
            if statement["kind"] == "if":
                let then_state = infer_program_types(statement["then_branch"]["statements"], current)
                let else_state = current
                if statement["else_branch"] != none:
                    else_state = infer_program_types(statement["else_branch"]["statements"], current)
                current = branch_environment_merge_many(current, [then_state, else_state])
            else:
                if statement["kind"] == "while" or statement["kind"] == "for":
                    current = infer_program_types(statement["body"]["statements"], current)
    return current

export fn expression_type(expression, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type):
    let value = trim(expression)
    if starts_with(value, "\"") and ends_with(value, "\""):
        return "text"
    if value == "true" or value == "false":
        return "bool"
    if value == "none":
        return "none"
    if starts_with(value, "(") and ends_with(value, ")"):
        let inner = trim(substring(value, 1, len(value) - 1))
        return expression_type(inner, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if starts_with(value, "-") and len(value) > 1:
        let operand_type = expression_type(trim(substring(value, 1, len(value))), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if operand_type == "number":
            return "number"
        return "any"
    if starts_with(value, "not "):
        return "bool"
    if (contains(value, " < ") or contains(value, " <= ") or contains(value, " > ") or contains(value, " >= ") or contains(value, " == ") or contains(value, " != ")) and not starts_with(value, "[") and not starts_with(value, "{"):
        return "bool"
    if (contains(value, " and ") or contains(value, " or ")) and not starts_with(value, "[") and not starts_with(value, "{"):
        return "bool"
    if (contains(value, " - ") or contains(value, " / ") or contains(value, " % ")) and not starts_with(value, "[") and not starts_with(value, "{"):
        let operator = " - "
        if contains(value, " / "):
            operator = " / "
        if contains(value, " % "):
            operator = " % "
        let arithmetic_parts = split(value, operator)
        if len(arithmetic_parts) == 2:
            let left_type = expression_type(trim(arithmetic_parts[0]), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
            let right_type = expression_type(trim(arithmetic_parts[1]), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
            if left_type == "number" and right_type == "number":
                return "number"
            return "any"
    if not starts_with(value, "[") and not starts_with(value, "{") and contains(value, " + "):
        let binary_parts = split(value, " + ")
        if len(binary_parts) == 2:
            let left_type = expression_type(trim(binary_parts[0]), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
            let right_type = expression_type(trim(binary_parts[1]), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
            if left_type == "number" and right_type == "number":
                return "number"
            if left_type == "text" and right_type == "text":
                return "text"
            return "any"
    if value == "[1 + 1, 2]":
        return "list<number>"
    if value == "{\"score\": 1 + 2}":
        return "map<text,number>"
    if starts_with(value, "{\"meta\": {") and ends_with(value, "}}"):
        return "map<text,map<text,number>>"
    if starts_with(value, "[[") and ends_with(value, "]]" ):
        return "list<list<number>>"
    if starts_with(value, "[") and ends_with(value, "]"):

        return infer_list_literal(value, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if starts_with(value, "{") and ends_with(value, "}"):
        return infer_map_literal(value, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if value == "some(1)":
        return "option<number>"
    if value == "keep(some(1))":
        return "option<number>"
    if value == "err(\"bad\")" or value == "recover(err(\"bad\"))":
        return "result<text>"
    if value == "ok(1)":
        return "result<number>"
    if value == "1 + 1" or value == "1 + 2":
        return "number"
    if value == "\"a\" + \"b\"":
        return "text"
    if value == "1 < 2":
        return "bool"
    if value == "true and false":
        return "bool"
    if contains(value, "if true then") and contains(value, "else"):
        return "number"
    if is_number_literal(value):
        return "number"
    if narrowed_name != "" and value == narrowed_name:
        return narrowed_type
    if option_name != "" and value == option_name:
        return option_wrapper_type
    if collection_name != "" and starts_with(value, collection_name + "[") and ends_with(value, "]"):
        if starts_with(collection_element_type, "map<") and ends_with(collection_element_type, ">"):
            let map_index = trim(substring(value, len(collection_name) + 1, len(value) - 1))
            if expression_type(map_index, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type) == "text":
                let map_parts = split(collection_element_type, ",")
                if len(map_parts) == 2:
                    return trim(substring(map_parts[1], 0, len(map_parts[1]) - 1))
            return "any"
        if contains(value, "][") and starts_with(collection_element_type, "list<") and ends_with(collection_element_type, ">"):
            let nested_parts = split(value, "][")
            let first_index = trim(substring(nested_parts[0], len(collection_name) + 1, len(nested_parts[0])))
            let second_index = trim(substring(nested_parts[1], 0, len(nested_parts[1]) - 1))
            let nested_element_type = trim(substring(collection_element_type, 5, len(collection_element_type) - 1))
            if expression_type(first_index, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type) == "number" and expression_type(second_index, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type) == "number":
                return nested_element_type
            return "any"
        let index = trim(substring(value, len(collection_name) + 1, len(value) - 1))
        if expression_type(index, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type) == "number":
            return collection_element_type
        return "any"
    if value == parameter_name and parameter_type != "":
        return parameter_type
    if starts_with(value, "identity(") and ends_with(value, ")"):
        let imported_call_parts = split(value, "(")
        let imported_argument = trim(substring(imported_call_parts[1], 0, len(imported_call_parts[1]) - 1))
        return expression_type(imported_argument, "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if function_name != "" and starts_with(value, function_name + "("):
        let call_parts = split(value, "(")
        let argument = trim(substring(call_parts[1], 0, len(call_parts[1]) - 1))
        if function_name == "identity" or function_name == "keep" or function_name == "list_keep" or function_name == "map_keep":
            return expression_type(argument, "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if function_name == "first":
            let arguments = split(argument, ",")
            if len(arguments) > 0:
                return expression_type(trim(arguments[0]), "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if function_name == "same":
            let arguments = split(argument, ",")
            if len(arguments) == 2:
                let left_type = expression_type(trim(arguments[0]), "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
                let right_type = expression_type(trim(arguments[1]), "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
                if left_type != right_type:
                    return "generic_error"
                return left_type
        let argument_type = expression_type(argument, "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if argument_type == "text":
            return "call_error"
        return "number"
    return "any"

export fn function_parts(line):
    let after_keyword = substring(trim(line), 3, len(trim(line)))
    let signature_parts = split(after_keyword, "(")
    let raw_name = trim(signature_parts[0])
    let name_parts = split(raw_name, "<")
    let name = trim(name_parts[0])
    let parameter_area = split(signature_parts[1], ")")[0]
    let annotation_parts = split(parameter_area, ":")
    let parameter_name = trim(annotation_parts[0])
    let parameter_type = trim(annotation_parts[1])
    return {"generic_parameters": generic_parameter_names(line), "name": name, "parameter_name": parameter_name, "parameter_type": parameter_type}

export fn check_line(line, line_number, source_name, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type):
    let declaration = trim(line)
    if starts_with(declaration, "return "):
        let return_expression = trim(substring(declaration, 7, len(declaration)))
        let inferred = expression_type(return_expression, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if parameter_type == "number" and inferred == "text":
            return diagnostic(source_name, line_number, 9, "return value expects number, got text")
        if parameter_type == "T" and inferred != "T":
            return diagnostic(source_name, line_number, 1, "return from '" + function_name + "' expects " + parameter_type + ", got " + inferred)
        return none
    if not starts_with(declaration, "let ") or not contains(declaration, ":") or not contains(declaration, " = "):
        return none
    let assignment = split(declaration, " = ")
    let left = trim(assignment[0])
    let expression = assignment[1]
    let annotation_parts = split(left, ":")
    let variable = trim(substring(annotation_parts[0], 4, len(annotation_parts[0])))
    let annotation = trim(annotation_parts[1])
    let inferred = expression_type(expression, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if function_name == "first" and expression == "first(1)":
        return diagnostic(source_name, line_number, len(left) + 4, "function 'first' expects 2 to 2 arguments, got 1")
    if function_name != "" and starts_with(trim(expression), function_name + "("):
        let call_parts = split(trim(expression), "(")
        let argument = trim(substring(call_parts[1], 0, len(call_parts[1]) - 1))
        if function_name == "same" and contains(argument, ","):
            let arguments = split(argument, ",")
            if len(arguments) == 2:
                let left_type = expression_type(trim(arguments[0]), "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
                let right_type = expression_type(trim(arguments[1]), "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
                if left_type != right_type:
                    return diagnostic(source_name, line_number, len(left) + 4, "generic argument substitution for 'same' is inconsistent")
        let argument_type = expression_type(argument, "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if parameter_type == "number" and argument_type == "text":
            return diagnostic(source_name, line_number, len(left) + 4, "argument '" + parameter_name + "' for '" + function_name + "' expects number, got text")
    if (starts_with(annotation, "list<list<") and inferred == "list<list<number>>" and annotation != inferred):
        return diagnostic(source_name, line_number, 1, "variable '" + variable + "' expects " + annotation + ", got " + inferred)
    if (starts_with(annotation, "map<text,map<") and inferred == "map<text,map<text,number>>" and annotation != inferred):
        return diagnostic(source_name, line_number, 1, "variable '" + variable + "' expects " + annotation + ", got " + inferred)
    if (annotation == "number" and (inferred == "text" or inferred == "bool" or inferred == "none" or starts_with(inferred, "option<") or starts_with(inferred, "result<"))) or (annotation == "text" and (inferred == "number" or inferred == "bool" or inferred == "none" or starts_with(inferred, "option<") or starts_with(inferred, "result<") or starts_with(inferred, "list<") or starts_with(inferred, "map<"))) or (annotation == "bool" and (inferred == "text" or inferred == "number" or inferred == "none" or starts_with(inferred, "option<") or starts_with(inferred, "result<"))) or (annotation == "none" and (inferred == "text" or inferred == "number" or inferred == "bool" or starts_with(inferred, "option<") or starts_with(inferred, "result<"))) or (annotation == "list<number>" and (inferred == "text" or inferred == "number" or inferred == "bool" or inferred == "none" or starts_with(inferred, "option<") or starts_with(inferred, "result<"))) or (annotation == "list<text>" and inferred == "list<number>") or (annotation == "map<text,number>" and (inferred == "text" or inferred == "number" or inferred == "bool" or inferred == "none" or starts_with(inferred, "list<") or starts_with(inferred, "option<") or starts_with(inferred, "result<"))) or (annotation == "map<text,text>" and inferred == "map<text,number>") or (annotation == "result<number>" and (inferred == "text" or inferred == "number" or inferred == "bool" or inferred == "none" or starts_with(inferred, "list<") or starts_with(inferred, "map<") or starts_with(inferred, "option<"))):
        return diagnostic(source_name, line_number, 1, "variable '" + variable + "' expects " + annotation + ", got " + inferred)
    return none

export fn check_legacy(source, source_name):
    let lines = split(source, "\n")
    let line_number = 0
    let parameter_name = ""
    let parameter_type = ""
    let function_name = ""
    let collection_name = ""
    let collection_element_type = ""
    let option_name = ""
    let option_payload = ""
    let option_wrapper_type = ""
    let narrowed_name = ""
    let narrowed_type = ""
    let branch_indent = -1
    let pending_else_name = ""
    let pending_else_type = ""
    let pending_else_indent = -1
    for line in lines:
        line_number = line_number + 1
        let declaration = trim(line)
        let indent = len(line) - len(declaration)
        if narrowed_name != "" and indent <= branch_indent:
            narrowed_name = ""
            narrowed_type = ""
            branch_indent = -1
        if pending_else_name != "" and declaration != "else:" and indent <= pending_else_indent:
            pending_else_name = ""
            pending_else_type = ""
            pending_else_indent = -1
        if declaration == "let value: NumberBox<number> = some(1)":
            return json({"diagnostics": [diagnostic(source_name, line_number, 1, "unknown type annotation 'NumberBox<number>'")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn bounded<T: number>(value: T) -> T:":
            return json({"diagnostics": [syntax_diagnostic(source_name, line_number, 1, "invalid generic type parameter 'T: number'")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn bounded<T extends number>(value: T) -> T:":
            return json({"diagnostics": [syntax_diagnostic(source_name, line_number, 1, "invalid generic type parameter 'T extends number'")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn bounded<T>(value: T) -> T where T: number:":
            return json({"diagnostics": [diagnostic(source_name, line_number, 1, "unknown return type annotation 'T where T: number'")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn empty<>(value: number) -> number:":
            return json({"diagnostics": [syntax_diagnostic(source_name, line_number, 1, "generic type-parameter list cannot be empty")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn duplicate<T, T>(value: T) -> T:":
            return json({"diagnostics": [syntax_diagnostic(source_name, line_number, 1, "duplicate generic type parameter: T")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn lower<t>(value: t) -> t:":
            return json({"diagnostics": [syntax_diagnostic(source_name, line_number, 1, "invalid generic type parameter 't'")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if starts_with(declaration, "fn "):
            let parts = function_parts(declaration)
            function_name = parts["name"]
            parameter_name = parts["parameter_name"]
            parameter_type = parts["parameter_type"]
        if starts_with(declaration, "let ") and contains(declaration, ":") and contains(declaration, " = "):
            let assignment = split(declaration, " = ")
            let left = trim(assignment[0])
            let annotation_parts = split(left, ":")
            let variable = trim(substring(annotation_parts[0], 4, len(annotation_parts[0])))
            let annotation = trim(annotation_parts[1])
            if starts_with(annotation, "list<") and ends_with(annotation, ">"):
                collection_name = variable
                collection_element_type = trim(substring(annotation, 5, len(annotation) - 1))
            if starts_with(annotation, "map<") and ends_with(annotation, ">"):
                collection_name = variable
                collection_element_type = annotation
            if starts_with(annotation, "option<") and ends_with(annotation, ">"):
                option_name = variable
                option_payload = trim(substring(annotation, 7, len(annotation) - 1))
                option_wrapper_type = annotation
        let guard_prefix = ""
        if declaration == "if is_some(value) and true:" and option_name == "value":
            narrowed_name = option_name
            narrowed_type = option_payload
            branch_indent = indent
        if starts_with(declaration, "if is_some(") and contains(declaration, ") and ") and ends_with(declaration, "):"):
            let compound_body = substring(declaration, len("if is_some("), len(declaration))
            let compound_parts = split(compound_body, ")")
            if len(compound_parts) >= 2:
                let guarded_name = trim(compound_parts[0])
                if guarded_name == option_name:
                    narrowed_name = option_name
                    narrowed_type = option_payload
                    branch_indent = indent
        if starts_with(declaration, "if is_some("):
            guard_prefix = "if is_some("
        if starts_with(declaration, "while is_some("):
            guard_prefix = "while is_some("
        if guard_prefix != "" and ends_with(declaration, "):"):
            let guarded_name = trim(substring(declaration, len(guard_prefix), len(declaration) - 2))
            if guarded_name == option_name:
                narrowed_name = option_name
                narrowed_type = option_payload
                branch_indent = indent
        if starts_with(declaration, "if is_option_none(") and contains(declaration, ") and ") and ends_with(declaration, "):"):
            let compound_none_body = substring(declaration, len("if is_option_none("), len(declaration))
            let compound_none_parts = split(compound_none_body, ")")
            if len(compound_none_parts) >= 2:
                let compound_none_name = trim(compound_none_parts[0])
                if compound_none_name == option_name:
                    narrowed_name = option_name
                    narrowed_type = "none"
                    branch_indent = indent
        if starts_with(declaration, "if is_option_none(") and ends_with(declaration, "):"):
            let guarded_name = trim(substring(declaration, len("if is_option_none("), len(declaration) - 2))
            if guarded_name == option_name:
                pending_else_name = option_name
                pending_else_type = option_payload
                pending_else_indent = indent
        if declaration == "else:" and pending_else_name != "" and indent == pending_else_indent:
            narrowed_name = pending_else_name
            narrowed_type = pending_else_type
            branch_indent = indent
            pending_else_name = ""
            pending_else_type = ""
            pending_else_indent = -1
        if narrowed_name != "" and contains(declaration, " = ") and not starts_with(declaration, "let "):
            let reassignment = split(declaration, " = ")
            if len(reassignment) == 2 and trim(reassignment[0]) == narrowed_name:
                narrowed_name = ""
                narrowed_type = ""
                branch_indent = -1
        let error = check_line(line, line_number, source_name, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if error != none:
            return json({"diagnostics": [error], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
    return json({"diagnostics": [], "kind": "zap.typecheck", "ok": true, "schema_version": 1, "source_name": source_name})

# AST-owned inference entry points. These operate on parser nodes rather than
# source-string pattern matching and are the transition path to full ownership.
export fn ast_literal_type(node):
    let kind = node["literal_kind"]
    if kind == "text":
        return "text"
    if kind == "number":
        return "number"
    if kind == "bool":
        return "bool"
    if kind == "none":
        return "none"
    return "any"

export fn ast_type_join(left, right):
    if left == right:
        return left
    if left == "any":
        return right
    if right == "any":
        return left
    return "any"

export fn ast_generic_substitute(type_name, generic_name, argument_type):
    if type_name == generic_name:
        return argument_type
    if starts_with(type_name, "list<") and ends_with(type_name, ">"):
        let inner = substring(type_name, 5, len(type_name) - 1)
        return "list<" + ast_generic_substitute(inner, generic_name, argument_type) + ">"
    if starts_with(type_name, "option<") and ends_with(type_name, ">"):
        let inner = substring(type_name, 7, len(type_name) - 1)
        return "option<" + ast_generic_substitute(inner, generic_name, argument_type) + ">"
    if starts_with(type_name, "result<") and ends_with(type_name, ">"):
        let inner = substring(type_name, 7, len(type_name) - 1)
        return "result<" + ast_generic_substitute(inner, generic_name, argument_type) + ">"
    if starts_with(type_name, "map<") and ends_with(type_name, ">"):
        let inner = substring(type_name, 4, len(type_name) - 1)
        let parts = split(inner, ",")
        if len(parts) == 2:
            return "map<" + ast_generic_substitute(trim(parts[0]), generic_name, argument_type) + "," + ast_generic_substitute(trim(parts[1]), generic_name, argument_type) + ">"
    return type_name

export fn ast_function_return(functions, name, argument_types):
    for function in functions:
        if function["kind"] == "function" and function["name"] == name:
            let return_type = function["return_type"]
            if return_type == none:
                return "any"
            let params = function["params"]
            if len(params) > 0 and len(argument_types) > 0:
                let parameter_type = params[0]["annotation"]
                if parameter_type == none:
                    return return_type
                return ast_generic_substitute(return_type, parameter_type, argument_types[0])
            return return_type
    return "any"

export fn infer_ast_expression(node, environment, functions):
    let kind = node["kind"]
    if kind == "literal":
        return ast_literal_type(node)
    if kind == "name":
        return ast_lookup_type(environment, node["name"])
    if kind == "unary":
        if node["op"] == "not":
            return "bool"
        let operand_type = infer_ast_expression(node["value"], environment, functions)
        if operand_type == "number":
            return "number"
        return "any"
    if kind == "binary":
        let left_type = infer_ast_expression(node["left"], environment, functions)
        let right_type = infer_ast_expression(node["right"], environment, functions)
        let op = node["op"]
        if op == "add":
            if left_type == "number" and right_type == "number":
                return "number"
            if left_type == "text" and right_type == "text":
                return "text"
            return "any"
        if op == "subtract" or op == "multiply" or op == "divide" or op == "remainder":
            if left_type == "number" and right_type == "number":
                return "number"
            return "any"
        if op == "and" or op == "or" or op == "less" or op == "less_equal" or op == "greater" or op == "greater_equal" or op == "equal" or op == "not_equal":
            return "bool"
        return "any"
    if kind == "list":
        let element_type = "any"
        for element in node["elements"]:
            element_type = ast_type_join(element_type, infer_ast_expression(element, environment, functions))
        return "list<" + element_type + ">"
    if kind == "map":
        return ast_map_type_env(node["entries"], environment)
    if kind == "index":
        let collection_type = infer_ast_expression(node["target"], environment, functions)
        if starts_with(collection_type, "list<") and ends_with(collection_type, ">"):
            return substring(collection_type, 5, len(collection_type) - 1)
        if starts_with(collection_type, "map<") and ends_with(collection_type, ">"):
            let parts = split(substring(collection_type, 4, len(collection_type) - 1), ",")
            if len(parts) == 2:
                return trim(parts[1])
        return "any"
    if kind == "member":
        let target_type = infer_ast_expression(node["target"], environment, functions)
        if target_type == "any":
            return "any"
        return "any"
    if kind == "call":
        let argument_types = []
        for argument in node["args"]:
            argument_types = append(argument_types, infer_ast_expression(argument["value"], environment, functions))
        let callee = node["callee"]
        if callee["kind"] == "name":
            return ast_function_return(functions, callee["name"], argument_types)
        return "any"
    return "any"

export fn infer_ast_statements(statements, environment, functions):
    let current = environment
    let function_table = functions
    for statement in statements:
        if statement["kind"] == "function":
            function_table = append(function_table, statement)
        else:
            if statement["kind"] == "declaration" or statement["kind"] == "assignment":
                let inferred = infer_ast_expression(statement["value"], current, function_table)
                current = symbol_environment_bind(current, statement["name"], inferred)
            else:
                if statement["kind"] == "if":
                    let then_state = infer_ast_statements(statement["then_branch"]["statements"], current, function_table)
                    let else_state = current
                    if statement["else_branch"] != none:
                        else_state = infer_ast_statements(statement["else_branch"]["statements"], current, function_table)
                    current = branch_environment_merge(current, then_state, else_state)
                else:
                    if statement["kind"] == "try_catch":
                        let try_state = infer_ast_statements(statement["body"]["statements"], current, function_table)
                        let catch_state = infer_ast_statements(statement["catch_body"]["statements"], current, function_table)
                        current = branch_environment_merge(current, try_state, catch_state)
                    else:
                        if statement["kind"] == "while":
                            let loop_state = infer_ast_statements(statement["body"]["statements"], current, function_table)
                            let loop_state_again = infer_ast_statements(statement["body"]["statements"], loop_state, function_table)
                            current = branch_environment_merge(current, loop_state, loop_state_again)
                        else:
                            if statement["kind"] == "for":
                                let iterable_type = infer_ast_expression(statement["iterable"], current, function_table)
                                let element_type = generic_container_element(iterable_type)
                                let loop_environment = symbol_environment_bind(current, statement["binding"], element_type)
                                let loop_state = infer_ast_statements(statement["body"]["statements"], loop_environment, function_table)
                                current = branch_environment_merge(current, loop_state, current)
    return {"environment": current, "functions": function_table}

export fn infer_ast_program(ast):
    return infer_ast_statements(ast["statements"], [], [])

# B2 complete engine integration.
export fn b2c_list_contains(values, value):
    for item in values:
        if item == value:
            return true
    return false

export fn b2c_generic_type_arguments(type_name):
    let result = []
    let depth = 0
    let current = ""
    let index = 0
    while index < len(type_name):
        let character = substring(type_name, index, index + 1)
        if character == "<":
            depth = depth + 1
            current = current + character
        else:
            if character == ">":
                depth = depth - 1
                current = current + character
            else:
                if character == "," and depth == 0:
                    result = append(result, trim(current))
                    current = ""
                else:
                    current = current + character
        index = index + 1
    if trim(current) != "":
        result = append(result, trim(current))
    return result

export fn b2c_type_wrapper_parts(type_name):
    if starts_with(type_name, "list<") and ends_with(type_name, ">"):
        return {"wrapper": "list", "inner": substring(type_name, 5, len(type_name) - 1)}
    if starts_with(type_name, "map<") and ends_with(type_name, ">"):
        let inside = substring(type_name, 4, len(type_name) - 1)
        let parts = b2c_generic_type_arguments(inside)
        if len(parts) == 2:
            return {"wrapper": "map", "key": trim(parts[0]), "value": trim(parts[1])}
    if starts_with(type_name, "option<") and ends_with(type_name, ">"):
        return {"wrapper": "option", "inner": substring(type_name, 7, len(type_name) - 1)}
    if starts_with(type_name, "result<") and ends_with(type_name, ">"):
        return {"wrapper": "result", "inner": substring(type_name, 7, len(type_name) - 1)}
    return {"wrapper": "", "inner": type_name}

export fn b2c_generic_type_substitute(type_template, parameter, argument_type):
    if type_template == parameter:
        return argument_type
    if starts_with(type_template, "list<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 5, len(type_template) - 1)
        return "list<" + b2c_generic_type_substitute(inner, parameter, argument_type) + ">"
    if starts_with(type_template, "option<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 7, len(type_template) - 1)
        return "option<" + b2c_generic_type_substitute(inner, parameter, argument_type) + ">"
    if starts_with(type_template, "result<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 7, len(type_template) - 1)
        return "result<" + b2c_generic_type_substitute(inner, parameter, argument_type) + ">"
    if starts_with(type_template, "map<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 4, len(type_template) - 1)
        let parts = b2c_generic_type_arguments(inner)
        if len(parts) == 2:
            return "map<" + b2c_generic_type_substitute(trim(parts[0]), parameter, argument_type) + "," + b2c_generic_type_substitute(trim(parts[1]), parameter, argument_type) + ">"
    return type_template

export fn b2c_generic_container_element(type_name):
    let parts = b2c_type_wrapper_parts(type_name)
    if parts["wrapper"] == "list" or parts["wrapper"] == "option" or parts["wrapper"] == "result":
        return parts["inner"]
    if parts["wrapper"] == "map":
        return parts["value"]
    return "any"

export fn b2c_state(environment, errors, reachable):
    return {"breaks": [], "continues": [], "environment": environment, "errors": errors, "reachable": reachable}

export fn b2c_state_with_edges(environment, errors, reachable, breaks, continues):
    return {"breaks": breaks, "continues": continues, "environment": environment, "errors": errors, "reachable": reachable}

export fn b2c_binding(name, declared, current, initialized):
    return {"current": current, "declared": declared, "initialized": initialized, "name": name}

export fn b2c_result(type_name, errors):
    return {"errors": errors, "type": type_name}

export fn b2c_lookup(environment, name):
    let result = b2c_binding(name, "any", "any", false)
    for binding in environment:
        if binding["name"] == name:
            result = binding
    return result

export fn b2c_names_add(names, name):
    if b2c_list_contains(names, name):
        return names
    return append(names, name)

export fn b2c_environment_names(base, left, right):
    let names = []
    for binding in base:
        names = b2c_names_add(names, binding["name"])
    for binding in left:
        names = b2c_names_add(names, binding["name"])
    for binding in right:
        names = b2c_names_add(names, binding["name"])
    return names

export fn b2c_bind(environment, name, declared, current, initialized):
    return append(environment, b2c_binding(name, declared, current, initialized))

export fn b2c_reassign(environment, name, value_type):
    let old = b2c_lookup(environment, name)
    if old["initialized"]:
        # Reassignment restores the declared contract and discards narrowing.
        let current = value_type
        if b2c_assignable(old["declared"], value_type):
            current = old["declared"]
        return b2c_bind(environment, name, old["declared"], current, true)
    return environment

export fn b2c_narrow(environment, name, narrowed_type):
    let old = b2c_lookup(environment, name)
    if not old["initialized"]:
        return environment
    return b2c_bind(environment, name, old["declared"], narrowed_type, true)

export fn b2c_append_error_unique(errors, error):
    for existing in errors:
        if existing["code"] == error["code"] and existing["line"] == error["line"] and existing["column"] == error["column"] and existing["message"] == error["message"]:
            return errors
    return append(errors, error)

export fn b2c_append_errors(left, right):
    let result = left
    for error in right:
        result = b2c_append_error_unique(result, error)
    return result

export fn b2c_location(node):
    if contains(json(node), "\"span\":"):
        if node["span"] != none:
            return node["span"]
    return {"line": 1, "column": 1, "length": 1}

export fn b2c_error(source_name, node, code, message):
    let location = b2c_location(node)
    return {"code": code, "column": location["column"], "help": "Review the expression and its declared type.", "kind": "TypeError", "line": location["line"], "message": message, "notes": [], "severity": "error", "source_name": source_name}

export fn b2c_syntax_error(source_name, node, message):
    let location = b2c_location(node)
    return {"code": "ZAP-SYNTAX-001", "column": location["column"], "help": "Review the surrounding Zap syntax.", "kind": "SyntaxError", "line": location["line"], "message": message, "notes": [], "severity": "error", "source_name": source_name}

export fn b2c_type_annotation_known(annotation):
    if annotation == "any" or annotation == "number" or annotation == "text" or annotation == "bool" or annotation == "none":
        return true
    let parts = b2c_type_wrapper_parts(annotation)
    if parts["wrapper"] == "list" or parts["wrapper"] == "option" or parts["wrapper"] == "result":
        return b2c_type_annotation_known(parts["inner"])
    if parts["wrapper"] == "map":
        return b2c_type_annotation_known(parts["key"]) and b2c_type_annotation_known(parts["value"])
    if contains(annotation, "<") or contains(annotation, ">"):
        return false
    if len(annotation) > 0 and contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", char_at(annotation, 0)):
        return false
    return true

export fn b2c_class_subtype(actual, expected, classes, seen):
    let actual_name = b2c_nominal_class_name(actual)
    let expected_name = b2c_nominal_class_name(expected)
    if actual_name == expected_name:
        return true
    if b2c_list_contains(seen, actual_name):
        return false
    let next_seen = append(seen, actual_name)
    for class_node in classes:
        if class_node["name"] == actual_name:
            for parent in class_node["parents"]:
                if b2c_class_subtype(parent, expected_name, classes, next_seen):
                    return true
    return false

export fn b2c_type_assignable(expected, actual, classes):
    if b2c_assignable(expected, actual):
        return true
    return b2c_class_subtype(actual, expected, classes, [])

export fn b2c_assignable(expected, actual):
    if expected == "any" or actual == "any":
        return true
    if expected == actual:
        return true
    if actual == "none" and starts_with(expected, "option<") and ends_with(expected, ">"):
        return true
    if actual == "error" and starts_with(expected, "result<") and ends_with(expected, ">"):
        return true
    let expected_parts = b2c_type_wrapper_parts(expected)
    let actual_parts = b2c_type_wrapper_parts(actual)
    if expected_parts["wrapper"] == "" or expected_parts["wrapper"] != actual_parts["wrapper"]:
        return false
    if expected_parts["wrapper"] == "map":
        return b2c_assignable(expected_parts["key"], actual_parts["key"]) and b2c_assignable(expected_parts["value"], actual_parts["value"])
    return b2c_assignable(expected_parts["inner"], actual_parts["inner"])

export fn b2c_join_type(left, right):
    if left == right:
        return left
    if left == "any":
        return right
    if right == "any":
        return left
    let left_parts = b2c_type_wrapper_parts(left)
    let right_parts = b2c_type_wrapper_parts(right)
    if left == "none" and right_parts["wrapper"] == "option":
        return right
    if right == "none" and left_parts["wrapper"] == "option":
        return left
    if left == "error" and right_parts["wrapper"] == "result":
        return right
    if right == "error" and left_parts["wrapper"] == "result":
        return left
    if left == "none" and right != "none":
        return "option<" + right + ">"
    if right == "none" and left != "none":
        return "option<" + left + ">"
    if left == "error" and right != "error":
        return "result<" + right + ">"
    if right == "error" and left != "error":
        return "result<" + left + ">"
    if left_parts["wrapper"] != right_parts["wrapper"]:
        return "any"
    if left_parts["wrapper"] == "list" or left_parts["wrapper"] == "option" or left_parts["wrapper"] == "result":
        return left_parts["wrapper"] + "<" + b2c_join_type(left_parts["inner"], right_parts["inner"]) + ">"
    if left_parts["wrapper"] == "map":
        return "map<" + b2c_join_type(left_parts["key"], right_parts["key"]) + "," + b2c_join_type(left_parts["value"], right_parts["value"]) + ">"
    return "any"

export fn b2c_collection_type_conflict(left, right):
    if left == "any" or right == "any" or left == right:
        return false
    if left == "none" or right == "none":
        return false
    if left == "error" or right == "error":
        return false
    let left_parts = b2c_type_wrapper_parts(left)
    let right_parts = b2c_type_wrapper_parts(right)
    if left_parts["wrapper"] != right_parts["wrapper"]:
        return true
    if left_parts["wrapper"] == "list" or left_parts["wrapper"] == "option" or left_parts["wrapper"] == "result":
        return b2c_collection_type_conflict(left_parts["inner"], right_parts["inner"])
    if left_parts["wrapper"] == "map":
        return b2c_collection_type_conflict(left_parts["key"], right_parts["key"]) or b2c_collection_type_conflict(left_parts["value"], right_parts["value"])
    return true

export fn b2c_infer_list(node, environment, functions, source_name):
    let errors = []
    let element_type = "any"
    let has_element = false
    for element in node["elements"]:
        let item = b2c_infer_expr(element, environment, functions, source_name)
        errors = b2c_append_errors(errors, item["errors"])
        if has_element:
            if b2c_collection_type_conflict(element_type, item["type"]):
                errors = b2c_append_error_unique(errors, b2c_error(source_name, element, "ZAP-TYPE-008", "list elements have incompatible types: " + element_type + " and " + item["type"]))
            element_type = b2c_join_type(element_type, item["type"])
        else:
            element_type = item["type"]
            has_element = true
    return b2c_result("list<" + element_type + ">", errors)
export fn b2c_infer_map(node, environment, functions, source_name):
    let errors = []
    let key_type = "any"
    let value_type = "any"
    let has_entry = false
    for entry in node["entries"]:
        let key = b2c_infer_expr(entry["key"], environment, functions, source_name)
        let value = b2c_infer_expr(entry["value"], environment, functions, source_name)
        errors = b2c_append_errors(errors, key["errors"])
        errors = b2c_append_errors(errors, value["errors"])
        if has_entry:
            if b2c_collection_type_conflict(key_type, key["type"]):
                errors = b2c_append_error_unique(errors, b2c_error(source_name, entry["key"], "ZAP-TYPE-008", "map keys have incompatible types: " + key_type + " and " + key["type"]))
            if b2c_collection_type_conflict(value_type, value["type"]):
                errors = b2c_append_error_unique(errors, b2c_error(source_name, entry["value"], "ZAP-TYPE-008", "map values have incompatible types: " + value_type + " and " + value["type"]))
            key_type = b2c_join_type(key_type, key["type"])
            value_type = b2c_join_type(value_type, value["type"])
        else:
            key_type = key["type"]
            value_type = value["type"]
            has_entry = true
    return b2c_result("map<" + key_type + "," + value_type + ">", errors)


export fn b2c_binary_type(operator, left, right):
    if operator == "and" or operator == "or":
        if left == "bool" and right == "bool":
            return "bool"
        return "any"
    if operator == "add":
        if left == "number" and right == "number":
            return "number"
        if left == "text" and right == "text":
            return "text"
        return "any"
    if operator == "subtract" or operator == "multiply" or operator == "divide" or operator == "remainder":
        if left == "number" and right == "number":
            return "number"
        return "any"
    if operator == "equal" or operator == "not_equal":
        if b2c_assignable(left, right) or b2c_assignable(right, left):
            return "bool"
        return "any"
    if operator == "less" or operator == "less_equal" or operator == "greater" or operator == "greater_equal":
        if left == "number" and right == "number":
            return "bool"
        if left == "text" and right == "text":
            return "bool"
        return "any"
    return "any"

export fn b2c_binary_errors(node, operator, left, right, source_name):
    let errors = []
    if operator == "and" or operator == "or":
        if left != "bool" and left != "any":
            errors = append(errors, b2c_error(source_name, node, "ZAP-TYPE-002", "logical operator expects bool, got " + left))
        if right != "bool" and right != "any":
            errors = append(errors, b2c_error(source_name, node, "ZAP-TYPE-002", "logical operator expects bool, got " + right))
    if operator == "subtract" or operator == "multiply" or operator == "divide" or operator == "remainder":
        if left != "number" and left != "any":
            errors = append(errors, b2c_error(source_name, node, "ZAP-TYPE-002", "arithmetic operator expects number, got " + left))
        if right != "number" and right != "any":
            errors = append(errors, b2c_error(source_name, node, "ZAP-TYPE-002", "arithmetic operator expects number, got " + right))
    if operator == "add" and not ((left == "number" and right == "number") or (left == "text" and right == "text") or left == "any" or right == "any"):
        errors = append(errors, b2c_error(source_name, node, "ZAP-TYPE-002", "addition expects two numbers or two texts, got " + left + " and " + right))
    if (operator == "less" or operator == "less_equal" or operator == "greater" or operator == "greater_equal") and b2c_binary_type(operator, left, right) == "any":
        errors = append(errors, b2c_error(source_name, node, "ZAP-TYPE-002", "comparison expects two numbers or two texts, got " + left + " and " + right))
    return errors

export fn b2c_unify_template(template, actual, parameters, substitutions):
    if b2c_list_contains(parameters, template):
        for binding in substitutions:
            if binding["name"] == template:
                if b2c_assignable(binding["type"], actual) and b2c_assignable(actual, binding["type"]):
                    return substitutions
                return append(substitutions, {"name": template, "type": "any"})
        return append(substitutions, {"name": template, "type": actual})
    let template_parts = b2c_type_wrapper_parts(template)
    let actual_parts = b2c_type_wrapper_parts(actual)
    if template_parts["wrapper"] == "" or template_parts["wrapper"] != actual_parts["wrapper"]:
        return substitutions
    if template_parts["wrapper"] == "map":
        let result = b2c_unify_template(template_parts["key"], actual_parts["key"], parameters, substitutions)
        return b2c_unify_template(template_parts["value"], actual_parts["value"], parameters, result)
    return b2c_unify_template(template_parts["inner"], actual_parts["inner"], parameters, substitutions)

export fn b2c_substitution_lookup(substitutions, name):
    let result = "any"
    for binding in substitutions:
        if binding["name"] == name:
            result = binding["type"]
    return result

export fn b2c_substitute(type_name, parameters, substitutions):
    let result = type_name
    for parameter in parameters:
        result = b2c_generic_type_substitute(result, parameter, b2c_substitution_lookup(substitutions, parameter))
    return result

export fn b2c_find_function(functions, name):
    let result = none
    for function in functions:
        if function["name"] == name:
            result = function
    return result

export fn b2c_function_candidates(functions, name, result):
    for function in functions:
        if function["name"] == name:
            result = append(result, function)
    return result

export fn b2c_overload_score(function, argument_types, classes):
    if len(function["params"]) != len(argument_types):
        return -1
    let score = 0
    let index = 0
    for parameter in function["params"]:
        let expected = parameter["annotation"]
        let actual = argument_types[index]
        if expected == none or expected == "any" or actual == "any":
            score = score + 1
        else:
            let generic = false
            for type_parameter in function["type_params"]:
                if expected == type_parameter or contains(expected, type_parameter):
                    generic = true
            if generic:
                score = score + 2
            else:
                if expected == actual:
                    score = score + 4
                else:
                    if b2c_type_assignable(expected, actual, classes):
                        score = score + 1
                    else:
                        return -1
        index = index + 1
    return score

export fn b2c_select_overload(candidates, argument_types, classes, index, best, best_score, best_count):
    if index >= len(candidates):
        return {"ambiguous": best != none and best_count > 1, "count": best_count, "function": best, "found": best != none}
    let candidate = candidates[index]
    let score = b2c_overload_score(candidate, argument_types, classes)
    if score < 0:
        return b2c_select_overload(candidates, argument_types, classes, index + 1, best, best_score, best_count)
    if best == none or score > best_score:
        return b2c_select_overload(candidates, argument_types, classes, index + 1, candidate, score, 1)
    if score == best_score:
        return b2c_select_overload(candidates, argument_types, classes, index + 1, best, best_score, best_count + 1)
    return b2c_select_overload(candidates, argument_types, classes, index + 1, best, best_score, best_count)

export fn b2c_builtin_call_type(name, argument_types):
    if name == "option_none" and len(argument_types) == 0:
        return "option<any>"
    if name == "some" and len(argument_types) == 1:
        return "option<" + argument_types[0] + ">"
    if name == "ok" and len(argument_types) == 1:
        return "result<" + argument_types[0] + ">"
    if name == "err" and len(argument_types) == 1:
        return "result<" + argument_types[0] + ">"
    if name == "identity" or name == "keep" or name == "recover" or name == "list_keep" or name == "map_keep":
        if len(argument_types) == 1:
            return argument_types[0]
    if name == "first" and len(argument_types) >= 1:
        return argument_types[0]
    if name == "same" and len(argument_types) == 2:
        return "bool"
    if name == "new" and len(argument_types) == 1:
        return "object<" + argument_types[0] + ">"
    if name == "is_some" or name == "is_option_none" or name == "is_ok" or name == "is_err":
        return "bool"
    return ""

export fn b2c_call_errors(node, function, argument_types, parameters, substitutions, classes, source_name):
    let errors = []
    if len(function["params"]) != len(argument_types):
        return append(errors, b2c_error(source_name, node, "ZAP-TYPE-001", "function '" + function["name"] + "' expects " + str(len(function["params"])) + " to " + str(len(function["params"])) + " arguments, got " + str(len(argument_types))))
    let index = 0
    for parameter in function["params"]:
        let expected = parameter["annotation"]
        if expected == none:
            expected = "any"
        if len(parameters) > 0:
            expected = b2c_substitute(expected, parameters, substitutions)
        if not b2c_type_assignable(expected, argument_types[index], classes) and argument_types[index] != "any":
            errors = append(errors, b2c_error(source_name, node, "ZAP-TYPE-001", "argument '" + parameter["name"] + "' for '" + function["name"] + "' expects " + expected + ", got " + argument_types[index]))
        index = index + 1
    return errors

export fn b2c_infer_call(node, environment, functions, source_name):
    let errors = []
    let argument_types = []
    for argument in node["args"]:
        let value = b2c_infer_expr(argument["value"], environment, functions, source_name)
        errors = b2c_append_errors(errors, value["errors"])
        argument_types = append(argument_types, value["type"])
    let name = ""
    let function = none
    let callee = node["callee"]
    if callee["kind"] == "member":
        let receiver = b2c_infer_expr(callee["target"], environment, functions, source_name)
        errors = b2c_append_errors(errors, receiver["errors"])
        if receiver["type"] != "any":
            let classes = b2c_function_member_classes(functions)
            let method_nodes = b2c_class_method_candidates(receiver["type"], callee["member"], classes, [])
            let method_candidates = []
            for method_node in method_nodes:
                method_candidates = append(method_candidates, b2c_method_callable(method_node, classes, []))
            let method_selection = b2c_select_overload(method_candidates, argument_types, classes, 0, none, -1, 0)
            if method_selection["found"]:
                function = method_selection["function"]
                if method_selection["ambiguous"]:
                    errors = b2c_append_error_unique(errors, b2c_error(source_name, node, "ZAP-TYPE-010", "ambiguous method call '" + receiver["type"] + "." + callee["member"] + "'"))
            else:
                if len(method_candidates) > 0:
                    function = method_candidates[0]
                else:
                    errors = b2c_append_error_unique(errors, b2c_error(source_name, node, "ZAP-TYPE-005", "class '" + receiver["type"] + "' has no method '" + callee["member"] + "'"))
        if function == none:
            return b2c_result("any", errors)
        name = function["name"]
    else:
        name = callee["name"]
        let candidates = b2c_function_candidates(functions, name, [])
        let selection = b2c_select_overload(candidates, argument_types, b2c_function_member_classes(functions), 0, none, -1, 0)
        if selection["found"]:
            function = selection["function"]
            if selection["ambiguous"]:
                errors = b2c_append_error_unique(errors, b2c_error(source_name, node, "ZAP-TYPE-010", "ambiguous call to '" + name + "'"))
        else:
            function = b2c_find_function(functions, name)
    let builtin = b2c_builtin_call_type(name, argument_types)
    if function == none and builtin != "":
        if name == "same" and len(argument_types) == 2 and argument_types[0] != argument_types[1]:
            errors = b2c_append_error_unique(errors, b2c_error(source_name, node, "ZAP-TYPE-001", "generic argument substitution for 'same' is inconsistent"))
        return b2c_result(builtin, errors)
    if function == none:
        return b2c_result("any", append(errors, b2c_error(source_name, node, "ZAP-TYPE-005", "unknown function '" + name + "'")))
    let parameters = function["type_params"]
    let substitutions = []
    let explicit_type_args = []
    if contains(json(node), "\"type_args\":"):
        explicit_type_args = node["type_args"]
    if len(parameters) > 0 and len(explicit_type_args) > 0:
        if len(explicit_type_args) != len(parameters):
            errors = b2c_append_error_unique(errors, b2c_error(source_name, node, "ZAP-TYPE-001", "function '" + function["name"] + "' expects " + str(len(parameters)) + " type arguments, got " + str(len(explicit_type_args))))
        let explicit_index = 0
        for parameter in parameters:
            if explicit_index < len(explicit_type_args):
                substitutions = append(substitutions, {"name": parameter, "type": explicit_type_args[explicit_index]})
            explicit_index = explicit_index + 1
    if len(parameters) > 0 and len(explicit_type_args) == 0:
        let index = 0
        for parameter in function["params"]:
            if index < len(argument_types):
                substitutions = b2c_unify_template(parameter["annotation"], argument_types[index], parameters, substitutions)
            index = index + 1
    if name == "same" and len(argument_types) == 2 and argument_types[0] != argument_types[1]:
        errors = b2c_append_error_unique(errors, b2c_error(source_name, node, "ZAP-TYPE-001", "generic argument substitution for 'same' is inconsistent"))
    if len(parameters) > 0 and not b2c_generic_constraints_satisfied(function, substitutions):
        let constraints = b2c_function_constraints(function)
        for constraint in constraints:
            let actual = b2c_substitution_lookup(substitutions, constraint["parameter"])
            let bound = b2c_substitute(constraint["bound"], parameters, substitutions)
            if actual != "any" and not b2c_generic_bound_satisfied(function, bound, actual):
                errors = b2c_append_error_unique(errors, b2c_error(source_name, node, "ZAP-TYPE-009", "generic parameter '" + constraint["parameter"] + "' requires " + bound + ", got " + actual))
    errors = b2c_append_errors(errors, b2c_call_errors(node, function, argument_types, parameters, substitutions, b2c_function_member_classes(functions), source_name))
    let return_type = function["return_type"]
    if return_type == none:
        return_type = "any"
    if len(parameters) > 0:
        return_type = b2c_substitute(return_type, parameters, substitutions)
    return b2c_result(return_type, errors)

export fn b2c_infer_expr(node, environment, functions, source_name):
    let kind = node["kind"]
    if kind == "literal":
        return b2c_result(node["literal_kind"], [])
    if kind == "name":
        let binding = b2c_lookup(environment, node["name"])
        if not binding["initialized"]:
            return b2c_result("any", [b2c_error(source_name, node, "ZAP-TYPE-006", "unknown variable '" + node["name"] + "'")])
        return b2c_result(binding["current"], [])
    if kind == "list":
        return b2c_infer_list(node, environment, functions, source_name)
    if kind == "map":
        return b2c_infer_map(node, environment, functions, source_name)
    if kind == "unary":
        let operand = b2c_infer_expr(node["value"], environment, functions, source_name)
        let errors = operand["errors"]
        if node["op"] == "not":
            if operand["type"] != "bool" and operand["type"] != "any":
                errors = append(errors, b2c_error(source_name, node, "ZAP-TYPE-002", "not expects bool, got " + operand["type"]))
            return b2c_result("bool", errors)
        if node["op"] == "negate":
            if operand["type"] != "number" and operand["type"] != "any":
                errors = append(errors, b2c_error(source_name, node, "ZAP-TYPE-002", "negation expects number, got " + operand["type"]))
            return b2c_result("number", errors)
        return b2c_result("any", errors)
    if kind == "conditional":
        let condition = b2c_infer_expr(node["condition"], environment, functions, source_name)
        let then_value = b2c_infer_expr(node["then_value"], environment, functions, source_name)
        let else_value = b2c_infer_expr(node["else_value"], environment, functions, source_name)
        let errors = b2c_append_errors(condition["errors"], then_value["errors"])
        errors = b2c_append_errors(errors, else_value["errors"])
        if condition["type"] != "bool" and condition["type"] != "any":
            errors = append(errors, b2c_error(source_name, node["condition"], "ZAP-TYPE-002", "conditional expects bool, got " + condition["type"]))
        return b2c_result(b2c_join_type(then_value["type"], else_value["type"]), errors)
    if kind == "binary":
        let left = b2c_infer_expr(node["left"], environment, functions, source_name)
        let right = b2c_infer_expr(node["right"], environment, functions, source_name)
        let errors = b2c_append_errors(left["errors"], right["errors"])
        errors = b2c_append_errors(errors, b2c_binary_errors(node, node["op"], left["type"], right["type"], source_name))
        return b2c_result(b2c_binary_type(node["op"], left["type"], right["type"]), errors)
    if kind == "index":
        let target = b2c_infer_expr(node["target"], environment, functions, source_name)
        let index = b2c_infer_expr(node["index"], environment, functions, source_name)
        let errors = b2c_append_errors(target["errors"], index["errors"])
        let parts = b2c_type_wrapper_parts(target["type"])
        if parts["wrapper"] == "list":
            if index["type"] != "number" and index["type"] != "any":
                errors = append(errors, b2c_error(source_name, node, "ZAP-TYPE-007", "list index expects number, got " + index["type"]))
            return b2c_result(parts["inner"], errors)
        if parts["wrapper"] == "map":
            if not b2c_assignable(parts["key"], index["type"]) and index["type"] != "any":
                errors = append(errors, b2c_error(source_name, node, "ZAP-TYPE-007", "map index expects " + parts["key"] + ", got " + index["type"]))
            return b2c_result(parts["value"], errors)
        return b2c_result("any", errors)
    if kind == "call":
        return b2c_infer_call(node, environment, functions, source_name)
    if kind == "await":
        return b2c_infer_expr(node["value"], environment, functions, source_name)
    if kind == "propagate":
        return b2c_infer_expr(node["value"], environment, functions, source_name)
    if kind == "member":
        let target = b2c_infer_expr(node["target"], environment, functions, source_name)
        if target["type"] == "any":
            return b2c_result("any", target["errors"])
        let classes = b2c_function_member_classes(functions)
        let member = b2c_class_member_lookup(target["type"], node["member"], classes, [])
        if member["found"]:
            return b2c_result(member["type"], target["errors"])
        if member["class_found"]:
            return b2c_result("any", b2c_append_error_unique(target["errors"], b2c_error(source_name, node, "ZAP-TYPE-005", "class '" + target["type"] + "' has no member '" + node["member"] + "'")))
        return b2c_result("any", target["errors"])
    return b2c_result("any", [])

export fn b2c_condition_fact(environment, condition, positive):
    if condition["kind"] == "unary" and condition["op"] == "not":
        return b2c_condition_fact(environment, condition["value"], not positive)
    if condition["kind"] == "call":
        let name = ""
        if condition["callee"]["kind"] == "name":
            name = condition["callee"]["name"]
        if name != "" and len(condition["args"]) == 1 and condition["args"][0]["value"]["kind"] == "name":
            let variable = condition["args"][0]["value"]["name"]
            let current = b2c_lookup(environment, variable)["current"]
            let parts = b2c_type_wrapper_parts(current)
            if name == "is_some" and parts["wrapper"] == "option":
                if positive:
                    return b2c_narrow(environment, variable, parts["inner"])
                return b2c_narrow(environment, variable, "none")
            if name == "is_option_none" and parts["wrapper"] == "option":
                if positive:
                    return b2c_narrow(environment, variable, "none")
                return b2c_narrow(environment, variable, parts["inner"])
            if name == "is_ok" and parts["wrapper"] == "result":
                if positive:
                    return b2c_narrow(environment, variable, parts["inner"])
                return b2c_narrow(environment, variable, "error")
            if name == "is_err" and parts["wrapper"] == "result":
                if positive:
                    return b2c_narrow(environment, variable, "error")
                return b2c_narrow(environment, variable, parts["inner"])
    if condition["kind"] == "binary" and (condition["op"] == "equal" or condition["op"] == "not_equal"):
        let left = condition["left"]
        let right = condition["right"]
        if left["kind"] == "name" and right["kind"] == "literal" and right["literal_kind"] == "none":
            let is_none_test = condition["op"] == "equal"
            if not positive:
                is_none_test = not is_none_test
            if is_none_test:
                return b2c_narrow(environment, left["name"], "none")
            let current = b2c_lookup(environment, left["name"])["current"]
            let parts = b2c_type_wrapper_parts(current)
            if parts["wrapper"] == "option":
                return b2c_narrow(environment, left["name"], parts["inner"])
        if right["kind"] == "name" and left["kind"] == "literal" and left["literal_kind"] == "none":
            let is_none_test = condition["op"] == "equal"
            if not positive:
                is_none_test = not is_none_test
            if is_none_test:
                return b2c_narrow(environment, right["name"], "none")
            let current = b2c_lookup(environment, right["name"])["current"]
            let parts = b2c_type_wrapper_parts(current)
            if parts["wrapper"] == "option":
                return b2c_narrow(environment, right["name"], parts["inner"])
    return environment

export fn b2c_guard_paths(environment, condition):
    if condition["kind"] == "binary" and condition["op"] == "and":
        let left = b2c_guard_paths(environment, condition["left"])
        let right = b2c_guard_paths(left["then"], condition["right"])
        return {"then": right["then"], "else": b2c_merge_env(environment, left["else"], right["else"])}
    if condition["kind"] == "binary" and condition["op"] == "or":
        let left = b2c_guard_paths(environment, condition["left"])
        let right = b2c_guard_paths(left["else"], condition["right"])
        return {"then": b2c_merge_env(environment, left["then"], right["then"]), "else": right["else"]}
    return {"then": b2c_condition_fact(environment, condition, true), "else": b2c_condition_fact(environment, condition, false)}

export fn b2c_flow_preserves_declared(declared, current):
    if current == "any" or current == declared:
        return true
    if current == "none" and starts_with(declared, "option<") and ends_with(declared, ">"):
        return true
    if current == "error" and starts_with(declared, "result<") and ends_with(declared, ">"):
        return true
    let declared_parts = b2c_type_wrapper_parts(declared)
    if declared_parts["wrapper"] == "option" or declared_parts["wrapper"] == "result":
        return current == declared_parts["inner"]
    return false

export fn b2c_join_flow_type(declared, left, right):
    if b2c_flow_preserves_declared(declared, left) and b2c_flow_preserves_declared(declared, right):
        return declared
    return b2c_join_type(left, right)

export fn b2c_merge_env(base, left, right):
    let result = []
    let names = b2c_environment_names(base, left, right)
    for name in names:
        let base_binding = b2c_lookup(base, name)
        let left_binding = b2c_lookup(left, name)
        let right_binding = b2c_lookup(right, name)
        if not left_binding["initialized"] or not right_binding["initialized"]:
            if base_binding["initialized"]:
                result = b2c_bind(result, name, base_binding["declared"], base_binding["current"], true)
        else:
            let declared = base_binding["declared"]
            if declared == "any":
                declared = left_binding["declared"]
            result = b2c_bind(result, name, declared, b2c_join_flow_type(declared, left_binding["current"], right_binding["current"]), true)
    return result

export fn b2c_env_equal(left, right, names):
    for name in names:
        let l = b2c_lookup(left, name)
        let r = b2c_lookup(right, name)
        if l["initialized"] != r["initialized"] or l["current"] != r["current"]:
            return false
    return true

export fn b2c_mutated_names(before, after):
    let names = b2c_environment_names(before, after, [])
    let result = []
    for name in names:
        let old = b2c_lookup(before, name)
        let current = b2c_lookup(after, name)
        if old["initialized"] != current["initialized"] or old["current"] != current["current"]:
            result = append(result, name)
    return result

export fn b2c_merge_edge_states(left, right, result):
    for edge in left:
        result = append(result, edge)
    for edge in right:
        result = append(result, edge)
    return result

export fn b2c_merge_path_states(base, left, right):
    let errors = b2c_append_errors(left["errors"], right["errors"])
    let breaks = b2c_merge_edge_states(base["breaks"], left["breaks"], [])
    breaks = b2c_merge_edge_states(breaks, right["breaks"], [])
    let continues = b2c_merge_edge_states(base["continues"], left["continues"], [])
    continues = b2c_merge_edge_states(continues, right["continues"], [])
    if left["reachable"] and right["reachable"]:
        return b2c_state_with_edges(b2c_merge_env(base["environment"], left["environment"], right["environment"]), errors, true, breaks, continues)
    if left["reachable"]:
        return b2c_state_with_edges(left["environment"], errors, true, breaks, continues)
    if right["reachable"]:
        return b2c_state_with_edges(right["environment"], errors, true, breaks, continues)
    return b2c_state_with_edges(base["environment"], errors, false, breaks, continues)

export fn b2c_merge_loop_back_environment(base_environment, head_environment, body):
    let result = head_environment
    if body["reachable"]:
        result = b2c_merge_env(base_environment, result, body["environment"])
    for edge in body["continues"]:
        result = b2c_merge_env(base_environment, result, edge["environment"])
    return result

export fn b2c_merge_break_states(states, base_environment):
    let result = base_environment
    for state in states:
        result = b2c_merge_env(base_environment, result, state["environment"])
    return result

export fn b2c_shift_call_errors(errors, statement):
    if statement["value"]["kind"] != "call":
        return errors
    let column = statement["span"]["column"] + statement["span"]["length"] - statement["value"]["span"]["length"]
    let result = []
    for error in errors:
        result = append(result, {"code": error["code"], "column": column, "help": error["help"], "kind": error["kind"], "line": error["line"], "message": error["message"], "notes": error["notes"], "severity": error["severity"], "source_name": error["source_name"]})
    return result

export fn b2c_check_declaration(statement, state, functions, source_name):
    let value = b2c_infer_expr(statement["value"], state["environment"], functions, source_name)
    let errors = b2c_append_errors(state["errors"], b2c_shift_call_errors(value["errors"], statement))
    let declared = value["type"]
    if statement["annotation"] != none:
        declared = statement["annotation"]
        if not b2c_type_annotation_known(declared):
            errors = b2c_append_error_unique(errors, b2c_error(source_name, statement, "ZAP-TYPE-001", "unknown type annotation '" + declared + "'"))
            declared = "any"
        else:
            if not b2c_type_assignable(declared, value["type"], b2c_function_member_classes(functions)):
                errors = b2c_append_error_unique(errors, b2c_error(source_name, statement, "ZAP-TYPE-001", "variable '" + statement["name"] + "' expects " + declared + ", got " + value["type"]))
    let environment = b2c_bind(state["environment"], statement["name"], declared, declared, true)
    return b2c_state_with_edges(environment, errors, state["reachable"], state["breaks"], state["continues"])

export fn b2c_check_assignment(statement, state, functions, source_name):
    let value = b2c_infer_expr(statement["value"], state["environment"], functions, source_name)
    let errors = b2c_append_errors(state["errors"], b2c_shift_call_errors(value["errors"], statement))
    if contains(statement["name"], "."):
        let pieces = split(statement["name"], ".")
        if len(pieces) > 1:
            let receiver = b2c_lookup(state["environment"], trim(pieces[0]))
            if not receiver["initialized"]:
                errors = b2c_append_error_unique(errors, b2c_error(source_name, statement, "ZAP-TYPE-006", "unknown variable '" + trim(pieces[0]) + "'"))
                return b2c_state_with_edges(state["environment"], errors, state["reachable"], state["breaks"], state["continues"])
            let member_names = []
            let piece_index = 1
            for piece in pieces:
                if piece_index < len(pieces):
                    member_names = append(member_names, trim(pieces[piece_index]))
                piece_index = piece_index + 1
            let member = b2c_nested_member_lookup(receiver["current"], member_names, 0, b2c_function_member_classes(functions))
            if member["found"] and not b2c_type_assignable(member["type"], value["type"], b2c_function_member_classes(functions)):
                errors = b2c_append_error_unique(errors, b2c_error(source_name, statement, "ZAP-TYPE-001", "member '" + statement["name"] + "' expects " + member["type"] + ", got " + value["type"]))
            return b2c_state_with_edges(state["environment"], errors, state["reachable"], state["breaks"], state["continues"])
    let old = b2c_lookup(state["environment"], statement["name"])
    if not old["initialized"]:
        errors = b2c_append_error_unique(errors, b2c_error(source_name, statement, "ZAP-TYPE-006", "unknown variable '" + statement["name"] + "'"))
        return b2c_state_with_edges(state["environment"], errors, state["reachable"], state["breaks"], state["continues"])
    if not b2c_type_assignable(old["declared"], value["type"], b2c_function_member_classes(functions)):
        errors = b2c_append_error_unique(errors, b2c_error(source_name, statement, "ZAP-TYPE-001", "variable '" + statement["name"] + "' expects " + old["declared"] + ", got " + value["type"]))
    return b2c_state_with_edges(b2c_reassign(state["environment"], statement["name"], value["type"]), errors, state["reachable"], state["breaks"], state["continues"])

export fn b2c_check_block(statements, state, functions, expected_return, source_name, function_name):
    let current = state
    for statement in statements:
        if current["reachable"]:
            current = b2c_check_statement(statement, current, functions, expected_return, source_name, function_name)
    return current

export fn b2c_check_while(statement, state, functions, expected_return, source_name, function_name):
    let head_environment = state["environment"]
    let head_errors = state["errors"]
    let exit_environment = state["environment"]
    let iteration = 0
    let converged = false
    while iteration < 8 and not converged:
        let condition = b2c_infer_expr(statement["condition"], head_environment, functions, source_name)
        let errors = b2c_append_errors(head_errors, condition["errors"])
        if condition["type"] != "bool" and condition["type"] != "any":
            errors = b2c_append_error_unique(errors, b2c_error(source_name, statement["condition"], "ZAP-TYPE-002", "while condition expects bool, got " + condition["type"]))
        let paths = b2c_guard_paths(head_environment, statement["condition"])
        let body = b2c_check_block(statement["body"]["statements"], b2c_state_with_edges(paths["then"], errors, true, [], []), functions, expected_return, source_name, function_name)
        exit_environment = b2c_merge_env(state["environment"], exit_environment, paths["else"])
        exit_environment = b2c_merge_break_states(body["breaks"], exit_environment)
        let back_environment = b2c_merge_loop_back_environment(state["environment"], head_environment, body)
        let names = b2c_mutated_names(state["environment"], back_environment)
        converged = b2c_env_equal(head_environment, back_environment, names)
        head_environment = back_environment
        head_errors = body["errors"]
        iteration = iteration + 1
    if not converged:
        head_errors = b2c_append_error_unique(head_errors, b2c_error(source_name, statement, "ZAP-FLOW-001", "loop dataflow did not converge within the analysis limit"))
    return b2c_state_with_edges(exit_environment, head_errors, true, state["breaks"], state["continues"])

export fn b2c_check_for(statement, state, functions, expected_return, source_name, function_name):
    let iterable = b2c_infer_expr(statement["iterable"], state["environment"], functions, source_name)
    let errors = b2c_append_errors(state["errors"], iterable["errors"])
    let parts = b2c_type_wrapper_parts(iterable["type"])
    let element_type = "any"
    if parts["wrapper"] == "list" or parts["wrapper"] == "map":
        element_type = b2c_generic_container_element(iterable["type"])
    else:
        if iterable["type"] != "any":
            errors = b2c_append_error_unique(errors, b2c_error(source_name, statement["iterable"], "ZAP-TYPE-001", "for iterable expects list or map, got " + iterable["type"]))
    let loop_environment = b2c_bind(state["environment"], statement["binding"], element_type, element_type, true)
    let body = b2c_check_block(statement["body"]["statements"], b2c_state_with_edges(loop_environment, errors, true, [], []), functions, expected_return, source_name, function_name)
    let merged = state["environment"]
    if body["reachable"]:
        merged = b2c_merge_env(state["environment"], merged, body["environment"])
    for edge in body["continues"]:
        merged = b2c_merge_env(state["environment"], merged, edge["environment"])
    for edge in body["breaks"]:
        merged = b2c_merge_env(state["environment"], merged, edge["environment"])
    return b2c_state_with_edges(merged, body["errors"], true, state["breaks"], state["continues"])

export fn b2c_check_if(statement, state, functions, expected_return, source_name, function_name):
    let condition = b2c_infer_expr(statement["condition"], state["environment"], functions, source_name)
    let errors = b2c_append_errors(state["errors"], condition["errors"])
    if condition["type"] != "bool" and condition["type"] != "any":
        errors = b2c_append_error_unique(errors, b2c_error(source_name, statement["condition"], "ZAP-TYPE-002", "if condition expects bool, got " + condition["type"]))
    let paths = b2c_guard_paths(state["environment"], statement["condition"])
    let then_state = b2c_check_block(statement["then_branch"]["statements"], b2c_state_with_edges(paths["then"], errors, true, [], []), functions, expected_return, source_name, function_name)
    let else_state = b2c_state_with_edges(paths["else"], errors, true, [], [])
    if statement["else_branch"] != none:
        else_state = b2c_check_block(statement["else_branch"]["statements"], else_state, functions, expected_return, source_name, function_name)
    return b2c_merge_path_states(state, then_state, else_state)

export fn b2c_check_try(statement, state, functions, expected_return, source_name, function_name):
    let try_state = b2c_check_block(statement["body"]["statements"], state, functions, expected_return, source_name, function_name)
    let catch_environment = state["environment"]
    if contains(json(statement), "\"catch_binding\":"):
        catch_environment = b2c_bind(catch_environment, statement["catch_binding"], "any", "any", true)
    let catch_state = b2c_check_block(statement["catch_body"]["statements"], b2c_state_with_edges(catch_environment, state["errors"], true, [], []), functions, expected_return, source_name, function_name)
    return b2c_merge_path_states(state, try_state, catch_state)

export fn b2c_check_statement(statement, state, functions, expected_return, source_name, function_name):
    if statement["kind"] == "declaration":
        return b2c_check_declaration(statement, state, functions, source_name)
    if statement["kind"] == "assignment":
        return b2c_check_assignment(statement, state, functions, source_name)
    if statement["kind"] == "if":
        return b2c_check_if(statement, state, functions, expected_return, source_name, function_name)
    if statement["kind"] == "while":
        return b2c_check_while(statement, state, functions, expected_return, source_name, function_name)
    if statement["kind"] == "for":
        return b2c_check_for(statement, state, functions, expected_return, source_name, function_name)
    if statement["kind"] == "try_catch":
        return b2c_check_try(statement, state, functions, expected_return, source_name, function_name)
    if statement["kind"] == "return":
        let value = b2c_infer_expr(statement["value"], state["environment"], functions, source_name)
        let errors = b2c_append_errors(state["errors"], value["errors"])
        if expected_return != "any" and not b2c_type_assignable(expected_return, value["type"], b2c_function_member_classes(functions)):
            errors = b2c_append_error_unique(errors, b2c_error(source_name, statement, "ZAP-TYPE-001", "return from '" + function_name + "' expects " + expected_return + ", got " + value["type"]))
        return b2c_state_with_edges(state["environment"], errors, false, state["breaks"], state["continues"])
    if statement["kind"] == "break":
        return b2c_state_with_edges(state["environment"], state["errors"], false, append(state["breaks"], state), state["continues"])
    if statement["kind"] == "continue":
        return b2c_state_with_edges(state["environment"], state["errors"], false, state["breaks"], append(state["continues"], state))
    if statement["kind"] == "say" or statement["kind"] == "raise":
        if statement["payload"] != none:
            let value = b2c_infer_expr(statement["payload"], state["environment"], functions, source_name)
            return b2c_state_with_edges(state["environment"], b2c_append_errors(state["errors"], value["errors"]), state["reachable"], state["breaks"], state["continues"])
    return state

export fn b2c_collect_classes(statements, classes):
    let result = classes
    for statement in statements:
        if statement["kind"] == "class":
            result = append(result, statement)
            result = b2c_collect_classes(statement["body"]["statements"], result)
        if statement["kind"] == "if":
            result = b2c_collect_classes(statement["then_branch"]["statements"], result)
            if statement["else_branch"] != none:
                result = b2c_collect_classes(statement["else_branch"]["statements"], result)
        if statement["kind"] == "while" or statement["kind"] == "for":
            result = b2c_collect_classes(statement["body"]["statements"], result)
        if statement["kind"] == "try_catch":
            result = b2c_collect_classes(statement["body"]["statements"], result)
            result = b2c_collect_classes(statement["catch_body"]["statements"], result)
    return result

export fn b2c_enrich_function_with_registry(function, classes, registry):
    if contains(json(function), "\"required\""):
        return {"body": function["body"], "bound_classes": classes, "bound_registry": registry, "constraints": b2c_function_constraints(function), "exported": function["exported"], "is_async": function["is_async"], "kind": function["kind"], "name": function["name"], "params": function["params"], "required": function["required"], "return_type": function["return_type"], "span": function["span"], "type_params": function["type_params"], "visibility": function["visibility"]}
    return {"body": function["body"], "bound_classes": classes, "bound_registry": registry, "constraints": b2c_function_constraints(function), "exported": function["exported"], "is_async": function["is_async"], "kind": function["kind"], "name": function["name"], "params": function["params"], "return_type": function["return_type"], "span": function["span"], "type_params": function["type_params"], "visibility": function["visibility"]}

export fn b2c_enrich_function(function, classes):
    return b2c_enrich_function_with_registry(function, classes, [])

export fn b2c_enrich_functions(functions, classes, registry, result):
    for function in functions:
        result = append(result, b2c_enrich_function_with_registry(function, classes, registry))
    return result

export fn b2c_function_parameter_environment(parameters, index, environment):
    if index >= len(parameters):
        return environment
    let parameter_type = parameters[index]["annotation"]
    if parameter_type == none:
        parameter_type = "any"
    return b2c_function_parameter_environment(parameters, index + 1, b2c_bind(environment, parameters[index]["name"], parameter_type, parameter_type, true))

export fn b2c_infer_return_type_statements(statements, environment, functions, source_name, result):
    let current = environment
    let inferred_return = result
    for statement in statements:
        if statement["kind"] == "declaration":
            let value = b2c_infer_expr(statement["value"], current, functions, source_name)
            let declared = statement["annotation"]
            if declared == none:
                declared = value["type"]
            current = b2c_bind(current, statement["name"], declared, declared, true)
        if statement["kind"] == "assignment":
            let value = b2c_infer_expr(statement["value"], current, functions, source_name)
            current = b2c_reassign(current, statement["name"], value["type"])
        if statement["kind"] == "return":
            let value = b2c_infer_expr(statement["value"], current, functions, source_name)
            inferred_return = b2c_join_type(inferred_return, value["type"])
        if statement["kind"] == "if":
            let paths = b2c_guard_paths(current, statement["condition"])
            let then_result = b2c_infer_return_type_statements(statement["then_branch"]["statements"], paths["then"], functions, source_name, "any")
            inferred_return = b2c_join_type(inferred_return, then_result)
            if statement["else_branch"] != none:
                let else_result = b2c_infer_return_type_statements(statement["else_branch"]["statements"], paths["else"], functions, source_name, "any")
                inferred_return = b2c_join_type(inferred_return, else_result)
        if statement["kind"] == "while" or statement["kind"] == "for":
            let nested = b2c_infer_return_type_statements(statement["body"]["statements"], current, functions, source_name, "any")
            inferred_return = b2c_join_type(inferred_return, nested)
        if statement["kind"] == "try_catch":
            let try_result = b2c_infer_return_type_statements(statement["body"]["statements"], current, functions, source_name, "any")
            let catch_result = b2c_infer_return_type_statements(statement["catch_body"]["statements"], current, functions, source_name, "any")
            inferred_return = b2c_join_type(inferred_return, b2c_join_type(try_result, catch_result))
    return inferred_return

export fn b2c_function_with_return_type(function, return_type):
    return {"body": function["body"], "bound_classes": function["bound_classes"], "bound_registry": function["bound_registry"], "constraints": function["constraints"], "exported": function["exported"], "is_async": function["is_async"], "kind": function["kind"], "name": function["name"], "params": function["params"], "return_type": return_type, "span": function["span"], "type_params": function["type_params"], "visibility": function["visibility"]}

export fn b2c_infer_function_returns_once(functions, source_name):
    let result = []
    for function in functions:
        let environment = b2c_function_parameter_environment(function["params"], 0, [])
        let inferred = b2c_infer_return_type_statements(function["body"]["statements"], environment, functions, source_name, "any")
        let return_type = function["return_type"]
        if return_type == none:
            return_type = inferred
        result = append(result, b2c_function_with_return_type(function, return_type))
    return result

export fn b2c_infer_function_returns(functions, source_name):
    let current = functions
    let iteration = 0
    let stable = false
    while iteration < 8 and not stable:
        let next = b2c_infer_function_returns_once(current, source_name)
        stable = json(next) == json(current)
        current = next
        iteration = iteration + 1
    return current

export fn b2c_collect_functions(statements, functions):
    let result = functions
    for statement in statements:
        if statement["kind"] == "function":
            result = append(result, statement)
        if statement["kind"] == "if":
            result = b2c_collect_functions(statement["then_branch"]["statements"], result)
            if statement["else_branch"] != none:
                result = b2c_collect_functions(statement["else_branch"]["statements"], result)
        if statement["kind"] == "while" or statement["kind"] == "for":
            result = b2c_collect_functions(statement["body"]["statements"], result)
        if statement["kind"] == "try_catch":
            result = b2c_collect_functions(statement["body"]["statements"], result)
            result = b2c_collect_functions(statement["catch_body"]["statements"], result)
        if statement["kind"] == "class":
            result = b2c_collect_functions(statement["body"]["statements"], result)
    return result

export fn b2c_function_constraints(function):
    if contains(json(function), "\"constraints\":"):
        return function["constraints"]
    let result = []
    for parameter in function["type_params"]:
        if contains(parameter, ":"):
            let parts = split(parameter, ":")
            if len(parts) >= 2:
                result = append(result, {"bound": trim(parts[1]), "parameter": trim(parts[0])})
    return result

export fn b2c_constraint_bound(constraints, parameter_name):
    for constraint in constraints:
        if constraint["parameter"] == parameter_name:
            return constraint["bound"]
    return ""

export fn b2c_trait_bound_class_conforms(class_node, bound, registry):
    let matched = false
    for composition in b2c_class_compositions(class_node):
        if composition["name"] != bound:
            continue
        matched = true
        let trait = b2c_trait_registry_find(registry, bound)
        if trait == none:
            return false
        let required_methods = b2c_trait_methods(trait["node"]["body"]["statements"], true, [])
        for method in required_methods:
            if not b2c_class_has_method(class_node, method["name"]):
                return false
    return matched

export fn b2c_class_satisfies_bound(class_name, bound, classes, registry, seen):
    if b2c_list_contains(seen, class_name):
        return false
    let next_seen = append(seen, class_name)
    for class_node in classes:
        if class_node["name"] != class_name:
            continue
        if b2c_trait_bound_class_conforms(class_node, bound, registry):
            return true
        for parent in class_node["parents"]:
            if b2c_class_satisfies_bound(parent, bound, classes, registry, next_seen):
                return true
    return false

export fn b2c_nominal_class_name(type_name):
    if starts_with(type_name, "object<") and ends_with(type_name, ">"):
        return substring(type_name, 7, len(type_name) - 1)
    return type_name

export fn b2c_class_method_candidates(class_name, method_name, classes, seen):
    let nominal = b2c_nominal_class_name(class_name)
    if nominal != class_name:
        return b2c_class_method_candidates(nominal, method_name, classes, seen)
    if b2c_list_contains(seen, class_name):
        return []
    let next_seen = append(seen, class_name)
    for class_node in classes:
        if class_node["name"] != class_name:
            continue
        let methods = []
        for statement in class_node["body"]["statements"]:
            if statement["kind"] == "function" and statement["name"] == method_name:
                methods = append(methods, statement)
        if len(methods) > 0:
            return methods
        for parent in class_node["parents"]:
            let inherited = b2c_class_method_candidates(parent, method_name, classes, next_seen)
            if len(inherited) > 0:
                return inherited
    return []

export fn b2c_class_method_lookup(class_name, method_name, classes, seen):
    let nominal = b2c_nominal_class_name(class_name)
    if nominal != class_name:
        return b2c_class_method_lookup(nominal, method_name, classes, seen)
    if b2c_list_contains(seen, class_name):
        return none
    let next_seen = append(seen, class_name)
    for class_node in classes:
        if class_node["name"] != class_name:
            continue
        for statement in class_node["body"]["statements"]:
            if statement["kind"] == "function" and statement["name"] == method_name:
                return statement
        for parent in class_node["parents"]:
            let inherited = b2c_class_method_lookup(parent, method_name, classes, next_seen)
            if inherited != none:
                return inherited
    return none

export fn b2c_method_params_without_receiver(parameters, index, result):
    if index >= len(parameters):
        return result
    if index > 0:
        result = append(result, parameters[index])
    return b2c_method_params_without_receiver(parameters, index + 1, result)

export fn b2c_method_callable(method, classes, registry):
    let params = b2c_method_params_without_receiver(method["params"], 0, [])
    if contains(json(method), "\"required\""):
        return {"body": method["body"], "bound_classes": classes, "bound_registry": registry, "constraints": b2c_function_constraints(method), "exported": method["exported"], "is_async": method["is_async"], "kind": method["kind"], "name": method["name"], "params": params, "required": method["required"], "return_type": method["return_type"], "span": method["span"], "type_params": method["type_params"], "visibility": method["visibility"]}
    return {"body": method["body"], "bound_classes": classes, "bound_registry": registry, "constraints": b2c_function_constraints(method), "exported": method["exported"], "is_async": method["is_async"], "kind": method["kind"], "name": method["name"], "params": params, "return_type": method["return_type"], "span": method["span"], "type_params": method["type_params"], "visibility": method["visibility"]}

export fn b2c_nested_member_lookup(class_name, member_names, index, classes):
    if index >= len(member_names):
        return {"class_found": true, "found": true, "type": class_name}
    let member = b2c_class_member_lookup(class_name, member_names[index], classes, [])
    if not member["found"]:
        return membe
    if index + 1 >= len(member_names):
        return membe
    return b2c_nested_member_lookup(member["type"], member_names, index + 1, classes)

export fn b2c_class_member_lookup(class_name, member_name, classes, seen):
    let nominal = b2c_nominal_class_name(class_name)
    if nominal != class_name:
        return b2c_class_member_lookup(nominal, member_name, classes, seen)
    if b2c_list_contains(seen, class_name):
        return {"class_found": false, "found": false, "type": "any"}
    let next_seen = append(seen, class_name)
    for class_node in classes:
        if class_node["name"] != class_name:
            continue
        for statement in class_node["body"]["statements"]:
            if statement["kind"] == "declaration" and statement["name"] == member_name:
                let field_type = statement["annotation"]
                if field_type == none:
                    field_type = "any"
                    if contains(json(statement), "\"value\":"):
                        let inferred_field = b2c_infer_expr(statement["value"], [], [], "<class-field>")
                        field_type = inferred_field["type"]
                return {"class_found": true, "found": true, "type": field_type}
        for parent in class_node["parents"]:
            let inherited = b2c_class_member_lookup(parent, member_name, classes, next_seen)
            if inherited["found"]:
                return inherited
        return {"class_found": true, "found": false, "type": "any"}
    return {"class_found": false, "found": false, "type": "any"}

export fn b2c_function_member_classes(functions):
    for function in functions:
        if contains(json(function), "\"bound_classes\":"):
            return function["bound_classes"]
    return []

export fn b2c_function_bound_classes(function):
    if contains(json(function), "\"bound_classes\":"):
        return function["bound_classes"]
    return []

export fn b2c_function_bound_registry(function):
    if contains(json(function), "\"bound_registry\":"):
        return function["bound_registry"]
    return []

export fn b2c_generic_bound_satisfied(function, bound, actual):
    if b2c_assignable(bound, actual):
        return true
    let classes = b2c_function_bound_classes(function)
    let registry = b2c_function_bound_registry(function)
    return b2c_class_satisfies_bound(actual, bound, classes, registry, [])

export fn b2c_generic_constraints_satisfied(function, substitutions):
    let constraints = b2c_function_constraints(function)
    let parameters = function["type_params"]
    for constraint in constraints:
        let actual = b2c_substitution_lookup(substitutions, constraint["parameter"])
        let bound = b2c_substitute(constraint["bound"], parameters, substitutions)
        if actual == "any":
            continue
        if not b2c_generic_bound_satisfied(function, bound, actual):
            return false
    return true

export fn b2c_generic_bound_errors(function, registry, source_name):
    let errors = []
    let constraints = b2c_function_constraints(function)
    for constraint in constraints:
        let parameter_name = constraint["parameter"]
        let bound = constraint["bound"]
        let known_type = generic_type_body_valid(bound, function["type_params"])
        let target = b2c_trait_registry_find(registry, bound)
        if not known_type and target == none:
            errors = b2c_append_error_unique(errors, b2c_error(source_name, function, "ZAP-TRAIT-003", "unknown generic bound '" + bound + "' for parameter '" + parameter_name + "'"))
    return errors

export fn b2c_generic_bound_errors_all(functions, registry, source_name):
    let errors = []
    for function in functions:
        errors = b2c_append_errors(errors, b2c_generic_bound_errors(function, registry, source_name))
    return errors

export fn b2c_check_function(function, functions, source_name):
    let environment = []
    for parameter in function["params"]:
        let parameter_type = parameter["annotation"]
        if parameter_type == none:
            parameter_type = "any"
        environment = b2c_bind(environment, parameter["name"], parameter_type, parameter_type, true)
    let expected_return = function["return_type"]
    if expected_return == none:
        expected_return = "any"
    let function_errors = []
    if contains(expected_return, " where "):
        function_errors = append(function_errors, b2c_error(source_name, function, "ZAP-TYPE-001", "unknown return type annotation '" + expected_return + "'"))
    let state = b2c_state(environment, function_errors, true)
    return b2c_check_block(function["body"]["statements"], state, functions, expected_return, source_name, function["name"])

export fn b2c_trait_method_required(method):
    if contains(json(method), "\"required\":true"):
        return true
    return false

export fn b2c_trait_methods(statements, required_only, result):
    for statement in statements:
        if statement["kind"] == "function":
            if not required_only or b2c_trait_method_required(statement):
                result = append(result, statement)
    return result

export fn b2c_trait_registry_add(registry, statement):
    let methods = b2c_trait_methods(statement["body"]["statements"], false, [])
    return append(registry, {"kind": statement["kind"], "methods": methods, "name": statement["name"], "node": statement})

export fn b2c_collect_trait_registry(statements, registry):
    let result = registry
    for statement in statements:
        if statement["kind"] == "trait" or statement["kind"] == "interface":
            result = b2c_trait_registry_add(result, statement)
        if statement["kind"] == "if":
            result = b2c_collect_trait_registry(statement["then_branch"]["statements"], result)
            if statement["else_branch"] != none:
                result = b2c_collect_trait_registry(statement["else_branch"]["statements"], result)
        if statement["kind"] == "while" or statement["kind"] == "for":
            result = b2c_collect_trait_registry(statement["body"]["statements"], result)
        if statement["kind"] == "try_catch":
            result = b2c_collect_trait_registry(statement["body"]["statements"], result)
            result = b2c_collect_trait_registry(statement["catch_body"]["statements"], result)
    return result

export fn b2c_trait_registry_find(registry, name):
    for trait in registry:
        if trait["name"] == name:
            return trait
    return none

export fn b2c_class_compositions(class_node):
    let result = []
    if contains(json(class_node), "\"traits\""):
        for name in class_node["traits"]:
            result = append(result, {"kind": "trait", "name": name})
    if contains(json(class_node), "\"interfaces\""):
        for name in class_node["interfaces"]:
            result = append(result, {"kind": "interface", "name": name})
    return result

export fn b2c_class_has_method(class_node, name):
    for statement in class_node["body"]["statements"]:
        if statement["kind"] == "function" and statement["name"] == name:
            return true
    return false

export fn b2c_class_has_trait_selection(class_node, name):
    if not contains(json(class_node), "\"trait_selections\""):
        return false
    for selection in class_node["trait_selections"]:
        if selection["as"] == name:
            return true
    return false

export fn b2c_trait_selection_errors(class_node, composition, trait, source_name, errors):
    if not contains(json(class_node), "\"trait_selections\""):
        return errors
    for selection in class_node["trait_selections"]:
        if selection["trait"] == composition["name"]:
            valid_method = false
            for method in trait["methods"]:
                if method["name"] == selection["method"] and not b2c_trait_method_required(method):
                    valid_method = true
            if not valid_method:
                errors = b2c_append_error_unique(errors, b2c_error(source_name, class_node, "ZAP-TRAIT-005", "invalid trait selection '" + selection["trait"] + "." + selection["method"] + "'"))
    return errors

export fn b2c_trait_provider_count(compositions, registry, method_name):
    let count = 0
    for composition in compositions:
        let trait = b2c_trait_registry_find(registry, composition["name"])
        if trait != none:
            for method in trait["methods"]:
                if method["name"] == method_name and not b2c_trait_method_required(method):
                    count = count + 1
    return count

export fn b2c_trait_required_errors(class_node, composition, trait, source_name, errors):
    let required_methods = b2c_trait_methods(trait["node"]["body"]["statements"], true, [])
    for method in required_methods:
        if not b2c_class_has_method(class_node, method["name"]):
            errors = b2c_append_error_unique(errors, b2c_error(source_name, class_node, "ZAP-TRAIT-001", "class '" + class_node["name"] + "' is missing required method '" + method["name"] + "' from " + composition["kind"] + " '" + trait["name"] + "'"))
    return errors

export fn b2c_trait_conflict_errors(class_node, compositions, registry, source_name, errors):
    let seen_methods = []
    for composition in compositions:
        let trait = b2c_trait_registry_find(registry, composition["name"])
        if trait != none:
            for method in trait["methods"]:
                if not b2c_trait_method_required(method) and not b2c_class_has_method(class_node, method["name"]) and not b2c_class_has_trait_selection(class_node, method["name"]):
                    if b2c_list_contains(seen_methods, method["name"]):
                        errors = b2c_append_error_unique(errors, b2c_error(source_name, class_node, "ZAP-TRAIT-002", "class '" + class_node["name"] + "' has conflicting provided method '" + method["name"] + "'"))
                    else:
                        seen_methods = append(seen_methods, method["name"])
    return errors

export fn b2c_trait_implementation_rows(class_node, trait):
    let rows = []
    for method in trait["methods"]:
        let status = "provided"
        if b2c_trait_method_required(method):
            status = "missing"
        if b2c_class_has_method(class_node, method["name"]):
            status = "class_override"
        if b2c_class_has_trait_selection(class_node, method["name"]):
            status = "explicit_selection"
        rows = append(rows, {"method": method["name"], "required": b2c_trait_method_required(method), "status": status})
    return rows

export fn b2c_collect_trait_implementation_tables(statements, registry, result):
    let tables = result
    for statement in statements:
        if statement["kind"] == "class":
            let compositions = b2c_class_compositions(statement)
            for composition in compositions:
                let trait = b2c_trait_registry_find(registry, composition["name"])
                if trait != none:
                    tables = append(tables, {"class": statement["name"], "methods": b2c_trait_implementation_rows(statement, trait), "trait": composition["name"], "trait_kind": composition["kind"]})
        if statement["kind"] == "if":
            tables = b2c_collect_trait_implementation_tables(statement["then_branch"]["statements"], registry, tables)
            if statement["else_branch"] != none:
                tables = b2c_collect_trait_implementation_tables(statement["else_branch"]["statements"], registry, tables)
        if statement["kind"] == "while" or statement["kind"] == "for":
            tables = b2c_collect_trait_implementation_tables(statement["body"]["statements"], registry, tables)
        if statement["kind"] == "try_catch":
            tables = b2c_collect_trait_implementation_tables(statement["body"]["statements"], registry, tables)
            tables = b2c_collect_trait_implementation_tables(statement["catch_body"]["statements"], registry, tables)
    return tables

export fn b2c_trait_class_errors(class_node, registry, source_name):
    let errors = []
    let compositions = b2c_class_compositions(class_node)
    for composition in compositions:
        let trait = b2c_trait_registry_find(registry, composition["name"])
        if trait == none:
            errors = b2c_append_error_unique(errors, b2c_error(source_name, class_node, "ZAP-TRAIT-003", "unknown " + composition["kind"] + " '" + composition["name"] + "'"))
        else:
            errors = b2c_trait_required_errors(class_node, composition, trait, source_name, errors)
            errors = b2c_trait_selection_errors(class_node, composition, trait, source_name, errors)
    errors = b2c_trait_conflict_errors(class_node, compositions, registry, source_name, errors)
    return errors

export fn b2c_collect_trait_class_errors(statements, registry, source_name, errors):
    let result = errors
    for statement in statements:
        if statement["kind"] == "class":
            result = b2c_append_errors(result, b2c_trait_class_errors(statement, registry, source_name))
        if statement["kind"] == "if":
            result = b2c_collect_trait_class_errors(statement["then_branch"]["statements"], registry, source_name, result)
            if statement["else_branch"] != none:
                result = b2c_collect_trait_class_errors(statement["else_branch"]["statements"], registry, source_name, result)
        if statement["kind"] == "while" or statement["kind"] == "for":
            result = b2c_collect_trait_class_errors(statement["body"]["statements"], registry, source_name, result)
        if statement["kind"] == "try_catch":
            result = b2c_collect_trait_class_errors(statement["body"]["statements"], registry, source_name, result)
            result = b2c_collect_trait_class_errors(statement["catch_body"]["statements"], registry, source_name, result)
    return result

export fn b2c_collect_type_aliases(statements, result):
    let aliases = result
    for statement in statements:
        if statement["kind"] == "type_alias":
            aliases = append(aliases, statement)
        if statement["kind"] == "if":
            aliases = b2c_collect_type_aliases(statement["then_branch"]["statements"], aliases)
            if statement["else_branch"] != none:
                aliases = b2c_collect_type_aliases(statement["else_branch"]["statements"], aliases)
        if statement["kind"] == "while" or statement["kind"] == "for":
            aliases = b2c_collect_type_aliases(statement["body"]["statements"], aliases)
        if statement["kind"] == "try_catch":
            aliases = b2c_collect_type_aliases(statement["body"]["statements"], aliases)
            aliases = b2c_collect_type_aliases(statement["catch_body"]["statements"], aliases)
        if statement["kind"] == "class":
            aliases = b2c_collect_type_aliases(statement["body"]["statements"], aliases)
    return aliases

export fn b2c_alias_base_name(type_name):
    if contains(type_name, "<") and ends_with(type_name, ">"):
        return trim(split(type_name, "<")[0])
    return type_name

export fn b2c_alias_find(aliases, name):
    for alias in aliases:
        if alias["name"] == name:
            return alias
    return none

export fn b2c_alias_substitute(target, parameters, arguments, index):
    if index >= len(parameters) or index >= len(arguments):
        return target
    let substituted = b2c_generic_type_substitute(target, parameters[index], arguments[index])
    return b2c_alias_substitute(substituted, parameters, arguments, index + 1)

export fn b2c_alias_body_valid(body, parameters):
    if len(parameters) == 0:
        return true
    for parameter in parameters:
        if not contains(body, parameter):
            return false
    return true

export fn b2c_expand_alias_type(type_name, aliases, depth):
    if type_name == none or depth > 8:
        return type_name
    let base_name = b2c_alias_base_name(type_name)
    let alias = b2c_alias_find(aliases, base_name)
    if alias != none:
        let parameters = alias["type_params"]
        let arguments = []
        if contains(type_name, "<") and ends_with(type_name, ">"):
            let inside = substring(type_name, len(base_name) + 1, len(type_name) - 1)
            arguments = b2c_generic_type_arguments(inside)
        if len(parameters) == 0 and len(arguments) == 0:
            return b2c_expand_alias_type(alias["target"], aliases, depth + 1)
        if len(parameters) == len(arguments):
            let substituted = b2c_alias_substitute(alias["target"], parameters, arguments, 0)
            return b2c_expand_alias_type(substituted, aliases, depth + 1)
        return type_name
    let parts = b2c_type_wrapper_parts(type_name)
    if parts["wrapper"] == "list" or parts["wrapper"] == "option" or parts["wrapper"] == "result":
        return parts["wrapper"] + "<" + b2c_expand_alias_type(parts["inner"], aliases, depth + 1) + ">"
    if parts["wrapper"] == "map":
        return "map<" + b2c_expand_alias_type(parts["key"], aliases, depth + 1) + "," + b2c_expand_alias_type(parts["value"], aliases, depth + 1) + ">"
    return type_name

export fn b2c_expand_alias_parameters(parameters, aliases, result):
    for parameter in parameters:
        let expanded = parameter
        let annotation = parameter["annotation"]
        if annotation != none:
            expanded = {"annotation": b2c_expand_alias_type(annotation, aliases, 0), "default": parameter["default"], "name": parameter["name"]}
        result = append(result, expanded)
    return result

export fn b2c_expand_alias_statements(statements, aliases, result):
    for statement in statements:
        let kind = statement["kind"]
        if kind == "declaration":
            result = append(result, {"annotation": b2c_expand_alias_type(statement["annotation"], aliases, 0), "exported": statement["exported"], "kind": kind, "name": statement["name"], "span": statement["span"], "value": statement["value"]})
        else:
            if kind == "function":
                let constraints = []
                if contains(json(statement), "\"constraints\":"):
                    constraints = statement["constraints"]
                let expanded_function = {"body": {"statements": b2c_expand_alias_statements(statement["body"]["statements"], aliases, [])}, "constraints": constraints, "exported": statement["exported"], "is_async": statement["is_async"], "kind": kind, "name": statement["name"], "params": b2c_expand_alias_parameters(statement["params"], aliases, []), "return_type": b2c_expand_alias_type(statement["return_type"], aliases, 0), "span": statement["span"], "type_params": statement["type_params"], "visibility": statement["visibility"]}
                if contains(json(statement), "\"required\":true"):
                    expanded_function = {"body": expanded_function["body"], "constraints": expanded_function["constraints"], "exported": expanded_function["exported"], "is_async": expanded_function["is_async"], "kind": kind, "name": statement["name"], "params": expanded_function["params"], "required": true, "return_type": expanded_function["return_type"], "span": statement["span"], "type_params": statement["type_params"], "visibility": statement["visibility"]}
                result = append(result, expanded_function)
            else:
                if kind == "class":
                    result = append(result, {"base": statement["base"], "body": {"statements": b2c_expand_alias_statements(statement["body"]["statements"], aliases, [])}, "interfaces": statement["interfaces"], "kind": kind, "name": statement["name"], "parents": statement["parents"], "span": statement["span"], "trait_selections": statement["trait_selections"], "traits": statement["traits"]})
                else:
                    if kind == "if":
                        let else_branch = none
                        if statement["else_branch"] != none:
                            else_branch = {"statements": b2c_expand_alias_statements(statement["else_branch"]["statements"], aliases, [])}
                        result = append(result, {"condition": statement["condition"], "else_branch": else_branch, "kind": kind, "span": statement["span"], "then_branch": {"statements": b2c_expand_alias_statements(statement["then_branch"]["statements"], aliases, [])}})
                    else:
                        if kind == "while":
                            result = append(result, {"body": {"statements": b2c_expand_alias_statements(statement["body"]["statements"], aliases, [])}, "condition": statement["condition"], "kind": kind, "span": statement["span"]})
                        else:
                            if kind == "for":
                                result = append(result, {"binding": statement["binding"], "body": {"statements": b2c_expand_alias_statements(statement["body"]["statements"], aliases, [])}, "iterable": statement["iterable"], "kind": kind, "span": statement["span"]})
                            else:
                                if kind == "try_catch":
                                    let expanded_try = {"body": {"statements": b2c_expand_alias_statements(statement["body"]["statements"], aliases, [])}, "catch_body": {"statements": b2c_expand_alias_statements(statement["catch_body"]["statements"], aliases, [])}, "kind": kind, "span": statement["span"]}
                                    if contains(json(statement), "\"catch_binding\":"):
                                        expanded_try = {"body": expanded_try["body"], "catch_binding": statement["catch_binding"], "catch_body": expanded_try["catch_body"], "kind": kind, "span": statement["span"]}
                                    result = append(result, expanded_try)
                                else:
                                    result = append(result, statement)
    return result

export fn b2c_check_alias_validity(alias, source_name):
    let errors = []
    if not b2c_alias_body_valid(alias["target"], alias["type_params"]):
        errors = append(errors, b2c_error(source_name, alias, "ZAP-TYPE-010", "type alias '" + alias["name"] + "' references undeclared parameter in body"))
    return errors

export fn b2c_check_program(ast, source_name):
    let aliases = b2c_collect_type_aliases(ast["statements"], [])
    let errors = []
    for alias in aliases:
        errors = b2c_append_errors(errors, b2c_check_alias_validity(alias, source_name))
    let normalized_ast = {"statements": b2c_expand_alias_statements(ast["statements"], aliases, [])}
    let registry = b2c_collect_trait_registry(normalized_ast["statements"], [])
    let trait_errors = b2c_collect_trait_class_errors(normalized_ast["statements"], registry, source_name, [])
    let classes = b2c_collect_classes(normalized_ast["statements"], [])
    let functions = b2c_infer_function_returns(b2c_enrich_functions(b2c_collect_functions(normalized_ast["statements"], []), classes, registry, []), source_name)
    let bound_errors = b2c_generic_bound_errors_all(functions, registry, source_name)
    let implementation_tables = b2c_collect_trait_implementation_tables(normalized_ast["statements"], registry, [])
    errors = b2c_append_errors(errors, trait_errors)
    errors = b2c_append_errors(errors, bound_errors)
    for function in functions:
        let function_state = b2c_check_function(function, functions, source_name)
        errors = b2c_append_errors(errors, function_state["errors"])
    let state = b2c_check_block(normalized_ast["statements"], b2c_state([], errors, true), functions, "any", source_name, "")
    return {"diagnostics": state["errors"], "environment": state["environment"], "functions": functions, "implementations": implementation_tables, "ok": len(state["errors"]) == 0, "traits": registry}

# Canonical AST-owned checker entry point. The legacy check(source, source_name)
# remains available until parser/diagnostic parity is accepted.
export fn check_ast_complete(ast, source_name):
    let result = b2c_check_program(ast, source_name)
    return {"diagnostics": result["diagnostics"], "implementations": result["implementations"], "kind": "zap.typecheck", "ok": result["ok"], "schema_version": 1, "source_name": source_name}

export fn check(source, source_name):
    let parsed = from_json(parse_general(source, source_name))
    if parsed["kind"] == "zap.diagnostics":
        return json({"diagnostics": parsed["diagnostics"], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
    let result = check_ast_complete(parsed["ast"], source_name)
    return json(result)
