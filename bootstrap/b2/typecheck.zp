# B2 candidate type checker written in Zap.
# This is a provisional corpus-limited implementation. Native Rust remains the
# reference type checker and owns the complete language semantics.

export fn ast_lookup_type(environment, name):
    for binding in environment:
        if binding["name"] == name:
            return binding["type"]
    return "any"

export fn ast_expression_type_env(node, environment):
    let kind = node["kind"]
    if kind == "literal":
        return node["literal_kind"]
    if kind == "name":
        return ast_lookup_type(environment, node["name"])
    if kind == "unary":
        if node["op"] == "not":
            return "bool"
        if node["op"] == "negate" and ast_expression_type_env(node["value"], environment) == "number":
            return "number"
        return "any"
    if kind == "binary":
        let operator = node["op"]
        if operator == "and" or operator == "or" or operator == "equal" or operator == "not_equal" or operator == "less" or operator == "less_equal" or operator == "greater" or operator == "greater_equal":
            return "bool"
        let left_type = ast_expression_type_env(node["left"], environment)
        let right_type = ast_expression_type_env(node["right"], environment)
        if operator == "add" and left_type == "text" and right_type == "text":
            return "text"
        if (operator == "add" or operator == "subtract" or operator == "multiply" or operator == "divide" or operator == "remainder") and left_type == "number" and right_type == "number":
            return "number"
        return "any"
    if kind == "list":
        if len(node["elements"]) == 0:
            return "list<any>"
        let first_type = ast_expression_type_env(node["elements"][0], environment)
        for element in node["elements"]:
            if ast_expression_type_env(element, environment) != first_type:
                return "list<any>"
        return "list<" + first_type + ">"
    if kind == "map":
        if len(node["entries"]) == 0:
            return "map<any,any>"
        let first_entry = node["entries"][0]
        return "map<" + ast_expression_type_env(first_entry["key"], environment) + "," + ast_expression_type_env(first_entry["value"], environment) + ">"
    if kind == "call":
        let callee = node["callee"]["name"]
        if callee == "identity" and len(node["args"]) == 1:
            return ast_expression_type_env(node["args"][0]["value"], environment)
        return "any"
    if kind == "index":
        let target_type = ast_expression_type_env(node["target"], environment)
        let index_type = ast_expression_type_env(node["index"], environment)
        if starts_with(target_type, "list<") and ends_with(target_type, ">"):
            if index_type == "number":
                return substring(target_type, 5, len(target_type) - 1)
            return "any"
        if starts_with(target_type, "map<") and ends_with(target_type, ">"):
            let parts = split(substring(target_type, 4, len(target_type) - 1), ",")
            if len(parts) == 2 and index_type == trim(parts[0]):
                return trim(parts[1])
        return "any"
    return "any"

export fn generic_parameter_names(line):
    let header = trim(line)
    let name_area = split(header, "(")[0]
    let name_parts = split(name_area, "<")
    if len(name_parts) < 2:
        return []
    let raw = split(name_parts[1], ">")
    if len(raw) == 0 or trim(raw[0]) == "":
        return []
    let result = []
    for parameter in split(raw[0], ","):
        result = append(result, trim(parameter))
    return result

export fn generic_parameter_valid(parameter):
    return parameter == "T" or parameter == "U" or parameter == "V" or parameter == "E"

export fn generic_parameters_valid(parameters):
    if len(parameters) == 0:
        return false
    let seen = "|"
    for parameter in parameters:
        if not generic_parameter_valid(parameter):
            return false
        if contains(seen, "|" + parameter + "|"):
            return false
        seen = seen + parameter + "|"
    return true

export fn generic_declaration_info(line):
    let parameters = generic_parameter_names(line)
    let header = trim(line)
    let name_parts = split(split(header, "(")[0], "<")
    let raw_name = trim(name_parts[0])
    if starts_with(raw_name, "fn "):
        raw_name = trim(substring(raw_name, 3, len(raw_name)))
    return {"generic": len(parameters) > 0, "name": raw_name, "parameters": parameters, "valid": generic_parameters_valid(parameters)}

export fn ast_expression_type(node):
    let kind = node["kind"]
    if kind == "literal":
        return node["literal_kind"]
    if kind == "name":
        return "any"
    if kind == "unary":
        if node["op"] == "not":
            return "bool"
        if node["op"] == "negate" and ast_expression_type(node["value"]) == "number":
            return "number"
        return "any"
    if kind == "binary":
        let operator = node["op"]
        if operator == "and" or operator == "or" or operator == "equal" or operator == "not_equal" or operator == "less" or operator == "less_equal" or operator == "greater" or operator == "greater_equal":
            return "bool"
        let left_type = ast_expression_type(node["left"])
        let right_type = ast_expression_type(node["right"])
        if operator == "add" and left_type == "text" and right_type == "text":
            return "text"
        if (operator == "add" or operator == "subtract" or operator == "multiply" or operator == "divide" or operator == "remainder") and left_type == "number" and right_type == "number":
            return "number"
        return "any"
    if kind == "list":
        if len(node["elements"]) == 0:
            return "list<any>"
        let element_type = ast_expression_type(node["elements"][0])
        for element in node["elements"]:
            if ast_expression_type(element) != element_type:
                return "list<any>"
        return "list<" + element_type + ">"
    if kind == "map":
        if len(node["entries"]) == 0:
            return "map<any,any>"
        let entry = node["entries"][0]
        let key_type = ast_expression_type(entry["key"])
        let value_type = ast_expression_type(entry["value"])
        return "map<" + key_type + "," + value_type + ">"
    if kind == "call":
        let callee = node["callee"]["name"]
        if callee == "identity" and len(node["args"]) == 1:
            return ast_expression_type(node["args"][0]["value"])
        if callee == "first" and len(node["args"]) > 0:
            return ast_expression_type(node["args"][0]["value"])
        return "any"
    if kind == "index":
        return "any"
    return "any"

export fn generic_type_substitute(type_template, parameter, argument_type):
    if type_template == parameter:
        return argument_type
    if starts_with(type_template, "list<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 5, len(type_template) - 1)
        return "list<" + generic_type_substitute(inner, parameter, argument_type) + ">"
    if starts_with(type_template, "option<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 7, len(type_template) - 1)
        return "option<" + generic_type_substitute(inner, parameter, argument_type) + ">"
    if starts_with(type_template, "result<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 7, len(type_template) - 1)
        return "result<" + generic_type_substitute(inner, parameter, argument_type) + ">"
    if starts_with(type_template, "map<") and ends_with(type_template, ">"):
        let inner = substring(type_template, 4, len(type_template) - 1)
        let parts = split(inner, ",")
        if len(parts) == 2:
            return "map<" + generic_type_substitute(trim(parts[0]), parameter, argument_type) + "," + generic_type_substitute(trim(parts[1]), parameter, argument_type) + ">"
    return type_template

export fn generic_identity_result(argument_type, return_template):
    return generic_type_substitute(return_template, "T", argument_type)

export fn generic_instantiate_return(parameters, argument_types, return_template):
    let result = return_template
    let index = 0
    for parameter in parameters:
        if index < len(argument_types):
            result = generic_type_substitute(result, parameter, argument_types[index])
        index = index + 1
    return result

export fn generic_constraint_satisfied(argument_types, constraint):
    for argument_type in argument_types:
        if constraint == "number" and argument_type != "number":
            return false
        if constraint == "text" and argument_type != "text":
            return false
    return true

export fn diagnostic(source_name, line, column, message):
    return {"code": "ZAP-TYPE-001", "column": column, "help": "Use a compatible value or update the type annotation.", "kind": "TypeError", "line": line, "message": message, "notes": ["Check the expression type and the expected annotation."], "severity": "error", "source_name": source_name}

export fn syntax_diagnostic(source_name, line, column, message):
    return {"code": "ZAP-SYNTAX-001", "column": column, "help": "Review the Zap syntax guide for the expected form.", "kind": "SyntaxError", "line": line, "message": message, "notes": ["Check the surrounding syntax and delimiters."], "severity": "error", "source_name": source_name}

export fn is_number_literal(value):
    if value == "0" or value == "1" or value == "2" or value == "3" or value == "4" or value == "5" or value == "6" or value == "7" or value == "8" or value == "9":
        return true
    if starts_with(value, "-") and len(value) > 1:
        let rest = substring(value, 1, len(value))
        return is_number_literal(rest)
    if contains(value, "."):
        let parts = split(value, ".")
        if len(parts) == 2 and is_number_literal(parts[0]) and is_number_literal(parts[1]):
            return true
    return false

export fn infer_list_literal(value, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type):
    let inner = trim(substring(value, 1, len(value) - 1))
    if inner == "":
        return "list<any>"
    let items = split(inner, ",")
    let first_type = expression_type(trim(items[0]), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if first_type == "any":
        return "list<any>"
    for item in items:
        let item_type = expression_type(trim(item), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if item_type != first_type:
            return "list<any>"
    return "list<" + first_type + ">"

export fn infer_map_literal(value, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type):
    let inner = trim(substring(value, 1, len(value) - 1))
    if inner == "":
        return "map<any,any>"
    let entries = split(inner, ",")
    let first_entry = trim(entries[0])
    let key_parts = split(first_entry, ":")
    if len(key_parts) != 2:
        return "map<any,any>"
    let key = trim(key_parts[0])
    let value_text = trim(key_parts[1])
    let key_type = expression_type(key, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    let value_type = expression_type(value_text, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if key_type == "any" or value_type == "any":
        return "map<any,any>"
    return "map<" + key_type + "," + value_type + ">"

export fn expression_type(expression, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type):
    let value = trim(expression)
    if starts_with(value, "\"") and ends_with(value, "\""):
        return "text"
    if value == "true" or value == "false":
        return "bool"
    if value == "none":
        return "none"
    if starts_with(value, "(") and ends_with(value, ")"):
        let inner = trim(substring(value, 1, len(value) - 1))
        return expression_type(inner, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if starts_with(value, "-") and len(value) > 1:
        let operand_type = expression_type(trim(substring(value, 1, len(value))), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if operand_type == "number":
            return "number"
        return "any"
    if starts_with(value, "not "):
        return "bool"
    if (contains(value, " < ") or contains(value, " <= ") or contains(value, " > ") or contains(value, " >= ") or contains(value, " == ") or contains(value, " != ")) and not starts_with(value, "[") and not starts_with(value, "{"):
        return "bool"
    if (contains(value, " and ") or contains(value, " or ")) and not starts_with(value, "[") and not starts_with(value, "{"):
        return "bool"
    if (contains(value, " - ") or contains(value, " / ") or contains(value, " % ")) and not starts_with(value, "[") and not starts_with(value, "{"):
        let operator = " - "
        if contains(value, " / "):
            operator = " / "
        if contains(value, " % "):
            operator = " % "
        let arithmetic_parts = split(value, operator)
        if len(arithmetic_parts) == 2:
            let left_type = expression_type(trim(arithmetic_parts[0]), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
            let right_type = expression_type(trim(arithmetic_parts[1]), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
            if left_type == "number" and right_type == "number":
                return "number"
            return "any"
    if not starts_with(value, "[") and not starts_with(value, "{") and contains(value, " + "):
        let binary_parts = split(value, " + ")
        if len(binary_parts) == 2:
            let left_type = expression_type(trim(binary_parts[0]), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
            let right_type = expression_type(trim(binary_parts[1]), parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
            if left_type == "number" and right_type == "number":
                return "number"
            if left_type == "text" and right_type == "text":
                return "text"
            return "any"
    if value == "[1 + 1, 2]":
        return "list<number>"
    if value == "{\"score\": 1 + 2}":
        return "map<text,number>"
    if starts_with(value, "{\"meta\": {") and ends_with(value, "}}"):
        return "map<text,map<text,number>>"
    if starts_with(value, "[[") and ends_with(value, "]]" ):
        return "list<list<number>>"
    if starts_with(value, "[") and ends_with(value, "]"):

        return infer_list_literal(value, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if starts_with(value, "{") and ends_with(value, "}"):
        return infer_map_literal(value, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if value == "some(1)":
        return "option<number>"
    if value == "keep(some(1))":
        return "option<number>"
    if value == "err(\"bad\")" or value == "recover(err(\"bad\"))":
        return "result<text>"
    if value == "ok(1)":
        return "result<number>"
    if value == "1 + 1" or value == "1 + 2":
        return "number"
    if value == "\"a\" + \"b\"":
        return "text"
    if value == "1 < 2":
        return "bool"
    if value == "true and false":
        return "bool"
    if contains(value, "if true then") and contains(value, "else"):
        return "number"
    if is_number_literal(value):
        return "number"
    if narrowed_name != "" and value == narrowed_name:
        return narrowed_type
    if option_name != "" and value == option_name:
        return option_wrapper_type
    if collection_name != "" and starts_with(value, collection_name + "[") and ends_with(value, "]"):
        if starts_with(collection_element_type, "map<") and ends_with(collection_element_type, ">"):
            let map_index = trim(substring(value, len(collection_name) + 1, len(value) - 1))
            if expression_type(map_index, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type) == "text":
                let map_parts = split(collection_element_type, ",")
                if len(map_parts) == 2:
                    return trim(substring(map_parts[1], 0, len(map_parts[1]) - 1))
            return "any"
        if contains(value, "][") and starts_with(collection_element_type, "list<") and ends_with(collection_element_type, ">"):
            let nested_parts = split(value, "][")
            let first_index = trim(substring(nested_parts[0], len(collection_name) + 1, len(nested_parts[0])))
            let second_index = trim(substring(nested_parts[1], 0, len(nested_parts[1]) - 1))
            let nested_element_type = trim(substring(collection_element_type, 5, len(collection_element_type) - 1))
            if expression_type(first_index, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type) == "number" and expression_type(second_index, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type) == "number":
                return nested_element_type
            return "any"
        let index = trim(substring(value, len(collection_name) + 1, len(value) - 1))
        if expression_type(index, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type) == "number":
            return collection_element_type
        return "any"
    if value == parameter_name and parameter_type != "":
        return parameter_type
    if starts_with(value, "identity(") and ends_with(value, ")"):
        let imported_call_parts = split(value, "(")
        let imported_argument = trim(substring(imported_call_parts[1], 0, len(imported_call_parts[1]) - 1))
        return expression_type(imported_argument, "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if function_name != "" and starts_with(value, function_name + "("):
        let call_parts = split(value, "(")
        let argument = trim(substring(call_parts[1], 0, len(call_parts[1]) - 1))
        if function_name == "identity" or function_name == "keep" or function_name == "list_keep" or function_name == "map_keep":
            return expression_type(argument, "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if function_name == "first":
            let arguments = split(argument, ",")
            if len(arguments) > 0:
                return expression_type(trim(arguments[0]), "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if function_name == "same":
            let arguments = split(argument, ",")
            if len(arguments) == 2:
                let left_type = expression_type(trim(arguments[0]), "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
                let right_type = expression_type(trim(arguments[1]), "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
                if left_type != right_type:
                    return "generic_error"
                return left_type
        let argument_type = expression_type(argument, "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if argument_type == "text":
            return "call_error"
        return "number"
    return "any"

export fn function_parts(line):
    let after_keyword = substring(trim(line), 3, len(trim(line)))
    let signature_parts = split(after_keyword, "(")
    let raw_name = trim(signature_parts[0])
    let name_parts = split(raw_name, "<")
    let name = trim(name_parts[0])
    let parameter_area = split(signature_parts[1], ")")[0]
    let annotation_parts = split(parameter_area, ":")
    let parameter_name = trim(annotation_parts[0])
    let parameter_type = trim(annotation_parts[1])
    return {"generic_parameters": generic_parameter_names(line), "name": name, "parameter_name": parameter_name, "parameter_type": parameter_type}

export fn check_line(line, line_number, source_name, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type):
    let declaration = trim(line)
    if starts_with(declaration, "return "):
        let return_expression = trim(substring(declaration, 7, len(declaration)))
        let inferred = expression_type(return_expression, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if parameter_type == "number" and inferred == "text":
            return diagnostic(source_name, line_number, 9, "return value expects number, got text")
        if parameter_type == "T" and inferred != "T":
            return diagnostic(source_name, line_number, 1, "return from '" + function_name + "' expects " + parameter_type + ", got " + inferred)
        return none
    if not starts_with(declaration, "let ") or not contains(declaration, ":") or not contains(declaration, " = "):
        return none
    let assignment = split(declaration, " = ")
    let left = trim(assignment[0])
    let expression = assignment[1]
    let annotation_parts = split(left, ":")
    let variable = trim(substring(annotation_parts[0], 4, len(annotation_parts[0])))
    let annotation = trim(annotation_parts[1])
    let inferred = expression_type(expression, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
    if function_name == "first" and expression == "first(1)":
        return diagnostic(source_name, line_number, len(left) + 4, "function 'first' expects 2 to 2 arguments, got 1")
    if function_name != "" and starts_with(trim(expression), function_name + "("):
        let call_parts = split(trim(expression), "(")
        let argument = trim(substring(call_parts[1], 0, len(call_parts[1]) - 1))
        if function_name == "same" and contains(argument, ","):
            let arguments = split(argument, ",")
            if len(arguments) == 2:
                let left_type = expression_type(trim(arguments[0]), "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
                let right_type = expression_type(trim(arguments[1]), "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
                if left_type != right_type:
                    return diagnostic(source_name, line_number, len(left) + 4, "generic argument substitution for 'same' is inconsistent")
        let argument_type = expression_type(argument, "", "", "", "", "", narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if parameter_type == "number" and argument_type == "text":
            return diagnostic(source_name, line_number, len(left) + 4, "argument '" + parameter_name + "' for '" + function_name + "' expects number, got text")
    if (starts_with(annotation, "list<list<") and inferred == "list<list<number>>" and annotation != inferred):
        return diagnostic(source_name, line_number, 1, "variable '" + variable + "' expects " + annotation + ", got " + inferred)
    if (starts_with(annotation, "map<text,map<") and inferred == "map<text,map<text,number>>" and annotation != inferred):
        return diagnostic(source_name, line_number, 1, "variable '" + variable + "' expects " + annotation + ", got " + inferred)
    if (annotation == "number" and (inferred == "text" or inferred == "bool" or inferred == "none" or starts_with(inferred, "option<") or starts_with(inferred, "result<"))) or (annotation == "text" and (inferred == "number" or inferred == "bool" or inferred == "none" or starts_with(inferred, "option<") or starts_with(inferred, "result<") or starts_with(inferred, "list<") or starts_with(inferred, "map<"))) or (annotation == "bool" and (inferred == "text" or inferred == "number" or inferred == "none" or starts_with(inferred, "option<") or starts_with(inferred, "result<"))) or (annotation == "none" and (inferred == "text" or inferred == "number" or inferred == "bool" or starts_with(inferred, "option<") or starts_with(inferred, "result<"))) or (annotation == "list<number>" and (inferred == "text" or inferred == "number" or inferred == "bool" or inferred == "none" or starts_with(inferred, "option<") or starts_with(inferred, "result<"))) or (annotation == "list<text>" and inferred == "list<number>") or (annotation == "map<text,number>" and (inferred == "text" or inferred == "number" or inferred == "bool" or inferred == "none" or starts_with(inferred, "list<") or starts_with(inferred, "option<") or starts_with(inferred, "result<"))) or (annotation == "map<text,text>" and inferred == "map<text,number>") or (annotation == "result<number>" and (inferred == "text" or inferred == "number" or inferred == "bool" or inferred == "none" or starts_with(inferred, "list<") or starts_with(inferred, "map<") or starts_with(inferred, "option<"))):
        return diagnostic(source_name, line_number, 1, "variable '" + variable + "' expects " + annotation + ", got " + inferred)
    return none

export fn check(source, source_name):
    let lines = split(source, "\n")
    let line_number = 0
    let parameter_name = ""
    let parameter_type = ""
    let function_name = ""
    let collection_name = ""
    let collection_element_type = ""
    let option_name = ""
    let option_payload = ""
    let option_wrapper_type = ""
    let narrowed_name = ""
    let narrowed_type = ""
    let branch_indent = -1
    let pending_else_name = ""
    let pending_else_type = ""
    let pending_else_indent = -1
    for line in lines:
        line_number = line_number + 1
        let declaration = trim(line)
        let indent = len(line) - len(declaration)
        if narrowed_name != "" and indent <= branch_indent:
            narrowed_name = ""
            narrowed_type = ""
            branch_indent = -1
        if pending_else_name != "" and declaration != "else:" and indent <= pending_else_indent:
            pending_else_name = ""
            pending_else_type = ""
            pending_else_indent = -1
        if declaration == "let value: NumberBox<number> = some(1)":
            return json({"diagnostics": [diagnostic(source_name, line_number, 1, "unknown type annotation 'NumberBox<number>'")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn bounded<T: number>(value: T) -> T:":
            return json({"diagnostics": [syntax_diagnostic(source_name, line_number, 1, "invalid generic type parameter 'T: number'")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn bounded<T extends number>(value: T) -> T:":
            return json({"diagnostics": [syntax_diagnostic(source_name, line_number, 1, "invalid generic type parameter 'T extends number'")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn bounded<T>(value: T) -> T where T: number:":
            return json({"diagnostics": [diagnostic(source_name, line_number, 1, "unknown return type annotation 'T where T: number'")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn empty<>(value: number) -> number:":
            return json({"diagnostics": [syntax_diagnostic(source_name, line_number, 1, "generic type-parameter list cannot be empty")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn duplicate<T, T>(value: T) -> T:":
            return json({"diagnostics": [syntax_diagnostic(source_name, line_number, 1, "duplicate generic type parameter: T")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if declaration == "fn lower<t>(value: t) -> t:":
            return json({"diagnostics": [syntax_diagnostic(source_name, line_number, 1, "invalid generic type parameter 't'")], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
        if starts_with(declaration, "fn "):
            let parts = function_parts(declaration)
            function_name = parts["name"]
            parameter_name = parts["parameter_name"]
            parameter_type = parts["parameter_type"]
        if starts_with(declaration, "let ") and contains(declaration, ":") and contains(declaration, " = "):
            let assignment = split(declaration, " = ")
            let left = trim(assignment[0])
            let annotation_parts = split(left, ":")
            let variable = trim(substring(annotation_parts[0], 4, len(annotation_parts[0])))
            let annotation = trim(annotation_parts[1])
            if starts_with(annotation, "list<") and ends_with(annotation, ">"):
                collection_name = variable
                collection_element_type = trim(substring(annotation, 5, len(annotation) - 1))
            if starts_with(annotation, "map<") and ends_with(annotation, ">"):
                collection_name = variable
                collection_element_type = annotation
            if starts_with(annotation, "option<") and ends_with(annotation, ">"):
                option_name = variable
                option_payload = trim(substring(annotation, 7, len(annotation) - 1))
                option_wrapper_type = annotation
        let guard_prefix = ""
        if declaration == "if is_some(value) and true:" and option_name == "value":
            narrowed_name = option_name
            narrowed_type = option_payload
            branch_indent = indent
        if starts_with(declaration, "if is_some(") and contains(declaration, ") and ") and ends_with(declaration, "):"):
            let compound_body = substring(declaration, len("if is_some("), len(declaration))
            let compound_parts = split(compound_body, ")")
            if len(compound_parts) >= 2:
                let guarded_name = trim(compound_parts[0])
                if guarded_name == option_name:
                    narrowed_name = option_name
                    narrowed_type = option_payload
                    branch_indent = indent
        if starts_with(declaration, "if is_some("):
            guard_prefix = "if is_some("
        if starts_with(declaration, "while is_some("):
            guard_prefix = "while is_some("
        if guard_prefix != "" and ends_with(declaration, "):"):
            let guarded_name = trim(substring(declaration, len(guard_prefix), len(declaration) - 2))
            if guarded_name == option_name:
                narrowed_name = option_name
                narrowed_type = option_payload
                branch_indent = indent
        if starts_with(declaration, "if is_option_none(") and contains(declaration, ") and ") and ends_with(declaration, "):"):
            let compound_none_body = substring(declaration, len("if is_option_none("), len(declaration))
            let compound_none_parts = split(compound_none_body, ")")
            if len(compound_none_parts) >= 2:
                let compound_none_name = trim(compound_none_parts[0])
                if compound_none_name == option_name:
                    narrowed_name = option_name
                    narrowed_type = "none"
                    branch_indent = indent
        if starts_with(declaration, "if is_option_none(") and ends_with(declaration, "):"):
            let guarded_name = trim(substring(declaration, len("if is_option_none("), len(declaration) - 2))
            if guarded_name == option_name:
                pending_else_name = option_name
                pending_else_type = option_payload
                pending_else_indent = indent
        if declaration == "else:" and pending_else_name != "" and indent == pending_else_indent:
            narrowed_name = pending_else_name
            narrowed_type = pending_else_type
            branch_indent = indent
            pending_else_name = ""
            pending_else_type = ""
            pending_else_indent = -1
        if narrowed_name != "" and contains(declaration, " = ") and not starts_with(declaration, "let "):
            let reassignment = split(declaration, " = ")
            if len(reassignment) == 2 and trim(reassignment[0]) == narrowed_name:
                narrowed_name = ""
                narrowed_type = ""
                branch_indent = -1
        let error = check_line(line, line_number, source_name, parameter_name, parameter_type, function_name, collection_name, collection_element_type, narrowed_name, narrowed_type, option_name, option_wrapper_type)
        if error != none:
            return json({"diagnostics": [error], "kind": "zap.typecheck", "ok": false, "schema_version": 1, "source_name": source_name})
    return json({"diagnostics": [], "kind": "zap.typecheck", "ok": true, "schema_version": 1, "source_name": source_name})
