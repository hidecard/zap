# B2 candidate typed-IR producer written in Zap.
# This producer owns bounded typed-IR fixtures and is not a replacement for the
# native reference typed-IR emitter.
import "bootstrap/b1/parser.zp"
import "bootstrap/b2/typecheck.zp"

export fn span(line, column, length):
    return {"column": column, "length": length, "line": line}

export fn literal_node(literal_kind, value, line, column, length):
    return {"kind": "literal", "literal_kind": literal_kind, "span": span(line, column, length), "value": value}

export fn declaration_node(name, annotation, inferred_type, value, line, length):
    return {"annotation": annotation, "exported": false, "inferred_type": inferred_type, "ir_schema_version": 1, "kind": "declaration", "name": name, "span": span(line, 1, length), "value": value}

export fn assignment_node(name, value, line, length):
    return {"kind": "assignment", "name": name, "span": span(line, 1, length), "value": value}

export fn binary_expression_node(value, marker, operator):
    let parts = split(value, marker)
    return {"kind": "binary", "left": expression_node(parts[0]), "op": operator, "right": expression_node(parts[1]), "span": span(1, 1, len(value))}

export fn expression_call_arguments(argument_text):
    let args = []
    if trim(argument_text) == "":
        return args
    for item in split(argument_text, ","):
        let argument = trim(item)
        if contains(argument, " = ") and not starts_with(argument, "{"):
            let parts = split(argument, " = ")
            if len(parts) == 2:
                args = append(args, {"kind": "named", "name": trim(parts[0]), "value": expression_node(trim(parts[1]))})
            else:
                args = append(args, {"kind": "positional", "value": expression_node(argument)})
        else:
            args = append(args, {"kind": "positional", "value": expression_node(argument)})
    return args

export fn expression_node(expression):
    let value = trim(expression)
    if starts_with(value, "await "):
        return {"kind": "await", "value": expression_node(trim(substring(value, 6, len(value)))), "span": span(1, 1, len(value))}
    if starts_with(value, "try "):
        return {"kind": "propagate", "value": expression_node(trim(substring(value, 4, len(value)))), "span": span(1, 1, len(value))}
    if starts_with(value, "not "):
        return {"kind": "unary", "op": "not", "value": expression_node(trim(substring(value, 4, len(value)))), "span": span(1, 1, len(value))}
    if ends_with(value, "]") and contains(value, "[") and not starts_with(value, "["):
        let open_index = 0
        while open_index < len(value):
            if char_at(value, open_index) == "[":
                break
            open_index = open_index + 1
        return {"index": expression_node(trim(substring(value, open_index + 1, len(value) - 1))), "kind": "index", "target": expression_node(trim(substring(value, 0, open_index))), "span": span(1, 1, len(value))}
    if contains(value, ".") and not starts_with(value, "["):
        let parts = split(value, ".")
        if len(parts) == 2 and not contains(value, " "):
            return {"kind": "member", "member": trim(parts[1]), "target": expression_node(trim(parts[0])), "span": span(1, 1, len(value))}
    if contains(value, " or "):
        return binary_expression_node(value, " or ", "or")
    if contains(value, " and "):
        return binary_expression_node(value, " and ", "and")
    if contains(value, "(") and ends_with(value, ")"):
        let open_index = 0
        while open_index < len(value):
            if char_at(value, open_index) == "(":
                break
            open_index = open_index + 1
        let callee = trim(substring(value, 0, open_index))
        let argument_text = trim(substring(value, open_index + 1, len(value) - 1))
        let args = expression_call_arguments(argument_text)
        return {"args": args, "callee": {"kind": "name", "name": callee, "span": span(1, 1, len(callee))}, "kind": "call", "span": span(1, 1, len(value))}
    if contains(value, " or "):
        return binary_expression_node(value, " or ", "or")
    if contains(value, " and "):
        return binary_expression_node(value, " and ", "and")
    if contains(value, " == "):
        return binary_expression_node(value, " == ", "equal")
    if contains(value, " != "):
        return binary_expression_node(value, " != ", "not_equal")
    if contains(value, " <= "):
        return binary_expression_node(value, " <= ", "less_equal")
    if contains(value, " >= "):
        return binary_expression_node(value, " >= ", "greater_equal")
    if contains(value, " < "):
        return binary_expression_node(value, " < ", "less")
    if contains(value, " > "):
        return binary_expression_node(value, " > ", "greater")
    if contains(value, " + "):
        return binary_expression_node(value, " + ", "add")
    if contains(value, " - "):
        return binary_expression_node(value, " - ", "subtract")
    if contains(value, " * "):
        return binary_expression_node(value, " * ", "multiply")
    if contains(value, " / "):
        return binary_expression_node(value, " / ", "divide")
    if contains(value, " % "):
        return binary_expression_node(value, " % ", "remainder")
    return inferred_literal(value)

export fn typed_ir_number_literal(value):
    if value == "0" or value == "1" or value == "2" or value == "3" or value == "4" or value == "5" or value == "6" or value == "7" or value == "8" or value == "9":
        return true
    if starts_with(value, "-") and len(value) > 1:
        return typed_ir_number_literal(substring(value, 1, len(value)))
    if contains(value, "."):
        let parts = split(value, ".")
        if len(parts) == 2 and typed_ir_number_literal(parts[0]) and typed_ir_number_literal(parts[1]):
            return true
    return false

export fn inferred_literal(expression):
    let value = trim(expression)
    if value != "" and not starts_with(value, "\"") and not starts_with(value, "[") and not starts_with(value, "{") and value != "true" and value != "false" and value != "none" and not typed_ir_number_literal(value):
        return {"kind": "name", "name": value, "span": span(1, 1, len(value))}
    if starts_with(value, "\""):
        return {"kind": "literal", "literal_kind": "text", "span": span(1, 1, len(value)), "value": substring(value, 1, len(value) - 1)}
    if value == "true":
        return {"kind": "literal", "literal_kind": "bool", "span": span(1, 1, 4), "value": true}
    if value == "false":
        return {"kind": "literal", "literal_kind": "bool", "span": span(1, 1, 5), "value": false}
    if value == "none":
        return {"kind": "literal", "literal_kind": "none", "span": span(1, 1, 4), "value": none}
    if starts_with(value, "["):
        let inner = trim(substring(value, 1, len(value) - 1))
        let elements = []
        if inner != "":
            for item in split(inner, ","):
                elements = append(elements, expression_node(trim(item)))
        return {"elements": elements, "kind": "list", "span": span(1, 1, len(value))}
    if starts_with(value, "{"):
        let inner = trim(substring(value, 1, len(value) - 1))
        let entries = []
        if inner != "":
            for item in split(inner, ","):
                let parts = split(item, ":")
                if len(parts) == 2:
                    entries = append(entries, {"key": expression_node(trim(parts[0])), "value": expression_node(trim(parts[1]))})
        return {"entries": entries, "kind": "map", "span": span(1, 1, len(value))}
    return {"kind": "literal", "literal_kind": "number", "span": span(1, 1, len(value)), "value": from_json(value)}

export fn inferred_type_for(expression):
    let value = trim(expression)
    if starts_with(value, "\""):
        return "text"
    if value == "true" or value == "false":
        return "bool"
    if value == "none":
        return "none"
    if starts_with(value, "["):
        let inner = trim(substring(value, 1, len(value) - 1))
        if inner == "":
            return "list<any>"
        let parts = split(inner, ",")
        let element_type = inferred_type_for(parts[0])
        for part in parts:
            if inferred_type_for(part) != element_type:
                return "list<any>"
        return "list<" + element_type + ">"
    if starts_with(value, "{"):
        let inner = trim(substring(value, 1, len(value) - 1))
        if inner == "":
            return "map<any,any>"
        let pair = split(inner, ":")
        if len(pair) == 2:
            return "map<text," + inferred_type_for(pair[1]) + ">"
        return "map<any,any>"
    return "number"

export fn generic_parameters(signature):
    let parts = split(trim(signature), "<")
    if len(parts) < 2:
        return []
    let raw = split(parts[1], ">")
    if len(raw) == 0 or trim(raw[0]) == "":
        return []
    let result = []
    for parameter in split(raw[0], ","):
        result = append(result, trim(parameter))
    return result

export fn generic_function_metadata(signature, return_type):
    let name_area = split(trim(signature), "(")[0]
    let name_parts = split(name_area, "<")
    let name = trim(name_parts[0])
    if starts_with(name, "fn "):
        name = trim(substring(name, 3, len(name)))
    return {"name": name, "type_params": generic_parameters(signature), "return_type": return_type}

export fn generic_type_alias_info(line):
    let value = trim(line)
    if not starts_with(value, "type "):
        return {"name": "", "type_params": [], "body": "", "valid": false}
    let declaration = trim(substring(value, 5, len(value)))
    let left = trim(split(declaration, "=")[0])
    let name = trim(split(left, "<")[0])
    let type_params = []
    if contains(left, "<") and contains(left, ">"):
        let raw = split(split(left, "<")[1], ">")
        if len(raw) > 0:
            for parameter in split(raw[0], ","):
                type_params = append(type_params, trim(parameter))
    let body = ""
    if contains(declaration, "="):
        body = trim(split(declaration, "=")[1])
    return {"body": body, "name": name, "type_params": type_params, "valid": name != "" and body != ""}

export fn generic_type_alias_node(info, line):
    return {"body": info["body"], "inferred_type": info["body"], "ir_schema_version": 1, "kind": "type_alias", "name": info["name"], "span": span(line, 1, 0), "type_params": info["type_params"]}

export fn emit_generic_type_aliases(source, source_name):
    let lines = split(source, "\\n")
    let nodes = []
    let line_number = 0
    for line in lines:
        line_number = line_number + 1
        let info = generic_type_alias_info(line)
        if info["valid"]:
            nodes = append(nodes, generic_type_alias_node(info, line_number))
    return json({"candidate_only": true, "ir": {"nodes": nodes}, "kind": "zap.typed_ir", "schema_version": 1, "source_name": source_name})

export fn control_statement_node(line, line_number, next_line):
    let value = trim(line)
    let kind = "expression"
    let payload = none
    let condition = none
    let iterable = none
    if starts_with(value, "return "):
        payload = expression_node(trim(substring(value, 7, len(value))))
    if starts_with(value, "say "):
        payload = expression_node(trim(substring(value, 4, len(value))))
    if starts_with(value, "raise "):
        payload = expression_node(trim(substring(value, 6, len(value))))
    if starts_with(value, "if "):
        condition = expression_node(trim(substring(value, 3, len(value) - 1)))
    if starts_with(value, "while "):
        condition = expression_node(trim(substring(value, 6, len(value) - 1)))
    if starts_with(value, "for ") and contains(value, " in "):
        iterable = expression_node(trim(split(value, " in ")[1]))
    if starts_with(value, "if "):
        kind = "if"
    if starts_with(value, "elif "):
        kind = "elif"
    if starts_with(value, "else"):
        kind = "else"
    if starts_with(value, "while "):
        kind = "while"
    if starts_with(value, "for "):
        kind = "for"
    if starts_with(value, "return"):
        kind = "return"
    if starts_with(value, "say "):
        kind = "say"
    if starts_with(value, "raise "):
        kind = "raise"
    if starts_with(value, "import "):
        kind = "import"
    if starts_with(value, "module "):
        kind = "module"
    if value == "try:":
        kind = "try"
    if starts_with(value, "catch"):
        kind = "catch"
    let successors = []
    if kind != "return":
        successors = [next_line]
    return {"condition": condition, "iterable": iterable, "kind": kind, "payload": payload, "source": value, "span": span(line_number, 1, len(value)), "successors": successors}

export fn emit_arbitrary_program(source, source_name):
    let lines = split(source, "\n")
    let nodes = []
    let line_number = 0
    for line in lines:
        let value = trim(line)
        if value != "":
            line_number = line_number + 1
            if starts_with(value, "let ") and contains(value, " = "):
                let parts = split(value, " = ")
                let left = trim(substring(parts[0], 4, len(parts[0])))
                let variable = left
                let annotation = none
                if contains(left, ":"):
                    let annotation_parts = split(left, ":")
                    variable = trim(annotation_parts[0])
                    annotation = trim(annotation_parts[1])
                nodes = append(nodes, declaration_node(variable, annotation, inferred_type_for(parts[1]), expression_node(parts[1]), line_number, len(value)))
            else:
                if contains(value, " = ") and not starts_with(value, "if ") and not starts_with(value, "while "):
                    let parts = split(value, " = ")
                    nodes = append(nodes, assignment_node(trim(parts[0]), expression_node(parts[1]), line_number, len(value)))
                else:
                    nodes = append(nodes, control_statement_node(value, line_number, line_number + 1))
    return json({"candidate_only": true, "ir": {"nodes": nodes}, "kind": "zap.typed_ir", "schema_version": 1, "source_name": source_name})

export fn owned_typed_expression(expression):
    if expression["kind"] == "literal":
        return {"ast": expression, "inferred_type": expression["literal_kind"], "kind": "typed_expression", "span": expression["span"]}
    if expression["kind"] == "binary":
        return {"ast": expression, "inferred_type": "any", "kind": "typed_expression", "left": owned_typed_expression(expression["left"]), "op": expression["op"], "right": owned_typed_expression(expression["right"]), "span": expression["span"]}
    if expression["kind"] == "unary":
        return {"ast": expression, "inferred_type": "any", "kind": "typed_expression", "operand": owned_typed_expression(expression["operand"]), "op": expression["op"], "span": expression["span"]}
    if expression["kind"] == "call":
        let arguments = []
        for argument in expression["args"]:
            arguments = append(arguments, {"kind": argument["kind"], "value": owned_typed_expression(argument["value"])})
        return {"args": arguments, "ast": expression, "callee": owned_typed_expression(expression["callee"]), "inferred_type": "any", "kind": "typed_expression", "span": expression["span"]}
    if expression["kind"] == "member":
        return {"ast": expression, "inferred_type": "any", "kind": "typed_expression", "member": expression["member"], "span": expression["span"], "target": owned_typed_expression(expression["target"])}
    if expression["kind"] == "list":
        let items = []
        for item in expression["elements"]:
            items = append(items, owned_typed_expression(item))
        return {"ast": expression, "inferred_type": "list<any>", "items": items, "kind": "typed_expression", "span": expression["span"]}
    if expression["kind"] == "map":
        let entries = []
        for entry in expression["entries"]:
            entries = append(entries, {"key": owned_typed_expression(entry["key"]), "value": owned_typed_expression(entry["value"])})
        return {"ast": expression, "entries": entries, "inferred_type": "map<any,any>", "kind": "typed_expression", "span": expression["span"]}
    return {"ast": expression, "inferred_type": "any", "kind": "typed_expression", "span": expression["span"]}

export fn owned_typed_statements(statements, result):
    for statement in statements:
        result = append(result, owned_typed_statement(statement))
    return result

export fn owned_typed_statement(statement):
    let kind = statement["kind"]
    if kind == "declaration":
        return {"annotation": statement["annotation"], "ast": statement, "inferred_type": statement["annotation"], "kind": kind, "name": statement["name"], "span": statement["span"], "value": owned_typed_expression(statement["value"])}
    if kind == "assignment":
        return {"ast": statement, "kind": kind, "name": statement["name"], "span": statement["span"], "value": owned_typed_expression(statement["value"])}
    if kind == "expression" or kind == "say" or kind == "return" or kind == "raise":
        return {"ast": statement, "kind": kind, "span": statement["span"], "value": owned_typed_expression(statement["value"])}
    if kind == "if":
        if statement["else_branch"] == none:
            return {"ast": statement, "condition": owned_typed_expression(statement["condition"]), "kind": kind, "span": statement["span"], "then_branch": {"statements": owned_typed_statements(statement["then_branch"]["statements"], [])}}
        return {"ast": statement, "condition": owned_typed_expression(statement["condition"]), "else_branch": {"statements": owned_typed_statements(statement["else_branch"]["statements"], [])}, "kind": kind, "span": statement["span"], "then_branch": {"statements": owned_typed_statements(statement["then_branch"]["statements"], [])}}
    if kind == "while":
        return {"ast": statement, "body": {"statements": owned_typed_statements(statement["body"]["statements"], [])}, "condition": owned_typed_expression(statement["condition"]), "kind": kind, "span": statement["span"]}
    if kind == "for":
        return {"ast": statement, "binding": statement["binding"], "body": {"statements": owned_typed_statements(statement["body"]["statements"], [])}, "iterable": owned_typed_expression(statement["iterable"]), "kind": kind, "span": statement["span"]}
    if kind == "try_catch":
        return {"ast": statement, "body": {"statements": owned_typed_statements(statement["body"]["statements"], [])}, "catch_binding": statement["catch_binding"], "catch_body": {"statements": owned_typed_statements(statement["catch_body"]["statements"], [])}, "kind": kind, "span": statement["span"]}
    if kind == "function":
        return {"ast": statement, "body": {"statements": owned_typed_statements(statement["body"]["statements"], [])}, "kind": kind, "name": statement["name"], "params": statement["params"], "return_type": statement["return_type"], "span": statement["span"], "type_params": statement["type_params"]}
    if kind == "class":
        return {"ast": statement, "body": {"statements": owned_typed_statements(statement["body"]["statements"], [])}, "interfaces": statement["interfaces"], "kind": kind, "name": statement["name"], "parents": statement["parents"], "span": statement["span"], "traits": statement["traits"]}
    if kind == "trait" or kind == "interface":
        return {"ast": statement, "body": {"statements": owned_typed_statements(statement["body"]["statements"], [])}, "kind": kind, "name": statement["name"], "span": statement["span"]}
    return {"ast": statement, "kind": kind, "span": statement["span"]}

export fn emit_program_typed_ir(source, source_name):
    let parsed = from_json(parse_general(source, source_name))
    if parsed["kind"] != "zap.ast":
        return json({"candidate_only": true, "coverage": "parser_ast_rejected", "diagnostics": parsed["diagnostics"], "ir": {"nodes": []}, "kind": "zap.typed_ir", "schema_version": 3, "source_name": source_name})
    let nodes = owned_typed_statements(parsed["ast"]["statements"], [])
    return json({"candidate_only": true, "coverage": "owned_ast_statement_expression_nodes", "ir": {"nodes": nodes}, "kind": "zap.typed_ir", "schema_version": 3, "source_name": source_name, "typed_metadata": true})

export fn owned_inferred_expression_children(expression, environment, functions, source_name):
    if expression["kind"] == "binary":
        return [owned_inferred_expression(expression["left"], environment, functions, source_name), owned_inferred_expression(expression["right"], environment, functions, source_name)]
    if expression["kind"] == "unary":
        return [owned_inferred_expression(expression["operand"], environment, functions, source_name)]
    if expression["kind"] == "member":
        return [owned_inferred_expression(expression["target"], environment, functions, source_name)]
    if expression["kind"] == "call":
        let result = [owned_inferred_expression(expression["callee"], environment, functions, source_name)]
        for argument in expression["args"]:
            result = append(result, owned_inferred_expression(argument["value"], environment, functions, source_name))
        return result
    if expression["kind"] == "list":
        let result = []
        for element in expression["elements"]:
            result = append(result, owned_inferred_expression(element, environment, functions, source_name))
        return result
    if expression["kind"] == "map":
        let result = []
        for entry in expression["entries"]:
            result = append(result, owned_inferred_expression(entry["key"], environment, functions, source_name))
            result = append(result, owned_inferred_expression(entry["value"], environment, functions, source_name))
        return result
    return []

export fn owned_inferred_expression(expression, environment, functions, source_name):
    let inferred = b2c_infer_expr(expression, environment, functions, source_name)
    return {"ast": expression, "children": owned_inferred_expression_children(expression, environment, functions, source_name), "diagnostics": inferred["errors"], "inferred_type": inferred["type"], "kind": "typed_expression", "span": expression["span"]}

export fn owned_inferred_statement(statement, environment, functions, source_name):
    let kind = statement["kind"]
    if kind == "declaration":
        let value = owned_inferred_expression(statement["value"], environment, functions, source_name)
        return {"annotation": statement["annotation"], "ast": statement, "inferred_type": value["inferred_type"], "kind": kind, "name": statement["name"], "span": statement["span"], "value": value}
    if kind == "assignment" or kind == "expression" or kind == "say" or kind == "return" or kind == "raise":
        return {"ast": statement, "kind": kind, "span": statement["span"], "value": owned_inferred_expression(statement["value"], environment, functions, source_name)}
    if kind == "if":
        if statement["else_branch"] == none:
            return {"ast": statement, "condition": owned_inferred_expression(statement["condition"], environment, functions, source_name), "kind": kind, "span": statement["span"], "then_branch": owned_inferred_statements(statement["then_branch"]["statements"], environment, functions, source_name, [])}
        return {"ast": statement, "condition": owned_inferred_expression(statement["condition"], environment, functions, source_name), "else_branch": owned_inferred_statements(statement["else_branch"]["statements"], environment, functions, source_name, []), "kind": kind, "span": statement["span"], "then_branch": owned_inferred_statements(statement["then_branch"]["statements"], environment, functions, source_name, [])}
    if kind == "while":
        return {"ast": statement, "body": owned_inferred_statements(statement["body"]["statements"], environment, functions, source_name, []), "condition": owned_inferred_expression(statement["condition"], environment, functions, source_name), "kind": kind, "span": statement["span"]}
    if kind == "for":
        return {"ast": statement, "binding": statement["binding"], "body": owned_inferred_statements(statement["body"]["statements"], environment, functions, source_name, []), "inferred_element_type": b2c_generic_container_element(owned_inferred_expression(statement["iterable"], environment, functions, source_name)["inferred_type"]), "iterable": owned_inferred_expression(statement["iterable"], environment, functions, source_name), "kind": kind, "span": statement["span"]}
    if kind == "try_catch":
        return {"ast": statement, "body": owned_inferred_statements(statement["body"]["statements"], environment, functions, source_name, []), "catch_body": owned_inferred_statements(statement["catch_body"]["statements"], environment, functions, source_name, []), "catch_binding": statement["catch_binding"], "kind": kind, "span": statement["span"]}
    if kind == "function":
        return {"ast": statement, "body": owned_inferred_statements(statement["body"]["statements"], environment, functions, source_name, []), "kind": kind, "name": statement["name"], "params": statement["params"], "return_type": statement["return_type"], "span": statement["span"], "type_params": statement["type_params"]}
    if kind == "class":
        return {"ast": statement, "body": owned_inferred_statements(statement["body"]["statements"], environment, functions, source_name, []), "interfaces": statement["interfaces"], "kind": kind, "name": statement["name"], "parents": statement["parents"], "span": statement["span"], "traits": statement["traits"]}
    if kind == "trait" or kind == "interface":
        return {"ast": statement, "body": owned_inferred_statements(statement["body"]["statements"], environment, functions, source_name, []), "kind": kind, "name": statement["name"], "span": statement["span"]}
    return {"ast": statement, "kind": kind, "span": statement["span"]}

export fn owned_inferred_statements(statements, environment, functions, source_name, result):
    let current = environment
    for statement in statements:
        result = append(result, owned_inferred_statement(statement, current, functions, source_name))
        if statement["kind"] == "declaration":
            let inferred = b2c_infer_expr(statement["value"], current, functions, source_name)
            let declared = statement["annotation"]
            if declared == none:
                declared = inferred["type"]
            current = append(current, b2c_binding(statement["name"], declared, declared, true))
    return result

export fn emit_inferred_program_typed_ir(source, source_name):
    let parsed = from_json(parse_general(source, source_name))
    if parsed["kind"] != "zap.ast":
        return json({"candidate_only": true, "coverage": "parser_ast_rejected", "diagnostics": parsed["diagnostics"], "ir": {"nodes": []}, "kind": "zap.typed_ir", "schema_version": 4, "source_name": source_name})
    let statements = parsed["ast"]["statements"]
    let classes = b2c_collect_classes(statements, [])
    let registry = b2c_collect_trait_registry(statements, [])
    let functions = b2c_enrich_functions(b2c_collect_functions(statements, []), classes, registry, [])
    let checked = b2c_check_program(parsed["ast"], source_name)
    let nodes = owned_inferred_statements(statements, [], functions, source_name, [])
    return json({"candidate_only": true, "coverage": "owned_ast_with_checker_inferred_types", "diagnostics": checked["diagnostics"], "ir": {"nodes": nodes}, "kind": "zap.typed_ir", "schema_version": 4, "source_name": source_name, "typed_metadata": true})

export fn typed_ir_reference_expression(expression):
    if expression["kind"] == "typed_expression" and contains(json(expression), "\"ast\":"):
        return expression["ast"]
    return expression

export fn typed_ir_reference_node(node):
    let value = typed_ir_reference_expression(node["value"])
    return {"annotation": node["annotation"], "inferred_type": node["inferred_type"], "ir_schema_version": 1, "kind": "declaration", "name": node["name"], "span": node["span"], "value": value}

export fn typed_ir_compare_reference(reference, candidate):
    let reference_node = reference["ir"]["nodes"][0]
    let candidate_node = candidate["ir"]["nodes"][0]
    let expected = typed_ir_reference_node(reference_node)
    let actual = typed_ir_reference_node(candidate_node)
    return {"candidate_kind": candidate["kind"], "candidate_only": candidate["candidate_only"], "deterministic": json(candidate) == json(candidate), "kind_match": candidate["kind"] == "zap.typed_ir", "node_count_match": len(reference["ir"]["nodes"]) == len(candidate["ir"]["nodes"]), "schema_match": candidate["schema_version"] >= 3, "semantic_equal": json(expected) == json(actual)}

export fn typed_ir_trait_method_node(owner, method):
    let required = false
    if contains(json(method), "\"required\":true"):
        required = true
    return {"body": method["body"], "kind": "trait_method", "name": method["name"], "owner": owner, "params": method["params"], "required": required, "return_type": method["return_type"], "span": method["span"]}

export fn typed_ir_trait_declaration_node(statement):
    let methods = []
    for method in statement["body"]["statements"]:
        if method["kind"] == "function":
            methods = append(methods, typed_ir_trait_method_node(statement["name"], method))
    return {"kind": "trait_declaration", "methods": methods, "name": statement["name"], "trait_kind": statement["kind"], "span": statement["span"]}

export fn typed_ir_class_has_method(statement, method_name):
    for member in statement["body"]["statements"]:
        if member["kind"] == "function" and member["name"] == method_name:
            return true
    return false

export fn typed_ir_trait_statement(statements, name):
    for statement in statements:
        if (statement["kind"] == "trait" or statement["kind"] == "interface") and statement["name"] == name:
            return statement
    return none

export fn typed_ir_class_selection_for(statement, method_name):
    if not contains(json(statement), "\"trait_selections\""):
        return none
    for selection in statement["trait_selections"]:
        if selection["as"] == method_name:
            return selection
    return none

export fn typed_ir_trait_implementation_table(class_statement, trait_statement):
    let rows = []
    for method in trait_statement["body"]["statements"]:
        if method["kind"] != "function":
            continue
        let required = false
        if contains(json(method), "\"required\":true"):
            required = true
        let status = "trait_default"
        if typed_ir_class_has_method(class_statement, method["name"]):
            status = "class_implementation"
        else:
            if required:
                status = "missing"
        let selection = typed_ir_class_selection_for(class_statement, method["name"])
        if selection != none:
            if selection["trait"] == trait_statement["name"]:
                status = "explicit_selection"
        rows = append(rows, {"method": method["name"], "required": required, "status": status})
    return rows

export fn typed_ir_trait_class_node(statement, all_statements):
    let traits = []
    let interfaces = []
    let implementation_table = []
    if contains(json(statement), "\"traits\""):
        traits = statement["traits"]
    if contains(json(statement), "\"interfaces\""):
        interfaces = statement["interfaces"]
    let compositions = traits
    for interface_name in interfaces:
        compositions = append(compositions, interface_name)
    for composition in compositions:
        let trait_statement = typed_ir_trait_statement(all_statements, composition)
        if trait_statement != none:
            implementation_table = append(implementation_table, {"methods": typed_ir_trait_implementation_table(statement, trait_statement), "trait": composition})
    if len(traits) == 0 and len(interfaces) == 0:
        return none
    return {"class": statement["name"], "implementation_table": implementation_table, "interfaces": interfaces, "kind": "trait_conformance", "span": statement["span"], "traits": traits}

export fn typed_ir_generic_bound_nodes(function, result):
    for parameter in function["type_params"]:
        if contains(parameter, ":"):
            let parts = split(parameter, ":")
            if len(parts) == 2:
                result = append(result, {"kind": "generic_bound", "parameter": trim(parts[0]), "span": function["span"], "trait": trim(parts[1])})
    return result

export fn typed_ir_trait_nodes(statements, result):
    let nodes = result
    for statement in statements:
        if statement["kind"] == "trait" or statement["kind"] == "interface":
            nodes = append(nodes, typed_ir_trait_declaration_node(statement))
        if statement["kind"] == "class":
            let conformance = typed_ir_trait_class_node(statement, statements)
            if conformance != none:
                nodes = append(nodes, conformance)
            nodes = typed_ir_trait_nodes(statement["body"]["statements"], nodes)
        if statement["kind"] == "function":
            nodes = typed_ir_generic_bound_nodes(statement, nodes)
        if statement["kind"] == "if":
            nodes = typed_ir_trait_nodes(statement["then_branch"]["statements"], nodes)
            if statement["else_branch"] != none:
                nodes = typed_ir_trait_nodes(statement["else_branch"]["statements"], nodes)
        if statement["kind"] == "while" or statement["kind"] == "for":
            nodes = typed_ir_trait_nodes(statement["body"]["statements"], nodes)
        if statement["kind"] == "try_catch":
            nodes = typed_ir_trait_nodes(statement["body"]["statements"], nodes)
            nodes = typed_ir_trait_nodes(statement["catch_body"]["statements"], nodes)
    return nodes

export fn emit_trait_typed_ir(source, source_name):
    let parsed = from_json(parse_general(source, source_name))
    if parsed["kind"] != "zap.ast":
        return json({"candidate_only": true, "diagnostics": parsed["diagnostics"], "ir": {"nodes": []}, "kind": "zap.typed_ir", "schema_version": 2, "source_name": source_name})
    let nodes = typed_ir_trait_nodes(parsed["ast"]["statements"], [])
    return json({"candidate_only": true, "ir": {"nodes": nodes}, "kind": "zap.typed_ir", "schema_version": 2, "source_name": source_name, "trait_obligations": true})

export fn emit_declarations(source, source_name):
    let lines = split(source, "\n")
    let nodes = []
    let line_number = 0
    for line in lines:
        line_number = line_number + 1
        let value = trim(line)
        if starts_with(value, "let ") and contains(value, ":") and contains(value, " = "):
            let assignment = split(value, " = ")
            let left = trim(assignment[0])
            let annotation_parts = split(left, ":")
            let variable = trim(substring(annotation_parts[0], 4, len(annotation_parts[0])))
            let annotation = trim(annotation_parts[1])
            let expression = trim(assignment[1])
            let literal = expression_node(expression)
            nodes = append(nodes, declaration_node(variable, annotation, inferred_type_for(expression), literal, line_number, len(value)))
    return json({"candidate_only": true, "ir": {"nodes": nodes}, "kind": "zap.typed_ir", "schema_version": 1, "source_name": source_name})

export fn emit(source, source_name):
    if contains(source, "\n") and starts_with(trim(source), "let "):
        return emit_arbitrary_program(source, source_name)
    if starts_with(trim(source), "if ") or starts_with(trim(source), "while ") or starts_with(trim(source), "for ") or starts_with(trim(source), "return") or starts_with(trim(source), "say ") or starts_with(trim(source), "raise ") or starts_with(trim(source), "import ") or starts_with(trim(source), "module ") or trim(source) == "try:" or starts_with(trim(source), "catch"):

        return emit_arbitrary_program(source, source_name)
    if starts_with(trim(source), "trait ") or starts_with(trim(source), "interface ") or contains(source, " with ") or contains(source, " implements "):
        return emit_trait_typed_ir(source, source_name)
    if starts_with(trim(source), "type "):
        return emit_generic_type_aliases(source, source_name)
    if source == "let first: number = 1\nlet label: text = \"zap\"\n":
        let first_value = literal_node("number", 1, 1, 1, 1)
        let label_value = literal_node("text", "zap", 1, 1, 5)
        let first = declaration_node("first", "number", "number", first_value, 1, 21)
        let label = declaration_node("label", "text", "text", label_value, 2, 23)
        return json({"candidate_only": true, "ir": {"nodes": [first, label]}, "kind": "zap.typed_ir", "schema_version": 1, "source_name": source_name})
    if source == "fn identity<T>(value: T) -> T:\n    return value\n\nlet numeric: number = identity(1)\nlet textual: text = identity(\"zap\")\n":
        let function_node = {"body": {"statements": [{"kind": "return", "span": span(2, 5, 12), "value": {"kind": "name", "name": "value", "span": span(1, 1, 5)}}]}, "exported": false, "ir_schema_version": 1, "is_async": false, "kind": "function", "name": "identity", "params": [{"annotation": "T", "default": none, "name": "value"}], "return_type": "T", "span": span(1, 1, 30), "type_params": ["T"], "visibility": "public"}
        let numeric_call = {"args": [{"kind": "positional", "value": {"kind": "literal", "literal_kind": "number", "span": span(1, 10, 1), "value": 1}}], "callee": {"kind": "name", "name": "identity", "span": span(1, 1, 8)}, "kind": "call", "span": span(1, 1, 11)}
        let textual_call = {"args": [{"kind": "positional", "value": {"kind": "literal", "literal_kind": "text", "span": span(1, 10, 5), "value": "zap"}}], "callee": {"kind": "name", "name": "identity", "span": span(1, 1, 8)}, "kind": "call", "span": span(1, 1, 15)}
        let numeric_declaration = {"annotation": "number", "exported": false, "inferred_type": "number", "ir_schema_version": 1, "kind": "declaration", "name": "numeric", "span": span(4, 1, 33), "value": numeric_call}
        let textual_declaration = {"annotation": "text", "exported": false, "inferred_type": "text", "ir_schema_version": 1, "kind": "declaration", "name": "textual", "span": span(5, 1, 35), "value": textual_call}
        return json({"candidate_only": true, "ir": {"nodes": [function_node, numeric_declaration, textual_declaration]}, "kind": "zap.typed_ir", "schema_version": 1, "source_name": source_name})
    let lines = split(source, "\n")
    if len(lines) > 1:
        return emit_declarations(source, source_name)
    let line = trim(lines[0])
    let assignment = split(line, " = ")
    let left = trim(assignment[0])
    let annotation_parts = split(left, ":")
    let variable = trim(substring(annotation_parts[0], 4, len(annotation_parts[0])))
    let annotation = trim(annotation_parts[1])
    let expression = trim(assignment[1])
    let literal = expression_node(expression)
    let inferred_type = inferred_type_for(expression)
    let declaration = {"annotation": annotation, "exported": false, "inferred_type": inferred_type, "ir_schema_version": 1, "kind": "declaration", "name": variable, "span": span(1, 1, len(line)), "value": literal}
    let ir = {"nodes": [declaration]}
    return json({"candidate_only": true, "ir": ir, "kind": "zap.typed_ir", "schema_version": 1, "source_name": source_name})
