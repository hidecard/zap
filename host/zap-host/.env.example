# Local demo configuration for zap-host.
# This file contains no credentials and must not be used as a production secret store.
ZAP_HOST_MODE=demo
ZAP_HOST_ADDR=127.0.0.1:3000
ZAP_HOST_MAX_BODY_BYTES=65536
ZAP_HOST_REQUEST_TIMEOUT_MS=10000
ZAP_HOST_SHUTDOWN_TIMEOUT_MS=30000
ZAP_HOST_RATE_LIMIT=60
ZAP_HOST_RATE_WINDOW_MS=60000
ZAP_HOST_RATE_KEY=local-demo
ZAP_DB_MAX_CONNECTIONS=16
ZAP_DB_ACQUIRE_TIMEOUT_MS=1000
ZAP_DB_QUERY_TIMEOUT_MS=5000
# Production example: ZAP_AUTH_MODE=jwt
# Production example: ZAP_AUTH_ALLOWED_ALGORITHMS=RS256
# Production also requires ZAP_AUTH_ISSUER, ZAP_AUTH_AUDIENCE, ZAP_AUTH_JWKS_URL, and DATABASE_URL.
RUST_LOG=zap_host=info,tower_http=info
