# Copy with deployment automation to /etc/zap/zap-web.env.
# Do not commit a populated environment file or credentials.
ZAP_WEB_PORT=3000
RUST_LOG=zap=info

# Host-adapter deployments use these explicit pool limits.
ZAP_DB_MAX_CONNECTIONS=16
ZAP_DB_ACQUIRE_TIMEOUT_MS=1000
ZAP_DB_QUERY_TIMEOUT_MS=5000

# Native Zap SQLite migrations use the project manifest by default.
# Override only through a secret/configuration manager when required.
# ZAP_DATABASE_URL=sqlite:///srv/zap/app/data/zap.sqlite3

# A real external database provider must inject credentials outside source control.
# DATABASE_URL=<injected-by-secret-manager>
# OIDC_ISSUER=<deployment-configured>
# OIDC_AUDIENCE=<deployment-configured>
# OIDC_CLIENT_ID=<deployment-configured>
