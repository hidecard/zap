# Reference environment for /etc/zap/zap-host.env.
# Copy through a deployment secret-management process; do not commit a populated file.
ZAP_HOST_ADDR=127.0.0.1:3000
ZAP_HOST_MAX_BODY_BYTES=65536
ZAP_HOST_REQUEST_TIMEOUT_MS=10000
ZAP_HOST_SHUTDOWN_TIMEOUT_MS=30000
ZAP_HOST_RATE_LIMIT=60
ZAP_HOST_RATE_WINDOW_MS=60000
# Replace with a deployment-derived trusted key policy; never use an arbitrary client header.
ZAP_HOST_RATE_KEY=deployment-subject-or-tenant
RUST_LOG=zap_host=info,tower_http=info

# Production repository pool policy; the injected UserRepository must consume these values.
ZAP_DB_MAX_CONNECTIONS=16
ZAP_DB_ACQUIRE_TIMEOUT_MS=1000
ZAP_DB_QUERY_TIMEOUT_MS=5000

# Production adapters must provide these outside this example:
# DATABASE_URL=<injected-by-secret-manager>
# Production OAuth2/OIDC resource-server mode.
ZAP_AUTH_MODE=jwt
ZAP_AUTH_ISSUER=<https-issuer-url>
ZAP_AUTH_AUDIENCE=<api-audience>
ZAP_AUTH_JWKS_URL=<https-jwks-url>
ZAP_AUTH_ALLOWED_ALGORITHMS=RS256
ZAP_AUTH_CLOCK_SKEW_SECONDS=30
ZAP_AUTH_JWKS_CACHE_SECONDS=300
ZAP_AUTH_MAX_TOKEN_BYTES=16384
# Browser clients must use Authorization Code + PKCE at the identity provider.
